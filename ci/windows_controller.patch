+        if ($LASTEXITCODE -ne 0 -or ($text | Out-String).Length -gt 8192) { throw 'DIAGNOSTIC_UNAVAILABLE' }
+        return (($text | Out-String) | ConvertFrom-Json)
+    } catch {
+        return [pscustomobject]@{available=$false; status='UNAVAILABLE'; stage='unknown'; completed=@();
+            native_rc=$null; stata_rc=$null; reason='unavailable'; plugin_sha256=$null;
+            stage_elapsed_ms=$null; compiler_errors=@()}
+    }
+}
