+pub(crate) fn ppml_coefficient_lifetime_bytes(
+    design: &FeDesign,
+    rhs: usize,
+    threads: usize,
+    categorical_checkpoint: bool,
+) -> Result<u128> {
+    let checkpoint = if categorical_checkpoint {
