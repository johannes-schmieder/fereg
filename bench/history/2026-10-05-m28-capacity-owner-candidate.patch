+            0
+        };
+        let buffer = IO_BUFFER_BYTES
+            .min(usize::try_from(bytes).unwrap_or(usize::MAX))
+            .max(row)
+            .max(8);
+        Ok(Self {
+            bytes,
+            buffer: Capacity::new(if buffered { buffer as u128 } else { 0 }),
+        })
