-#[allow(clippy::too_many_arguments)]
-fn finish_ols_schur(
-    mut absorber: ReusableCategoricalMapAbsorber<'_>,
-    graph: TwoFePcgWorkspace,
-    weights: BorrowedMapWeights<'_>,
-    config: crate::fe::AbsorbConfig,
-    map: MapConfig,
