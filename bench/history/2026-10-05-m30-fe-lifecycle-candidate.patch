-                let values = &original.as_slice()[row * rhs..(row + 1) * rhs];
-                for channel in 0..channels {
-                    let left = weight(self.weights, row) * basis_value(&self.effect, channel, row);
-                    for (sum, &value) in coefficients[channel * rhs..(channel + 1) * rhs]
