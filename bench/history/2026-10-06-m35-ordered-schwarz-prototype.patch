+use schwarz_precond::{LocalSolver, LocalSolveError, SubdomainEntry, SubdomainCore, SchwarzPreconditioner, ReductionStrategy};
+use std::sync::{Arc, atomic::{AtomicUsize,Ordering}, Barrier};
+
+struct DelayedDiagonal { index:usize, phase:Arc<AtomicUsize>, barrier:Arc<Barrier> }
+impl LocalSolver for DelayedDiagonal {
+    fn n_local(&self)->usize{1}
+    fn scratch_size(&self)->usize{1}
+    fn solve_local(&self,r:&mut[f64],z:&mut[f64],_:bool)->Result<(),LocalSolveError>{
+        self.barrier.wait();
+        let order=if self.phase.load(Ordering::Relaxed)==0 {[0,1,2]}else{[2,0,1]};
+        std::thread::sleep(std::time::Duration::from_millis(order[self.index]*3));
+        z[0]=r[0]*if self.index==0{1.0}else{2.0f64.powi(-53)};
+        Ok(())
+    }
+}
+
+#[test]
+fn overlapping_spd_terms_complete_in_different_orders(){
+    for threads in [4,8] {
+        let pool=rayon::ThreadPoolBuilder::new().num_threads(threads).build().unwrap();
+        for strategy in [ReductionStrategy::AtomicScatter,ReductionStrategy::ParallelReduction] {
+          for ordered in [false,true] {
+            let phase=Arc::new(AtomicUsize::new(0));
+            let barrier=Arc::new(Barrier::new(3));
+            let entries=(0..3).map(|index|SubdomainEntry::try_new(SubdomainCore::uniform(vec![0]),DelayedDiagonal{index,phase:phase.clone(),barrier:barrier.clone()}).unwrap()).collect();
+            let pre=SchwarzPreconditioner::new(entries,strategy);
+            let mut bits=Vec::new();
+            for order in [0,1,0,1] {
+                phase.store(order,Ordering::Relaxed);
+                bits.push(pool.install(||{let mut z=[0.0];if ordered{pre.apply_ordered(&[1.0],&mut z).unwrap();}else{pre.apply(&[1.0],&mut z).unwrap();}z[0].to_bits()}));
+            }
+            println!("FEREG_KERNEL_DIAG schwarz workers={threads} backend={strategy:?} ordered={ordered} bits={bits:?} nonexact={}",bits.iter().any(|b|*b!=bits[0]));
+            // All terms are positive diagonal SPD operators. Exact mathematical sum is 1+2^-52.
+            if ordered {assert!(bits.iter().all(|b|*b==bits[0]));}
+            for b in bits {assert!((f64::from_bits(b)-(1.0+2.0f64.powi(-52))).abs()<=f64::EPSILON);}
+          }
+        }
+    }
