index 00000000..a8a7f607
--- /dev/null
+++ b/crates/fereg-core/src/ols/prepared_topology.rs
@@ -0,0 +1,234 @@
+//! Ordinary grammar finishes directly into the shared immutable FE topology.
+
+use super::*;
+use crate::fe::ValidatedFinalizedTopology;
+use crate::prepared_categorical_data::PreparedCategoricalModelSource;
+
+pub(crate) struct FinalOlsParts {
+    pub(crate) model: PreparedOlsModel,
+    pub(crate) sample: PreparedNumericSample,
+    pub(crate) categorical_sources: Vec<PreparedCategoricalSource>,
+    pub(crate) effects: Vec<PreparedOlsEffect>,
+    pub(crate) prebuilt_index: Option<(usize, LevelIndex)>,
+    pub(crate) structural_intercept: bool,
+    pub(crate) report_intercept: bool,
+    pub(crate) singletons: PreparedOlsSingletons,
+}
+
+impl FinalOlsParts {
+    pub(super) fn into_ordinary(self, request: &OlsRequestV1) -> Result<PreparedOlsData> {
+        self.into_ordinary_with_reservation(request, &mut SystemFeTopologyReservation)
+    }
+
+    pub(super) fn into_ordinary_with_reservation<R: FeTopologyReservation>(
+        mut self,
+        request: &OlsRequestV1,
+        reservation: &mut R,
+    ) -> Result<PreparedOlsData> {
+        let mut recipes = Vec::new();
+        reservation.reserve_vec(
+            &mut recipes,
+            self.effects.len(),
+            "unable to reserve transferred effect recipe views",
+        )?;
+        for effect in &self.effects {
+            push_reserved(
+                &mut recipes,
+                std::slice::from_ref(&effect.categorical_source_index),
+                "transferred recipe-view capacity exhausted",
+            )?;
+        }
+        let topology = ValidatedFinalizedTopology::from_single_source_indexes(
+            self.categorical_sources.len(),
+            self.sample.n_active(),
+            &recipes,
+            |candidate| {
+                let source = self
+                    .categorical_sources
+                    .get_mut(candidate)
+                    .ok_or_else(|| invalid("prepared FE topology source index is out of range"))?;
+                let levels = source.encoded.n_levels();
+                let index = if self
+                    .prebuilt_index
+                    .as_ref()
+                    .is_some_and(|(i, _)| *i == candidate)
+                {
+                    self.prebuilt_index
+                        .take()
+                        .expect("matched prepared membership")
+                        .1
+                } else {
+                    LevelIndex::from_codes(&source.encoded.codes, levels)?
+                };
+                if !request.keep_singletons {
+                    for level in 0..levels {
+                        if level_multiplicity(&self.sample, index.checked_members(level)?)? == 1 {
+                            return Err(invalid("prepared FE topology contains a singleton after fixed-point pruning"));
+                        }
+                    }
+                }
+                Ok((std::mem::take(&mut source.encoded.codes), levels, index))
+            },
+        )?;
+        drop(recipes);
+        if self.prebuilt_index.is_some() {
+            return Err(invalid(
+                "prebuilt FE membership has no matching topology source",
+            ));
+        }
+        for (effect, index) in self.effects.iter_mut().zip(topology.effect_to_topology()) {
+            effect.topology_source_index = *index;
+        }
+        let mut categorical_sources = Vec::new();
+        reservation.reserve_vec(
+            &mut categorical_sources,
+            self.categorical_sources.len(),
+            "unable to reserve final categorical model sources",
+        )?;
+        for (candidate, source) in self.categorical_sources.into_iter().enumerate() {
+            push_reserved(
+                &mut categorical_sources,
+                PreparedCategoricalModelSource::from_transferred_encoding(
+                    candidate, source, &topology,
+                )?,
+                "final categorical model-source capacity exhausted",
+            )?;
+        }
+        let prepared = PreparedOlsData {
+            model: self.model,
+            sample: self.sample,
+            categorical_sources,
+            fe_topology: topology,
+            effects: self.effects,
+            singleton_policy: if request.keep_singletons {
+                PreparedOlsFeSingletonPolicy::KeptByRequest
+            } else {
+                PreparedOlsFeSingletonPolicy::VerifiedFixedPoint
+            },
+            structural_intercept: self.structural_intercept,
+            report_intercept: self.report_intercept,
+            singletons: self.singletons,
+        };
+        prepared.validate_fe_bindings()?;
+        if prepared.effects.len() != request.absorbed_terms.len()
+            || prepared
+                .effects
+                .iter()
+                .zip(&request.absorbed_terms)
+                .any(|(effect, term)| {
+                    effect.term_id != term.id
+                        || effect.label != term.label
+                        || term.categorical_sources.as_slice() != [effect.source]
+                })
+        {
+            return Err(invalid(
+                "prepared FE topology dimensions or term identity differ from request",
+            ));
+        }
+        prepared.fe_topology.registry().total_levels()?;
+        Ok(prepared)
+    }
+}
+
+pub(super) fn prepare_final_memberships(
+    sources: &[PreparedCategoricalSource],
+    effects: &[PreparedOlsEffect],
+    mut prebuilt: Option<(usize, LevelIndex)>,
+) -> Result<Vec<(usize, LevelIndex)>> {
+    let mut membership = Vec::new();
+    membership
+        .try_reserve_exact(effects.len())
+        .map_err(|_| allocation("unable to reserve prepared FE membership sources"))?;
+    for effect in effects {
+        let candidate = effect.categorical_source_index;
+        if membership.iter().any(|(index, _)| *index == candidate) {
+            continue;
+        }
+        let source = sources
+            .get(candidate)
+            .ok_or_else(|| invalid("prepared FE topology source index is out of range"))?;
+        let index = if prebuilt.as_ref().is_some_and(|(i, _)| *i == candidate) {
+            prebuilt.take().expect("matched prepared membership").1
+        } else {
+            LevelIndex::from_codes(&source.encoded.codes, source.encoded.n_levels())?
+        };
+        membership.push((candidate, index));
+    }
+    if prebuilt.is_some() {
+        return Err(invalid(
+            "prebuilt FE membership has no matching topology source",
+        ));
+    }
+    Ok(membership)
+}
+
+impl PreparedOlsData {
+    /// The topology proof is local to its immutable buffers. Check the current
+    /// mutable sample and every small source/effect binding on each borrowed use.
+    pub(crate) fn validate_fe_bindings(&self) -> Result<()> {
+        let topology = self.fe_topology();
+        let nobs = self.sample.n_active();
+        if topology.nobs() != nobs || topology.effect_to_topology().len() != self.effects.len() {
+            return Err(invalid(
+                "borrowed FE design topology is not aligned with the final sample",
+            ));
+        }
+        for (effect, expected_index) in self.effects.iter().zip(topology.effect_to_topology()) {
+            let source = self
+                .categorical_sources
+                .get(effect.categorical_source_index)
+                .ok_or_else(|| invalid("borrowed FE design categorical source is out of range"))?;
+            let registry = topology.registry().source(effect.topology_source_index)?;
+            let codes = source.codes(topology)?;
+            let compacted = topology.source_for_candidate(effect.categorical_source_index)?;
+            if effect.topology_source_index != *expected_index
+                || source.source() != effect.source
+                || source.n_levels(topology)? != registry.n_levels()
+                || codes.len() != nobs
+                || registry.partition().is_interaction()
+                || registry.partition().categorical_source_indices().len() != 1
+                || topology.compacted_sources()
+                    [registry.partition().categorical_source_indices()[0]]
+                    .candidate_source_index()
+                    != effect.categorical_source_index
+                || !std::ptr::eq(codes, compacted.codes())
+                || self
+                    .sample
+                    .regressors
+                    .get(source.prepared_source_index())
+                    .is_none_or(|values| values.len() != nobs)
+            {
+                return Err(invalid(
+                    "borrowed FE design source identities are inconsistent",
+                ));
+            }
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn build_borrowed_intercept_fe_design_with_reservation<'a, R: FeTopologyReservation>(
+    prepared: &'a PreparedOlsData,
+    reservation: &mut R,
+) -> Result<BorrowedInterceptFeDesign<'a>> {
+    prepared.validate_fe_bindings()?;
+    let mut effects = Vec::new();
+    reservation.reserve_vec(
+        &mut effects,
+        prepared.effects.len(),
+        "unable to reserve borrowed FE design effects",
+    )?;
+    for effect in &prepared.effects {
+        let source = ValidatedBorrowedInterceptSource::from_finalized_source(
+            &prepared.fe_topology,
+            effect.topology_source_index,
+        )
+        .ok_or_else(|| invalid("borrowed FE design topology source is out of range"))?;
+        push_reserved(
+            &mut effects,
+            source.effect(),
+            "borrowed FE design effect capacity exhausted",
+        )?;
+    }
+    BorrowedInterceptFeDesign::new(prepared.sample.n_active(), effects)
+}
