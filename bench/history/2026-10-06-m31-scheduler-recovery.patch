-
-    let mut reference_norms = reserved_filled(
-        reservation,
-        generated_columns,
-        0.0_f64,
-        "unable to reserve low-memory prepared OLS reference norms",
-    )?;
-    let mut score_norms = reserved_filled(
-        reservation,
-        generated_columns,
-        0.0_f64,
-        "unable to reserve low-memory prepared OLS within score norms",
