+//! Numerical banks shared by stateless OLS and retained finite operations.
+#[derive(Debug)]
+pub(crate) struct FiniteWorkspace<Slot = ()> {
+    pub(crate) response: Vec<f64>,
+    pub(crate) gram: Vec<f64>,
+    pub(crate) factor: Vec<f64>,
+    pub(crate) inverse_lower: Vec<f64>,
+    pub(crate) rhs: Vec<f64>,
+    pub(crate) moment_partials: Vec<f64>,
+    pub(crate) row: Vec<f64>,
+    pub(crate) solve: Vec<f64>,
+    pub(crate) permutation: Vec<usize>,
+    pub(crate) scores: Vec<f64>,
+    pub(crate) coefficients: Vec<f64>,
+    pub(crate) bread: Vec<f64>,
+    pub(crate) residuals: Vec<f64>,
+    pub(crate) reported_coefficients: Vec<Option<f64>>,
+    pub(crate) kept: Vec<usize>,
+    pub(crate) candidate_positions: Vec<usize>,
+    pub(crate) candidate_ids: Vec<usize>,
+    pub(crate) candidate_scales: Vec<f64>,
+    pub(crate) reference_mean_corrections: Vec<f64>,
+    pub(crate) basis_slots: Vec<Slot>,
+}
+impl<Slot> Default for FiniteWorkspace<Slot> {
+    fn default() -> Self {
+        Self {
+            response: Vec::new(),
+            gram: Vec::new(),
+            factor: Vec::new(),
+            inverse_lower: Vec::new(),
+            rhs: Vec::new(),
+            moment_partials: Vec::new(),
+            row: Vec::new(),
+            solve: Vec::new(),
+            permutation: Vec::new(),
+            scores: Vec::new(),
+            coefficients: Vec::new(),
+            bread: Vec::new(),
+            residuals: Vec::new(),
+            reported_coefficients: Vec::new(),
+            kept: Vec::new(),
+            candidate_positions: Vec::new(),
+            candidate_ids: Vec::new(),
+            candidate_scales: Vec::new(),
+            reference_mean_corrections: Vec::new(),
+            basis_slots: Vec::new(),
+        }
+    }
+}
diff --git a/crates/fereg-core/src/ols/prepared_fit/finite.rs b/crates/fereg-core/src/ols/prepared_fit/finite.rs
new file mode 100644
index 00000000..ce79e3ad
--- /dev/null
+++ b/crates/fereg-core/src/ols/prepared_fit/finite.rs
@@ -0,0 +1,404 @@
+//! One-shot adapter to the common stateless immutable-row finite service.
+use super::*;
+use crate::ols::finite_operations::{resize, solve_factor, FactorBanks, RankRequest};
+use crate::ols::finite_wls_kernel::{
+    fill_finite_wls_moments, FiniteDenseRows, FiniteResponse, FiniteWorkspace,
+};
+
+pub(super) enum ProjectedFiniteRows<'a> {
+    Dense(&'a DenseMatrix),
+    Scratch {
+        scratch: &'a PreparedOlsScratch,
+        outcome: &'a [f64],
+    },
+}
+impl ProjectedFiniteRows<'_> {
+    fn source<'a>(
+        &'a self,
+        selected: &'a [usize],
+        scales: &'a [f64],
+        weights: NormalizedWeights<'a>,
+        weight_scale: PreparedOlsBreadWeightScale,
+    ) -> FixedBlockMomentSource<'a> {
+        match self {
+            Self::Dense(values) => FixedBlockMomentSource::Dense {
+                values: FiniteDenseRows::projected(values),
+                rows: values.nrows(),
+                stored_columns: values.ncols() - 1,
+                selected_columns: Some(selected),
+                response: FiniteResponse::FirstColumn(values),
+                weights: weights.borrowed(),
+                solver_weight_divisor: weight_scale.solver_weight_divisor,
+                column_scales: Some(scales),
+            },
+            Self::Scratch { scratch, outcome } => FixedBlockMomentSource::Scratch {
+                values: scratch,
+                selected_columns: Some(selected),
+                response: (*outcome).into(),
+                weights: weights.borrowed(),
+                solver_weight_divisor: weight_scale.solver_weight_divisor,
+                column_scales: Some(scales),
+            },
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn solve_one_shot<P: PreparedOlsFitView + ?Sized, R: FitReservation>(
+    prepared: &P,
+    storage: ProjectedFiniteRows<'_>,
+    weights: NormalizedWeights<'_>,
+    bread_weight_scale: PreparedOlsBreadWeightScale,
+    reference_norms: &[f64],
+    score_norms: &[f64],
+    config: PreparedOlsFitConfig,
+    reservation: &mut R,
+    perturb_first_coefficient: bool,
+    perturb_bread: bool,
+    build_bread: bool,
+) -> Result<FiniteFit> {
+    let rows = prepared.fit_sample().n_active();
+    let columns = prepared.fit_model().columns.len();
+    let valid = match &storage {
+        ProjectedFiniteRows::Dense(values) => {
+            values.nrows() == rows && values.ncols() == columns + 1
+        }
+        ProjectedFiniteRows::Scratch { scratch, outcome } => {
+            scratch.rows() == rows && scratch.columns() == columns && outcome.len() == rows
+        }
+    };
+    if !valid || reference_norms.len() != columns || score_norms.len() != columns {
+        return Err(invalid_argument(
+            "prepared finite projected axes are inconsistent",
+        ));
+    }
+    let mut workspace = FiniteWorkspace::<()>::default();
+    let mut statuses = reserved_filled(
+        reservation,
+        columns,
+        PreparedOlsFitStatus::NumericallyRankDeficient,
+        "unable to reserve finite statuses",
+    )?;
+    reservation.reserve(
+        &mut workspace.candidate_ids,
+        columns,
+        "unable to reserve finite candidates",
+    )?;
+    classify_qr_candidates(
+        prepared,
+        &mut statuses,
+        &mut workspace.candidate_ids,
+        config.fixed_effect_collinearity_tolerance,
+        "finite candidate capacity exhausted",
+        |column| match storage {
+            ProjectedFiniteRows::Dense(_) => {
+                fast_qr_norms(reference_norms[column], score_norms[column])
+            }
+            ProjectedFiniteRows::Scratch { .. } => {
+                low_qr_norms(reference_norms[column], score_norms[column])
+            }
+        },
+    )?;
+    reservation.reserve(
+        &mut workspace.candidate_scales,
+        workspace.candidate_ids.len(),
+        "unable to reserve finite scales",
+    )?;
+    workspace.candidate_scales.extend(
+        workspace
+            .candidate_ids
+            .iter()
+            .map(|&column| reference_norms[column]),
+    );
+    let relative_threshold =
+        config.rank_tolerance_multiplier * f64::EPSILON * rows.max(columns).max(1) as f64;
+    let (report, bread) = if workspace.candidate_ids.is_empty() {
+        let report = super::super::finite_wls_kernel::RankRevealingQrReport {
+            rank: 0,
+            initial_norm: 0.,
+            maximum_dropped_relative_norm: 0.,
+            condition_proxy: 1.,
+            ambiguous: false,
+        };
+        let bread = if build_bread {
+            Some(build_one_shot_bread(
+                &mut workspace,
+                reference_norms,
+                bread_weight_scale,
+                config,
+                reservation,
+                perturb_bread,
+            )?)
+        } else {
+            None
+        };
+        (report, bread)
+    } else {
+        let source = storage.source(
+            &workspace.candidate_ids,
+            &workspace.candidate_scales,
+            weights,
+            bread_weight_scale,
+        );
+        let layout = finite_wls_moment_layout(source)?;
+        let count = workspace.candidate_ids.len();
+        resize(
+            &mut workspace.moment_partials,
+            layout.partial_elements,
+            0.,
+            reservation,
+        )?;
+        resize(
+            &mut workspace.gram,
+            checked_square(count, "finite Gram dimensions overflow")?,
+            0.,
+            reservation,
+        )?;
+        resize(&mut workspace.rhs, count, 0., reservation)?;
+        fill_finite_wls_moments(
+            source,
+            layout,
+            &mut workspace.moment_partials,
+            &mut workspace.rhs,
+            &mut workspace.gram,
+        )?;
+        factor_and_bread(
+            &storage,
+            weights,
+            &mut workspace,
+            relative_threshold,
+            reference_norms,
+            bread_weight_scale,
+            config,
+            reservation,
+            perturb_bread,
+            build_bread,
+        )?
+    };
+    finish(
+        prepared,
+        storage,
+        workspace,
+        statuses,
+        report,
+        relative_threshold,
+        bread,
+        reference_norms,
+        score_norms,
+        reservation,
+        perturb_first_coefficient,
+    )
+}
+
+#[allow(clippy::too_many_arguments)]
+fn factor_and_bread<R: FitReservation>(
+    storage: &ProjectedFiniteRows<'_>,
+    weights: NormalizedWeights<'_>,
+    workspace: &mut FiniteWorkspace,
+    threshold: f64,
+    reference_norms: &[f64],
+    weight_scale: PreparedOlsBreadWeightScale,
+    config: PreparedOlsFitConfig,
+    reservation: &mut R,
+    perturb_bread: bool,
+    build_bread: bool,
+) -> Result<(
+    super::super::finite_wls_kernel::RankRevealingQrReport,
+    Option<FiniteBreadDraft>,
+)> {
+    let mut allow_cholesky = true;
+    loop {
+        let source = storage.source(
+            &workspace.candidate_ids,
+            &workspace.candidate_scales,
+            weights,
+            weight_scale,
+        );
+        let factor = solve_factor(
+            source,
+            &workspace.candidate_ids,
+            threshold,
+            RankRequest::OlsDiscover,
+            allow_cholesky,
+            FactorBanks {
+                gram: &workspace.gram,
+                rhs: &workspace.rhs,
+                factor: &mut workspace.factor,
+                auxiliary: &mut workspace.inverse_lower,
+                solve: &mut workspace.solve,
+                scores: &mut workspace.scores,
+                row: &mut workspace.row,
+                permutation: &mut workspace.permutation,
+                coefficients: &mut workspace.coefficients,
+                inverse: &mut workspace.bread,
+                selected: &mut workspace.kept,
+            },
+            reservation,
+            |_, _, _| Ok(()),
+        )?;
+        let bread = if build_bread {
+            match build_one_shot_bread(
+                workspace,
+                reference_norms,
+                weight_scale,
+                config,
+                reservation,
+                perturb_bread,
+            ) {
+                Ok(bread) => Some(bread),
+                Err(error)
+                    if !factor.used_qr
+                        && !perturb_bread
+                        && error.code == ErrorCode::InvalidData =>
+                {
+                    // The complete inverse/reference-scale finalization is the
+                    // OLS trial boundary. Its one rejected Cholesky trial may
+                    // retry QR; allocation/argument errors and QR errors fail.
+                    allow_cholesky = false;
+                    continue;
+                }
+                Err(error) => return Err(error),
+            }
+        } else {
+            None
+        };
+        return Ok((factor.report, bread));
+    }
+}
+
+fn build_one_shot_bread<R: FitReservation>(
+    workspace: &mut FiniteWorkspace,
+    reference_norms: &[f64],
+    weight_scale: PreparedOlsBreadWeightScale,
+    config: PreparedOlsFitConfig,
+    reservation: &mut R,
+    perturb_bread: bool,
+) -> Result<FiniteBreadDraft> {
+    let mut identities = reserved_empty(
+        reservation,
+        workspace.kept.len(),
+        "unable to reserve finite bread identities",
+    )?;
+    identities.extend_from_slice(&workspace.kept);
+    let mut positions = reserved_empty(
+        reservation,
+        workspace.kept.len(),
+        "unable to reserve finite selected positions",
+    )?;
+    for &column in &workspace.kept {
+        positions.push(
+            workspace
+                .candidate_ids
+                .iter()
+                .position(|&id| id == column)
+                .ok_or_else(|| invalid_argument("finite selected identity is absent"))?,
+        );
+    }
+    finalize_finite_bread_draft(
+        &workspace.candidate_ids,
+        &workspace.gram,
+        identities,
+        positions,
+        std::mem::take(&mut workspace.bread),
+        reference_norms,
+        weight_scale,
+        config.bread_tolerance,
+        reservation,
+        perturb_bread,
+    )
+}
+
+#[allow(clippy::too_many_arguments)]
+fn finish<P: PreparedOlsFitView + ?Sized, R: FitReservation>(
+    prepared: &P,
+    storage: ProjectedFiniteRows<'_>,
+    workspace: FiniteWorkspace,
+    mut statuses: Vec<PreparedOlsFitStatus>,
+    report: super::super::finite_wls_kernel::RankRevealingQrReport,
+    relative_threshold: f64,
+    bread: Option<FiniteBreadDraft>,
+    reference_norms: &[f64],
+    score_norms: &[f64],
+    reservation: &mut R,
+    perturb_coefficient: bool,
+) -> Result<FiniteFit> {
+    let columns = prepared.fit_model().columns.len();
+    let mut coefficients = reserved_filled(
+        reservation,
+        columns,
+        None,
+        "unable to reserve finite coefficients",
+    )?;
+    for (position, &generated) in workspace.kept.iter().enumerate() {
+        let value = workspace.coefficients[position] / reference_norms[generated];
+        if !value.is_finite() {
+            return Err(invalid_data("prepared OLS QR coefficient is not finite"));
+        }
+        coefficients[generated] = Some(value);
+        statuses[generated] = PreparedOlsFitStatus::Kept;
+    }
+    if perturb_coefficient {
+        *coefficients.iter_mut().flatten().next().ok_or_else(|| {
+            invalid_argument("injected perturbation requires a kept coefficient")
+        })? += 0.25;
+    }
+    let finite_score = build_finite_score_draft(
+        &workspace.candidate_ids,
+        &workspace.gram,
+        &workspace.rhs,
+        &coefficients,
+        &statuses,
+        reference_norms,
+        score_norms,
+    )?;
+    let within_residuals = match storage {
+        ProjectedFiniteRows::Dense(within) => {
+            let mut residuals = reserved_empty(
+                reservation,
+                within.nrows(),
+                "unable to reserve finite residuals",
+            )?;
+            for row in 0..within.nrows() {
+                // Immutable projected coordinates retain the physical FE owner.
+                let mut value = within[(row, 0)];
+                for &column in &workspace.kept {
+                    value = (-coefficients[column].expect("selected finite coefficient"))
+                        .mul_add(within[(row, column + 1)], value);
+                }
+                if !value.is_finite() {
+                    return Err(invalid_data("prepared finite residual is not finite"));
+                }
+                residuals.push(value);
+            }
+            Some(residuals)
+        }
+        ProjectedFiniteRows::Scratch { .. } => None,
+    };
+    let mut dropped = reserved_empty(
+        reservation,
+        columns,
+        "unable to reserve finite dropped identities",
+    )?;
+    for (column, status) in statuses.iter().enumerate() {
+        if *status != PreparedOlsFitStatus::Kept {
+            dropped.push(column);
+        }
+    }
+    // The finite service never overwrites projected rows, including QR cases.
+    Ok(FiniteFit {
+        generated_coefficients: coefficients,
+        generated_statuses: statuses,
+        kept: workspace.kept,
+        dropped,
+        rank: report.rank,
+        certificate: PreparedOlsRankCertificate {
+            relative_threshold,
+            maximum_dropped_trailing_norm: report.maximum_dropped_relative_norm,
+            condition_proxy: report.condition_proxy,
+            passed: true,
+        },
+        finite_score,
+        bread,
+        within_residuals,
+    })
+}
diff --git a/crates/fereg-core/src/ols/prepared_fit/one_shot.rs b/crates/fereg-core/src/ols/prepared_fit/one_shot.rs
new file mode 100644
index 00000000..d5bb396e
--- /dev/null
+++ b/crates/fereg-core/src/ols/prepared_fit/one_shot.rs
@@ -0,0 +1,925 @@
+//! One OLS lifecycle; storage implements projection and physical finite kernels.
+use super::*;
+
+struct DenseRaw {
+    values: DenseMatrix,
+    moments: Option<RawMomentCache>,
+    reference_norms: Vec<f64>,
+    reference_mean_scales: Vec<f64>,
+    strided_score_means: Option<Vec<f64>>,
+}
+
+struct DenseProjected {
+    within: Option<DenseMatrix>,
+    raw: DenseRaw,
+    cached_norms: Vec<f64>,
+}
+struct ScratchProjected {
+    scratch: PreparedOlsScratch,
+    outcome: Vec<f64>,
+}
+
+enum ProjectedStorage {
+    Dense(DenseProjected),
+    Scratch(ScratchProjected),
+}
+struct OneShotInputs {
+    storage: ProjectedStorage,
+    reference_norms: Vec<f64>,
+    norms: Vec<f64>,
+    within_outcome_norm: f64,
+    initial_sum_of_squares: f64,
+    absorption_report: SolveReport,
+    initial_fe_coefficients: Option<FeCoefficientBatch>,
+    scratch_bytes: u64,
+    fast_score_cache: Option<PreparedOlsFastScoreCache>,
+}
+impl OneShotInputs {
+    fn score_norms(&self) -> &[f64] {
+        match self.storage {
+            ProjectedStorage::Dense(_) => &self.norms[1..],
+            ProjectedStorage::Scratch(_) => &self.norms,
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn dense_raw<P: PreparedOlsFitView + ?Sized, R: FitReservation>(
+    prepared: &P,
+    frame: LinearSolveFrame<'_>,
+    reservation: &mut R,
+    retain_fast_score_cache: bool,
+    max_fast_score_cache_bytes: usize,
+    loaded_rows: Option<LoadedOlsRows>,
+) -> Result<DenseRaw> {
+    let weights = frame.weights();
+    let generated_columns = prepared.fit_model().columns.len();
+    let (rows, pending_moments) =
+        loaded_rows.map_or((None, None), |loaded| (Some(loaded.rows), loaded.moments));
+    let (raw, reused_rows) = prepared.fit_build_rhs_with_loaded_rows(frame.response(), rows)?;
+    let pending_moments = if reused_rows && weights.values.is_none() {
+        pending_moments
+    } else {
+        None
+    };
+    let use_strided_fast_score_cache =
+        retain_fast_score_cache && !fast_score_cache_fits(prepared, max_fast_score_cache_bytes)?;
+    let mut reference_norms = reserved_filled(
+        reservation,
+        generated_columns,
+        0.0_f64,
+        "unable to reserve prepared OLS reference norms",
+    )?;
+    let mut reference_mean_scales = if retain_fast_score_cache {
+        reserved_filled(
+            reservation,
+            generated_columns,
+            0.0_f64,
+            "unable to reserve prepared OLS fast score mean scales",
+        )?
+    } else {
+        Vec::new()
+    };
+    // IID already uses the deterministic row-major raw-moment cache for an
+    // absorbed intercept.  Reuse that same primitive when an inference fit is
+    // too large for the accepted packed score cache: it supplies norms,
+    // scales, and means in two fused passes rather than walking the row-major
+    // matrix once per generated column and then scanning it again for score
+    // means.  The packed path remains unchanged.
+    let raw_moments = if (prepared.fit_has_absorbed_intercept() && !retain_fast_score_cache)
+        || use_strided_fast_score_cache
+    {
+        let cache = match pending_moments {
+            Some(result) => result?,
+            None => build_raw_moment_cache(&raw, weights, reservation)?,
+        };
+        for (column, norm) in reference_norms.iter_mut().enumerate() {
+            *norm = cache.norms[column + 1];
+        }
+        for (column, scale) in reference_mean_scales.iter_mut().enumerate() {
+            *scale = cache.scales[column + 1];
+        }
+        Some(cache)
+    } else {
+        None
+    };
+    if retain_fast_score_cache && raw_moments.is_none() {
+        crate::parallel::stage_try_for_each(
+            reference_norms
+                .par_iter_mut()
+                .zip(reference_mean_scales.par_iter_mut())
+                .enumerate(),
+            raw.nrows() as u128 * generated_columns as u128,
+            |(column, (norm, mean_scale))| -> Result<()> {
+                *norm = weighted_matrix_column_norm(&raw, column + 1, weights)?;
+                for row in 0..raw.nrows() {
+                    *mean_scale = mean_scale.max(raw[(row, column + 1)].abs());
+                }
+                Ok(())
+            },
+        )?;
+    } else if raw_moments.is_none() {
+        crate::parallel::stage_try_for_each(
+            reference_norms.par_iter_mut().enumerate(),
+            raw.nrows() as u128 * generated_columns as u128,
+            |(column, norm)| -> Result<()> {
+                *norm = weighted_matrix_column_norm(&raw, column + 1, weights)?;
+                Ok(())
+            },
+        )?;
+    }
+    let strided_score_means = if use_strided_fast_score_cache {
+        let cache = raw_moments
+            .as_ref()
+            .ok_or_else(|| invalid_argument("prepared OLS strided score raw moments are absent"))?;
+        let mut means = reserved_empty(
+            reservation,
+            generated_columns,
+            "unable to reserve prepared OLS strided score means",
+        )?;
+        means.extend_from_slice(&cache.means[1..]);
+        Some(means)
+    } else {
+        None
+    };
+
+    Ok(DenseRaw {
+        values: raw,
+        moments: raw_moments,
+        reference_norms,
+        reference_mean_scales,
+        strided_score_means,
+    })
+}
