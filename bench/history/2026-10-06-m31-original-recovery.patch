-fn stable_slice_segment_norm(values: &[f64], start: usize) -> Result<f64> {
-    if start > values.len() {
-        return Err(invalid_argument(
-            "prepared OLS low-memory norm segment is out of range",
-        ));
-    }
-    stable_qr_segment_norm(values.iter().copied().skip(start))
