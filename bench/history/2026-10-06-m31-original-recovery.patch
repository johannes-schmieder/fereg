-#[allow(clippy::too_many_arguments)]
-fn fit_scaled_pivoted_qr_low<P: PreparedOlsFitView + ?Sized, R: FitReservation>(
-    prepared: &P,
-    scratch: &mut PreparedOlsScratch,
-    within_outcome: &mut [f64],
