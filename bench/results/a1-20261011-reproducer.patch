+    /// Adopt only an unchanged certified frame whose exact-input permission is
+    /// still current. There is no speculative state to restore in this case;
+    /// rejection leaves the already accepted ordinary frame authoritative.
+    pub(crate) fn strict_candidate_reusing(
+        &mut self,
+        permit: StrictFrameReuse,
+    ) -> Result<StrictLinearCandidateTransaction<'_, 'a, P>> {
+        let current = permit.generations == self.generations
+            && self.output().is_ok_and(|output| output.certified());
+        let evidence = self
+            .frame
+            .as_mut()
+            .and_then(|frame| match &mut frame.proof {
+                LinearFrameProof::Canonical(proof) => proof.strict_ordinary_tolerance.take(),
+                LinearFrameProof::Frozen(_) => None,
+            });
+        if !current || evidence != Some(self.config.absorb.map.tolerance) {
+            return self.strict_candidate();
+        }
+        Ok(StrictLinearCandidateTransaction {
+            session: self,
+            rollback: None,
+            basis_unchanged: true,
+            #[cfg(test)]
+            fused_projection: false,
+        })
+    }
+
+    pub(crate) fn strict_frame_reuse(
+        &self,
+        response: &[f64],
+        weights: BorrowedMapWeights<'_>,
+        scale: super::PreparedOlsBreadWeightScale,
+        generation: u64,
+        config: PreparedOlsFitConfig,
+    ) -> Result<Option<StrictFrameReuse>> {
+        let fresh = self
+            .frame
+            .as_ref()
+            .and_then(|frame| frame.canonical_proof())
+            .and_then(|proof| proof.strict_ordinary_tolerance);
+        let reason = if !self.prepared_alignment_valid || self.projection_refresh_required {
+            "alignment"
+        } else if fresh != Some(config.absorb.map.tolerance) {
+            "fresh_strict_proof"
+        } else if config != self.config {
+            "configuration"
+        } else if self.response.len() != response.len()
+            || !self
+                .response
+                .iter()
+                .zip(response)
+                .all(|(a, b)| a.to_bits() == b.to_bits())
+        {
+            "response"
+        } else if !self.current_hessian_products_match(weights, scale, generation)? {
+            "hessian"
+        } else {
+            "eligible"
+        };
+        if crate::diagnostics::solver_trace_enabled() {
+            crate::diagnostics::emit_solver_trace(&format!(
+                "FEREG_SOLVER_TRACE|phase=strict_frame_eligibility|reason={reason}",
+            ));
+        }
+        if reason != "eligible" {
+            return Ok(None);
+        }
+        Ok(Some(StrictFrameReuse {
+            generations: self.generations,
+        }))
