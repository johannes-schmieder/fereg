+fn strict_ordinary_provenance_requires_exact_inputs_and_is_consumed_once() {
+    let outcome = vec![1.2, 4.0, 0.5, 6.1, 2.7, 8.3, 5.5, 11.8];
+    let x = vec![-2.0, 0.5, -1.0, 2.0, -0.25, 3.0, 1.0, 4.5];
+    let weights = vec![1.5, 0.75, 2.0, 1.25, 3.5, 0.6, 1.8, 2.2];
+    let prepared = prepared_two_fe(&outcome, &x);
+    let config = ppml_linear_config(PreparedPpmlIrlsConfig::default(), 1e-12).unwrap();
+    let scale = ppml_bread_weight_scale(&weights).unwrap();
+    let frame =
+        LinearSolveFrame::from_parts(&outcome, BorrowedMapWeights::Provided(&weights), scale)
+            .unwrap();
+    for invalidation in 0..7 {
+        let mut session = CertifiedLinearSession::new_with_fe_design(
+            &prepared,
+            frame,
+            config,
+            LinearSessionGenerations::new(1, 1, 1, 1, 1),
+            prepared.fit_owned_fe_design().unwrap(),
+        )
+        .unwrap();
+        assert!(session.solve_fresh().unwrap().certified());
+        // An ordinary canonical certificate alone is not a strict transaction.
+        assert!(session
+            .strict_frame_reuse(
+                &outcome,
+                BorrowedMapWeights::Provided(&weights),
+                scale,
+                1,
+                config
+            )
+            .unwrap()
+            .is_none());
+        session
+            .strict_candidate()
+            .unwrap()
+            .commit_for_strict_reuse()
+            .unwrap();
+        let beta: Vec<_> = session.output().unwrap().coefficients().collect();
+        let basis_generation = session.basis_generation_for_test();
+        let mut changed_response = outcome.clone();
+        changed_response[0] = f64::from_bits(changed_response[0].to_bits() + 1);
+        let mut changed_weights = weights.clone();
+        changed_weights[0] = f64::from_bits(changed_weights[0].to_bits() + 1);
+        let mut changed_scale = scale;
+        changed_scale.reference_weight_multiplier *= 2.0;
+        let mut changed_config = config;
+        changed_config.absorb.map.tolerance *= 0.1;
+        for (response, h, scale, generation, config) in [
+            (&changed_response[..], &weights[..], scale, 1, config),
+            (&outcome, &changed_weights, scale, 1, config),
+            (&outcome, &weights, changed_scale, 1, config),
+            (&outcome, &weights, scale, 2, config),
+            (&outcome, &weights, scale, 1, changed_config),
+        ] {
+            assert!(session
+                .strict_frame_reuse(
+                    response,
+                    BorrowedMapWeights::Provided(h),
+                    scale,
+                    generation,
+                    config
+                )
+                .unwrap()
+                .is_none());
+        }
+        let permit = session
+            .strict_frame_reuse(
+                &outcome,
+                BorrowedMapWeights::Provided(&weights),
+                scale,
+                1,
+                config,
+            )
+            .unwrap()
+            .unwrap();
+        match invalidation {
+            0 => {
+                let adopted = session.strict_candidate_reusing(permit).unwrap();
+                assert!(adopted.reused_fresh_frame());
+                assert!(adopted.basis_unchanged());
+                assert!(adopted.candidate().certified());
+                assert_eq!(adopted.candidate().coefficients().collect::<Vec<_>>(), beta);
+                adopted.rollback();
+                assert_eq!(session.basis_generation_for_test(), basis_generation);
+                assert!(session.output().unwrap().certified());
+            }
+            1 => {
+                let adopted = session.strict_candidate_reusing(permit).unwrap();
+                assert!(
+                    adopted.commit_for_strict_reuse().is_err(),
+                    "adoption cannot mint fresh evidence again"
+                );
+            }
+            2 => session.refresh_response(&outcome, 2).unwrap(),
+            3 => session
+                .refresh_weights(BorrowedMapWeights::Provided(&weights), scale, 2)
+                .unwrap(),
+            4 => session.invalidate_sample(2).unwrap(),
+            5 => session.invalidate_topology(2).unwrap(),
+            6 => session.refresh_basis(basis_generation + 1).unwrap(),
+            _ => unreachable!(),
+        }
+        assert!(session
+            .strict_frame_reuse(
+                &outcome,
+                BorrowedMapWeights::Provided(&weights),
+                scale,
+                1,
+                config
+            )
+            .unwrap()
+            .is_none());
+    }
+}
