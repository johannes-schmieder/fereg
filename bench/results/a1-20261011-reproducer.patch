+#[test]
+fn strict_ordinary_provenance_rejects_same_rank_pivot_and_restores_basis() {
+    let x = vec![-2.0, -1.0, 0.5, 1.0, 2.0, 4.0];
+    let outcome = vec![1.0, 2.0, 2.5, 4.0, 5.0, 9.0];
+    let prepared = prepared(&outcome, &[x.clone(), x]);
+    let scale = PreparedOlsBreadWeightScale {
+        weight_kind: None,
+        solver_weight_divisor: 1.0,
+        reference_weight_multiplier: 1.0,
+        reference_weight_sum: outcome.len() as f64,
+    };
+    let frame = LinearSolveFrame::from_parts(&outcome, BorrowedMapWeights::Unit, scale).unwrap();
+    let config = ppml_linear_config(PreparedPpmlIrlsConfig::default(), 1e-12).unwrap();
+    let mut session = CertifiedLinearSession::new(
+        &prepared,
+        frame,
+        config,
+        LinearSessionGenerations::new(1, 1, 1, 1, 1),
+    )
+    .unwrap();
+    let initial = session.solve_fresh().unwrap();
+    let kept = initial.basis().kept_generated_columns().to_vec();
+    let dropped = initial.basis().dropped_generated_columns().to_vec();
+    let mut candidate = session.strict_candidate().unwrap();
+    assert!(candidate.inject_same_rank_basis_pivot());
+    assert!(candidate.commit_for_strict_reuse().is_err());
+    let restored = session.output().unwrap();
+    assert!(restored.certified());
+    assert_eq!(restored.basis().kept_generated_columns(), kept);
+    assert_eq!(restored.basis().dropped_generated_columns(), dropped);
+    assert_eq!(session.basis_generation_for_test(), 1);
+}
