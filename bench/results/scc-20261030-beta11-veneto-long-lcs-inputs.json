    "preparation/stage1.do": "version 19.0\nclear all\nset more off\nadopath ++ \"/private/tmp/fevc-veneto-lcs-20261030/preparation\"\nset processors 4\nset seed 20260917\nset sortseed 20260917\ncd \"/private/tmp/fevc-veneto-lcs-20261030\"\nlog using \"logs/stage1.log\", text name(preparation)\nglobal dir_tmp \"/private/tmp/fevc-veneto-lcs-20261030/work\"\n// KSS uses distinct only for logging one identifier's counts. Supply that\n// narrow interface with built-ins, without installing an unrelated package.\nprogram define distinct, rclass\n    syntax varname\n    tempvar tag\n    quietly egen byte `tag' = tag(`varlist')\n    quietly count if `tag'==1\n    local ndist = r(N)\n    quietly count\n    return scalar N = r(N)\n    return scalar ndistinct = `ndist'\nend\ncapture noisily {\n    preserve\n    clear\n    set obs 3\n    gen id = cond(_n==3,2,1)\n    distinct id\n    assert r(N)==3 & r(ndistinct)==2\n    restore\n    // Original KSS build bytes; `gior' resolves to gior_r under Stata abbreviation.\n    do \"build.do\"\n    use \"$dir_tmp/py_final_1985_2001_veneto_only.dta\", clear\n    keep if inrange(year,1996,2001)\n    drop if missing(female,age,year)\n    isid id year\n    assert !missing(id,firmid,year,log_dailywages,age)\n    assert inrange(year,1996,2001)\n    rename id worker\n    rename firmid firm\n    rename log_dailywages y\n    keep worker firm year y age\n    sort worker year\n    format worker firm %20.0f\n    format y %24.17g\n    export delimited worker firm year y age using \"work/long_panel_preprune.csv\", replace\n    save \"work/long_panel_preprune.dta\", replace\n    count\n    display as result \"VENETO_1996_2001_STAGE1_PASS\"\n}\nlocal rc = _rc\nlog close preparation\nexit `rc'\n",
    "preparation/stage2_lcs.m": "function stage2_lcs()\n% Largest connected set of the 1996-2001 Veneto panel: the original stage-2\n% preparation up to KSS's connected_set (CHK 2013), without the leave-one-out\n% pruning or singleton removal that follow it in prepare_stage2.m.\nroot='/private/tmp/fevc-veneto-lcs-20261030';\naddpath(fullfile(root,'preparation'));\nmaxNumCompThreads(4);\ndiary(fullfile(root,'logs','stage2_lcs.log'));\ndata=readtable(fullfile(root,'work','long_panel_preprune.csv'),'VariableNamingRule','preserve');\nassert(isequal(data.Properties.VariableNames,{'worker','firm','year','y','age'}));\nassert(all(ismember(data.year,1996:2001)) && all(isfinite(data.y)));\ndata=sortrows(data,{'worker','year'});\nassert(size(unique([data.worker data.year],'rows'),1)==height(data));\nid=data.worker;firm=data.firm;y=data.y;controls=[data.year data.age (1:height(data))'];\noriginal_rows=height(data);clear data;\nlag=[NaN;firm(1:end-1)];lag([true;diff(id)~=0])=NaN;\n[y,id,firm,io,fo,controls]=connected_set(y,id,firm,lag,controls);\nconnected_rows=numel(y);\n% Independent check on the retained worker-firm graph.\npairs=unique([id firm],'rows');workers=max(id);firms=max(firm);\nB=sparse(pairs(:,1),pairs(:,2),1,workers,firms);\nG=graph([sparse(workers,workers),B;B',sparse(firms,firms)]);\nassert(max(conncomp(G))==1,'largest connected set is not connected');\n% Seventeen significant digits keep every double exact.\nfid=fopen(fullfile(root,'work','long_panel_lcs.csv'),'w');\nfprintf(fid,'worker,firm,year,y,age\\n');\nfprintf(fid,'%.17g,%.17g,%.17g,%.17g,%.17g\\n',[io fo controls(:,1) y controls(:,2)]');\nfclose(fid);\nfprintf('VENETO_LCS original_rows=%d connected_rows=%d workers=%d firms=%d\\n',...\n    original_rows,connected_rows,workers,firms);\ndiary off;\nend\n",
    "preparation/stage2_lcs.out": "WARNING: package sun.awt.X11 not in java.desktop\nWARNING: package sun.awt.X11 not in java.desktop\n[\bWarning: Name is nonexistent or not a directory:\n/Users/johannes/.cursor/extensions/mathworks.language-matlab-1.3.2/server/matlab]\b \n[\bWarning: Directory access failure: /Users/johannes/Documents/MATLAB]\b \nVENETO_LCS original_rows=6044422 connected_rows=5811476 workers=1472080 firms=130124\n",
