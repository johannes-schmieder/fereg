+"""Disposable A3 additional calibration; never builds, retries or chooses a route.
+
+Usage: python a3_additional_diagnostic.py --results SHARED_A3_BOOK MANIFEST
+Manifest requires bound {path,sha256} protocol, study_source, and three kernels.
+The kernels must come from the reviewed generic-CPU plugin-FMA harness with this
+study_source replacing only the task study_tests.rs. Logs and science bytes are
+retained beside the shared book. Build provenance belongs in the full manifest.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import struct
+import math
+import time
+
+if not __debug__:
+    raise RuntimeError('optimized Python is unsupported: scientific and budget assertions are required')
+
+ROUTES = ['explicit-direct', 'explicit-iterative', 'implicit']
+TEST = 'study_calibration::a3_calibration_kernel'
+STAGE = 'calibration-additional'
+
+
+def digest(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def bound(item):
+    path = Path(item['path']).resolve()
+    if digest(path) != item['sha256']:
+        raise ValueError('identity mismatch: ' + str(path))
+    return path
+
+
+def traces(text):
+    found = []
+    for line in text.splitlines():
+        at = line.find('FEREG_SOLVER_TRACE|')
+        if at >= 0:
+            found.append(dict(part.split('=', 1) for part in line[at:].split('|')[1:] if '=' in part))
+    return found
+
+
+def single(trace, phase):
+    rows = [row for row in trace if row.get('phase') == phase]
+    assert len(rows) == 1, 'expected one ' + phase
+    return rows[0]
+
+
+def verify_science(path, rows, width):
+    header = b'A3_STUDY_SCIENCE_V1\n'
+    lengths = [rows, rows * (width - 1), width * width, width, width, width]
+    expected_bytes = len(header) + 16 + 8 * len(lengths) + 8 * sum(lengths) + 24
+    assert path.stat().st_size == expected_bytes, 'science byte length'
+    with path.open('rb') as stream:
+        assert stream.read(len(header)) == header, 'science header'
+        assert struct.unpack('<QQ', stream.read(16)) == (rows, width), 'science shape'
+        for expected in lengths:
+            assert struct.unpack('<Q', stream.read(8))[0] == expected, 'science bank length'
+            stream.seek(expected * 8, 1)
+        assert all(math.isfinite(v) for v in struct.unpack('<ddd', stream.read(24))), 'science certificate'
+        assert stream.read(1) == b'', 'science trailing bytes'
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--results', type=Path, required=True)
+    parser.add_argument('manifest', type=Path)
+    args = parser.parse_args()
+    book_path = args.results.resolve()
+    work = book_path.parent
+    manifest = json.loads(args.manifest.read_text())
+    manifest_binding = {'path': str(args.manifest.resolve()), 'sha256': digest(args.manifest)}
+    driver_binding = {'path': str(Path(__file__).resolve()), 'sha256': digest(__file__)}
+    bindings = [manifest['protocol'], manifest['study_source']] + [manifest['kernels'][r] for r in ROUTES]
+    paths = [bound(item) for item in bindings]
+    protocol = json.loads(paths[0].read_text())
+    assert protocol['routes'] == ROUTES and protocol['workers'] == [1, 16]
+    assert protocol['repetitions'] == [0, 1]
+    assert protocol['limits']['additional_calls'] == 180
+    assert protocol['limits']['additional_seconds'] == 600
+    assert protocol['limits']['per_call_seconds'] == 30
+    assert protocol['limits']['parent_seconds'] == 2700
+    assert [c['id'] for c in protocol['cells']] == list(range(1, 16))
+    kernels = dict(zip(ROUTES, paths[2:]))
+    bindings.extend([manifest_binding, driver_binding])
+    starting_book_sha256 = digest(book_path)
+    book = json.loads(book_path.read_text())
+    assert not any(r['stage'] == STAGE for r in book['records']), 'no repeat/continuation'
+    assert not any(i['stage'] == STAGE for i in book['invocations']), 'stage already attempted'
+    assert len([r for r in book['records'] if r['stage'] == 'whole']) == 8
+    assert len([r for r in book['records'] if r['stage'] == 'kernel']) == 36
+    assert all(r['status'] in ['completed-diagnostic', 'refused'] for r in book['records'])
+    assert len(book['whole_comparisons']) == 4
+    assert all(c['status'] == 'scientific-comparison-passed' for c in book['whole_comparisons'])
+    assert book['artifact_identity_valid']
+    initial = book['elapsed_seconds']
+    assert initial <= 720, 'first subset exceeded its shared cap'
+    book['first_subset_elapsed_seconds'] = initial
+    began = time.monotonic()
+    invocation = {'stage': STAGE, 'manifest_sha256': manifest_binding['sha256'],
+                  'driver_sha256': driver_binding['sha256'], 'bindings': manifest,
+                  'starting_shared_book_sha256': starting_book_sha256,
+                  'protocol': protocol, 'initial_elapsed_seconds': initial}
+    book['invocations'].append(invocation)
+
+    def save():
+        elapsed = time.monotonic() - began
+        invocation['elapsed_seconds'] = elapsed
+        book['elapsed_seconds'] = initial + elapsed
+        temporary = book_path.with_suffix('.pending.json')
+        temporary.write_text(json.dumps(book, indent=2) + '\n')
+        temporary.replace(book_path)
+
+    jobs = [(c, w, rep, route) for c in protocol['cells'] for w in [1, 16]
+            for rep in [0, 1] for route in (ROUTES if rep == 0 else list(reversed(ROUTES)))]
+    inputs = {}
+    repetitions = {}
+    failed = False
+    try:
+        save()
+        for cell, workers, repeat, route in jobs:
+            remaining = min(600 - (time.monotonic() - began),
+                            2700 - initial - (time.monotonic() - began))
+            if remaining <= 0:
+                invocation['budget_exhausted'] = True
+                break
+            label = f'a3-add-c{cell["id"]:02d}-w{workers}-{route}-r{repeat}'
+            log = work / (label + '.log')
+            science = work / (label + '.science.bin')
+            assert not log.exists() and not science.exists(), 'preserve previous artifacts'
+            record = {'stage': STAGE, 'label': label, 'cell': cell, 'workers': workers,
+                      'repeat': repeat, 'route': route, 'status': 'running',
+                      'artifact_sha256': manifest['kernels'][route]['sha256']}
+            book['records'].append(record)
+            save()
+            env = dict(os.environ, FEREG_PHASE_TIMING='1', FEREG_SOLVER_TRACE='1',
+                       FEREG_STUDY_CELL=str(cell['id']), FEREG_STUDY_WORKERS=str(workers),
+                       FEREG_STUDY_SCIENCE_OUTPUT=str(science))
+            env.pop('LLVM_PROFILE_FILE', None)
+            env.pop('FEREG_STUDY_DEGREE', None)
+            command = [str(kernels[route]), '--exact', TEST, '--ignored', '--nocapture', '--test-threads=1']
+            called = time.monotonic()
+            try:
+                with log.open('x') as stream:
+                    outcome = subprocess.run(command, env=env, stdout=stream,
+                                             stderr=subprocess.STDOUT, timeout=min(30, remaining))
+                record['subprocess_seconds'] = time.monotonic() - called
+                record['return_code'] = outcome.returncode
+                assert outcome.returncode == 0, 'process failed'
+                trace = traces(log.read_text())
+                backend = single(trace, 'a3_calibration_backend')
+                assert backend['active_name'] == 'x86_64-fma' and backend['arch'] == 'x86_64'
+                assert backend['fma'] == backend['avx'] == '1' and backend['global_fma'] == '0'
+                feature = single(trace, 'a3_calibration_features')
+                for name in ['rows', 'left_levels', 'right_levels', 'degree', 'repeats', 'width']:
+                    assert int(feature[name]) == cell[name], name
+                assert int(feature['cell']) == cell['id'] and int(feature['workers']) == workers
+                assert int(feature['seed']) == 739391 and int(feature['allowance_bytes']) == 268435456
+                assert int(feature['unique_edges']) == cell['left_levels'] * cell['degree']
+                assert feature['input_fnv64'] == inputs.setdefault(cell['id'], feature['input_fnv64'])
+                result = single(trace, 'a3_calibration_result')
+                assert result['requested'] == route and int(result['cell']) == cell['id']
+                record.update(backend=backend, features=feature, kernel_result=result)
+                work_signature = sorted([t for t in trace if t.get('phase') == 'canonical_study_rhs'],
+                                        key=lambda t: (int(t['rhs']), int(t['start'])))
+                if result['status'] == 'refused':
+                    assert not science.exists(), 'refused call produced science bytes'
+                    record['status'] = 'refused'
+                    refusal = [t for t in trace if t.get('phase') in {
+                        'canonical_study_admission', 'canonical_study_declined',
+                        'canonical_study_fallback'}]
+                    components = sorted([t for t in trace if t.get('phase') == 'canonical_study_component'],
+                                        key=lambda t: int(t['start']))
+                    record['refusal_signature'] = {'status': 'refused', 'reasons_and_admission': refusal,
+                                                   'components': components, 'completed_rhs_work': work_signature}
+                    signature = record['refusal_signature']
+                else:
+                    geometry = single(trace, 'canonical_study_summary')
+                    assert geometry['requested'] == geometry['geometry'] == route
+                    assert result['status'] == 'certified-witness'
+                    assert float(result['max_residual_error']) < 1e-8
+                    assert float(result['max_gram_error']) < 1e-10
+                    verify_science(science, cell['rows'], cell['width'])
+                    record.update(status='completed-diagnostic', science_sha256=digest(science))
+                    signature = [record['science_sha256'], work_signature]
+                key = (cell['id'], workers, route)
+                assert signature == repetitions.setdefault(key, signature), 'fixed-worker repeat changed'
+                record['repeat_identity_passed'] = True
+            except subprocess.TimeoutExpired:
+                record['status'] = 'timeout'
+                failed = True
+            except Exception as error:
+                record.update(status='failed', error=str(error))
+                failed = True
+            finally:
+                record.setdefault('subprocess_seconds', time.monotonic() - called)
+                if log.exists():
+                    raw = log.read_text(errors='replace')
+                    record['traces'] = traces(raw)
+                    record['phase_traces'] = [line for line in raw.splitlines() if line.startswith('FEREG_PHASE|')]
+                    record['log_sha256'] = digest(log)
+                if science.exists():
+                    record['science_sha256'] = digest(science)
+                record['process_and_validation_seconds'] = time.monotonic() - called
+                save()
+                print(json.dumps({'label': label, 'status': record['status'],
+                                  'seconds': record['subprocess_seconds'],
+                                  'additional_elapsed_seconds': invocation['elapsed_seconds'],
+                                  'aggregate_elapsed_seconds': book['elapsed_seconds']}), flush=True)
+            if failed:
+                invocation['stopped_on_failure'] = True
+                break
+    finally:
+        checks = []
+        for item in bindings:
+            try:
+                bound(item)
+                checks.append({'sha256': item['sha256'], 'unchanged': True})
+            except Exception as error:
+                checks.append({'sha256': item['sha256'], 'unchanged': False, 'error': str(error)})
+        invocation['end_identity_checks'] = checks
+        invocation['artifact_identity_valid'] = all(c['unchanged'] for c in checks)
+        invocation['attempted_calls'] = sum(r['stage'] == STAGE for r in book['records'])
+        invocation['unattempted_calls'] = len(jobs) - invocation['attempted_calls']
+        elapsed = time.monotonic() - began
+        if elapsed >= 600 or initial + elapsed >= 2700:
+            invocation['budget_exhausted'] = True
+        incomplete = invocation['unattempted_calls'] > 0 or invocation.get('budget_exhausted', False)
+        invocation['terminal_status'] = ('incomplete' if incomplete else
+                                         'failed' if failed or not invocation['artifact_identity_valid'] else
+                                         'completed-diagnostic')
+        save()
+        print(json.dumps({'stage': STAGE, 'terminal_status': invocation['terminal_status'],
+                          'attempted_calls': invocation['attempted_calls'],
+                          'unattempted_calls': invocation['unattempted_calls'],
+                          'budget_exhausted': invocation.get('budget_exhausted', False)}), flush=True)
+    if invocation['terminal_status'] != 'completed-diagnostic':
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
