+                    assert backend[0]['arch'] == 'x86_64'
+                    assert backend[0]['fma'] == backend[0]['avx'] == '1'
+                    assert backend[0]['global_fma'] == '0'
+                    record['backend'] = backend[0]
+                    result = [t for t in trace if t.get('phase') == 'a3_calibration_result']
+                    assert len(result) == 1, 'missing unique kernel sentinel'
