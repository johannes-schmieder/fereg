+        let (first, _) = additional_neighbor(a, 0, p, q, k, shape);
+        for e in 0..k {
+            let (b, bridge) = additional_neighbor(a, e, p, q, k, shape);
+            let first_root = root(&mut parent, first);
+            let next_root = root(&mut parent, b);
+            parent[next_root.max(first_root)] = next_root.min(first_root);
+            let weight = if bridge {
+                if shape == 2 {
+                    2_f64.powi(-20)
+                } else {
+                    1.
+                }
+            } else {
+                (2 + (a + 3 * e) % 7) as f64 / 8.
+            };
