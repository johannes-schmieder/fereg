+            BorrowedMapWeights::Provided(&weights), 1.,
+            MapConfig { tolerance: 1e-12, ..MapConfig::default() },
+            256*1024*1024, 0, &mut Vec::new()).unwrap();
+        let Some(mut product) = result else {
+            eprintln!("FEREG_SOLVER_TRACE|phase=a3_calibration_result|cell={cell}|status=refused|requested={}|rows={n}|degree={k}|width={width}|workers={workers}|seconds={:.9}", study_route(), started.elapsed().as_secs_f64());
+            return;
+        };
+        assert!(product.report.certified());
