+use super::*;
+use crate::metadata::*;
+use crate::ols::{
+    prepare_model, LoadedNumericColumn, LoadedOlsInput, OlsInputBinding, OlsInputRole,
+    OlsRequestV1, PreparedOlsData,
+};
+
+fn prepared(y: &[f64], x: &[Vec<f64>], g: &[f64], h: &[f64]) -> PreparedOlsData {
+    prepared_effects(y, x, &[g, h])
+}
+
+fn prepared_effects(y: &[f64], x: &[Vec<f64>], effects: &[&[f64]]) -> PreparedOlsData {
+    let mut sources = Vec::new();
+    let mut terms = Vec::new();
+    let mut numeric = Vec::new();
+    let mut bindings = vec![
+        OlsInputBinding {
+            stata_var_position: 1,
+            role: OlsInputRole::Candidate,
+        },
+        OlsInputBinding {
+            stata_var_position: 2,
+            role: OlsInputRole::Outcome,
+        },
+    ];
+    for (j, values) in x
+        .iter()
+        .map(Vec::as_slice)
+        .chain(effects.iter().copied())
+        .enumerate()
+    {
+        let id = (j + 1) as u32;
+        let source = SourceId::new(id).unwrap();
+        sources.push(SourceEntry {
+            id: source,
+            canonical_name: format!("v{id}"),
+        });
+        bindings.push(OlsInputBinding {
+            stata_var_position: id + 2,
+            role: OlsInputRole::NumericSource(source),
+        });
+        numeric.push((
+            source,
+            LoadedNumericColumn {
+                values: values.to_vec(),
+                missing: vec![false; y.len()],
+            },
+        ));
+        if j < x.len() {
+            terms.push(ExpandedTerm {
+                id: TermId::new(id).unwrap(),
+                order: TermOrder::new(id).unwrap(),
+                coefficient_slot: CoefficientSlot::new(id).unwrap(),
+                raw_kind: RawTermKind::Variable,
+                whole_column_omitted: false,
+                canonical_token: format!("c.v{id}"),
+                components: vec![TermComponent {
+                    order: ComponentOrder::new(1).unwrap(),
+                    source,
+                    kind: ComponentKind::Continuous,
+                    level_state: LevelState::Absent,
+                    level_value: 0.,
+                    base: MetadataFlag::False,
+                    omitted: MetadataFlag::Unavailable,
+                    raw_operator: "c".into(),
+                    time_series_state: TimeSeriesState::None,
+                    raw_time_series_operator: String::new(),
+                }],
+            });
+        }
+    }
+    prepare_model(
+        &OlsRequestV1 {
+            model: CompiledTermGraph { sources, terms },
+            absorbed_terms: (0..effects.len() as u32)
+                .map(|j| AbsorbedTerm {
+                    id: AbsorbTermId::new(j + 1).unwrap(),
+                    intercept: true,
+                    categorical_sources: vec![SourceId::new(x.len() as u32 + j + 1).unwrap()],
+                    slope_sources: Vec::new(),
+                    label: format!("fe{j}"),
+                    saved_name: String::new(),
+                })
+                .collect(),
+            bindings,
+            include_intercept: true,
+            keep_singletons: true,
+        },
+        &[],
+        &LoadedOlsInput {
+            candidate: vec![true; y.len()],
+            outcome: LoadedNumericColumn {
+                values: y.to_vec(),
+                missing: vec![false; y.len()],
+            },
+            numeric_sources: numeric,
+            analytic_weight: None,
+            frequency_weight: None,
+            probability_weight: None,
+        },
+        false,
+    )
+    .unwrap()
+}
+
+// TASK-ONLY kernel calibration. Invoke one ignored test per bounded process.
+pub(super) fn a3_calibration_kernel() {
+    // Reject a mismatched caller or globally enabled FMA before any measurement.
+    assert_eq!(crate::kernels::active_name(), "x86_64-fma");
+    assert!(!cfg!(target_feature = "fma"));
+    let degree: usize = std::env::var("FEREG_STUDY_DEGREE")
+        .unwrap()
+        .parse()
+        .unwrap();
+    let workers: usize = std::env::var("FEREG_STUDY_WORKERS")
+        .unwrap()
+        .parse()
+        .unwrap();
+    assert!([4, 16, 64].contains(&degree));
+    assert!([1, 16].contains(&workers));
+    assert!(["explicit-direct", "explicit-iterative", "implicit"].contains(&study_route()));
+    let n = 16_384;
+    let width = 17;
+    let p = n / (2 * degree);
+    let q = 128;
+    let mut g = Vec::with_capacity(n);
+    let mut h = Vec::with_capacity(n);
+    let mut weights = Vec::with_capacity(n);
+    let mut values = vec![Vec::with_capacity(n); width];
+    let mut truth = vec![Vec::with_capacity(n); width];
+    // Every unique pair has two equal-weight observations and opposite residuals.
+    // Their exact dyadic residuals have zero FE scores independently of any solve.
+    for a in 0..p {
+        for e in 0..degree {
+            let b = (a + 17 * e) % q;
+            for repeat in 0..2 {
+                g.push(a as f64);
+                h.push(b as f64);
+                weights.push((2 + (a + 3 * e) % 7) as f64 / 8.0);
+                for j in 0..width {
+                    let mut bits = (a * degree + e + 1) as u64;
+                    bits = bits
+                        .wrapping_mul(0x9e3779b97f4a7c15)
+                        .wrapping_add(j as u64 * 7919);
+                    bits ^= bits >> 29;
+                    bits = bits.wrapping_mul(0xbf58476d1ce4e5b9);
+                    bits ^= bits >> 31;
+                    let residual =
+                        (2 * repeat as i32 - 1) as f64 * ((bits % 127) as f64 - 63.0) / 128.0;
+                    truth[j].push(residual);
+                    values[j].push(
+                        residual + ((a * (j + 1)) % 97) as f64 / 64.0
+                            - ((b * (j + 3)) % 53) as f64 / 32.0,
+                    );
+                }
+            }
+        }
+    }
+    let prepared = prepared(&values[0], &values[1..], &g, &h);
+    let generated: Vec<_> = (0..width - 1).collect();
+    let team = rayon::ThreadPoolBuilder::new()
+        .num_threads(workers)
+        .build()
+        .unwrap();
+    team.install(|| {
+        let started = Instant::now();
+        let result = try_build(&prepared, &generated, &values[0],
+            BorrowedMapWeights::Provided(&weights), 1.0,
+            MapConfig { tolerance: 1e-12, ..MapConfig::default() },
+            64 * 1024 * 1024, 0, &mut Vec::new()).unwrap();
+        let Some(mut product) = result else {
+            eprintln!("FEREG_SOLVER_TRACE|phase=a3_calibration_result|status=refused|requested={}|rows={n}|degree={degree}|width={width}|workers={workers}|seconds={:.9}", study_route(), started.elapsed().as_secs_f64());
+            return;
+        };
+        assert!(product.report.certified());
+        let mut dense = DenseMatrix::zeros(n, width - 1).unwrap();
+        product.write_dense(&mut dense).unwrap();
+        let kernel_seconds = started.elapsed().as_secs_f64();
+        let witness_started = Instant::now();
+        let mut max_residual_error = 0_f64;
+        let mut max_gram_error = 0_f64;
+        for i in 0..n {
+            max_residual_error = max_residual_error.max((product.response[i] - truth[0][i]).abs());
+            for j in 1..width {
+                max_residual_error = max_residual_error.max((dense[(i, j - 1)] - truth[j][i]).abs());
+            }
+        }
+        assert!(max_residual_error < 1e-8);
+        for j in 0..width {
+            for k in 0..width {
+                let expected: f64 = (0..n).map(|i| weights[i]
+                    * (truth[j][i] / nonzero(product.scales[j]))
+                    * (truth[k][i] / nonzero(product.scales[k]))).sum();
+                max_gram_error = max_gram_error.max((product.moments.gram[j * width + k] - expected).abs());
+            }
+        }
+        assert!(max_gram_error < 1e-10);
+        eprintln!("FEREG_SOLVER_TRACE|phase=a3_calibration_result|status=certified-witness|requested={}|rows={n}|degree={degree}|unique_edges={}|unique_pairs={}|width={width}|workers={workers}|left_levels={p}|right_levels={q}|allowance_bytes=67108864|tolerance=1e-12|seconds={kernel_seconds:.9}|witness_seconds={:.9}|max_residual_error={max_residual_error:e}|max_gram_error={max_gram_error:e}", study_route(), p * degree, p * degree * (degree - 1) / 2, witness_started.elapsed().as_secs_f64());
+    });
+}
