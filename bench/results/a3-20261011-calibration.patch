+    let prepared = prepared(&values[0], &values[1..], &g, &h);
+    let generated: Vec<_> = (0..width - 1).collect();
+    let team = rayon::ThreadPoolBuilder::new()
+        .num_threads(workers)
+        .build()
+        .unwrap();
+    team.install(|| {
