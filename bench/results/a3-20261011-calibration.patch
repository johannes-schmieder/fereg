+                    bits ^= bits >> 31;
+                    let residual =
+                        (2 * (repeat % 2) as i32 - 1) as f64 * ((bits % 127) as f64 - 63.) / 128.;
+                    truth[j].push(residual);
+                    values[j].push(
+                        residual + ((a * (j + 1)) % 97) as f64 / 64.
