+"""Task-only A3 first subset: 8 whole fits first, then 36 kernel calls.
+
+Manifest: {"harness":{"path":...,"sha256":...},
+ "plugins":{"auto":{...},"implicit":{...}},
+ "cases":[{"path":...,"sha256":...,"rows":1000000,"workers":1}, ...],
+ "kernels":{"explicit-direct":{...},"explicit-iterative":{...},"implicit":{...}}}
+Exactly four frozen cases cover rows 1M/4M and workers 1/16. Kernels may be
+added later. Every used artifact must have its expected hash in this manifest.
+Invocation: python a3_diagnostic.py --source CHECKOUT MANIFEST --stage whole|kernel
+No automatic retry, model fit, route recommendation or timing claim.
+"""
+import argparse
+import hashlib
+import json
+import math
+import mmap
+import os
+import re
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import time
+
+WORK = Path(__file__).resolve().parent
+bootstrap = argparse.ArgumentParser(add_help=False)
+bootstrap.add_argument('--source', type=Path)
+bootstrap_args, _ = bootstrap.parse_known_args()
+ROOT = bootstrap_args.source.resolve() if bootstrap_args.source else WORK.parents[2]
+sys.path[:0] = [str(ROOT / 'bench'), str(ROOT / 'scripts')]
+from native_io import case_header, digest
+from replay_plugins import (differences, discrete_view, exact_view, matrix,
+                            numerical_scope_indices, work_scope_indices)
+
+ROUTES = ['explicit-direct', 'explicit-iterative', 'implicit']
+TEST = 'study_calibration::a3_calibration_kernel'
+RESULTS = WORK / 'a3-study-results.json'
+LIMIT = 720.0
+
+
+def bound(item):
+    path = Path(item['path']).resolve()
+    actual = digest(path)
+    if actual != item['sha256']:
+        raise ValueError(f'identity mismatch: {path.name}')
+    return path
+
+
+def traces(text):
+    parsed = []
+    for line in text.splitlines():
+        at = line.find('FEREG_SOLVER_TRACE|')
+        if at >= 0:
+            parsed.append(dict(part.split('=', 1) for part in line[at:].split('|')[1:] if '=' in part))
+    return parsed
+
+
+def proxy(data):
+    return {**data, 'columns': [['3ff0000000000000'], ['0000000000000000']]}
+
+
+def protected(data):
+    return discrete_view(proxy(data), {'poisson': True, 'outputs': {'sample': 0, 'drop_reason': 1}})
+
+
+def unaffected(data):
+    result = exact_view(proxy(data), True)
+    for table, indices in numerical_scope_indices(True).items():
+        for i in indices:
+            result['matrices'][table]['bits'][i] = 'declared-numerical'
+    for table, indices in work_scope_indices(True).items():
+        if table == 'runtime_signature':
+            for i in indices:
+                result[table][i] = 'declared-work'
+        else:
+            for i in indices:
+                result['matrices'][table]['bits'][i] = 'declared-work'
+    for name in ['RB', 'RV']:
+        result['matrices'][name]['bits'] = ['declared-numerical'] * len(result['matrices'][name]['bits'])
+    return result
+
+
+def close(a, b, rtol, atol):
+    return len(a) == len(b) and all(math.isfinite(x) and math.isfinite(y) and abs(x-y) <= atol + rtol * max(abs(x), abs(y)) for x, y in zip(a, b))
+
+
+def whole_result(output, shape, raw, trace):
+    data = json.loads(output.read_text())
+    assert data['return_code'] == 0 and not data['error']
+    assert matrix(data, 'RCERT')[-1] == matrix(data, 'RREC')[-1] == 1.0
+    assert len(matrix(data, 'RCERT')) == 16
+    assert all(math.isfinite(v) and v >= 0 for v in matrix(data, 'RCERT')[:-1])
+    assert (data['matrices']['RRUNTIME']['rows'], data['matrices']['RRUNTIME']['columns']) == (108, 1)
+    runtime = matrix(data, 'RRUNTIME')
+    assert runtime[76:78] == [1.0, 1.0]
+    arguments = dict(value.decode().split('=', 1) for value in raw[1:])
+    obs = {}
+    column_file = Path(str(output) + '.columns')
+    assert column_file.stat().st_size == shape[0] * shape[1] * 8
+    with column_file.open('rb') as stream, mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ) as bank:
+        for name in ['sample', 'drop_reason']:
+            position = int(arguments.get('output_' + name, '0'))
+            if position:
+                start = (position - 1) * shape[0] * 8
+                hasher = hashlib.sha256()
+                for offset in range(start, start + shape[0] * 8, 1 << 20):
+                    hasher.update(bank[offset:min(offset + (1 << 20), start + shape[0] * 8)])
+                obs[name] = hasher.hexdigest()
+    assert 'sample' in obs
+    return {'wire_matrices': data['matrices'], 'protected': protected(data),
+            'unaffected': unaffected(data), 'observation_hashes': obs,
+            'outer_iterations': runtime[1], 'inner_iterations': runtime[2],
+            'total_seconds': runtime[0], 'geometry_summaries': [t for t in trace if t.get('phase') == 'canonical_study_summary']}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, help='source checkout containing bench/ and scripts/')
+    parser.add_argument('manifest', type=Path)
+    parser.add_argument('--stage', choices=['whole', 'kernel'], required=True)
+    args = parser.parse_args()
+    manifest = json.loads(args.manifest.read_text())
+    summary = json.loads(RESULTS.read_text()) if RESULTS.exists() else {
+        'schema': 1, 'purpose': 'A3 bounded diagnostic; no qualification claim',
+        'first_subset_limits': {'kernel_calls': 36, 'whole_fit_calls': 8, 'combined_seconds': LIMIT},
+        'parent_limits': {'calibration': 216, 'holdout': 144, 'million': 48, 'seconds': 2700},
+        'elapsed_seconds': 0.0, 'records': [], 'invocations': []}
+    if any(r['stage'] == args.stage for r in summary['records']):
+        raise RuntimeError('stage already attempted: no automatic continuation/retry')
+    initial = summary['elapsed_seconds']
+    began = time.monotonic()
+    summary['invocations'].append({'stage': args.stage, 'manifest_sha256': digest(args.manifest), 'driver_sha256': digest(Path(__file__)), 'bindings': manifest, 'source': str(ROOT)})
+    def save():
+        summary['elapsed_seconds'] = initial + time.monotonic() - began
+        RESULTS.write_text(json.dumps(summary, indent=2) + '\n')
+    jobs = []
+    used_bindings = []
+    if args.stage == 'whole':
+        harness = bound(manifest['harness'])
+        used_bindings.append(manifest['harness'])
+        used_bindings.extend(manifest['plugins'][route] for route in ['auto', 'implicit'])
+        used_bindings.extend(manifest['cases'])
+        plugins = {name: bound(manifest['plugins'][name]) for name in ['auto', 'implicit']}
