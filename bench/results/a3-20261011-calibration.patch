+// TASK-ONLY extension. Cells, seed and order are frozen in the protocol JSON.
+const ADDITIONAL_CELLS: [(usize, usize, usize, usize, usize, usize, u8); 15] = [
+    (16384, 2048, 32, 4, 2, 17, 0),
+    (16384, 2048, 256, 4, 2, 17, 0),
+    (16384, 2048, 2048, 4, 2, 17, 0),
+    (131072, 2048, 128, 4, 16, 17, 0),
+    (131072, 2048, 256, 4, 16, 17, 0),
+    (131072, 2048, 2048, 4, 16, 17, 0),
+    (131072, 16384, 128, 4, 2, 17, 0),
+    (131072, 4096, 128, 16, 2, 17, 0),
+    (131072, 1024, 128, 64, 2, 17, 0),
+    (131072, 1024, 1024, 64, 2, 17, 0),
+    (131072, 16384, 128, 4, 2, 4, 0),
+    (131072, 256, 256, 256, 2, 17, 0),
+    (131072, 1024, 128, 64, 2, 17, 1),
+    (131072, 1024, 1024, 64, 2, 17, 2),
+    (131072, 1024, 1024, 64, 2, 17, 3),
+];
+
+fn additional_neighbor(
+    g: usize,
+    e: usize,
+    p: usize,
+    q: usize,
+    k: usize,
+    shape: u8,
+) -> (usize, bool) {
+    if shape == 0 {
+        return ((g + 17 * e) % q, false);
+    }
+    let block = g / (p / 2);
+    let local = g % (p / 2);
+    let bridge = shape >= 2 && local == 0 && e == k - 1;
+    if bridge {
+        ((1 - block) * (q / 2), true)
+    } else {
+        (block * (q / 2) + (local + 17 * e) % (q / 2), false)
+    }
+}
