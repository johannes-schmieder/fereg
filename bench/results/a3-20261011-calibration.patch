+// Disposable study-copy instrumentation only. This function is not a proposed
+// runtime surface: both build-time and per-call opt-ins are mandatory, and the
+// caller supplies the sole file path. It observes the accepted Fast score bank
+// after its existing certificate and never changes numerical state or errors.
+fn capture_f1_study_scores(
+    storage: &PreparedOlsScoreStorage<'_>,
+    means: &[f64],
+    generated_columns: &[usize],
+    finite_positions: &[usize],
+    intercept_position: Option<usize>,
+    fit: &CertifiedPreparedOlsFit,
+) {
+    if option_env!("FEREG_F1_STUDY_BUILD") != Some("1")
+        || fit.execution().mode != PreparedOlsExecutionMode::Fast
+    {
+        return;
+    }
+    let Some(path) = std::env::var_os("FEREG_F1_STUDY_CAPTURE") else {
+        return;
+    };
+    let path = std::path::Path::new(&path);
+    if !path.is_absolute() {
+        eprintln!("FEREG_F1_STUDY_CAPTURE|status=nonabsolute_path");
+        return;
+    }
+    let saved = (|| -> std::io::Result<()> {
+        use std::io::Write;
+        let (rows, storage_kind) = match storage {
+            PreparedOlsScoreStorage::Dense(within) => (within.nrows(), 1_u64),
+            PreparedOlsScoreStorage::Selected(selected) => (selected.within.nrows(), 2_u64),
+            PreparedOlsScoreStorage::Scratch(_) => return Ok(()),
+        };
+        // create_new avoids replacement of a prior capture. The 8 KiB I/O
+        // buffer is bounded; no observation-sized bank is allocated or copied.
+        let file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(path)?;
+        let mut output = std::io::BufWriter::with_capacity(8192, file);
+        output.write_all(b"FEREG_F1_SCORE_CAPTURE_V1\n")?;
+        let rank = generated_columns.len();
+        let dimension = fit.bread().dimension();
+        for value in [
+            rows as u64,
+            rank as u64,
+            dimension as u64,
+            intercept_position.map_or(u64::MAX, |value| value as u64),
+            storage_kind,
+        ] {
+            output.write_all(&value.to_le_bytes())?;
+        }
+        let scale = fit.bread().weight_scale();
+        for value in [
+            scale.solver_weight_divisor,
+            scale.reference_weight_multiplier,
+            scale.reference_weight_sum,
+        ] {
+            output.write_all(&value.to_bits().to_le_bytes())?;
+        }
+        // Generated indices and finite positions are zero-based. Coefficient
+        // slots retain their original one-based identity; kind 0=finite, 1=FE
+        // normalized constant. Arrays follow the dimensional header directly.
+        for values in [generated_columns, finite_positions] {
+            for &value in values {
+                output.write_all(&(value as u64).to_le_bytes())?;
+            }
+        }
+        for coordinate in fit.bread().coordinates() {
+            for value in [
+                u64::from(coordinate.coefficient_slot.get()),
+                coordinate.generated_column_index as u64,
+                u64::from(matches!(
+                    coordinate.kind,
+                    PreparedOlsBreadCoordinateKind::NormalizedAbsorbedIntercept
+                )),
+            ] {
+                output.write_all(&value.to_le_bytes())?;
+            }
+        }
+        for values in [means, fit.bread().values()] {
+            for &value in values {
+                output.write_all(&value.to_bits().to_le_bytes())?;
+            }
+        }
+        // Emit exactly the finite rows read by score covariance, in row-major
+        // order. The values are the accepted within-X coordinates, with no
+        // additional normalization or recomputation during capture.
+        match storage {
+            PreparedOlsScoreStorage::Dense(within) => {
+                for &value in within.as_slice() {
+                    output.write_all(&value.to_bits().to_le_bytes())?;
+                }
+            }
+            PreparedOlsScoreStorage::Selected(selected) => {
+                for row in 0..rows {
+                    for &generated in generated_columns {
+                        let value = selected.within[(row, generated + 1)];
+                        output.write_all(&value.to_bits().to_le_bytes())?;
+                    }
+                }
+            }
+            PreparedOlsScoreStorage::Scratch(_) => unreachable!(),
+        }
+        output.write_all(b"FEREG_F1_SCORE_CAPTURE_COMPLETE\n")?;
+        output.flush()
+    })();
+    match saved {
+        Ok(()) => eprintln!("FEREG_F1_STUDY_CAPTURE|status=complete"),
+        Err(_) => eprintln!("FEREG_F1_STUDY_CAPTURE|status=io_error"),
+    }
