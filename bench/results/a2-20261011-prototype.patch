+    let mut result = try_build_once(
+        prepared,
+        generated,
+        response,
+        weights,
+        divisor,
+        config,
+        allowance,
+        prior_operator_work,
+        obsolete_projection,
+        warm.as_mut(),
+    );
+    if result.as_ref().err().is_some_and(|error| {
+        warm.as_mut()
+            .is_some_and(|call| call.retry_after_certificate(error))
+    }) {
+        // The failed builder and all of its weighted banks have dropped. The
+        // fresh cold build retains only the consumed-work ledger and identity.
+        result = try_build_once(
+            prepared,
+            generated,
+            response,
+            weights,
+            divisor,
+            config,
+            allowance,
+            prior_operator_work,
+            obsolete_projection,
+            warm.as_mut(),
+        );
+    }
+    if let Some(call) = warm.as_ref() {
+        call.trace(result.as_ref().is_ok_and(|products| products.is_some()));
+    }
+    match result {
+        Err(error) if error.code == ErrorCode::NonConvergence => Ok(None),
+        other => other,
+    }
