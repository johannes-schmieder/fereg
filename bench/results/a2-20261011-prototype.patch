+            error.code,
+            match entry {
+                0..=2 => ErrorCode::Interrupted,
+                3 => ErrorCode::Allocation,
+                _ => ErrorCode::InvalidArgument,
+            }
+        );
+        assert!(
+            session.canonical_guess.is_none(),
+            "entry {entry} retained a bank after failure"
+        );
+        assert_eq!(FROZEN_FAILURE_INJECTION.get(), 0);
+    }
+}
