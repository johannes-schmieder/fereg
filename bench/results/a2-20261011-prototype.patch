+#!/usr/bin/env python3
+"""Decode the exact historical failed source patch; never apply or execute it."""
+import argparse
+import base64
+import hashlib
+import json
+from pathlib import Path
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('output', type=Path)
+args = parser.parse_args()
+record = json.loads(Path(__file__).with_name('failed-near-roundoff-variant.json').read_text())
+raw = base64.b64decode(record['payload'], validate=True)
+if record['encoding'] != 'base64' or len(raw) != record['bytes'] or hashlib.sha256(raw).hexdigest() != record['sha256']:
+    raise ValueError('failed-variant byte identity mismatch')
+with args.output.open('xb') as stream:
+    stream.write(raw)
+print(record['sha256'])
