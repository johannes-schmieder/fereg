+#[test]
+fn a2_session_without_admission_is_exact_and_checkpoint_disables_bank() {
+    let (prepared, y, _, _) = a2_contrast_fixture();
+    let scale = super::super::PreparedOlsBreadWeightScale {
+        weight_kind: None,
+        solver_weight_divisor: 1.,
+        reference_weight_multiplier: 1.,
+        reference_weight_sum: y.len() as f64,
+    };
+    let frame = LinearSolveFrame::from_parts(&y, BorrowedMapWeights::Unit, scale).unwrap();
+    let mut cold = CertifiedLinearSession::new(
+        &prepared,
+        frame,
+        config(),
+        LinearSessionGenerations::new(1, 1, 1, 1, 1),
+    )
+    .unwrap();
+    cold.enable_fast_canonical_products(1_000_000).unwrap();
+    cold.solve_fresh().unwrap();
+    assert!(cold.canonical_guess.is_none());
+    let expected = cold.output().unwrap().frame().coefficients.clone();
+    let mut retained = CertifiedLinearSession::new(
+        &prepared,
+        frame,
+        config(),
+        LinearSessionGenerations::new(1, 1, 1, 1, 1),
+    )
+    .unwrap();
+    retained.enable_fast_canonical_products(1_000_000).unwrap();
+    retained.enable_canonical_guess(GuessLayout::new(32, 3).unwrap());
+    retained.solve_fresh().unwrap();
+    assert_eq!(
+        retained
+            .output()
+            .unwrap()
+            .frame()
+            .coefficients
+            .iter()
+            .map(|x| x.to_bits())
+            .collect::<Vec<_>>(),
+        expected.iter().map(|x| x.to_bits()).collect::<Vec<_>>()
+    );
+    assert!(retained.canonical_guess.is_some());
+    retained.enable_checkpoint_lsmr(true);
+    assert!(retained.canonical_guess.is_none());
+    assert!(retained.canonical_guess_layout.is_none());
+}
