+#!/bin/bash -l
+#$ -P welfgr
+#$ -N fereg_a2_corrected
+#$ -pe omp 16
+#$ -l mem_per_core=1G
+#$ -l h_rt=00:35:00
+#$ -j y
+set -euo pipefail
+umask 077
+RUN_ROOT=${FEREG_STUDY_ROOT:?set an isolated reproduction root}
+module purge
+module load gcc/12.2.0 python3/3.12.4
+export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
+export PYTHONDONTWRITEBYTECODE=1
+unset FEREG_F1_STUDY_CAPTURE LLVM_PROFILE_FILE FEREG_SOLVER_TRACE_FILE
+: "${FEREG_A2_DRIVER_SHA256:?frozen reviewed discovery driver required}"
+printf 'job=%s host=%s slots=%s\n' "$JOB_ID" "$HOSTNAME" "$NSLOTS"
+python3 - "$RUN_ROOT" <<'PY'
+import hashlib,json,os,pathlib,re,subprocess,sys
+if not __debug__:
+    raise RuntimeError('optimized Python would disable prerequisite checks')
+r=pathlib.Path(sys.argv[1]); h=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
+build_file=r/'a2-build.json'; build=json.loads(build_file.read_text())
+assert h(build_file)=='facff00b7d7d4a55a615688d572a6fe23dc53052b4a8568511cef45569a14f36'
+assert build['status']=='built-not-measured' and build['job_id']=='8028183'
+assert build['flags']=={'RUSTFLAGS':'-C target-cpu=x86-64','CARGO_ENCODED_RUSTFLAGS':None,
+ 'target':'x86_64-unknown-linux-gnu','profile':'release','default_features':True,'extra_features':[]}
+assert 'target_feature="fma"' not in build['effective_cfg']
+assert 'A2_BUILD_COMPLETE' in (r/'logs/a2-build.log').read_text().splitlines()
+accounting=subprocess.check_output(['qacct','-j','8028183'],text=True,timeout=30)
+assert len(re.findall(r'^jobnumber\s+',accounting,re.M))==1
+assert re.search(r'^failed\s+0\s*$',accounting,re.M)
+assert re.search(r'^exit_status\s+0\s*$',accounting,re.M)
+assert int(os.environ['NSLOTS'])==16
+assert h(r/'input/a2-build-staging.json')==build['staging_sha256']=='38c839ea24ddf7538f8f13d9217b377860fc381768dddcd0aa0f75f26e86d628'
+assert h(r/'input/a2-prototype.patch')==build['patch_sha256']=='c1623b6a250ef5f321077efd0a383da11764d21dd900d31a7c694a635c855ad5'
+assert h(r/'input/a2-prototype-manifest.json')==build['prototype_manifest_sha256']=='f3f55785460a49b1ef547adf681de931672bac324a431a24a22dd08fe6ab8dd5'
