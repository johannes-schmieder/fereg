+
+// Repeated opposite dyadic contrasts have exactly zero conditional means in
+// both partitions. This gives an independent within-row witness without using
+// either canonical builder as the reference.
+pub(in crate::ols) fn a2_contrast_fixture() -> (PreparedOlsData, Vec<f64>, Vec<f64>, Vec<f64>) {
+    let q = 32;
+    let mut g = Vec::new();
+    let mut h = Vec::new();
+    let mut y = Vec::new();
+    let mut x = Vec::new();
+    let mut x2 = Vec::new();
+    let mut residual = Vec::new();
+    let mut control = Vec::new();
+    for a in 0..2 * q {
+        for edge in 0..2 {
+            let b = (a + edge) % q;
+            for repeat in 0..4 {
+                let r = if repeat % 2 == 0 { 0.25 } else { -0.25 };
+                let c = if repeat < 2 { r } else { -r };
+                g.push(a as f64);
+                h.push(b as f64);
+                y.push(a as f64 * 0.125 + b as f64 * 0.25 + r);
+                x.push(a as f64 * 0.25 - b as f64 * 0.5 + c);
+                x2.push(a as f64 * 0.125 + if repeat < 2 { 0.5 } else { -0.5 });
+                residual.push(r);
+                control.push(c);
+            }
+        }
+    }
+    (prepared(&y, &[x, x2], &g, &h), y, residual, control)
+}
+
+#[test]
+fn a2_builder_moves_a_certified_bank_and_projects_fresh_weighted_inputs() {
+    let (prepared, y, residual, control) = a2_contrast_fixture();
+    let config = MapConfig {
+        tolerance: 1e-10,
+        ..Default::default()
+    };
+    let mut call = WarmCall::new(GuessLayout::new(32, 3).unwrap(), None, &[0, 1], 1, 1);
+    let mut first = try_build_with_guess(
+        &prepared,
+        &[0, 1],
+        &y,
+        BorrowedMapWeights::Unit,
+        1.,
+        config,
+        1_000_000,
+        0,
+        &mut Vec::new(),
+        &mut call,
+    )
+    .unwrap()
+    .unwrap();
+    let baseline = try_build(
+        &prepared,
+        &[0, 1],
+        &y,
+        BorrowedMapWeights::Unit,
+        1.,
+        config,
+        1_000_000,
+        0,
+        &mut Vec::new(),
+    )
+    .unwrap()
+    .unwrap();
+    for (actual, expected) in [
+        (&first.right, &baseline.right),
+        (&first.left, &baseline.left),
+        (&first.scales, &baseline.scales),
+        (&first.means, &baseline.means),
+        (&first.norms, &baseline.norms),
+        (&first.response, &baseline.response),
+        (&first.moments.gram, &baseline.moments.gram),
+    ] {
+        assert_eq!(
+            actual.iter().map(|x| x.to_bits()).collect::<Vec<_>>(),
+            expected.iter().map(|x| x.to_bits()).collect::<Vec<_>>()
+        );
+    }
+    assert_eq!(first.report.certificate, baseline.report.certificate);
+    assert_eq!(first.report.iterations, baseline.report.iterations);
+    let right_pointer = first.right.as_ptr();
+    let seed = call
+        .take()
+        .unwrap()
+        .finish(&mut first)
+        .expect("iterative producer");
+    assert!(first.right.is_empty());
+    assert!(first.scales.is_empty());
+    // This assertion observes a move, not a clone or successful silent discard.
+    assert_eq!(seed.right.as_ptr(), right_pointer);
+    let weights = vec![2.; y.len()];
+    let cold_refresh = try_build(
+        &prepared,
+        &[0, 1],
+        &y,
+        BorrowedMapWeights::Provided(&weights),
+        1.,
+        config,
+        1_000_000,
+        0,
+        &mut Vec::new(),
+    )
+    .unwrap()
+    .expect("unchanged cold refresh must certify the contrast fixture");
+    assert!(cold_refresh.report.certified());
+    let mut second_call =
+        WarmCall::new(GuessLayout::new(32, 3).unwrap(), Some(seed), &[0, 1], 1, 1);
+    let mut second = try_build_with_guess(
+        &prepared,
+        &[0, 1],
+        &y,
+        BorrowedMapWeights::Provided(&weights),
+        1.,
+        config,
+        1_000_000,
+        0,
+        &mut Vec::new(),
+        &mut second_call,
+    )
+    .unwrap()
+    .unwrap();
+    assert!(second_call.as_ref().unwrap().used.load(Ordering::Relaxed));
+    assert!(second.report.certified());
+    for (actual, truth) in second.response.iter().zip(residual) {
+        assert!((actual - truth).abs() < 1e-10);
+    }
+    let mut dense = DenseMatrix::zeros(y.len(), 2).unwrap();
+    second.write_dense(&mut dense).unwrap();
+    for (actual, truth) in dense.as_slice().iter().step_by(2).zip(control) {
+        assert!((actual - truth).abs() < 1e-10);
+    }
+    let cold = try_build(
+        &prepared,
+        &[0, 1],
+        &y,
+        BorrowedMapWeights::Provided(&weights),
+        1.,
+        config,
+        1_000_000,
+        0,
+        &mut Vec::new(),
+    )
+    .unwrap()
+    .unwrap();
+    assert!(second.report.iterations <= cold.report.iterations);
+}
+
+#[test]
+fn a2_late_certificate_retry_rebuilds_once_and_fatal_errors_propagate() {
+    let (prepared, y, _, _) = a2_contrast_fixture();
+    let config = MapConfig {
+        tolerance: 1e-10,
+        ..Default::default()
+    };
+    for fault in [1, 2, 3] {
+        let mut call = WarmCall::new(GuessLayout::new(32, 3).unwrap(), None, &[0, 1], 1, 1);
+        let mut first = try_build_with_guess(
+            &prepared,
+            &[0, 1],
+            &y,
+            BorrowedMapWeights::Unit,
+            1.,
+            config,
+            1_000_000,
+            0,
+            &mut Vec::new(),
+            &mut call,
+        )
+        .unwrap()
+        .unwrap();
+        let seed = call.take().unwrap().finish(&mut first).unwrap();
+        let mut call = WarmCall::new(GuessLayout::new(32, 3).unwrap(), Some(seed), &[0, 1], 1, 1);
+        CANONICAL_CERTIFICATE_FAULT.set(fault);
+        let result = try_build_with_guess(
+            &prepared,
+            &[0, 1],
+            &y,
+            BorrowedMapWeights::Unit,
+            1.,
+            config,
+            1_000_000,
+            0,
+            &mut Vec::new(),
+            &mut call,
+        );
+        assert_eq!(CANONICAL_CERTIFICATE_FAULT.get(), 0);
+        if fault == 1 {
+            assert!(result.unwrap().unwrap().report.certified());
+            assert!(call.as_ref().unwrap().retry);
+        } else {
+            let error = match result {
+                Err(error) => error,
+                Ok(_) => panic!("fatal certificate error was hidden"),
+            };
+            assert_eq!(
+                error.code,
+                if fault == 2 {
+                    ErrorCode::Allocation
+                } else {
+                    ErrorCode::Interrupted
+                }
+            );
+            assert!(!call.as_ref().unwrap().retry);
+        }
+    }
+}
