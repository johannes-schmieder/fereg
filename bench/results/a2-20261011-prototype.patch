+        assert_eq!(count, 2);
+        let mut cold = [1., 1.];
+        solve_reduced_cg_with_product(&mut cold, &mut [0.; 6], 2, 1e-14, |x, out| {
+            out[0] = x[0];
+            out[1] = 2. * x[1];
+        })
