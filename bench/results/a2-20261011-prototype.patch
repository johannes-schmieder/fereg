+#!/usr/bin/env python3
+"""A2 build-only staging. Final manifest creation requires root review clearance."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tarfile
+
+BASE = 'e975bf3ddda7746dc62e0ee9d641cd07d1c0a684'
+REMOTE = os.environ.get('FEREG_STUDY_ROOT', '')
+EXISTING = {
+    'baseline-linux.plugin': 'be729dc710b0e04c02e5d09ec234ee4cc9379ed40fed2d64a18710470651c57d',
+    'timing-harness': 'd2b54097145c26a0cd219249b9cfb6fa8df1fb8c29a7db174c751bc85aa0f3d2',
+}
+INPUTS = ('a2-build-base.tar.gz', 'a2-prototype.patch', 'a2-prototype-manifest.json',
+          'a2_build.sh', 'a2_build_stage.py')
+FLAGS = {'RUSTFLAGS': '-C target-cpu=x86-64', 'CARGO_ENCODED_RUSTFLAGS': None,
+         'target': 'x86_64-unknown-linux-gnu', 'profile': 'release',
+         'default_features': True, 'extra_features': []}
+
+
+def require(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def digest(path):
+    result = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1 << 20), b''):
+            result.update(block)
+    return result.hexdigest()
+
+
+def child(root, name):
+    relative = Path(name)
+    require(not relative.is_absolute() and '..' not in relative.parts, 'unsafe relative path')
+    path = (root / relative).resolve()
+    require(path.is_relative_to(root.resolve()), 'path escaped root')
+    return path
+
+
+def save_new(path, value):
+    with path.open('x') as stream:
+        stream.write(json.dumps(value, indent=2, allow_nan=False) + '\n')
+
+
+def prototype_files(root):
+    manifest = json.loads((root / 'a2-prototype-manifest.json').read_text())
+    require(manifest['base_revision'] == BASE, 'prototype base changed')
+    patch = root / 'a2-prototype.patch'
+    require(digest(patch) == manifest['patch_sha256'], 'prototype patch/manifest mismatch')
+    files = {item['path']: item['sha256'] for item in manifest['files']}
+    require(len(files) == len(manifest['files']) and len(files) > 0, 'duplicate/empty source manifest')
+    patched = []
+    for line in patch.read_text().splitlines():
+        if line.startswith('+++ '):
+            require(line.startswith('+++ b/'), 'unexpected patch target format/deletion')
+            patched.append(line[6:].split('\t', 1)[0])
+    require(set(patched) == set(files) and len(patched) == len(files), 'patch/source inventory mismatch')
+    return manifest, files
+
+
+def verify_source(source, files):
+    for name, expected in files.items():
+        require(digest(child(source, name)) == expected, 'source hash: ' + name)
+
+
+def prepare_manifest(task_root, clearance):
+    require(clearance.strip(), 'root must provide final independent review clearance')
+    prototype, files = prototype_files(task_root)
+    verify_source(task_root / 'a2-source', files)
+    inputs = {name: digest(task_root / name) for name in INPUTS}
+    result = {'schema': 1, 'status': 'review-cleared-build-only', 'base_revision': BASE,
+        'review_clearance': clearance, 'prototype_status': prototype['status'],
+        'prototype_manifest_sha256': inputs['a2-prototype-manifest.json'],
+        'patch_sha256': inputs['a2-prototype.patch'], 'input_sha256': inputs,
+        'source_sha256': files, 'existing_sha256': EXISTING, 'flags': FLAGS,
+        'run_root': REMOTE, 'source_directory': 'a2-source',
+        'resources': {'slots': 4, 'mem_per_core': '4G', 'h_rt': '00:30:00', 'cargo_jobs': 4},
+        'resource_basis': 'Same bounded four-slot/16 GiB build reservation as the successful F2 build; no campaign processing or new data.',
+        'transfer': [{'local_task_file': name, 'remote': REMOTE + '/input/' + name, 'sha256': sha}
+                     for name, sha in inputs.items()],
+        'submission': {'required_environment': 'FEREG_A2_STAGING_SHA256=<SHA256 of this manifest>',
+                       'log': 'logs/a2-build.log', 'no_submission_by_helper': True},
+        'outputs': ['a2-source/target', 'a2-linux.plugin', 'a2-build.json',
+                    'logs/a2-build.log', 'logs/a2-rustc.txt', 'logs/a2-cfg.txt'],
+        'acceptance': 'Root must collect exact build job qacct failed=0 and exit_status=0, A2_BUILD_COMPLETE marker, and verify receipt/candidate hashes. No candidate fit follows from a build alone; a separately reviewed driver is required.',
+        'limitations': ['Build-only task; standard Linux build includes binary audit, actual-plugin loader and numeric batch guard checks.',
+                       'No candidate campaign fit, pricing panel, default route decision, native distribution, or performance claim.']}
+    destination = task_root / 'a2-build-staging.json'
+    save_new(destination, result)
+    print(json.dumps({'staging_manifest': str(destination), 'sha256': digest(destination),
+                      'source_files': len(files), 'transfer_files_excluding_manifest': len(inputs)}))
+
+
+def remote_stage(mode, root):
+    require(str(root) == REMOTE and os.environ.get('JOB_ID', '').isdigit(), 'exact SCC compute root/job required')
+    require(int(os.environ.get('NSLOTS', '0')) == 4, 'four build slots required')
+    staging_file = root / 'input/a2-build-staging.json'
+    require(digest(staging_file) == os.environ.get('FEREG_A2_STAGING_SHA256'), 'staging manifest hash')
+    staging = json.loads(staging_file.read_text())
+    require(staging['status'] == 'review-cleared-build-only' and staging['base_revision'] == BASE,
+            'final reviewed build manifest required')
+    require(staging['flags'] == FLAGS and staging['existing_sha256'] == EXISTING, 'compiler/baseline binding')
+    for name, expected in staging['input_sha256'].items():
+        require(digest(child(root / 'input', name)) == expected, 'staged input hash: ' + name)
+    prototype, files = prototype_files(root / 'input')
+    require(files == staging['source_sha256'], 'final file inventory changed')
+    for name, expected in EXISTING.items():
+        require(digest(root / name) == expected, 'existing baseline/harness changed: ' + name)
+    source = root / 'a2-source'
+    if mode == 'prepare-build':
+        require(not source.exists(), 'refuse to reuse or replace source checkout')
+        require(not (root / 'a2-build.json').exists() and not (root / 'a2-linux.plugin').exists(), 'refuse build overwrite')
+        require(os.environ.get('RUSTFLAGS') == FLAGS['RUSTFLAGS'], 'generic production target flags required')
+        forbidden = ('CARGO_ENCODED_RUSTFLAGS', 'CARGO_BUILD_RUSTFLAGS',
+                     'CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS', 'RUSTC_WRAPPER', 'RUSTC_WORKSPACE_WRAPPER',
+                     'FEREG_F1_STUDY_BUILD', 'FEREG_STUDY_CANONICAL_ROUTE', 'FEREG_F2_GEOMETRY')
+        require(not any(key in os.environ for key in forbidden), 'unexpected build override')
+        require(not any(key.startswith('CARGO_PROFILE_RELEASE_') for key in os.environ), 'unexpected profile override')
+        source.mkdir()
+        with tarfile.open(root / 'input/a2-build-base.tar.gz', 'r:gz') as archive:
+            for member in archive.getmembers():
+                child(source, member.name)
+                require(member.isfile() or member.isdir(), 'non-file archive member')
+            archive.extractall(source, filter='data')
+        subprocess.run(['patch', '--batch', '--fuzz=0', '-p1', '-i', str(root / 'input/a2-prototype.patch')],
+                       cwd=source, check=True, timeout=30)
+        verify_source(source, files)
+        return
+    require(mode == 'finish-build', 'unknown remote stage')
+    verify_source(source, files)
+    cfg = (root / 'logs/a2-cfg.txt').read_text().splitlines()
+    require('target_arch="x86_64"' in cfg and 'target_feature="fma"' not in cfg, 'generic core cfg required')
+    save_new(root / 'a2-build.json', {'schema': 1, 'status': 'built-not-measured', 'job_id': os.environ['JOB_ID'],
+        'host': os.environ['HOSTNAME'], 'slots': 4, 'base_revision': BASE, 'flags': FLAGS,
+        'staging_sha256': digest(staging_file), 'prototype_manifest_sha256': digest(root / 'input/a2-prototype-manifest.json'),
+        'patch_sha256': digest(root / 'input/a2-prototype.patch'), 'source_sha256': files,
+        'cargo_lock_sha256': digest(source / 'Cargo.lock'), 'plugin_sha256': digest(root / 'a2-linux.plugin'),
+        'existing_sha256': EXISTING, 'effective_cfg': cfg, 'rustc': (root / 'logs/a2-rustc.txt').read_text(),
+        'standard_build_checks': 'scripts/build_linux.sh completed binary audit, actual-plugin loader and numeric batch guard checks',
+        'acceptance_pending': 'Root accounting0/0 plus marker and exact receipt/artifact hash validation; candidate fits require separate reviewed driver.'})
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest='mode', required=True)
+    freeze = commands.add_parser('prepare-manifest')
+    freeze.add_argument('--task-root', type=Path, required=True)
+    freeze.add_argument('--review-clearance', required=True)
+    for name in ('prepare-build', 'finish-build'):
+        command = commands.add_parser(name)
+        command.add_argument('run_root', type=Path)
+    args = parser.parse_args()
+    if args.mode == 'prepare-manifest':
+        prepare_manifest(args.task_root.resolve(), args.review_clearance)
+    else:
+        remote_stage(args.mode, args.run_root.resolve())
+
+
+if __name__ == '__main__':
+    main()
