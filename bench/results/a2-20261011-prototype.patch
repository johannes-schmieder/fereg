+        assert_eq!(values.map(f64::to_bits), cold.map(f64::to_bits));
+        assert!((values[0] - 1.).abs() < 1e-14 && (values[1] - 0.5).abs() < 1e-14);
+        assert!(!call.used.load(Ordering::Relaxed));
+    }
+
+    #[test]
+    fn a2_certificate_retry_is_once_and_never_resets_consumed_work() {
+        let mut call = seeded_call(&[1., 2.]);
+        call.used.store(true, Ordering::Relaxed);
+        call.ledger[0].store(1, Ordering::Relaxed);
+        call.in_certificate = true;
+        for code in [
+            ErrorCode::Allocation,
+            ErrorCode::Interrupted,
+            ErrorCode::InvalidData,
+        ] {
+            assert!(!call.retry_after_certificate(&FeregError::new(code, "fatal")));
+            assert!(call.seed.is_some());
+        }
+        assert!(call.retry_after_certificate(&declined()));
+        assert!(call.seed.is_none());
+        assert_eq!(call.ledger[0].load(Ordering::Relaxed), 1);
+        let mut values = [1., 1.];
+        let error = call
+            .solve(
+                0,
+                &block(2),
+                &mut values,
+                &mut [0.; 6],
+                &[0., 1., 1., 0., 0., 0.],
+                &[0., 1., 1.],
+                &[2., 1.],
+                2,
+                1e-14,
+                |x, out| {
+                    out[0] = x[0];
+                    out[1] = 2. * x[1];
+                },
+            )
+            .unwrap_err();
+        assert_eq!(error.code, ErrorCode::NonConvergence);
+        assert_eq!(call.ledger[0].load(Ordering::Relaxed), 2);
+        call.in_certificate = true;
+        assert!(!call.retry_after_certificate(&declined()));
+    }
+
+    #[test]
+    fn a2_unseeded_recurrence_is_exactly_the_existing_cold_recurrence() {
+        let mut call = seeded_call(&[1., 2.]);
+        call.seed = None;
+        let mut actual = [3., 7.];
+        let mut expected = actual;
+        let apply = |x: &[f64], out: &mut [f64]| {
+            out[0] = 2. * x[0] + x[1];
+            out[1] = x[0] + 3. * x[1];
+        };
+        let expected_count =
+            solve_reduced_cg_with_product(&mut expected, &mut [0.; 6], 2, 1e-12, apply).unwrap();
+        let count = call
+            .solve(
+                0,
+                &block(2),
+                &mut actual,
+                &mut [0.; 6],
+                &[0., 3., 7., 0., 0., 0.],
+                &[0., 1., 1.],
+                &[2., 1.],
+                2,
+                1e-12,
+                apply,
+            )
+            .unwrap();
+        assert_eq!(count, expected_count);
+        assert_eq!(actual.map(f64::to_bits), expected.map(f64::to_bits));
+    }
+}
