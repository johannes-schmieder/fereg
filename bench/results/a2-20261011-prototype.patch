+#[test]
+fn a2_session_stages_replacement_and_clears_rollback_break_and_invalidation() {
+    let (prepared, y, _, _) = a2_contrast_fixture();
+    let scale = super::super::PreparedOlsBreadWeightScale {
+        weight_kind: None,
+        solver_weight_divisor: 1.,
+        reference_weight_multiplier: 1.,
+        reference_weight_sum: y.len() as f64,
+    };
+    for failure in [0, 1, 2, 3] {
+        let frame = LinearSolveFrame::from_parts(&y, BorrowedMapWeights::Unit, scale).unwrap();
+        let mut session = CertifiedLinearSession::new(
+            &prepared,
+            frame,
+            config(),
+            LinearSessionGenerations::new(1, 1, 1, 1, 1),
+        )
+        .unwrap();
+        session.enable_fast_canonical_products(1_000_000).unwrap();
+        session.enable_canonical_guess(GuessLayout::new(32, 3).unwrap());
+        assert!(session.solve_fresh().unwrap().certified());
+        assert!(session.canonical_guess.is_some());
+        match failure {
+            0 => {
+                // Staging under the same physical weights is still a fresh
+                // response generation; force the canonical refresh contract.
+                session.projection_refresh_required = true;
+                let transaction = session.strict_candidate().unwrap();
+                assert!(transaction.candidate().certified());
+                assert!(transaction.session.canonical_guess.is_some());
+                drop(transaction);
+                assert!(session.canonical_guess.is_none());
+                assert!(session.output().unwrap().certified());
+            }
+            1 => {
+                let error = session
+                    .rebuild_retained_inputs_interruptible(&mut || {
+                        Err(FeregError::new(ErrorCode::Interrupted, "A2 interruption"))
+                    })
+                    .unwrap_err();
+                assert_eq!(error.code, ErrorCode::Interrupted);
+                assert!(session.canonical_guess.is_none());
+            }
+            2 => {
+                let error = session.refresh_response(&[], 2).unwrap_err();
+                assert_eq!(error.code, ErrorCode::InvalidArgument);
+                assert!(session.canonical_guess.is_none());
+            }
+            _ => {
+                session.invalidate_topology(2).unwrap();
+                assert!(session.canonical_guess.is_none());
+            }
+        }
+    }
+}
