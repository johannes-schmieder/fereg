+        assert_eq!(error.code, ErrorCode::NonConvergence);
+        assert_eq!(call.ledger[0].load(Ordering::Relaxed), 4);
+        assert!(call.used.load(Ordering::Relaxed));
+        // Cold alone solves this independent diagonal system within original M.
+        let mut cold = [1.; 4];
+        solve_reduced_cg_with_product(&mut cold, &mut [0.; 12], 4, 1e-14, |x, out| {
+            for i in 0..4 {
+                out[i] = (i + 1) as f64 * x[i];
+            }
+        })
+        .unwrap();
+        for (i, value) in cold.iter().enumerate() {
+            assert!((value - 1. / (i + 1) as f64).abs() < 1e-14);
+        }
+    }
+
+    #[test]
+    fn a2_nonimproving_guess_keeps_the_entire_cold_budget() {
+        let call = seeded_call(&[9., 8.]);
