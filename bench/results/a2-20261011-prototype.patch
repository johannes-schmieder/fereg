+//! Optional guesses for a fresh two-effect canonical projection. No bank here
+//! carries a certificate, weighted geometry, or finite-rank authority.
+use super::*;
+use std::sync::atomic::AtomicBool;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct GuessLayout {
+    q: usize,
+    width: usize,
+    payload: u128,
+    bytes: u128,
+}
+impl GuessLayout {
+    pub(crate) fn new(q: usize, width: usize) -> Option<Self> {
+        if q == 0 || width < 2 {
+            return None;
+        }
+        let cells = q.checked_mul(width)?;
+        // One bank, scales, exact column identities, anchors and a temporary
+        // inverse-coordinate map. Both old and new ownership fit this bound.
+        let payload = (cells as u128)
+            .checked_add(width as u128)?
+            .checked_add((width - 1) as u128)?
+            .checked_add(2 * q as u128)?
+            .checked_mul(8)?
+            .checked_add(512)?;
+        let ledger = (cells as u128).checked_mul(size_of::<AtomicUsize>() as u128)?;
+        let bytes = payload.checked_mul(2)?.checked_add(ledger)?;
+        Some(Self {
+            q,
+            width,
+            payload,
+            bytes,
+        })
+    }
+    pub(crate) fn bytes(self) -> u128 {
+        self.bytes
+    }
+}
+
+pub(crate) struct ProjectionGuess {
+    pub(super) right: Vec<f64>,
+    scales: Vec<f64>,
+    generated: Vec<usize>,
+    anchors: Vec<usize>,
+    sample: u64,
+    topology: u64,
+    left: usize,
+    rows: usize,
+}
+impl ProjectionGuess {
+    pub(in crate::ols) fn heap_bytes(&self) -> u128 {
+        (self.right.capacity() as u128 + self.scales.capacity() as u128) * size_of::<f64>() as u128
+            + (self.generated.capacity() as u128 + self.anchors.capacity() as u128)
+                * size_of::<usize>() as u128
+    }
+    fn bytes(&self) -> u128 {
+        self.heap_bytes() + size_of::<Self>() as u128
+    }
+}
+
+// Optional allocations are bounded by actual capacity, not requested length.
+// A refusal discards only the optimization; authoritative allocations retain
+// their original error paths. This helper never hides errors from the builder.
+fn optional_vec<T>(len: usize, mut value: impl FnMut() -> T) -> Option<Vec<T>> {
+    let mut result = Vec::new();
+    result.try_reserve_exact(len).ok()?;
+    if result.capacity() > len {
+        return None;
+    }
+    result.resize_with(len, &mut value);
+    Some(result)
+}
+
+pub(in crate::ols) struct WarmCall {
+    layout: GuessLayout,
+    seed: Option<ProjectionGuess>,
+    generated: Vec<usize>,
+    anchors: Vec<usize>,
+    levels: Vec<usize>,
+    ledger: Vec<AtomicUsize>,
+    pub(super) used: AtomicBool,
+    sample: u64,
+    topology: u64,
+    left: usize,
+    rows: usize,
+    iterative: bool,
+    pub(super) in_certificate: bool,
+    pub(super) retry: bool,
+}
+impl WarmCall {
+    pub(in crate::ols) fn new(
+        layout: GuessLayout,
+        seed: Option<ProjectionGuess>,
+        generated: &[usize],
+        sample: u64,
+        topology: u64,
+    ) -> Option<Self> {
+        let width = generated.len().checked_add(1)?;
+        if width > layout.width {
+            return None;
+        }
+        let mut columns = optional_vec(generated.len(), || 0)?;
+        columns.copy_from_slice(generated);
+        let seed = seed.filter(|s| {
+            s.sample == sample
+                && s.topology == topology
+                && s.generated == generated
+                && s.scales.len() == width
+                && s.right.len() == s.anchors.len() * width
+                && s.bytes() <= layout.payload
+        });
+        Some(Self {
+            layout,
+            seed,
+            generated: columns,
+            anchors: optional_vec(layout.q, || usize::MAX)?,
+            levels: optional_vec(layout.q, || usize::MAX)?,
+            ledger: optional_vec(layout.q.checked_mul(width)?, || AtomicUsize::new(0))?,
+            used: AtomicBool::new(false),
+            sample,
+            topology,
+            left: usize::MAX,
+            rows: 0,
+            iterative: false,
+            in_certificate: false,
+            retry: false,
+        })
+    }
+    pub(super) fn bind(
+        &mut self,
+        rows: usize,
+        left: usize,
+        anchors: &[usize],
+        free: &[usize],
+        iterative: bool,
+    ) -> bool {
+        self.left = left;
+        self.rows = rows;
+        self.iterative = iterative && anchors.len() <= self.layout.q;
+        if !self.iterative {
+            self.seed = None;
+            return false;
+        }
+        self.anchors.truncate(anchors.len());
+        self.anchors.copy_from_slice(anchors);
+        self.levels.fill(usize::MAX);
+        for (h, &coordinate) in free.iter().enumerate() {
+            if coordinate != usize::MAX {
+                self.levels[coordinate] = h;
+            }
+        }
+        if self
+            .seed
+            .as_ref()
+            .is_some_and(|s| s.rows != rows || s.left != left || s.anchors != anchors)
+        {
+            self.seed = None;
+        }
+        true
+    }
+    pub(super) fn check_conversion(&mut self, roots: &[f64], scales: &[f64]) {
+        let Some(seed) = &self.seed else {
+            return;
+        };
+        let q = self.anchors.len();
+        let valid = scales.iter().enumerate().all(|(j, &scale)| {
+            roots.iter().enumerate().all(|(h, &root)| {
+                (seed.right[j * q + h] * nonzero(seed.scales[j]) / nonzero(scale) * root)
+                    .is_finite()
+            })
+        });
+        if !valid {
+            self.seed = None;
+        }
+    }
+    pub(super) fn retry_after_certificate(&mut self, error: &FeregError) -> bool {
+        if error.code != ErrorCode::NonConvergence
+            || !self.in_certificate
+            || self.retry
+            || !self.used.load(Ordering::Relaxed)
+        {
+            return false;
+        }
+        self.seed = None;
+        self.retry = true;
+        self.in_certificate = false;
+        true
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn solve(
+        &self,
+        j: usize,
+        block: &ComponentFactor,
+        values: &mut [f64],
+        scratch: &mut [f64],
+        cross: &[f64],
+        roots: &[f64],
+        scales: &[f64],
+        cap: usize,
+        tolerance: f64,
+        apply: impl Fn(&[f64], &mut [f64]),
+    ) -> Result<usize> {
+        let q = self.anchors.len();
+        let used = &self.ledger[j * self.layout.q + block.start];
+        let remaining = cap.saturating_sub(used.load(Ordering::Relaxed));
+        if let Some(seed) = self.seed.as_ref().filter(|_| !self.retry && cap >= 2) {
+            let guess = |i: usize| {
+                let h = self.levels[block.start + i];
+                seed.right[j * q + h] * nonzero(seed.scales[j]) / nonzero(scales[j]) * roots[h]
+            };
+            match cg_attempt(
+                values,
+                scratch,
+                (cap / 2).min(remaining),
+                tolerance,
+                &apply,
+                Some((&guess, &self.used)),
+                Some(used),
+            ) {
+                Ok(_) => return Ok(used.load(Ordering::Relaxed)),
+                Err(error) if error.code == ErrorCode::NonConvergence => {}
+                Err(error) => return Err(error),
+            }
+            // Rebuild the original b. Neither a warm residual nor a modified
+            // RHS becomes the normalization or stopping target of the retry.
+            for (i, value) in values.iter_mut().enumerate() {
+                let h = self.levels[block.start + i];
+                *value = cross[j * q + h] / roots[h];
+            }
+        }
+        let remaining = cap.saturating_sub(used.load(Ordering::Relaxed));
+        cg_attempt(
+            values,
+            scratch,
+            remaining,
+            tolerance,
+            apply,
+            None,
+            Some(used),
+        )?;
+        Ok(used.load(Ordering::Relaxed))
+    }
+    pub(super) fn trace(&self, accepted: bool) {
+        if !crate::diagnostics::solver_trace_enabled() {
+            return;
+        }
+        for (rhs, ledger) in self.ledger.chunks(self.layout.q).enumerate() {
+            eprintln!("FEREG_SOLVER_TRACE|phase=canonical_guess|rhs={rhs}|used={}|cold_certificate_retry={}|accepted={}|iterations_sum={}",
+                usize::from(self.used.load(Ordering::Relaxed)), usize::from(self.retry), usize::from(accepted),
+                ledger.iter().map(|n| n.load(Ordering::Relaxed)).sum::<usize>());
+        }
+    }
+    pub(in crate::ols) fn finish<P: PreparedOlsFitView + Sync + ?Sized>(
+        self,
+        products: &mut Products<'_, P>,
+    ) -> Option<ProjectionGuess> {
+        if !self.iterative {
+            return None;
+        }
+        let guess = ProjectionGuess {
+            right: std::mem::take(&mut products.right),
+            scales: std::mem::take(&mut products.scales),
+            generated: self.generated,
+            anchors: self.anchors,
+            sample: self.sample,
+            topology: self.topology,
+            left: self.left,
+            rows: self.rows,
+        };
+        (guess.bytes() <= self.layout.payload).then_some(guess)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn seeded_call(truth: &[f64]) -> WarmCall {
+        let q = truth.len() + 1;
+        let layout = GuessLayout::new(q, 2).unwrap();
+        let mut right = vec![0.; 2 * q];
+        right[1..q].copy_from_slice(truth);
+        let anchors = (0..q)
+            .map(|i| if i == 0 { 0 } else { usize::MAX })
+            .collect();
+        let seed = ProjectionGuess {
+            right,
+            scales: vec![2., 1.],
+            generated: vec![7],
+            anchors,
+            sample: 3,
+            topology: 5,
+            left: 0,
+            rows: 40,
+        };
+        let mut call = WarmCall::new(layout, Some(seed), &[7], 3, 5).unwrap();
+        let free: Vec<_> = (0..q)
+            .map(|i| if i == 0 { usize::MAX } else { i - 1 })
+            .collect();
+        let anchors: Vec<_> = (0..q)
+            .map(|i| if i == 0 { 0 } else { usize::MAX })
+            .collect();
+        call.bind(40, 0, &anchors, &free, true);
+        call
+    }
+    fn block(n: usize) -> ComponentFactor {
+        ComponentFactor {
+            len: n,
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn a2_capacity_reserves_two_banks_and_persistent_ledger() {
+        for q in [1, 3, 10_000] {
+            for width in [2, 17] {
+                let layout = GuessLayout::new(q, width).unwrap();
+                let columns: Vec<_> = (0..width - 1).collect();
+                let call = WarmCall::new(layout, None, &columns, 0, 0).unwrap();
+                let metadata = (call.generated.capacity()
+                    + call.anchors.capacity()
+                    + call.levels.capacity()) as u128
+                    * 8
+                    + size_of::<WarmCall>() as u128;
+                let future_bank = (q * width + width) as u128 * 8;
+                assert!(metadata + future_bank <= layout.payload);
+                assert_eq!(
+                    layout.bytes(),
+                    2 * layout.payload + call.ledger.capacity() as u128 * 8
+                );
+            }
+        }
+        assert!(GuessLayout::new(usize::MAX, 17).is_none());
+        assert!(GuessLayout::new(2, 1).is_none());
+        assert!(optional_vec(usize::MAX, || 0_f64).is_none());
+    }
+
+    #[test]
+    fn a2_identity_and_anchor_mismatches_drop_only_the_guess() {
+        let old = seeded_call(&[1., 2.]).seed.take().unwrap();
+        let layout = GuessLayout::new(3, 2).unwrap();
+        let mismatch = WarmCall::new(layout, Some(old), &[8], 3, 5).unwrap();
+        assert!(mismatch.seed.is_none());
+        for identity in [(4, 5), (3, 6)] {
+            let old = seeded_call(&[1., 2.]).seed.take().unwrap();
+            assert!(
+                WarmCall::new(layout, Some(old), &[7], identity.0, identity.1)
+                    .unwrap()
+                    .seed
+                    .is_none()
+            );
+        }
+        let mut current = seeded_call(&[1., 2.]);
+        current.bind(
+            40,
+            0,
+            &[1, usize::MAX, usize::MAX],
+            &[0, usize::MAX, 1],
+            true,
+        );
+        assert!(current.seed.is_none());
+    }
+
+    #[test]
+    fn a2_scale_conversion_uses_new_roots_and_original_rhs_target() {
+        let call = seeded_call(&[2., 3.]);
+        // Old scales=2, new scales=4; roots=2,4 yields guess=(2,6).
+        let mut values = [2., 6.];
+        let cross = [0., 4., 24., 0., 0., 0.];
+        let count = call
+            .solve(
+                0,
+                &block(2),
+                &mut values,
+                &mut [0.; 6],
+                &cross,
+                &[0., 2., 4.],
+                &[4., 1.],
+                2,
+                1e-12,
+                |x, out| out.copy_from_slice(x),
+            )
+            .unwrap();
+        assert_eq!(count, 0);
+        assert_eq!(values, [2., 6.]);
+        let call = seeded_call(&[1. + 1e-7, 1.]);
+        let mut values = [1., 1.];
+        let count = call
+            .solve(
+                0,
+                &block(2),
+                &mut values,
+                &mut [0.; 6],
+                &[0., 1., 1., 0., 0., 0.],
+                &[0., 1., 1.],
+                &[2., 1.],
+                2,
+                1e-6,
+                |x, out| out.copy_from_slice(x),
+            )
+            .unwrap();
+        assert_eq!(
+            count, 0,
+            "the target is the original RHS norm, not the smaller warm residual"
