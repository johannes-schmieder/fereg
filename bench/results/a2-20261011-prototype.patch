+"""Synthetic A2 driver guards; never calls a native plugin or subprocess."""
+import ast
+import copy
+import hashlib
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import struct
+import time
+from unittest.mock import patch
+
+work = Path(__file__).resolve().parent
+root = Path(os.environ['FEREG_SOURCE_ROOT']).resolve()
+began = time.monotonic()
+report_path = work / 'a2-tooling-checks.json'
+prior = json.loads(report_path.read_text()) if report_path.exists() else [
+    {'invocation': 1, 'kind': 'driver syntax inspection', 'status': 'passed',
+     'elapsed_seconds': None, 'charged_seconds': 1.,
+     'note': 'Initial ast.parse wall time was not captured; charge one second conservatively.'}]
+checks = []
+
+
+def bits(value):
+    return struct.pack('>d', value).hex()
+
+
+def require(condition, name):
+    if not condition:
+        raise AssertionError(name)
+    checks.append(name)
+
+
+try:
+    driver_path = work / 'a2_discovery.py'
+    ast.parse(driver_path.read_text())
+    spec = importlib.util.spec_from_file_location('a2_discovery', driver_path)
+    driver = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(driver)
+    driver.load_api(root)
+    headers = json.loads((work / 'driver-headers.json').read_text())
+    driver.validate_observation_requests(headers['templates'])
+    require(headers['templates']['output_saved_count'] == '2' and
+            headers['templates']['output_saved_channels'] == '1:0|1:0' and
+            headers['templates']['output_sample'] == '21',
+            'original frozen header accepts zero saved positions and named result matrices')
+    try:
+        driver.validate_observation_requests(headers['templates-v2'])
+    except ValueError:
+        checks.append('templates-v2 numerical observation outputs rejected')
+    else:
+        raise AssertionError('undeclared templates-v2 observation outputs accepted')
+    for name in ['residual', 'xb', 'absorbed', 'eta', 'mean']:
+        modified = {**headers['templates'], 'output_' + name: '22'}
+        try:
+            driver.validate_observation_requests(modified)
+        except ValueError:
+            checks.append('actual nonzero observation slot rejected: ' + name)
+        else:
+            raise AssertionError('undeclared observation slot accepted: ' + name)
+    for kind in ['saved', 'bias']:
+        modified = {**headers['templates'], 'output_' + kind + '_count': '1',
+                    'output_' + kind + '_channels': '2:22'}
+        try:
+            driver.validate_observation_requests(modified)
+        except ValueError:
+            checks.append('actual saved/bias channel request rejected: ' + kind)
+        else:
+            raise AssertionError('undeclared channel output accepted')
+    require(driver.PREVIOUS_SECONDS == 137.82965058900277,
+            'zero-fit failed panel wall time remains charged to parent budget')
+    packet = json.loads((work / 'a2-preflight-results.json').read_text())['records'][0]
+    baseline = {'schema': 1, 'return_code': 0, 'error': '', 'columns': [], 'matrices': packet['matrices']}
+    scope = driver.make_scope(baseline, {'synthetic': True})
+    obs = {'all_columns_sha256': 'frozen', 'sample': 'frozen', 'drop_reason': 'frozen'}
+    require(not driver.compare(baseline, baseline, scope, obs, obs), 'exact identity passes')
+
+    candidate = copy.deepcopy(baseline)
+    value = driver.replay.number(candidate['matrices']['RB']['bits'][0])
+    candidate['matrices']['RB']['bits'][0] = bits(math.nextafter(value, math.inf))
+    require(not driver.compare(baseline, candidate, scope, obs, obs), 'declared one-ulp finite coefficient passes')
+
+    for value in [float('nan'), float('inf'), driver.MISSING]:
+        candidate = copy.deepcopy(baseline)
+        candidate['matrices']['RB']['bits'][0] = bits(value)
+        try:
+            driver.compare(baseline, candidate, scope, obs, obs)
+        except RuntimeError:
+            checks.append('scoped missing/nonfinite rejected: ' + str(value))
+        else:
+            raise AssertionError('scoped missingness accepted')
+
+    missing = copy.deepcopy(baseline)
+    missing['matrices']['RINF']['bits'][8] = bits(driver.MISSING)
+    missing_scope = driver.make_scope(missing, {'synthetic': True})
+    require('/matrices/RINF/bits/8' not in missing_scope['leaves'], 'baseline missing sentinel is unscoped')
+    require(bool(driver.compare(missing, baseline, missing_scope, obs, obs)), 'changing baseline missingness rejected exactly')
+
+    for table, index, name in [('RRUNTIME', 1, 'outer count'), ('RCERT', 15, 'certificate decision'),
+                               ('RSOLVER', 0, 'solver family'), ('RSTATUS', 1, 'omission'),
+                               ('RDROP', 0, 'drop decision')]:
+        candidate = copy.deepcopy(baseline)
+        old = driver.replay.number(candidate['matrices'][table]['bits'][index])
+        candidate['matrices'][table]['bits'][index] = bits(old + 1.)
+        require(bool(driver.compare(baseline, candidate, scope, obs, obs)), name + ' remains exact')
+
+    for key in obs:
+        other = {**obs, key: 'changed'}
+        require(bool(driver.compare(baseline, baseline, scope, obs, other)), key + ' remains exact')
+    candidate = copy.deepcopy(baseline)
+    old = driver.replay.number(candidate['matrices']['RRUNTIME']['bits'][2])
+    candidate['matrices']['RRUNTIME']['bits'][2] = bits(old + 1.)
+    require(not driver.compare(baseline, candidate, scope, obs, obs), 'only named inner work may change')
+    require(not driver.replay.differences(driver.protected(baseline), driver.protected(candidate)), 'cross-worker protected comparison permits only work')
+
+    candidate = copy.deepcopy(baseline)
+    old = driver.replay.number(candidate['matrices']['RFIT']['bits'][19])
+    candidate['matrices']['RFIT']['bits'][19] = bits(old + abs(old) * 1e-6 + 1e-6)
+    require(bool(driver.compare(baseline, candidate, scope, obs, obs)), 'strong statistic bound unchanged')
+    trace = '\n'.join('FEREG_SOLVER_TRACE|phase=canonical_guess|rhs=' + str(i) + '|used=1|cold_certificate_retry=1|accepted=1|iterations_sum=9' for i in range(3))
+    parsed = driver.parse_traces(trace)
+    require(parsed['accepted_guess_calls'] == 1 and len(parsed['canonical_guess_rows']) == 3,
+            'call-wide acceptance counted once; per-RHS warm+cold work retained')
+    uncalled = {'status': 'running', 'fit_started': False}
+    with patch.object(driver.time, 'monotonic', return_value=10.):
+        result = driver.run_fit(None, None, None, None, uncalled, 9., None, None)
+    require(result is None and uncalled == {'status': 'not_started_budget', 'fit_started': False},
+            'expired pre-call deadline leaves native fit unattempted')
+    terminal = {'status': 'discovery_passed_pending_independent_qualification',
