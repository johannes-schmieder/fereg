+        )
+        .unwrap();
+        session.enable_fast_canonical_products(1_000_000).unwrap();
+        session.enable_canonical_guess(GuessLayout::new(32, 3).unwrap());
+        if entry == 2 {
+            let geometry =
+                ReusableMapAbsorber::certificate_geometry_bytes(session.fe_design()).unwrap();
+            let rhs = session.fe_projector.as_ref().unwrap().max_rhs();
+            let workspace = ppml_coefficient_lifetime_bytes(session.fe_design(), rhs, 1).unwrap();
+            let joint = ReusableMapAbsorber::joint_slope_bytes(
+                session.fe_design(),
+                prepared.fit_model().columns.len(),
+            )
+            .unwrap();
+            session.enable_ppml_certificate_geometry(geometry).unwrap();
+            session
+                .enable_ppml_coefficient_solver(1, workspace, None, None)
+                .unwrap();
+            session.enable_ppml_joint_slopes(joint).unwrap();
+        }
+        session.solve_fresh().unwrap();
+        assert!(
+            session.canonical_guess.is_some(),
