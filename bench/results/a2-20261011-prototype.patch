+    prior_operator_work: u128,
+    obsolete_projection: &mut Vec<f64>,
+    warm: &mut Option<WarmCall>,
+) -> Result<Option<Products<'a, P>>> {
+    if warm.is_none() {
+        return try_build(
+            prepared,
+            generated,
+            response,
+            weights,
+            divisor,
+            config,
+            allowance,
+            prior_operator_work,
