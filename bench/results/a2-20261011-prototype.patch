+CASES = {
+    'ppml-akm-1m': ('4d9c918c5e60b1e7ebb4ee01227c1bf467fbdb9b2a4858664eb02e1fe87cbfaf', 1000000),
+    'ppml-dense-1m': ('608ec878eeb1994ec85eda1adf63e88ed5da29265622c9e3c0b09b2c6e1eb3ea', 1000000),
+    'ppml-dense-4m': ('994f11613c063d1032fa6ee364cb179c57c126289b53a9e5913707e1f95218e5', 4000000),
+    'ppml-sparse-1m': ('fb8bb0d823773b3250c9e3523396c92db0fc79dc27fd85277578227db84ea843', 1000000),
+}
+BASELINE = 'be729dc710b0e04c02e5d09ec234ee4cc9379ed40fed2d64a18710470651c57d'
+HARNESS = 'd2b54097145c26a0cd219249b9cfb6fa8df1fb8c29a7db174c751bc85aa0f3d2'
+PREFLIGHT_SECONDS = 127.149324881
+PREVIOUS_SECONDS = PREFLIGHT_SECONDS + 10.680325708002783
+FIT_CAP, PANEL_CAP = 120., 1800.
+MISSING = 8.98846567431158e307
+
+
+def check(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def load_api(source):
+    global replay, native
+    sys.path[:0] = [str(source / 'scripts'), str(source / 'bench')]
+    replay = importlib.import_module('replay_plugins')
+    native = importlib.import_module('native_io')
+
+
+def sha(path):
+    return native.digest(Path(path))
+
+
+def canonical_sha(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+def present(bits):
+    value = replay.number(bits)
+    return math.isfinite(value) and value < MISSING
+
+
+def get(view, path):
+    for part in path.split('/')[1:]:
+        view = view[int(part)] if isinstance(view, list) else view[part]
+    return view
+
+
+def proxy(data):
+    # Real binary input/sample/drop hashes are separately required below.
+    return {**data, 'columns': [['3ff0000000000000'], ['0000000000000000']]}
+
+
+def protected(data):
+    return replay.discrete_view(proxy(data), {'poisson': True, 'outputs': {'sample': 0, 'drop_reason': 1}})
+
+
+def make_scope(data, identities):
+    view = replay.exact_view(proxy(data), True)
+    paths = {}
+    for kind, envelope in [('numerical', replay.numerical_scope_indices(True)),
+                           ('work', replay.work_scope_indices(True))]:
+        for table, indices in envelope.items():
+            values = view[table] if table == 'runtime_signature' else view['matrices'][table]['bits']
+            for i in sorted(indices):
+                check(i < len(values), 'scope schema mismatch')
+                path = f'/{table}/{i}' if table == 'runtime_signature' else f'/matrices/{table}/bits/{i}'
+                if present(values[i]):
+                    paths[path] = {'kind': kind, 'baseline_bits': values[i]}
+    for table in ['RB', 'RV']:
+        for i, bits in enumerate(view['matrices'][table]['bits']):
+            if present(bits):
+                paths[f'/matrices/{table}/bits/{i}'] = {'kind': 'numerical', 'baseline_bits': bits}
+    replay.validate_scope_targets(list(paths), proxy(data), True)
+    return {'schema': 1, 'reason': 'A2 canonical projection guesses: declared numerical and named inner-work leaves only',
+            'identities': identities, 'leaves': paths}
+
+
+def compare(a, b, scope, observations_a, observations_b):
+    left, right = replay.exact_view(proxy(a), True), replay.exact_view(proxy(b), True)
+    paths = scope['leaves']
+    replay.validate_scope_targets(list(paths), proxy(b), True)
+    check(all(get(left, p) == v['baseline_bits'] for p, v in paths.items()), 'baseline scope binding changed')
+    errors = [p for p in replay.differences(left, right) if p not in paths]
+    errors += ['protected' + p for p in replay.differences(protected(a), protected(b))]
+    errors += ['observations' + p for p in replay.differences(observations_a, observations_b)]
+    for name, rtol, atol in [('RB', 1e-7, 1e-10), ('RV', 1e-6, 1e-10), ('RFIT', 1e-12, 1e-14)]:
+        for i, (x, y) in enumerate(zip(a['matrices'][name]['bits'], b['matrices'][name]['bits'])):
+            path = f'/matrices/{name}/bits/{i}'
+            if path not in paths or paths[path]['kind'] != 'numerical':
+                continue
+            xv, yv = replay.number(x), replay.number(y)
+            if abs(xv - yv) > atol + rtol * max(abs(xv), abs(yv)):
+                errors.append(path + ': unchanged scientific bound')
+    return errors
+
+
+def bound(item):
+    path = Path(item['path']).resolve()
+    check(sha(path) == item['sha256'], 'artifact identity mismatch: ' + path.name)
+    return path
+
+
+def binary_observations(path, shape, arguments):
+    check(path.stat().st_size == shape[0] * shape[1] * 8, 'binary observation size mismatch')
+    result = {'rows': shape[0], 'columns': shape[1], 'all_columns_sha256': sha(path)}
+    with path.open('rb') as stream:
+        for name in ['sample', 'drop_reason']:
+            slot = int(arguments.get('output_' + name, '0'))
+            check(0 <= slot <= shape[1], 'output slot out of range')
+            if not slot:
+                check(name != 'sample', 'frozen case must publish a sample mask')
+                result[name] = 'not_requested; RDROP exact'
+                continue
+            stream.seek((slot - 1) * shape[0] * 8)
+            digest = hashlib.sha256()
+            remaining = shape[0] * 8
+            while remaining:
+                part = stream.read(min(remaining, 1 << 20))
+                check(bool(part), 'truncated observation column')
+                digest.update(part)
+                remaining -= len(part)
+            result[name] = digest.hexdigest()
+    return result
+
+
+def validate_observation_requests(arguments):
+    # ppml_estimate::ObservationOutputs has these scalar observation slots.
+    # Matrix names and saved-channel descriptor counts are metadata, not slots.
+    for name in ['residual', 'xb', 'absorbed', 'eta', 'mean']:
+        check(int(arguments.get('output_' + name, '0')) == 0,
+              'undeclared observation output: ' + name)
+    # transport::decode_output_position_registry decodes one length-framed
+    # position per channel; a zero position means the channel is not requested.
+    for kind in ['saved', 'bias']:
+        count = int(arguments.get('output_' + kind + '_count', '0'))
+        encoded = arguments.get('output_' + kind + '_channels', '.')
+        check(count >= 0, 'negative output descriptor count')
+        if count == 0:
+            check(encoded == '.', 'empty output registry must use dot sentinel')
+            continue
+        entries = encoded.split('|')
+        check(len(entries) == count, 'output registry cardinality mismatch')
+        for entry in entries:
+            match = re.fullmatch(r'([0-9]+):([0-9]+)', entry)
+            check(match is not None and int(match[1]) == len(match[2]),
+                  'invalid length-framed output position')
+            check(int(match[2]) == 0, 'undeclared observation output: ' + kind)
+
+
+def read_result(path, shape, arguments):
+    check(path.stat().st_size <= 16 * 1024 * 1024, 'unexpected noncompact result')
+    data = json.loads(path.read_text())
+    check(data.get('columns') == [], 'harness must use external binary columns')
+    native.validate_result({k: v for k, v in data.items() if k != 'columns'})
+    native.diagnostics(data, True)
+    cert = replay.matrix(data, 'RCERT')
+    check(len(cert) == 16 and all(math.isfinite(v) and 0 <= v < MISSING for v in cert), 'nonfinite certificate')
+    runtime = replay.matrix(data, 'RRUNTIME')
+    check(runtime[76:78] == [1., 1.], 'certificate acceptance missing')
+    observations = binary_observations(Path(str(path) + '.columns'), shape, arguments)
+    return data, observations
+
+
+def parse_traces(text):
+    rows = []
+    phases = []
+    for line in text.splitlines():
+        for prefix, output in [('FEREG_SOLVER_TRACE|', rows), ('FEREG_PHASE|', phases)]:
+            if prefix in line:
+                parts = line[line.index(prefix) + len(prefix):].split('|')
+                item = dict(p.split('=', 1) for p in parts if '=' in p)
+                if parts and '=' not in parts[0]:
+                    item['label'] = parts[0]
+                output.append(item)
+    guesses = [r for r in rows if r.get('phase') == 'canonical_guess']
+    return {'canonical_guess_rows': guesses,
+            'accepted_guess_calls': sum(r.get('rhs') == '0' and r.get('used') == '1' and r.get('accepted') == '1' for r in guesses),
+            'guess_semantics': 'used/accepted/retry are call-wide, repeated per RHS; iterations_sum includes warm and cold',
+            'reduced_solve_rows': [r for r in rows if r.get('phase') == 'canonical_reduced_solve'],
+            'phase_costs': phases}
+
+
+def run_fit(harness, plugin, case, output, record, deadline, shape, arguments):
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        record.update(status='not_started_budget', fit_started=False)
+        return None
+    env = dict(os.environ, FEREG_PHASE_TIMING='1', FEREG_SOLVER_TRACE='1',
+               OMP_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1', MKL_NUM_THREADS='1', NUMEXPR_NUM_THREADS='1')
+    for key in list(env):
+        if key == 'LLVM_PROFILE_FILE' or key.startswith(('FEREG_STUDY_', 'FEREG_A3_', 'FEREG_F1_')):
+            del env[key]
+    log = output.with_suffix('.log')
+    began = time.monotonic()
+    try:
+        with log.open('x') as stream:
+            record['fit_started'] = True
+            result = subprocess.run([str(harness), str(plugin), '--replay', str(case), str(output)],
+                                    env=env, stdout=stream, stderr=subprocess.STDOUT,
+                                    timeout=min(FIT_CAP, remaining))
+        record['process_exit_code'] = result.returncode
+        check(result.returncode == 0, 'native process failed')
+        data, observations = read_result(output, shape, arguments)
+        native_clock = re.findall(r'NATIVE_SECONDS=([0-9.eE+-]+)', log.read_text(errors='replace'))
+        check(len(native_clock) == 1 and math.isfinite(float(native_clock[0])) and float(native_clock[0]) > 0, 'missing unique native total clock')
+        record.update(status='complete', observations=observations,
+                      runtime_bits=data['matrices']['RRUNTIME']['bits'],
+                      solver_bits=data['matrices']['RSOLVER']['bits'],
+                      memory_bits=data['matrices']['RMEMORY']['bits'],
+                      scientific_sha256=canonical_sha(replay.exact_view(proxy(data), True)),
+                      protected_sha256=canonical_sha(protected(data)))
+        return data, observations
+    except subprocess.TimeoutExpired as error:
+        record.update(status='timeout', timeout_seconds=min(FIT_CAP, remaining),
+                      error_type=type(error).__name__, error_sha256=hashlib.sha256(str(error).encode()).hexdigest())
+    except Exception as error:
+        record.update(status='failed', error_type=type(error).__name__,
+                      error_sha256=hashlib.sha256(str(error).encode()).hexdigest())
+    finally:
+        record['fit_and_validation_seconds'] = time.monotonic() - began
+        if output.exists():
+            record['result_sha256'] = sha(output)
+        if log.exists():
+            text = log.read_text(errors='replace')
+            record['log_sha256'] = sha(log)
+            record.update(parse_traces(text))
+            native_seconds = re.findall(r'NATIVE_SECONDS=([0-9.eE+-]+)', text)
+            record['native_seconds'] = [float(v) for v in native_seconds]
+    return None
+
+
+def terminal_verdict(summary, began, now):
+    summary['elapsed_seconds'] = now - began
+    summary['charged_total_seconds'] = PREVIOUS_SECONDS + summary['elapsed_seconds']
+    summary['attempted_fits'] = sum(r.get('fit_started', False) for r in summary['records'])
+    summary['unattempted_fits'] = len(summary['records']) - summary['attempted_fits']
+    summary['end_verdict'] = {
+        'identities_unchanged': all(r['unchanged'] for r in summary['end_identity_checks']),
+        'within_panel_budget': summary['elapsed_seconds'] <= PANEL_CAP,
+    }
+    if not summary['end_verdict']['identities_unchanged']:
+        summary['status'] = 'stopped_artifact_changed'
+    if not summary['end_verdict']['within_panel_budget']:
+        summary['status'] = 'stopped_terminal_budget'
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('manifest', type=Path)
+    args = parser.parse_args()
+    load_api(args.source.resolve())
+    manifest = json.loads(args.manifest.read_text())
+    check(manifest['plugins']['baseline']['sha256'] == BASELINE, 'wrong uninstrumented baseline')
+    check(manifest['harness']['sha256'] == HARNESS, 'wrong frozen harness')
+    check(len(manifest['cases']) == 4 and {c['name'] for c in manifest['cases']} == set(CASES), 'wrong frozen panel')
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    summary_path = output / 'summary.json'
+    check(not summary_path.exists(), 'existing attempt: no retry/resume')
+    summary = {'schema': 1, 'purpose': 'bounded A2 discovery; not qualification or quiet timing',
+               'status': 'running', 'driver_sha256': sha(Path(__file__)), 'manifest_sha256': sha(args.manifest),
+               'limits': {'planned_fits': 24, 'seconds_per_fit': FIT_CAP, 'panel_seconds': PANEL_CAP,
+                          'parent_fits': 48, 'parent_seconds': 3600, 'previous_fits': 4,
+                          'previous_seconds': PREVIOUS_SECONDS, 'retry': False},
+               'records': [{'case': c, 'workers': w, 'artifact': a, 'status': 'unattempted', 'fit_started': False}
+                           for c in CASES for w in [1, 4, 16] for a in ['baseline', 'candidate']],
+               'comparisons': []}
+    began = time.monotonic()
+    def save(terminal=False):
+        if terminal:
+            terminal_verdict(summary, began, time.monotonic())
+        else:
+            summary['elapsed_seconds'] = time.monotonic() - began
+            summary['charged_total_seconds'] = PREVIOUS_SECONDS + summary['elapsed_seconds']
+        summary_path.write_text(json.dumps(summary, indent=2) + '\n')
+    save()
+    bindings = [manifest['harness'], *manifest['plugins'].values(), *manifest['cases'],
+                {'path': str(Path(__file__).resolve()), 'sha256': summary['driver_sha256']},
+                {'path': str(args.manifest.resolve()), 'sha256': summary['manifest_sha256']}]
+    summary['helper_sha256'] = {}
+    for name in ['native_io', 'replay_plugins', 'replay_psd', 'replay_bias_reference', 'replay_ols_reference']:
+        path = Path(sys.modules[name].__file__).resolve()
+        identity = sha(path)
+        summary['helper_sha256'][name] = identity
+        bindings.append({'path': str(path), 'sha256': identity})
+    cross_worker = {}
+    try:
+        harness = bound(manifest['harness'])
+        plugins = {a: bound(manifest['plugins'][a]) for a in ['baseline', 'candidate']}
+        cases = {c['name']: bound(c) for c in manifest['cases']}
+        check(all(c['sha256'] == CASES[c['name']][0] for c in manifest['cases']), 'case identity outside declaration')
+        summary['artifact_hashes'] = {a: manifest['plugins'][a]['sha256'] for a in plugins}
+        summary['harness_sha256'] = HARNESS
+        for name, original in cases.items():
+            with original.open('rb') as stream:
+                shape, raw = native.case_header(stream)
+            arguments = dict(v.decode().split('=', 1) for v in raw[1:])
+            check(raw[0] == b'estimate-ppml' and shape[0] == CASES[name][1], 'case family/shape mismatch')
+            validate_observation_requests(arguments)
+            for workers in [1, 4, 16]:
+                variant = output / f'{name}-w{workers}.case'
+                native.prepare_case(original, variant, workers)
+                input_sha = sha(variant)
+                baseline = None
+                for artifact in ['baseline', 'candidate']:
+                    record = next(r for r in summary['records'] if (r['case'], r['workers'], r['artifact']) == (name, workers, artifact))
+                    record.update(status='running', input_sha256=input_sha, frozen_input_sha256=CASES[name][0],
+                                  artifact_sha256=manifest['plugins'][artifact]['sha256'])
+                    save()
+                    result_path = output / f'{name}-w{workers}-{artifact}.json'
+                    result = run_fit(harness, plugins[artifact], variant, result_path, record, began + PANEL_CAP, shape, arguments)
+                    save()
+                    check(result is not None, 'fit failed: remaining slots unattempted')
+                    data, observations = result
+                    witness = {'protected': protected(data), 'observations': observations}
+                    if name in cross_worker:
+                        cross_errors = replay.differences(cross_worker[name], witness)
+                        if cross_errors:
+                            record.update(status='scientific_failure', science_errors=cross_errors)
+                        check(not cross_errors, 'cross-worker discrete/input/sample/drop difference')
+                    else:
+                        cross_worker[name] = witness
+                    if artifact == 'baseline':
+                        baseline = result
+                        scope = make_scope(data, {'input_sha256': input_sha, 'baseline_sha256': BASELINE,
+                                                 'harness_sha256': HARNESS, 'result_sha256': record['result_sha256']})
+                        scope_path = output / f'{name}-w{workers}-scope.json'
+                        with scope_path.open('x') as stream:
+                            json.dump(scope, stream, indent=2)
+                        record['scope_sha256'] = sha(scope_path)
+                        # Persist the baseline-bound exact leaf list before the candidate starts.
+                        save()
+                    else:
+                        check(sha(scope_path) == next(r['scope_sha256'] for r in summary['records'] if r['case'] == name and r['workers'] == workers and r['artifact'] == 'baseline'), 'scope changed')
+                        errors = compare(baseline[0], data, scope, baseline[1], observations)
+                        baseline_record = next(r for r in summary['records'] if r['case'] == name and r['workers'] == workers and r['artifact'] == 'baseline')
+                        if errors:
+                            record.update(status='scientific_failure', science_errors=errors)
+                        comparison = {'case': name, 'workers': workers, 'status': 'failed' if errors else 'passed',
+                                      'errors': errors, 'scope_sha256': sha(scope_path),
+                                      'baseline_seconds': replay.matrix(baseline[0], 'RRUNTIME')[0],
+                                      'candidate_seconds': replay.matrix(data, 'RRUNTIME')[0],
+                                      'baseline_native_seconds': baseline_record['native_seconds'][0],
+                                      'candidate_native_seconds': record['native_seconds'][0]}
+                        summary['comparisons'].append(comparison)
+                        save()
+                        check(not errors, 'scientific comparison failed: no retry')
+                    # The complete binary bank is represented by its exact hash; avoid keeping duplicate data.
+                    Path(str(result_path) + '.columns').unlink()
+                variant.unlink()
+        guesses = sum(r.get('accepted_guess_calls', 0) for r in summary['records'] if r['artifact'] == 'candidate')
+        baseline_seconds = sum(c['baseline_seconds'] for c in summary['comparisons'])
+        candidate_seconds = sum(c['candidate_seconds'] for c in summary['comparisons'])
+        baseline_native = sum(c['baseline_native_seconds'] for c in summary['comparisons'])
+        candidate_native = sum(c['candidate_native_seconds'] for c in summary['comparisons'])
+        summary['opportunity'] = {'accepted_guess_calls': guesses, 'baseline_total_seconds': baseline_seconds,
+                                  'candidate_total_seconds': candidate_seconds,
+                                  'baseline_native_seconds': baseline_native, 'candidate_native_seconds': candidate_native,
+                                  'net_lower_total_cost': candidate_seconds < baseline_seconds and candidate_native < baseline_native,
+                                  'cost_scope': 'complete native total, including conversion, initial residual matvec, cold retries, setup and certificates; candidate tracing cost included'}
+        check(guesses > 0, 'no accepted compatible guess: stop')
+        check(candidate_seconds < baseline_seconds and candidate_native < baseline_native, 'no net total-cost benefit in both native and RRUNTIME clocks: stop')
+        summary['status'] = 'discovery_passed_pending_independent_qualification'
+    except Exception as error:
+        summary.update(status='stopped', stop_type=type(error).__name__,
+                       stop_reason=str(error) if isinstance(error, ValueError) else 'unexpected error; inspect hashed task log',
+                       stop_error_sha256=hashlib.sha256(str(error).encode()).hexdigest())
+    finally:
+        summary['end_identity_checks'] = []
+        for binding in bindings:
+            try:
+                unchanged = sha(binding['path']) == binding['sha256']
+            except OSError:
+                unchanged = False
+            summary['end_identity_checks'].append({'sha256': binding['sha256'], 'unchanged': unchanged})
+        save(terminal=True)
+        # A final serialization that crosses the bound cannot preserve success.
+        if time.monotonic() - began > PANEL_CAP:
+            save(terminal=True)
+    print(json.dumps({'status': summary['status'], 'elapsed_seconds': summary['elapsed_seconds'],
+                      'attempted': summary['attempted_fits'], 'unattempted': summary['unattempted_fits']}), flush=True)
+    return 0 if summary['status'] == 'discovery_passed_pending_independent_qualification' else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
