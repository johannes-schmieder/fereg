+use super::*;
+use crate::ols::canonical_products::tests::a2_contrast_fixture;
+
+fn config() -> PreparedOlsFitConfig {
+    let mut config = PreparedOlsFitConfig::default();
+    config.absorb.solver = FeSolverKind::Map;
+    config.absorb.map.tolerance = 1e-10;
+    config.execution.mode = PreparedOlsExecutionMode::Fast;
+    config.execution.threads = crate::options::ThreadConfig::from_requested(1, true).unwrap();
