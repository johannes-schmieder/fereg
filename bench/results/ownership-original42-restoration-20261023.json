  "helper": {
    "sha256": "e288ff7005f1afccecbcabeed00d11d7eb03f80deb8842c68df66dfed1004749",
    "source": "\"\"\"One bounded attempt to recover only the predecessor's exact frozen bytes.\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\n\nTASK = Path(__file__).resolve().parent\nREPO = TASK.parents[2]\nSOURCE = TASK / 'sources/original42-restoration'\nWORK = SOURCE / 'target/tmp/cmg-upgrade'\nGENERATED = WORK / 'generated-inputs'\nOUT = WORK / 'qualification-inputs'\nPYTHON = TASK / 'python-original42/bin/python'\nREPLAY = REPO / 'target/ci/examples/replay'\nGENERATOR = REPO / 'target/ci/examples/replay_large'\nFREEZE = REPO / 'bench/results/two-fe-policy-gates-qualification-freeze-20261022.json'\nRESULT = TASK / 'original42-restoration.json'\nLOG = TASK / 'original42-restoration.log'\n\n\ndef sha(path):\n    value = hashlib.sha256()\n    with Path(path).open('rb') as stream:\n        for block in iter(lambda: stream.read(1 << 20), b''):\n            value.update(block)\n    return value.hexdigest()\n\n\ndef read(path):\n    return json.loads(Path(path).read_text())\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef main():\n    require(not WORK.exists() and not RESULT.exists() and not LOG.exists(), 'restoration already attempted')\n    start = time.monotonic()\n    result = dict(schema=1, status='failed', purpose='Exact original42 byte restoration only',\n                  native_plugin_calls=0,\n                  budgets=dict(total_seconds=2400, input_seconds=300, per_reference_seconds=120,\n                               attempts_per_request=1), commands=[], restored_files={})\n    env = {**os.environ, **{k: '1' for k in ('OPENBLAS_NUM_THREADS', 'OMP_NUM_THREADS',\n                                           'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS', 'VECLIB_MAXIMUM_THREADS')},\n           'PYTHONDONTWRITEBYTECODE': '1', 'LC_ALL': 'C'}\n    with LOG.open('xb') as log:\n        def run(command, limit, label, capture=False):\n            remaining = min(limit, 2400 - (time.monotonic() - start))\n            require(remaining > 0, 'total restoration deadline exhausted')\n            before = time.monotonic()\n            entry = dict(label=label, timeout_s=remaining,\n                         argv=[str(a).replace(str(TASK), '<task>').replace(str(REPO), '<repo>') for a in command])\n            result['commands'].append(entry)\n            process = subprocess.Popen(list(map(str, command)), cwd=SOURCE, env=env,\n                                       stdout=subprocess.PIPE if capture else log,\n                                       stderr=log if capture else subprocess.STDOUT, start_new_session=True)\n            try:\n                captured, _ = process.communicate(timeout=remaining)\n                entry['exit'] = process.returncode\n            except subprocess.TimeoutExpired:\n                os.killpg(process.pid, signal.SIGKILL)\n                entry['exit'] = process.wait()\n                entry['timed_out'] = True\n                raise\n            finally:\n                entry['elapsed_s'] = time.monotonic() - before\n            require(entry['exit'] == 0, label + ' failed')\n            if capture:\n                log.write(captured)\n                return captured\n\n        def admit(path, target=None):\n            target = OUT / path.name if target is None else target\n            actual = sha(path)\n            require(actual == expected[path.name], 'historical hash mismatch: ' + path.name)\n            if path != target:\n                require(not target.exists(), 'refuse overwrite: ' + target.name)\n                os.link(path, target)\n            result['restored_files'][path.name] = dict(sha256=actual, bytes=path.stat().st_size)\n\n        try:\n            source = read(TASK / 'original42-restoration-source.json')\n            freeze = read(FREEZE)\n            plan = freeze['plans']['Darwin']['content']\n            pairs = [(Path(name).name, value) for name, value in plan['files'].items()\n                     if name.startswith('qualification-inputs/')]\n            require(len(pairs) == len({name for name, _ in pairs}), 'duplicate expected filenames')\n            expected = dict(pairs)\n            result.update(source_revision=source['source_revision'], source_manifest=source,\n                          prior_freeze_sha256=sha(FREEZE))\n            versions = json.loads(run([PYTHON, '-c',\n                'import json,numpy,scipy,platform;print(json.dumps(dict(python=platform.python_version(),numpy=numpy.__version__,scipy=scipy.__version__)))'],\n                30, 'historical-environment-check', capture=True))\n            result['environment'] = versions\n            require(versions['numpy'] == '2.2.6' and versions['scipy'] == '1.16.3', 'historical environment differs')\n            for name, value in source['files'].items():\n                require(sha(SOURCE / name) == value, 'restoration source differs: ' + name)\n            binaries = {name: sha(path) for name, path in [('replay', REPLAY), ('replay_large', GENERATOR)]}\n            result['serializer_sha256'] = binaries\n            WORK.mkdir(parents=True)\n            OUT.mkdir()\n            imports = WORK / 'replay-inputs'\n            run([REPLAY, imports], 300, 'independent-replay-import-recovery')\n            command = [PYTHON, SOURCE / 'bench/routing_cases.py', '--seed', '2026105201',\n                       '--output', GENERATED, '--generator', GENERATOR]\n            for family, name in [('no-fe', 'ols-00'), ('one-fe', 'ols-06'), ('slopes', 'ols-22')]:\n                command += ['--source', family + '=' + str(imports / (name + '.case'))]\n            command += ['--low-saved', imports / 'ols-24.case']\n            run(command, 300 - (time.monotonic() - start), 'frozen-42-input-recovery')\n            for item in plan['cases']:\n                family = item['family']\n                admit(GENERATED / (family + '.case'))\n                meta = read(GENERATED / (family + '.json'))\n                retained = freeze['input_metadata'][family]['content']\n                # Restore the historical metadata document, not a new provenance claim.\n                if 'generator_sha256' in meta:\n                    meta['generator_sha256'] = retained['generator_sha256']\n                require(meta == retained, 'reconstructed metadata content differs: ' + family)\n                target = OUT / (family + '.json')\n                raw = (json.dumps(meta, indent=2) + '\\n').encode()\n                require(hashlib.sha256(raw).hexdigest() == expected[target.name],\n                        'historical metadata serialization differs: ' + family)\n                with target.open('xb') as stream:\n                    stream.write(raw)\n                admit(target)\n                if item['oracle']['kind'] == 'replay':\n                    admit(GENERATED / Path(item['oracle']['path']).name)\n            for item in plan['cases']:\n                if item['oracle']['kind'] != 'routing':\n                    continue\n                case = OUT / Path(item['input']).name\n                reference = OUT / Path(item['oracle']['path']).name\n                run([PYTHON, SOURCE / 'bench/routing_oracle.py', '--case', case,\n                     '--output', reference], 120, 'historical-reference-' + item['family'])\n                admit(reference)\n                admit(reference.with_suffix('.npz'))\n            require(set(result['restored_files']) == set(expected), 'restored file coverage differs')\n            for name, value in expected.items():\n                require(sha(OUT / name) == value, 'restored file drift: ' + name)\n            for name, value in source['files'].items():\n                require(sha(SOURCE / name) == value, 'restoration source drift: ' + name)\n            require(binaries == {name: sha(path) for name, path in [('replay', REPLAY), ('replay_large', GENERATOR)]},\n                    'serializer drift')\n            require(time.monotonic() - start <= 2400, 'restoration exceeded declared budget')\n            result['status'] = 'byte_exact_restoration_verified'\n        except BaseException as error:\n            result.update(error_type=type(error).__name__, error=str(error).replace(str(TASK), '<task>'))\n            raise\n        finally:\n            result['elapsed_s'] = time.monotonic() - start\n            log.flush()\n            result['log_sha256'] = sha(LOG)\n            with RESULT.open('x') as stream:\n                json.dump(result, stream, sort_keys=True, indent=2, allow_nan=False)\n                stream.write('\\n')\n    print('ORIGINAL42_EXACT_RESTORATION_COMPLETE', len(result['restored_files']), result['elapsed_s'])\n\n\nif __name__ == '__main__':\n    main()\n"
  },
