+// TASK-LOCAL DIAGNOSTIC ONLY. No solver owner/layout or work ledger changes.
+// Begin/end records include error exits; nested clocks must not be summed.
+pub(crate) struct DiagnosticScope {
+    phase: &'static str,
+    rhs: usize,
+    started: Option<std::time::Instant>,
+}
+impl DiagnosticScope {
+    pub(crate) fn new(phase: &'static str, rhs: usize) -> Self {
+        let started = solver_trace_enabled().then(std::time::Instant::now);
+        if started.is_some() {
+            eprintln!("FEREG_DIAGNOSTIC|event=begin|phase={phase}|rhs={rhs}|thread={:?}", std::thread::current().id());
+        }
+        Self { phase, rhs, started }
+    }
+}
+impl Drop for DiagnosticScope {
+    fn drop(&mut self) {
+        if let Some(started) = self.started {
+            eprintln!("FEREG_DIAGNOSTIC|event=end|phase={}|rhs={}|seconds={:.9}|thread={:?}", self.phase, self.rhs, started.elapsed().as_secs_f64(), std::thread::current().id());
+        }
+    }
+}
