+        prepared,
+        generated,
+        response,
+        weights,
+        divisor,
+        config,
+        allowance,
+        prior_operator_work,
+        obsolete_projection,
+        call,
+    )?;
+    if result.is_some() {
+        return Ok(result);
+    }
+    call.clear_pending();
+    if !reused {
+        return if call.retry && call.spent() {
+            Err(declined())
+        } else {
+            Ok(None)
+        };
+    }
+    call.retire_for_retry();
+    let result = try_build_once(
+        prepared,
+        generated,
+        response,
+        weights,
+        divisor,
+        config,
+        allowance,
+        prior_operator_work,
+        obsolete_projection,
+        call,
+    )?;
+    if result.is_none() {
+        call.clear_pending();
+        if call.spent() {
+            return Err(declined());
+        }
+    }
+    Ok(result)
