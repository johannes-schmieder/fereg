+    #[test]
+    fn h9_pcg_zero_tiny_rhs_exhaustion_and_breakdown() {
+        for scale in [0., 1e-200, 1.] {
+            let mut rhs = [scale, 2. * scale];
+            let mut report = RhsReport::default();
+            let result = pcg(
+                &mut rhs,
+                &mut [0.; 12],
+                1,
+                1e-14,
+                |x, y| y.copy_from_slice(x),
+                |r, z, _| {
+                    z.copy_from_slice(r);
+                    Ok(())
+                },
+                &mut report,
+            );
+            assert!(result.is_ok());
+            assert_eq!(rhs, [scale, 2. * scale]);
+            assert_eq!(report.operator, if scale == 0. { 0 } else { 2 });
+            assert_eq!(report.true_relative, 0.);
+        }
+        let mut report = RhsReport::default();
+        assert!(pcg(
+            &mut [1., 2.],
+            &mut [0.; 12],
+            1,
+            1e-14,
+            |x, y| {
+                y[0] = x[0];
+                y[1] = 4. * x[1]
+            },
+            |r, z, _| {
+                z.copy_from_slice(r);
+                Ok(())
+            },
+            &mut report
+        )
+        .is_err());
+        assert_eq!(report.iterations, 1);
+        assert_eq!(report.operator, 2);
+        let mut report = RhsReport::default();
+        assert!(pcg(
+            &mut [1., 2.],
+            &mut [0.; 12],
+            2,
+            1e-14,
+            |x, y| {
+                for i in 0..2 {
+                    y[i] = -x[i]
+                }
+            },
+            |r, z, _| {
+                z.copy_from_slice(r);
+                Ok(())
+            },
+            &mut report
+        )
+        .is_err());
+        assert_eq!(report.operator, 2);
+        assert!(pcg(
+            &mut [1., 2.],
+            &mut [0.; 12],
+            2,
+            1e-14,
+            |x, y| y.copy_from_slice(x),
+            |r, z, _| {
+                for i in 0..2 {
+                    z[i] = -r[i]
+                }
