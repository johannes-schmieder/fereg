+pub(crate) fn trace(message: String) {
+    if crate::diagnostics::solver_trace_enabled() {
+        crate::diagnostics::emit_solver_trace(&format!("FEREG_SOLVER_TRACE|phase=h9_{message}"));
+    }
+}
