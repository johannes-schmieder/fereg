+    let pairs = args[6].parse::<usize>().map_err(|e| e.to_string())?;
+    if ![1, 4, 16].contains(&workers) || ![0, 3].contains(&pairs) {
+        return Err("workers must be 1,4,16; pairs must be 0 or 3".into());
+    }
+    // The replay already verified original generated order, then rebases the
+    // immutable raw numeric columns to the helper's equivalent coordinate IDs.
+    if current.tags.iter().any(|&tag| tag != 0) {
+        return Err("replay requires exact numeric-column bindings in this bounded capture".into());
+    }
+    let mut old = old;
+    old.columns.clear();
+    old.columns.shrink_to_fit();
