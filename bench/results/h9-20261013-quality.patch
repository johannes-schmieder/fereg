+    current.cache.generated = old.cache.generated.clone();
+    let rho = current
+        .cache
+        .weights
+        .iter()
+        .zip(&old.cache.weights)
+        .map(|(a, b)| (a / b).max(b / a))
+        .fold(1_f64, f64::max);
+    if !rho.is_finite() {
+        return Err("nonfinite producer/current drift".into());
+    }
+    REPLAY.store(true, Ordering::Relaxed);
+    OBSERVE.store(true, Ordering::Relaxed);
+    rayon::ThreadPoolBuilder::new().num_threads(workers).build().map_err(|e|e.to_string())?.install(||{
+        let prepare=Instant::now();
+        let a:Vec<_>=current.cache.a.iter().map(|&x|f64::from(x)).collect();let b:Vec<_>=current.cache.b.iter().map(|&x|f64::from(x)).collect();
+        let (g,h)=if current.cache.left==0{(&a,&b)}else{(&b,&a)};
+        let prepared=super::h9_fixture::prepared(&current.columns[0],&current.columns[1..],g,h);
+        let prepare_seconds=prepare.elapsed().as_secs_f64();
+        println!("H9_REPLAY|workers={workers}|io_s={io_seconds:.17e}|prepare_s={prepare_seconds:.17e}|rho={rho:.17e}|producer_iterative={}|current_iterative={}|current_implicit={}|obsolete_capacity={}",old.cache.iterative,current.cache.iterative,current.implicit,current.obsolete_capacity);
+        let n=current.columns[0].len();let width=current.columns.len();
+        let mut dense=DenseMatrix::zeros(n,width-1).map_err(|e|e.to_string())?;
+        let signature_path=std::path::Path::new(&args[4]).with_file_name(std::path::Path::new(&args[4]).file_name().unwrap().to_string_lossy().replace("quality-","signature-").replace(".bin",".json"));
+        let expected=std::fs::read_to_string(signature_path).map_err(|e|format!("missing certified capture signature: {e}"))?;
+        let (expected_geometry, expected)=expected.trim().strip_prefix("{\"geometry\":\"").and_then(|v|v.strip_suffix("\"}")).and_then(|v|v.split_once("\",\"signature\":\"")).ok_or("invalid capture signature JSON")?;
+        let mut repeat_signatures:[Option<String>;2]=[None,None];
+        let mut baseline:Option<(Vec<f64>,Vec<f64>,Vec<f64>)>=None;
+        for pair in 0..=pairs {
+            let arms=if pairs==0{vec![false]}else if pair%2==0{vec![false,true]}else{vec![true,false]};
+            for candidate in arms {
+                // Existing caller output storage is common. Historical retention
+                // allocations, geometry, solves, native certificate and complete
+                // output reconstruction all fall within this timer.
+                println!("H9_ARM_START|pair={pair}|candidate={candidate}");
+                std::io::Write::flush(&mut std::io::stdout()).map_err(|e|e.to_string())?;
+                OBSERVE.store(pair==0&&!candidate,Ordering::Relaxed);
+                let mut obsolete=Vec::with_capacity(current.obsolete_capacity);
+                *REPORTS.lock().unwrap()=Vec::new();
+                let deadline=Deadline::new();
+                let start=Instant::now();
+                let report_slots=old.cache.components.len()*width;
+                let mut reports=REPORTS.lock().unwrap();reports.clear();reports.try_reserve_exact(report_slots).map_err(|e|e.to_string())?;
+                let diagnostic_bytes=reports.capacity()*size_of::<RhsReport>();drop(reports);
+                let mut retained_bytes=0;
+                if candidate {
+                    if old.cache.bytes()+diagnostic_bytes as u128>current.allowance{return Err("historical cache admission fails".into());}
+                    let cache=Arc::new(old.cache.clone());retained_bytes=cache.bytes();
+                    *ACTIVE.lock().unwrap()=Some(cache);
+                }
+                let allowance=if candidate{current.allowance.checked_sub(diagnostic_bytes as u128).ok_or("diagnostic admission fails")?}else{current.allowance};
+                let result=try_build(&prepared,&current.cache.generated,&current.columns[0],BorrowedMapWeights::Provided(&current.cache.weights),1.,current.config,allowance,current.prior,&mut obsolete);
+                *ACTIVE.lock().unwrap()=None;
+                let mut product=match result {Ok(Some(p))=>p,Ok(None)=>{println!("H9_ARM|pair={pair}|candidate={candidate}|status=declined|seconds={:.17e}|cache_bytes={retained_bytes}",start.elapsed().as_secs_f64());print_reports(pair);return Err("canonical replay declined; no fallback performed".into());},Err(e)=>{println!("H9_ARM|pair={pair}|candidate={candidate}|status=error|seconds={:.17e}|cache_bytes={retained_bytes}",start.elapsed().as_secs_f64());print_reports(pair);return Err(format!("canonical replay error: {e}"));}};
+                if let Err(e)=product.write_dense(&mut dense){println!("H9_ARM|pair={pair}|candidate={candidate}|status=reconstruction_error|seconds={:.17e}|cache_bytes={retained_bytes}",start.elapsed().as_secs_f64());print_reports(pair);return Err(e.to_string());}
+                let seconds=start.elapsed().as_secs_f64();
+                drop(deadline);
+                let signature=product_signature(&product,&dense);
+                let modeled_bytes=(*PEAK.lock().unwrap()).max(product.report.solver_workspace_peak.bytes().ok_or("unmodeled native workspace")? as u128)+retained_bytes+diagnostic_bytes as u128;
+                let independent=independent_certificate(&current,&product.response,&dense);
+                println!("H9_ARM|pair={pair}|warmup={}|candidate={candidate}|status=certified|seconds={seconds:.17e}|cache_bytes={retained_bytes}|diagnostic_bytes={diagnostic_bytes}|modeled_bytes={modeled_bytes}|allowance={}|native_certificate={:.17e}|independent_certificate={independent:.17e}|signature={signature}",pairs!=0&&pair==0,current.allowance,product.report.certificate.relative_infinity_norm);
+                print_reports(pair);
+                if !independent.is_finite()||independent>current.config.tolerance{return Err("independent original-input certificate fails".into());}
+                if modeled_bytes>current.allowance{return Err("total modeled admission exceeds allowance".into());}
+                let arm=usize::from(candidate);
+                if let Some(previous)=&repeat_signatures[arm]{if previous!=&signature{return Err("fixed-worker exact repeatability failed".into());}}else{repeat_signatures[arm]=Some(signature.clone());}
+                if !candidate {
+                    if workers==1&&pair==0 {
+                        if signature!=expected || GEOMETRY.lock().unwrap().as_str()!=expected_geometry{return Err(format!("cold captured identity mismatch: expected {expected_geometry}|{expected}"));}
