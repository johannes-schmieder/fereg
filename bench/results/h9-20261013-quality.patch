+#[path = "../fused_kernels.rs"]
+mod fused_kernels;
+fn main() {
+    fused_kernels::install();
+    if let Err(error) = fereg_core::ols::h9_replay_cli(&std::env::args().collect::<Vec<_>>()) {
+        eprintln!("H9_FAILURE|{error}");
+        std::process::exit(1);
+    }
