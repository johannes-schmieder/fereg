+                    }
+                    if baseline.is_none(){baseline=Some((product.response.clone(),dense.as_slice().to_vec(),product.moments.gram.clone()));}
+                } else if let Some((ref y,ref x,ref gram))=baseline {
+                    let difference=|a:&[f64],b:&[f64]|a.iter().zip(b).map(|(a,b)|(a-b).abs()).fold(0_f64,f64::max);
+                    let mut max_relative=0_f64;
+                    for j in 0..width{
+                        let (sum,reference)=(0..n).fold((0.,0.),|(sum,reference),i|{let (a,b)=if j==0{(product.response[i],y[i])}else{(dense[(i,j-1)],x[i*(width-1)+j-1])};(sum+(a-b).powi(2),reference+b*b)});
+                        let relative=sum.sqrt()/reference.sqrt().max(1.);
+                        if !relative.is_finite(){return Err("nonfinite per-column projection agreement".into());}
+                        max_relative=max_relative.max(relative);
+                    }
+                    let gram_error=difference(&product.moments.gram,gram);
+                    println!("H9_AGREEMENT|pair={pair}|max_column_relative_l2={max_relative:.17e}|normalized_gram_max_abs={gram_error:.17e}");
+                    if !max_relative.is_finite()||max_relative>1e-10||gram_error>1e-11{return Err("frozen projection/Gram agreement witness failed".into());}
+                    println!("H9_COMPARE|pair={pair}|response_max_abs={:.17e}|controls_max_abs={:.17e}|gram_max_abs={:.17e}",difference(&product.response,y),difference(dense.as_slice(),x),difference(&product.moments.gram,gram));
+                }
+            }
+        }
+        Ok(())
+    })
+}
+fn print_reports(pair: usize) {
+    let mut reports = REPORTS.lock().unwrap();
+    reports.sort_by_key(|r| (r.rhs, r.component));
+    for r in reports.iter() {
+        println!("H9_RHS|pair={pair}|rhs={}|component={}|iterations={}|operator_apps={}|preconditioner_apps={}|recurrence_relative={:.17e}|true_relative={:.17e}|recurrence_pass={}",r.rhs,r.component,r.iterations,r.operator,r.preconditioner,r.recurrence_relative,r.true_relative,r.accepted_recurrence);
+    }
+}
+fn independent_certificate(current: &Capture, response: &[f64], dense: &DenseMatrix) -> f64 {
+    // Independent original-row sums; no solver coefficient/recurrence inputs.
+    let n = response.len();
+    let mut maximum = 0_f64;
+    for j in 0..current.columns.len() {
+        let scale = nonzero(
+            current.columns[j]
+                .iter()
+                .map(|v| v.abs())
+                .fold(0_f64, f64::max),
+        );
+        let value = |i: usize| {
+            if j == 0 {
+                response[i] / scale
+            } else {
+                dense[(i, j - 1)] / scale
+            }
+        };
+        let residual_norm = (0..n)
+            .map(|i| current.cache.weights[i] * value(i).powi(2))
+            .sum::<f64>()
+            .sqrt();
+        let original_norm = (0..n)
+            .map(|i| current.cache.weights[i] * (current.columns[j][i] / scale).powi(2))
+            .sum::<f64>()
+            .sqrt();
+        let norm = original_norm.max(residual_norm);
+        if !norm.is_finite() { return f64::INFINITY; }
+        for codes in [&current.cache.a, &current.cache.b] {
+            let count = codes.iter().copied().max().unwrap() as usize + 1;
+            let mut sums = vec![0.; count];
+            let mut mass = vec![0.; count];
+            for i in 0..n {
+                let c = codes[i] as usize;
+                mass[c] += current.cache.weights[i];
+                sums[c] += current.cache.weights[i] * value(i);
+            }
+            for c in 0..count {
+                let score = sums[c].abs() / mass[c].sqrt();
+                if !score.is_finite() { return f64::INFINITY; }
+                let relative = if norm > 0. { score / norm } else if score == 0. { 0. } else { f64::INFINITY };
+                maximum = maximum.max(relative);
+            }
+        }
+    }
+    maximum
+}
+
+struct Deadline(
+    Option<std::sync::mpsc::Sender<()>>,
+    Option<std::thread::JoinHandle<()>>,
+);
+impl Deadline {
+    fn new() -> Self {
+        let (tx, rx) = std::sync::mpsc::channel();
+        let thread = std::thread::spawn(move || {
+            if rx
+                .recv_timeout(std::time::Duration::from_secs(120))
+                .is_err()
+            {
+                eprintln!("H9_FAILURE|per_arm_timeout_120s");
+                std::process::exit(124);
+            }
+        });
+        Self(Some(tx), Some(thread))
+    }
+}
+impl Drop for Deadline {
+    fn drop(&mut self) {
+        if let Some(tx) = self.0.take() {
+            let _ = tx.send(());
+        }
+        if let Some(thread) = self.1.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+pub(super) fn cold_reference(values: &[f64]) -> f64 {
+    if !REPLAY.load(Ordering::Relaxed) {
+        return 0.;
+    }
+    let scale = values.iter().map(|v| v.abs()).fold(0_f64, f64::max);
+    if scale == 0. {
+        0.
+    } else {
+        values
+            .iter()
+            .map(|v| (v / scale).powi(2))
+            .sum::<f64>()
+            .sqrt()
+    }
+}
+pub(super) fn cold_report(
+    rhs: usize,
+    block: &ComponentFactor,
+    iterations: usize,
+    scratch: &[f64],
+    reference: f64,
+    iterative: bool,
+) {
+    if !REPLAY.load(Ordering::Relaxed) {
+        return;
+    }
+    let recurrence = if !iterative {
+        f64::NAN
+    } else if reference == 0. {
+        0.
+    } else {
+        scratch[..block.len]
+            .iter()
+            .map(|v| v * v)
+            .sum::<f64>()
+            .sqrt()
+            / reference
+    };
+    REPORTS.lock().unwrap().push(RhsReport {
+        rhs,
+        component: block.start,
+        iterations,
+        operator: if iterative { iterations } else { 0 },
+        preconditioner: 0,
+        recurrence_relative: recurrence,
+        true_relative: f64::NAN,
+        accepted_recurrence: iterative,
+    });
+}
+
+pub(super) fn memory_peak(bytes:u128){if REPLAY.load(Ordering::Relaxed){*PEAK.lock().unwrap()=bytes;}}
