+struct Capture {
+    tags: Vec<usize>,
+    cache: Cache,
+    columns: Vec<Vec<f64>>,
+    config: MapConfig,
+    allowance: u128,
+    prior: u128,
+    implicit: bool,
+    obsolete_capacity: usize,
+}
+fn read_capture(geometry: &str, quality: &str) -> std::result::Result<Capture, String> {
+    use std::io::Read;
+    struct Reader(std::io::BufReader<std::fs::File>);
+    impl Reader {
+        fn bytes<const N: usize>(&mut self) -> std::result::Result<[u8; N], String> {
+            let mut b = [0; N];
+            self.0.read_exact(&mut b).map_err(|e| e.to_string())?;
+            Ok(b)
+        }
+        fn u(&mut self) -> std::result::Result<usize, String> {
+            usize::try_from(u64::from_le_bytes(self.bytes()?)).map_err(|e| e.to_string())
+        }
+        fn f(&mut self) -> std::result::Result<f64, String> {
+            Ok(f64::from_le_bytes(self.bytes()?))
+        }
+        fn fs(&mut self, n: usize) -> std::result::Result<Vec<f64>, String> {
+            (0..n).map(|_| self.f()).collect()
+        }
+        fn us(&mut self, n: usize) -> std::result::Result<Vec<usize>, String> {
+            (0..n).map(|_| self.u()).collect()
+        }
+        fn codes(&mut self, n: usize) -> std::result::Result<Vec<u32>, String> {
+            (0..n)
+                .map(|_| Ok(u32::from_le_bytes(self.bytes()?)))
+                .collect()
+        }
+        fn end(&mut self) -> std::result::Result<(), String> {
+            let mut b = [0];
+            if self.0.read(&mut b).map_err(|e| e.to_string())? != 0 {
+                Err("trailing capture bytes".into())
+            } else {
+                Ok(())
+            }
+        }
+    }
+    let open = |p: &str| {
+        std::fs::File::open(p)
+            .map(|f| Reader(std::io::BufReader::new(f)))
+            .map_err(|e| e.to_string())
+    };
+    let mut g = open(geometry)?;
+    let n = g.u()?;
+    let q = g.u()?;
+    let k = g.u()?;
+    let weights = g.fs(n)?;
+    let roots = g.fs(q)?;
+    let free = g.us(q)?;
+    let parent = g.us(q)?;
+    let anchors = g.us(q)?;
+    let generated = g.us(k)?;
+    let a = g.codes(n)?;
+    let b = g.codes(n)?;
+    g.end()?;
+    let mut r = open(quality)?;
+    if r.bytes::<8>()? != *b"H9QUAL01" {
+        return Err("quality magic mismatch".into());
+    }
+    let h = r.us(14)?;
+    if h[0] != n || h[2] != q || h[3] != k + 1 {
+        return Err("capture dimension mismatch".into());
+    }
+    let tolerance = r.f()?;
+    let allowance = u128::from_le_bytes(r.bytes()?);
+    let prior = u128::from_le_bytes(r.bytes()?);
+    let tags = r.us(h[3])?;
+    let components = (0..h[6])
+        .map(|_| {
+            Ok(ComponentFactor {
+                start: r.u()?,
+                len: r.u()?,
+                offset: r.u()?,
+                matrix_offset: r.u()?,
+                level_start: r.u()?,
+            })
+        })
+        .collect::<std::result::Result<Vec<_>, String>>()?;
+    let factor = r.fs(h[5])?;
+    let columns = (0..h[3])
+        .map(|_| r.fs(n))
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    r.end()?;
+    if columns
+        .iter()
+        .flatten()
+        .chain(&weights)
+        .any(|v| !v.is_finite())
+        || weights.iter().any(|v| *v <= 0.)
+    {
+        return Err("nonfinite capture".into());
+    }
+    if h[7] > 1
+        || h[8] > 1
+        || h[9] > 1
+        || a.iter().any(|&c| c as usize >= h[1])
+        || b.iter().any(|&c| c as usize >= q)
+    {
+        return Err("invalid capture identities".into());
+    }
+    if components.iter().map(|c| c.len).sum::<usize>() != h[4] {
+        return Err("component dimension mismatch".into());
+    }
+    Ok(Capture {
+        tags,
+        cache: Cache {
+            weights,
+            roots,
+            free,
+            parent,
+            anchors,
+            a,
+            b,
+            generated,
+            components,
+            factor,
+            iterative: h[8] != 0,
+            left: h[7],
+        },
+        columns,
+        config: MapConfig {
+            tolerance,
+            max_iterations: h[10],
+            check_every: h[11],
+            symmetric: h[13] != 0,
+        },
+        allowance,
+        prior,
+        implicit: h[9] != 0,
+        obsolete_capacity: h[12],
+    })
+}
+
+fn hash_values<'a>(values: impl Iterator<Item = &'a f64>) -> u64 {
+    let mut hash = 0xcbf29ce484222325_u64;
+    for value in values {
+        for byte in value.to_bits().to_le_bytes() {
+            hash = (hash ^ u64::from(byte)).wrapping_mul(0x100000001b3);
+        }
+    }
+    hash
+}
+pub(super) fn geometry_signature(roots: &[f64], factor: &[f64], iterative: bool, implicit: bool) {
+    if OBSERVE.load(Ordering::Relaxed) || std::env::var_os("FEREG_H9_QUALITY_DIR").is_some() {
+        *GEOMETRY.lock().unwrap() = format!(
+            "roots={:016x}|factor={:016x}|iterative={iterative}|implicit={implicit}",
+            hash_values(roots.iter()),
+            hash_values(factor.iter())
+        );
+    }
+}
+fn product_signature<P: PreparedOlsFitView + Sync + ?Sized>(
+    product: &Products<'_, P>,
+    dense: &DenseMatrix,
+) -> String {
+    format!("response={:016x}|controls={:016x}|gram={:016x}|scales={:016x}|means={:016x}|norms={:016x}|iterations={}|certificate={:016x}",
+    hash_values(product.response.iter()),hash_values(dense.as_slice().iter()),hash_values(product.moments.gram.iter()),hash_values(product.scales.iter()),hash_values(product.means.iter()),hash_values(product.norms.iter()),product.report.iterations,product.report.certificate.relative_infinity_norm.to_bits())
+}
+pub(super) fn capture_signature<P: PreparedOlsFitView + Sync + ?Sized>(
+    call: usize,
+    product: &mut Products<'_, P>,
+) -> Result<()> {
+    if let Some(dir) = std::env::var_os("FEREG_H9_QUALITY_DIR") {
+        let started = Instant::now();
+        let mut dense = DenseMatrix::zeros(product.design.nobs(), product.columns.len() - 1)?;
+        product.write_dense(&mut dense)?;
+        let text = format!(
+            "{{\"geometry\":\"{}\",\"signature\":\"{}\"}}",
+            GEOMETRY.lock().unwrap().as_str(),
+            product_signature(product, &dense)
+        );
+        std::fs::write(
+            std::path::Path::new(&dir).join(format!("signature-{call}.json")),
+            text,
+        )
+        .map_err(|_| allocation())?;
+        inventory::event(format!(
+            "signature_time|call={call}|seconds={:.17e}|temporary_bytes={}",
+            started.elapsed().as_secs_f64(),
+            dense.as_slice().len() * 8
+        ));
+    }
+    Ok(())
+}
