--- /dev/null
+++ b/crates/fereg-core/src/ols/canonical_products/h9_quality.rs
@@ -0,0 +1,1013 @@
+//! Task-only stale-preconditioner diagnostic. No estimator installs this state.
+use super::*;
+use std::sync::{Arc, Mutex};
+
+static ACTIVE: Mutex<Option<Arc<Cache>>> = Mutex::new(None);
+static REPLAY: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static OBSERVE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static PEAK: Mutex<u128> = Mutex::new(0);
+static GEOMETRY: Mutex<String> = Mutex::new(String::new());
+static REPORTS: Mutex<Vec<RhsReport>> = Mutex::new(Vec::new());
+
+#[derive(Clone)]
+pub(super) struct Cache {
+    pub weights: Vec<f64>,
+    pub roots: Vec<f64>,
+    pub free: Vec<usize>,
+    pub parent: Vec<usize>,
+    pub anchors: Vec<usize>,
+    pub a: Vec<u32>,
+    pub b: Vec<u32>,
+    pub generated: Vec<usize>,
+    pub components: Vec<ComponentFactor>,
+    pub factor: Vec<f64>,
+    pub iterative: bool,
+    pub left: usize,
+}
+impl Cache {
+    pub(super) fn bytes(&self) -> u128 {
+        let f = self.weights.capacity() + self.roots.capacity() + self.factor.capacity();
+        let i = self.free.capacity()
+            + self.parent.capacity()
+            + self.anchors.capacity()
+            + self.generated.capacity();
+        (f * 8
+            + i * size_of::<usize>()
+            + (self.a.capacity() + self.b.capacity()) * 4
+            + self.components.capacity() * size_of::<ComponentFactor>()
+            + size_of::<Self>()
+            + 32) as u128
+    }
+    pub(super) fn validate(
+        &self,
+        weights: &[f64],
+        roots: &[f64],
+        free: &[usize],
+        parent: &[usize],
+        anchors: &[usize],
+        a: &[u32],
+        b: &[u32],
+        generated: &[usize],
+        left: usize,
+    ) -> Result<()> {
+        if self.left != left
+            || self.a != a
+            || self.b != b
+            || self.free != free
+            || self.parent != parent
+            || self.anchors != anchors
+            || self.generated != generated
+            || self.roots.len() != roots.len()
+            || self.weights.len() != weights.len()
+        {
+            return Err(declined());
+        }
+        for (&now, &old) in weights.iter().zip(&self.weights) {
+            if !now.is_finite() || now <= 0. || !old.is_finite() || old <= 0. {
+                return Err(declined());
+            }
+            let ratio = now / old;
+            if !ratio.is_finite() || ratio <= 0. || !(1. / ratio).is_finite() {
+                return Err(declined());
+            }
+        }
+        for (h, &f) in free.iter().enumerate() {
+            if f != usize::MAX {
+                if !roots[h].is_finite()
+                    || roots[h] <= 0.
+                    || !self.roots[h].is_finite()
+                    || self.roots[h] <= 0.
+                {
+                    return Err(declined());
+                }
+                let t = roots[h] / self.roots[h];
+                if !t.is_finite() || t <= 0. {
+                    return Err(declined());
+                }
+            }
+        }
+        Ok(())
+    }
+    fn apply(
+        &self,
+        block: &ComponentFactor,
+        roots: &[f64],
+        input: &[f64],
+        output: &mut [f64],
+        temp: &mut [f64],
+    ) -> Result<()> {
+        let old = self
+            .components
+            .iter()
+            .find(|c| c.start == block.start && c.len == block.len)
+            .ok_or_else(declined)?;
+        let n = block.len;
+        let matrix = self
+            .factor
+            .get(old.offset..old.offset + n * n)
+            .ok_or_else(declined)?;
+        for (h, &f) in self.free.iter().enumerate() {
+            if f != usize::MAX && f >= block.start && f < block.start + n {
+                temp[f - block.start] = roots[h] / self.roots[h];
+            }
+        }
+        for i in 0..n {
+            output[i] = input[i] * temp[i];
+        }
+        inverse_action(matrix, self.iterative, output)?;
+        for i in 0..n {
+            output[i] *= temp[i];
+        }
+        Ok(())
+    }
+}
+
+fn inverse_action(matrix: &[f64], iterative: bool, values: &mut [f64]) -> Result<()> {
+    let n = values.len();
+    if matrix.len() != n * n {
+        return Err(declined());
+    }
+    for i in 0..n {
+        let diagonal = matrix[i * n + i];
+        if !diagonal.is_finite() || diagonal <= 0. {
+            return Err(declined());
+        }
+        for k in 0..i {
+            values[i] -= matrix[i * n + k] * values[k];
+        }
+        values[i] /= diagonal;
+    }
+    if iterative {
+        for i in 0..n {
+            values[i] *= matrix[i * n + i];
+        }
+    }
+    for i in (0..n).rev() {
+        for k in i + 1..n {
+            values[i] -= matrix[k * n + i] * values[k];
+        }
+        values[i] /= matrix[i * n + i];
+    }
+    if values.iter().any(|x| !x.is_finite()) {
+        return Err(declined());
+    }
+    Ok(())
+}
+
+pub(super) fn active() -> Option<Arc<Cache>> {
+    ACTIVE.lock().unwrap().clone()
+}
+
+#[derive(Debug, Clone, Default)]
+struct RhsReport {
+    rhs: usize,
+    component: usize,
+    iterations: usize,
+    operator: usize,
+    preconditioner: usize,
+    recurrence_relative: f64,
+    true_relative: f64,
+    accepted_recurrence: bool,
+}
+
+pub(super) fn solve(
+    cache: &Cache,
+    block: &ComponentFactor,
+    roots: &[f64],
+    rhs: usize,
+    values: &mut [f64],
+    scratch: &mut [f64],
+    maximum: usize,
+    tolerance: f64,
+    apply: impl Fn(&[f64], &mut [f64]),
+) -> Result<usize> {
+    let mut report = RhsReport {
+        rhs,
+        component: block.start,
+        true_relative: f64::NAN,
+        ..RhsReport::default()
+    };
+    let result = pcg(
+        values,
+        scratch,
+        maximum / 2,
+        tolerance,
+        &apply,
+        |r, z, tmp| cache.apply(block, roots, r, z, tmp),
+        &mut report,
+    );
+    REPORTS.lock().unwrap().push(report);
+    result
+}
+
+fn pcg(
+    values: &mut [f64],
+    scratch: &mut [f64],
+    cap: usize,
+    tolerance: f64,
+    apply: impl Fn(&[f64], &mut [f64]),
+    precondition: impl Fn(&[f64], &mut [f64], &mut [f64]) -> Result<()>,
+    report: &mut RhsReport,
+) -> Result<usize> {
+    let n = values.len();
+    if scratch.len() < 6 * n {
+        return Err(declined());
+    }
+    let scale = values.iter().map(|x| x.abs()).fold(0_f64, f64::max);
+    if !scale.is_finite() {
+        return Err(declined());
+    }
+    if scale == 0. {
+        report.accepted_recurrence = true;
+        report.true_relative = 0.;
+        return Ok(0);
+    }
+    let (r, rest) = scratch.split_at_mut(n);
+    let (p, rest) = rest.split_at_mut(n);
+    let (ap, rest) = rest.split_at_mut(n);
+    let (z, rest) = rest.split_at_mut(n);
+    let (original, temp) = rest.split_at_mut(n);
+    let temp = &mut temp[..n];
+    for i in 0..n {
+        original[i] = values[i] / scale;
+        r[i] = original[i];
+    }
+    values.fill(0.);
+    let reference = original.iter().map(|v| v * v).sum::<f64>().sqrt();
+    let target = tolerance * reference;
+    report.recurrence_relative = 1.;
+    let mut result = Err(declined());
+    if cap > 0 {
+        report.preconditioner += 1;
+        let initial = precondition(r, z, temp);
+        let mut energy: f64 = r.iter().zip(z.iter()).map(|(r, z)| r * z).sum();
+        if initial.is_err() || !energy.is_finite() || energy <= 0. {
+            report.operator += 1;
+            apply(values, ap);
+            report.true_relative = original
+                .iter()
+                .zip(ap.iter())
+                .map(|(b, a)| (b - a).powi(2))
+                .sum::<f64>()
+                .sqrt()
+                / reference;
+            return Err(declined());
+        }
+        p.copy_from_slice(z);
+        for iteration in 1..=cap {
+            report.iterations = iteration;
+            report.operator += 1;
+            apply(p, ap);
+            let curvature: f64 = p.iter().zip(ap.iter()).map(|(p, a)| p * a).sum();
+            if !curvature.is_finite() || curvature <= 0. {
+                break;
+            }
+            let alpha = energy / curvature;
+            let hardware = crate::kernels::installed();
+            let square =
+                crate::kernels::dispatch!(hardware, joint_step_energy(alpha, p, ap, values, r));
+            report.recurrence_relative = square.sqrt() / reference;
+            if !square.is_finite() {
+                break;
+            }
+            if square.sqrt() <= target {
+                report.accepted_recurrence = true;
+                result = Ok(iteration);
+                break;
+            }
+            if iteration == cap {
+                break;
+            }
+            report.preconditioner += 1;
+            if precondition(r, z, temp).is_err() {
+                break;
+            }
+            let next: f64 = r.iter().zip(z.iter()).map(|(r, z)| r * z).sum();
+            if !next.is_finite() || next <= 0. {
+                break;
+            }
+            let beta = next / energy;
+            crate::kernels::dispatch!(hardware, affine_direction(beta, z, p));
+            energy = next;
+        }
+    }
+    // Diagnostic exact-current operator check is charged, even on exhaustion.
+    report.operator += 1;
+    apply(values, ap);
+    report.true_relative = original
+        .iter()
+        .zip(ap.iter())
+        .map(|(b, a)| (b - a).powi(2))
+        .sum::<f64>()
+        .sqrt()
+        / reference;
+    for value in values {
+        *value *= scale;
+        if !value.is_finite() {
+            return Err(declined());
+        }
+    }
+    // Native independent original-input FE certificate remains the final gate.
+    result
+}
