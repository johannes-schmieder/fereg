+/// The task binary is the sole caller. No estimation path installs a cache.
+pub fn run_cli(args: &[String]) -> std::result::Result<(), String> {
+    if std::env::var_os("FEREG_H9_DIR").is_some()
+        || std::env::var_os("FEREG_H9_QUALITY_DIR").is_some()
+    {
+        return Err("unset capture directories before replay".into());
+    }
+    if args.len() != 7 {
+        return Err("usage: h9_replay OLD_GEOMETRY OLD_QUALITY CURRENT_GEOMETRY CURRENT_QUALITY WORKERS PAIRS (PAIRS=0 verifies cold identity; 3 runs one warmup plus three pairs)".into());
+    }
+    let io = Instant::now();
+    let old = read_capture(&args[1], &args[2])?;
+    let mut current = read_capture(&args[3], &args[4])?;
+    let io_seconds = io.elapsed().as_secs_f64();
+    if old.implicit {
+        return Err("implicit producer is ineligible".into());
+    }
+    if old.cache.generated != current.cache.generated
+        || old.cache.a != current.cache.a
+        || old.cache.b != current.cache.b
+        || old.cache.left != current.cache.left
