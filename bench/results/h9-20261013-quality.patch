+//! Task-only H9 inventory. Never included in the production checkout.
+use super::ComponentFactor;
+use super::{Column, MapConfig, Plan, PreparedOlsFitView};
+use std::io::{BufWriter, Write};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Instant;
+static CALL: AtomicUsize = AtomicUsize::new(0);
+
+pub(super) fn event(text: String) {
+    if std::env::var_os("FEREG_H9_DIR").is_none() { return; }
+    crate::diagnostics::emit_solver_trace(&format!("FEREG_SOLVER_TRACE|phase=h9_{text}"));
+}
+
+/// Separate replay payload. Geometry captures and their reviewed reader retain
+/// their original layout; these files are only an experimental solver input.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn capture_quality<P: PreparedOlsFitView + ?Sized>(
+    call: usize, plan: &Plan, left: usize, d: usize,
+    columns: &[Column<'_, P>], factor: &[f64], components: &[ComponentFactor],
+    iterative: bool, implicit: bool, config: MapConfig, allowance: u128,
+    prior_work: u128, obsolete_capacity: usize,
+) -> f64 {
+    let Some(dir) = std::env::var_os("FEREG_H9_QUALITY_DIR") else { return 0.; };
+    let started = Instant::now();
+    let path = std::path::Path::new(&dir).join(format!("quality-{call}.bin"));
+    let file = std::fs::OpenOptions::new().write(true).create_new(true)
+        .open(path).expect("H9 quality output");
+    let mut out = BufWriter::with_capacity(65536, file);
+    out.write_all(b"H9QUAL01").expect("H9 quality magic");
+    for value in [plan.n, plan.p, plan.q, plan.width, d, factor.len(), components.len(),
+        left, usize::from(iterative), usize::from(implicit), config.max_iterations,
+        config.check_every, obsolete_capacity, usize::from(config.symmetric)] {
+        out.write_all(&(value as u64).to_le_bytes()).expect("H9 quality header");
+    }
+    out.write_all(&config.tolerance.to_le_bytes()).expect("H9 quality tolerance");
+    for value in [allowance, prior_work] {
+        out.write_all(&value.to_le_bytes()).expect("H9 quality budget");
+    }
+    for column in columns {
+        let tag: u64 = match column {
+            Column::Numeric(_) => 0,
+            Column::Constant(v) if *v == 1. => 1,
+            Column::Constant(v) if *v == 0. => 2,
+            Column::Constant(_) => panic!("unsupported H9 capture constant"),
+            Column::Indicator(..) => 3,
+            Column::Generated(..) => 4,
+        };
+        out.write_all(&tag.to_le_bytes()).expect("H9 quality column tag");
+    }
+    for c in components {
+        for value in [c.start, c.len, c.offset, c.matrix_offset, c.level_start] {
+            out.write_all(&(value as u64).to_le_bytes()).expect("H9 quality component");
+        }
+    }
+    for value in factor {
+        out.write_all(&value.to_le_bytes()).expect("H9 quality factor");
+    }
+    for column in columns {
+        for row in 0..plan.n {
+            out.write_all(&column.value(row).expect("H9 quality column").to_le_bytes())
+                .expect("H9 quality values");
+        }
+    }
+    out.flush().expect("H9 quality flush");
+    started.elapsed().as_secs_f64()
+}
+pub(super) fn begin(n: usize, left: usize, width: usize) -> usize {
+    if std::env::var_os("FEREG_H9_DIR").is_none() { return usize::MAX; }
+    let call = CALL.fetch_add(1, Ordering::Relaxed);
+    event(format!("build|call={call}|rows={n}|left={left}|width={width}"));
+    call
+}
+fn hash_codes(codes: &[u32]) -> u64 {
+    let mut h=0xcbf29ce484222325_u64;
+    for value in codes {
+        for byte in value.to_le_bytes() { h=(h ^ u64::from(byte)).wrapping_mul(0x100000001b3); }
+    }
+    h
+}
+#[allow(clippy::too_many_arguments)]
+pub(super) fn capture(
+    call: usize, weights: &[f64], roots: &[f64], free: &[usize], parent: &[usize],
+    anchors: &[usize], a: &[u32], b: &[u32], generated: &[usize], components: &[ComponentFactor],
+    iterative: bool, implicit: bool, bytes: u128, allowance: u128, factor_capacity: usize,
+    matrix_capacity: usize, krylov_cells: usize, obsolete_capacity: usize,
+) -> f64 {
+    if std::env::var_os("FEREG_H9_DIR").is_none() { return 0.; }
+    let started=Instant::now();
+    if let Some(dir)=std::env::var_os("FEREG_H9_DIR") {
+        let path=std::path::Path::new(&dir).join(format!("geometry-{call}.bin"));
+        let file=std::fs::OpenOptions::new().write(true).create_new(true).open(path).expect("H9 snapshot output");
+        let mut out=BufWriter::with_capacity(65536,file);
+        for value in [weights.len(),roots.len(),generated.len()] { out.write_all(&(value as u64).to_le_bytes()).expect("H9 header"); }
+        for values in [weights,roots] {
+            for value in values {out.write_all(&value.to_le_bytes()).expect("H9 values");}
+        }
+        for values in [free,parent,anchors,generated] {
+            for value in values {out.write_all(&(*value as u64).to_le_bytes()).expect("H9 coordinates");}
+        }
+        for codes in [a,b] { for value in codes { out.write_all(&value.to_le_bytes()).expect("H9 codes"); } }
+        out.flush().expect("H9 flush");
+    }
+    let dims: Vec<_>=components.iter().map(|c| c.len).collect();
+    event(format!("geometry|call={call}|rows={}|q={}|iterative={iterative}|implicit={implicit}|phase_bytes={bytes}|allowance={allowance}|factor_capacity={factor_capacity}|matrix_capacity={matrix_capacity}|krylov_cells={krylov_cells}|obsolete_capacity={obsolete_capacity}|a_hash={:016x}|b_hash={:016x}|dimensions={dims:?}", weights.len(), roots.len(),hash_codes(a),hash_codes(b)));
+    started.elapsed().as_secs_f64()
+}
