  "runner_source": "\"\"\"One user-approved practical Mac check; existing science, no extra verifier.\"\"\"\nimport copy\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport statistics\nimport subprocess\nimport sys\nimport time\n\nTASK = Path(__file__).resolve().parent\nSOURCE = TASK/'sources/qualification-eligibility-repair'\nWORK = SOURCE/'target/tmp/ownership-cells'\nPLAN = WORK/'qualification-practical-Darwin.json'\nOUTPUT = WORK/'practical-qualification-Darwin'\n\n\ndef modules():\n    sys.path.insert(0, str(SOURCE/'bench'))\n    import qualify as q\n    original_validate = q.ownership.validate\n    def validate(value):\n        assert value['platform'] == 'Darwin' and value['blocks'] == 2 and value['budget_s'] == 1800\n        prior = copy.deepcopy(value)\n        prior.update(blocks=24, budget_s=14400)\n        original_validate(prior)\n    q.ownership.validate = validate\n    return q\n\n\ndef prepare():\n    q = modules()\n    original = q.read(WORK/'qualification-Darwin.json')\n    plan = copy.deepcopy(original)\n    plan.update(blocks=2, budget_s=1800)\n    plan['mac_cell_policy'] = q.fresh_mac_policy(plan)\n    q.ownership.validate(plan)\n    q.validate_cell_policy(plan)\n    assert plan['mac_cell_policy']['new_call_cap'] == 870\n    assert not PLAN.exists() and not OUTPUT.exists()\n    q.write(PLAN, plan)\n    print('Prepared 58 settings / 870 calls / 1800 seconds / zero retries')\n\n\ndef run():\n    q = modules()\n    plan = q.read(PLAN)\n    result = q.run(PLAN, OUTPUT, 0, 0, False)\n    rows = []\n    complete = result['status'] == 'complete' and not result['failures']\n    if complete:\n        assert len(result['cases']) == 58 and result['native_calls_started'] == 870\n        for cell in result['cases']:\n            for reference in ('original', 'incumbent'):\n                scores = [q.score(block['calls'], reference, 'candidate') for block in cell['blocks']]\n                excess = statistics.median(s['excess_s'] for s in scores)\n                rows.append(dict(case=cell['id'], reference=reference,\n                    median_ratio=statistics.median(s['ratio'] for s in scores),\n                    median_excess_s=excess, status='passed' if excess <= 0 else 'slowdown'))\n    summary = dict(status=('passed' if all(r['status']=='passed' for r in rows) else 'needs_discussion') if complete else 'failed',\n        interpretation='Practical paired median regression check, not a desktop confidence-bound claim.',\n        calls=result.get('native_calls_started',0), cells=len(result['cases']),\n        elapsed_s=result['elapsed_s'], failures=result['failures'], comparisons=rows,\n        retries=0, blocks=2, allowance='max(5%, 1 ms)',\n        result_sha256=q.digest(OUTPUT/'run-0-0/results.json'))\n    q.write(OUTPUT/'summary.json', summary)\n    print(json.dumps(summary, sort_keys=True), flush=True)\n    return 0 if summary['status']=='passed' else 1\n\n\ndef launch():\n    log = TASK/'practical-mac.log'\n    receipt = TASK/'practical-mac-execution.json'\n    assert PLAN.exists() and not OUTPUT.exists() and not log.exists() and not receipt.exists()\n    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', OPENBLAS_NUM_THREADS='1', OMP_NUM_THREADS='1',\n        MKL_NUM_THREADS='1', VECLIB_MAXIMUM_THREADS='1', NUMEXPR_NUM_THREADS='1', LC_ALL='C', PYTHONUNBUFFERED='1')\n    env.pop('FEREG_TEST_THREADS',None)\n    start = time.monotonic()\n    with log.open('xb') as stream:\n        process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'run'], cwd=SOURCE,\n            env=env, stdout=stream, stderr=subprocess.STDOUT, start_new_session=True)\n        try:\n            code = process.wait(timeout=1860)\n        except subprocess.TimeoutExpired:\n            import signal\n            os.killpg(process.pid,signal.SIGTERM)\n            try: process.wait(timeout=5)\n            except subprocess.TimeoutExpired:\n                os.killpg(process.pid,signal.SIGKILL);process.wait()\n            code = 124\n    with receipt.open('x') as stream:\n        json.dump(dict(exit_code=code,elapsed_s=time.monotonic()-start,retries=0,calls_cap=870),stream,indent=2)\n    return code\n\n\nif __name__ == '__main__':\n    mode = sys.argv[1]\n    if mode == 'prepare': prepare()\n    elif mode == 'launch': raise SystemExit(launch())\n    elif mode == 'run': raise SystemExit(run())\n    else: raise SystemExit('prepare | launch | run')\n",
