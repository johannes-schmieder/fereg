+#!/usr/bin/env python3
+"""Six bounded Auto captures of a task-only geometry observer; no route changes."""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import signal
+import subprocess
+import sys
+import time
+sys.dont_write_bytecode = True
+from study_extract import child, digest, require, save
+from f2_checkpoint_diagnostic import rewrite, traces
+CASES = ('ols-three-dense-1m', 'ols-three-dense-4m', 'ols-three-sparse-1m')
+WORKERS = (1, 16)
+BUDGET = 600
+TIMEOUT = 120
+
+
+def geometry(log):
+    lines = log.read_text(errors='replace').splitlines() if log.exists() else []
+    selected = [line for line in lines if line.startswith('FEREG_F2_GEOMETRY|')]
+    parsed = []
+    for line in selected:
+        fields = dict(part.split('=', 1) for part in line.split('|')[1:])
+        for key, value in list(fields.items()):
+            if key in ('call', 'pair', 'rows', 'rhs', 'workers', 'lanes', 'available_bytes',
+                       'scratch_bytes', 'count_visits', 'clear_visits', 'sum_count_squared',
+                       'weighted_count_sum', 'numerator', 'denominator'):
+                fields[key] = int(value)
+            elif key.endswith('_s') or key in ('coherence_upper', 'bound1', 'bound2', 'bound3', 'bound4'):
+                fields[key] = float(value)
+                require(math.isfinite(fields[key]) and fields[key] >= 0, 'invalid geometry diagnostic')
+        parsed.append(fields)
+    return {'lines': selected, 'events': parsed}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True)
+    for name in ('plugin', 'harness', 'bindings', 'reference', 'manifest'):
+        parser.add_argument('--' + name, type=Path, required=True)
+        parser.add_argument('--' + name + '-sha256', required=True)
+    parser.add_argument('--cases', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    require(platform.system() == 'Linux' and sys.byteorder == 'little', 'SCC binary protocol required')
+    require(os.environ.get('JOB_ID', '').isdigit() and int(os.environ.get('NSLOTS', '0')) >= 16,
+            'requires SCC compute allocation, 16 reserved slots')
+    for name in ('plugin', 'harness', 'bindings', 'reference', 'manifest'):
+        require(digest(getattr(args, name)) == getattr(args, name + '_sha256'), name + ' hash mismatch')
+    declared = json.loads(args.manifest.read_text())
+    for section in ('probe_source_sha256', 'source_support_sha256'):
+        require(bool(declared.get(section)), 'missing source manifest section: ' + section)
+        for name, expected in declared[section].items():
+            require(digest(child(args.source, name)) == expected, 'source manifest mismatch: ' + name)
+    require(bool(declared.get('support_sha256')), 'missing support manifest')
+    for name, expected in declared['support_sha256'].items():
+        require(digest(child(args.manifest.parent, name)) == expected, 'support manifest mismatch: ' + name)
+    require(digest(child(args.manifest.parent, 'f2-geometry.patch')) == declared['patch_sha256'],
+            'patch manifest mismatch')
+    require(declared['tests']['status'] == 'passed' and declared['tests']['sys_flags_optimize'] == 0,
+            'non-optimized independent witnesses required')
+    sys.path.insert(0, str(args.source / 'bench'))
+    sys.path.insert(0, str(args.source / 'scripts'))
+    from native_io import case_header, diagnostics, load_json, validate_result
+    from replay_plugins import exact_view, differences
+    bindings = load_json(args.bindings.read_text())
+    for name, expected in bindings['evidence_sha256'].items():
+        require(digest(child(args.source, name)) == expected, 'retained evidence hash mismatch')
+    reference = load_json(args.reference.read_text())
+    anchors = {(r['case'], r['workers']): r for r in reference['records']
+               if r['arm'] == 'auto' and r['status'] == 'completed_capture'}
+    require(set(anchors) == {(c, w) for c in CASES for w in WORKERS}, 'six completed Auto anchors required')
+    specs = {Path(s['case']).stem: s for s in bindings['cases']}
+    manifest = args.cases / 'manifest.json'
+    require((args.cases / 'EXTRACTION_COMPLETE').read_text().strip() == digest(manifest), 'manifest sentinel mismatch')
+    extracted = load_json(manifest.read_text())
+    require(extracted['status'] == 'complete_hash_identical'
+            and extracted['bindings_sha256'] == args.bindings_sha256, 'incomplete extraction')
+    args.output.mkdir(parents=True, exist_ok=False)
+    records = [{'case': c, 'workers': w, 'arm': 'auto', 'status': 'unattempted'} for c in CASES for w in WORKERS]
+    summary = {'schema': 1, 'status': 'running', 'purpose': __doc__, 'planned_calls': 6,
+               'budget_s': BUDGET, 'per_fit_timeout_s': TIMEOUT, 'warmups': 0, 'repetitions': 1, 'retries': 0,
+               'host': {'platform': platform.platform(), 'job_id': os.environ['JOB_ID'], 'slots': os.environ['NSLOTS']},
+               'bindings': {name: getattr(args, name + '_sha256') for name in ('plugin', 'harness', 'bindings', 'reference', 'manifest')},
+               'support_sha256': {p.name: digest(p) for p in (Path(__file__), Path(__file__).with_name('study_extract.py'),
+                    Path(__file__).with_name('f2_checkpoint_diagnostic.py'), args.source/'bench/native_io.py',
+                    args.source/'scripts/replay_plugins.py')},
+               'extraction_manifest_sha256': digest(manifest), 'records': records,
+               'limitations': ['Task-only geometry observation; no default route or numerical acceptance change.',
+                    'Bounds concern exact arithmetic for true unit weights and one common global constant only.',
+                    'One cold traced call per request; no repeat or performance qualification.',
+                    'Geometry is recomputed for primary and final residual; both actual costs are charged in this observer. A future selector could first apply an unchanged full initial certificate and avoid geometry for already accepted inputs; that route and cost are not tested here.',
+                    'Scratch is dropped before original solver setup; trace reports additional temporary capacity. Public RMEMORY is unchanged.',
+                    'Closing clock includes prior trace writes; native fit timing also includes the closing write.']}
+    active = None
+    began = time.monotonic()
+    def persist():
+        summary['elapsed_s'] = time.monotonic() - began
+        save(args.output/'summary.json', summary)
+    def expire(*unused):
+        raise TimeoutError('600-second geometry panel budget exhausted')
+    signal.signal(signal.SIGALRM, expire)
+    signal.setitimer(signal.ITIMER_REAL, BUDGET)
+    try:
+        for case in CASES:
+            require(digest(child(args.cases, specs[case]['case'])) == specs[case]['sha256'], 'frozen case mismatch')
+        persist()
+        for record in records:
+            stem = record['case']+'-t'+str(record['workers'])
+            request, result, log = [args.output/(stem+s) for s in ('.case', '.json', '.log')]
+            anchor = anchors[record['case'], record['workers']]
+            spec = specs[record['case']]
+            shape, body, changes = rewrite(child(args.cases, spec['case']), request, record['workers'], 'auto', case_header)
+            require(body == anchor['body_sha256'] and spec['sha256'] == anchor['input_sha256'], 'anchor input mismatch')
+            request_sha = digest(request)
+            require(request_sha == anchor['request_sha256'], 'exact Auto request mismatch')
+            record.update(status='running', request_sha256=request_sha, input_sha256=spec['sha256'], body_sha256=body, argument_changes=changes)
+            persist()
+            remaining = BUDGET-(time.monotonic()-began)
+            if remaining <= 0: raise TimeoutError('geometry budget exhausted before call')
+            env = dict(os.environ, FEREG_PHASE_TIMING='1', FEREG_SOLVER_TRACE='1', RAYON_NUM_THREADS=str(record['workers']))
+            for name in ('FEREG_F1_STUDY_CAPTURE', 'FEREG_SOLVER_TRACE_FILE', 'LLVM_PROFILE_FILE'):
+                env.pop(name, None)
+            started = time.monotonic()
+            try:
+                with log.open('w') as stream:
