+//! TASK-ONLY adapter. No selector, numerical result, solver report or memory-plan mutation.
+use super::{
+    study_f2_geometry::{self as probe, Partition},
+    BorrowedMapWeights,
+};
+use crate::fe::{BorrowedInterceptEffect, BorrowedInterceptFeDesign};
+use crate::memory::FeSolverMemoryBudget;
+use std::{
+    sync::atomic::{AtomicUsize, Ordering},
+    time::Instant,
+};
+
+impl Partition for BorrowedInterceptEffect<'_> {
+    fn levels(&self) -> usize {
+        self.n_levels()
+    }
+    fn members(&self, level: usize) -> &[usize] {
+        self.level_index().members(level)
+    }
+    fn code(&self, row: usize) -> usize {
+        self.codes()[row] as usize
+    }
+}
+
+pub(super) fn observe(
+    design: &BorrowedInterceptFeDesign<'_>,
+    weights: BorrowedMapWeights<'_>,
+    rhs: usize,
+    budget: Option<FeSolverMemoryBudget>,
+) {
+    if option_env!("FEREG_F2_GEOMETRY") != Some("1") || !crate::diagnostics::solver_trace_enabled()
+    {
+        return;
+    }
+    static CALL: AtomicUsize = AtomicUsize::new(0);
+    let call = CALL.fetch_add(1, Ordering::Relaxed) + 1;
+    let started = Instant::now();
+    let available = budget.map_or(u128::MAX, |b| {
+        b.usable_bytes.saturating_sub(b.execution_bytes)
+    });
+    let result = if weights == BorrowedMapWeights::Unit {
+        probe::inspect(design.effects(), design.nobs(), available)
+    } else {
+        Err("unsupported_weights")
+    };
+    let elapsed = started.elapsed().as_secs_f64();
+    match result {
+        Ok(report) => {
+            for (pair, p) in report.pairs.iter().enumerate() {
+                eprintln!("FEREG_F2_GEOMETRY|call={call}|pair={pair}|sum_count_squared={}|weighted_count_sum={}|numerator={}|denominator={}|coherence_upper={:.17e}|counting_clearing_s={:.9}", p.sum_count_squared,p.weighted_count_sum,p.numerator,p.denominator,p.coherence_upper,p.counting_clearing_s);
+            }
+            eprintln!("FEREG_F2_GEOMETRY|call={call}|status=observed|rows={}|rhs={rhs}|workers={}|lanes=1|available_bytes={available}|scratch_bytes={}|count_visits={}|clear_visits={}|allocation_s={:.9}|marginal_s={:.9}|bound_s={:.9}|feature_s={:.9}|adapter_s={elapsed:.9}|bound1={:.17e}|bound2={:.17e}|bound3={:.17e}|bound4={:.17e}|model=exact_arithmetic_unit_global_constant",design.nobs(),rayon::current_num_threads(),report.scratch_bytes,report.count_visits,report.clear_visits,report.allocation_s,report.marginal_s,report.bound_s,report.total_s,report.map_bounds[0],report.map_bounds[1],report.map_bounds[2],report.map_bounds[3]);
+        }
+        Err(reason) => eprintln!("FEREG_F2_GEOMETRY|call={call}|status=abstained|reason={reason}|rows={}|rhs={rhs}|workers={}|lanes=1|adapter_s={elapsed:.9}",design.nobs(),rayon::current_num_threads()),
+    }
+    // The closing trace includes all prior probe trace writes; its own final
+    // write is the only unclocked instrumentation. Native timing includes it.
+    eprintln!(
+        "FEREG_F2_GEOMETRY|call={call}|status=closed|including_prior_output_s={:.9}",
+        started.elapsed().as_secs_f64()
+    );
+}
