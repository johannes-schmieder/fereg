+                # a lossless transport conversion, not numeric regeneration.
+                hex_bytes = binascii.hexlify(values.astype('>f8').tobytes())
+                wire = np.empty((end - start, 17), dtype=np.uint8)
+                wire[:, :16] = np.frombuffer(hex_bytes, dtype=np.uint8).reshape(-1, 16)
+                wire[:, 16] = 10
