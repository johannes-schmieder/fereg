+#[path = "f2-geometry-source/crates/fereg-core/src/fe/borrowed_map/study_f2_geometry.rs"]
+mod geometry;
+use geometry::Partition;
+struct Owned {
+    codes: Vec<usize>,
+    groups: Vec<Vec<usize>>,
+}
+impl Partition for Owned {
+    fn levels(&self) -> usize {
+        self.groups.len()
+    }
+    fn members(&self, level: usize) -> &[usize] {
+        &self.groups[level]
+    }
+    fn code(&self, row: usize) -> usize {
+        self.codes[row]
+    }
+}
+fn main() {
+    let args = std::env::args().collect::<Vec<_>>();
+    let text = std::fs::read_to_string(&args[1]).unwrap();
+    let parts = text
+        .lines()
+        .map(|line| {
+            let codes = line
+                .split_whitespace()
+                .map(|x| x.parse::<usize>().unwrap())
+                .collect::<Vec<_>>();
+            let mut groups = vec![vec![]; codes.iter().max().unwrap() + 1];
+            for (row, &code) in codes.iter().enumerate() {
+                groups[code].push(row);
+            }
+            Owned { codes, groups }
+        })
+        .collect::<Vec<_>>();
+    let rows = if args.get(2).is_some_and(|s| s == "overflow") {
+        i32::MAX as usize + 1
+    } else {
+        parts[0].codes.len()
+    };
+    let available = if args.get(2).is_some_and(|s| s == "memory") {
+        0
+    } else {
+        u128::MAX
+    };
+    match geometry::inspect(&parts, rows, available) {
+        Err(e) => println!("{{\"error\":\"{e}\"}}"),
+        Ok(r) => {
+            print!("{{\"scratch_bytes\":{},\"count_visits\":{},\"clear_visits\":{},\"allocation_s\":{},\"marginal_s\":{},\"bound_s\":{},\"total_s\":{},\"pairs\":[",r.scratch_bytes,r.count_visits,r.clear_visits,r.allocation_s,r.marginal_s,r.bound_s,r.total_s);
+            for (i, p) in r.pairs.iter().enumerate() {
+                if i != 0 {
+                    print!(",");
+                }
+                print!("{{\"sum_count_squared\":{},\"weighted_count_sum\":{},\"numerator\":{},\"denominator\":{},\"coherence_upper\":{:.17e},\"counting_clearing_s\":{}}}",p.sum_count_squared,p.weighted_count_sum,p.numerator,p.denominator,p.coherence_upper,p.counting_clearing_s);
+            }
+            println!(
+                "],\"bounds\":[{:.17e},{:.17e},{:.17e},{:.17e}]}}",
+                r.map_bounds[0], r.map_bounds[1], r.map_bounds[2], r.map_bounds[3]
+            );
+        }
+    }
+}
