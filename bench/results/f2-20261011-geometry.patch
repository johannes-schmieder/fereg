+    # in the frozen transport. PPML's four-row RSEP capacity stays unchanged.
+    require(shape[0] == 100 and shape[1] == spec['columns'] + (6 if spec['poisson'] else 5),
+            'original B template shape mismatch')
+    require(arguments[0] == (b'estimate-ppml' if spec['poisson'] else b'estimate-ols'),
+            'template estimator mismatch')
+    original = dict(value.split(b'=', 1) for value in arguments[1:])
+    require(len(original) == len(arguments) - 1, 'duplicate template argument')
