+#!/usr/bin/env python3
+import hashlib, importlib.util, json, subprocess, sys, time
+from pathlib import Path
+from fractions import Fraction
+if sys.flags.optimize != 0:
+ raise RuntimeError('independent assertion witnesses require sys.flags.optimize == 0')
+began=time.monotonic()
+root=Path(__file__).resolve().parent
+ref=root/'f2-geometry-source/crates/fereg-oracle/examples/f2_geometry_reference.py'
+spec=importlib.util.spec_from_file_location('reference',ref)
+reference=importlib.util.module_from_spec(spec);spec.loader.exec_module(reference)
+fixtures=[
+ ('independent',[[r%2,(r//2)%2,(r//4)%2] for r in range(32)]),
+ ('truncated',[[r%3,(r//3)%3,(r//9)%3] for r in range(37)]),
+ ('weak_connected',[[int(r>=32),int(r>=32) ^ int(r in (0,32)),r%2] for r in range(64)]),
+ ('disconnected',[[2*(r//16)+(r%2),2*(r//16)+(r//2)%2,2*(r//16)+(r//4)%2] for r in range(32)]),
+ ('unequal',[[r%3,(r//3)%4,(r//12)%2] for r in range(41)]),
+ ('constant_effect',[[0,r%2,(r//2)%3] for r in range(32)]),
+ ('extra_pair_intersection',[[r//4%2,r//4%2,r%2] for r in range(32)]),
+ ('label_permutation',[[2-r%3,2-(r//3)%3,2-(r//9)%3] for r in range(37)]),
+]
+output=root/'f2-geometry-feature-results.json'
+records=[]
+for name,rows in fixtures:
+ codes=[list(column) for column in zip(*rows)]
+ path=root/'f2-geometry-feature-input.txt';path.write_text('\n'.join(' '.join(map(str,c)) for c in codes)+'\n')
+ raw=subprocess.check_output([str(root/'f2-geometry-feature-probe'),str(path)],text=True)
+ result=json.loads(raw)
+ for observed,(i,j) in zip(result['pairs'],[(0,1),(0,2),(1,2)]):
+  expected=reference.pair_reference(codes,i,j)
+  assert all(observed[k]==v for k,v in expected.items()), (name,expected,observed)
+  assert Fraction(observed['coherence_upper'])**2 >= min(Fraction(1),Fraction(expected['numerator'],expected['denominator']))
+ reference.exact_projection_witness(codes,result['bounds'])
+ assert result['count_visits']==len(rows)*3 and result['clear_visits']==len(rows)*3
+ records.append({'case':name,'rows':len(rows),'status':'passed','features':result})
+ print(name,'passed',flush=True)
+for mode,error in [('memory','scratch_budget'),('overflow','unsupported_dimensions')]:
+ result=json.loads(subprocess.check_output([str(root/'f2-geometry-feature-probe'),str(path),mode],text=True))
+ assert result=={'error':error},result
+ records.append({'case':mode,'status':'passed','result':result})
+path.unlink()
+sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
+output.write_text(json.dumps({'status':'passed','sys_flags_optimize':sys.flags.optimize,'verification_elapsed_s':time.monotonic()-began,'synthetic_geometry_cases':8,'additional_admission_cases':2,'native_estimation_calls':0,'source_sha256':sha(root/'f2-geometry-source/crates/fereg-core/src/fe/borrowed_map/study_f2_geometry.rs'),'reference_sha256':sha(ref),'records':records},indent=2)+'\n')
+print('FEATURE_TESTS_COMPLETE',sha(output))
