+              if (match := re.fullmatch(r'NATIVE_SECONDS=([0-9.]+)', line))]
+    require(len(native) <= 1, 'multiple native calls in one request')
+    return {'lines': captured, 'map_checkpoints': checkpoints, 'parse_errors': parse_errors,
+            'final_residual_observed': any(x['call_role'] == 'final_residual' for x in checkpoints),
+            'native_call_s': native[0] if native else None}
+
+
+def retained_science(data, column_hash, record, evidence):
+    changes = []
+    for name in ('RSTATUS', 'RFIT', 'RDOF', 'RCERT', 'RREC'):
+        packed = evidence['wire_matrices'][record['wire_matrix_refs'][name]]
+        reference = {'rows': packed['rows'], 'columns': packed['columns'],
+                     'bits': [packed['ieee64_hex'][i:i + 16]
+                              for i in range(0, len(packed['ieee64_hex']), 16)]}
+        if data['matrices'][name] != reference:
+            changes.append(name)
+    if column_hash != record['columns_sha256']:
+        changes.append('binary_columns')
+    return changes
+
+
+def compare_routes(left, right, numbers):
+    errors, details = [], {}
+    for name in ('RSTATUS', 'RDOF', 'RFE', 'RCLUSTER', 'RSUBSET', 'RMARKB', 'RMARKV'):
+        if left['matrices'][name] != right['matrices'][name]:
