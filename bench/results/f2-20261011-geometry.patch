+//! TASK-ONLY unit-weight geometry measurement. Never selects or accepts a solve.
+use std::time::Instant;
+
+pub trait Partition {
+    fn levels(&self) -> usize;
+    fn members(&self, level: usize) -> &[usize];
+    fn code(&self, row: usize) -> usize;
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Pair {
+    pub sum_count_squared: u128,
+    pub weighted_count_sum: u128,
+    pub numerator: u128,
+    pub denominator: u128,
+    pub coherence_upper: f64,
+    pub counting_clearing_s: f64,
+}
+
+#[derive(Debug)]
+pub struct Report {
+    pub pairs: [Pair; 3],
+    pub map_bounds: [f64; 4],
+    pub scratch_bytes: usize,
+    pub allocation_s: f64,
+    pub marginal_s: f64,
+    pub bound_s: f64,
+    pub total_s: f64,
+    pub count_visits: usize,
+    pub clear_visits: usize,
+}
+
+type Result<T> = std::result::Result<T, &'static str>;
+fn add(a: u128, b: u128) -> Result<u128> {
+    a.checked_add(b).ok_or("integer_overflow")
+}
+fn mul(a: u128, b: u128) -> Result<u128> {
+    a.checked_mul(b).ok_or("integer_overflow")
+}
+fn sub(a: u128, b: u128) -> Result<u128> {
+    a.checked_sub(b).ok_or("invalid_integer_cancellation")
+}
+fn up(x: f64) -> f64 {
+    if x == 0.0 {
+        0.0
+    } else {
+        f64::from_bits(x.to_bits() + 1)
+    }
+}
+fn down(x: f64) -> f64 {
+    f64::from_bits(x.to_bits() - 1)
+}
+fn plus(a: f64, b: f64) -> f64 {
+    up(a + b)
+}
+fn times(a: f64, b: f64) -> f64 {
+    up(a * b)
+}
+
+pub fn integer_bound(numerator: u128, denominator: u128) -> Result<f64> {
+    if denominator == 0 {
+        return Err("zero_denominator");
+    }
+    if numerator == 0 {
+        return Ok(0.0);
+    }
+    // Each integer cast is nearest-rounded; one adjacent float encloses it.
+    // Positive normal inputs here avoid underflow and signed-zero concerns.
+    let ratio = up(up(numerator as f64) / down(denominator as f64));
+    // Centered conditional expectations are contractions, hence coherence<=1.
+    Ok(up(ratio.sqrt()).min(1.0))
+}
+
+pub fn propagate(a: f64, b: f64, c: f64) -> [f64; 4] {
+    // All pairs remove the same GLOBAL constant only. Extra pair intersections
+    // remain. Start after R1 with both other block moments <= original RHS norm.
+    // For R2 R3 R2 R1: u=a+bc+ac², v=b+ac and
+    // B=[[au,av],[c³+bu,c²+bv]]. Every positive operation rounds outward.
+    let cc = times(c, c);
+    let u = plus(plus(a, times(b, c)), times(a, cc));
+    let v = plus(b, times(a, c));
+    let matrix = [
+        [times(a, u), times(a, v)],
+        [plus(times(c, cc), times(b, u)), plus(cc, times(b, v))],
+    ];
+    let mut moment = [1.0, 1.0];
+    std::array::from_fn(|_| {
+        moment = [
+            plus(
+                times(matrix[0][0], moment[0]),
+                times(matrix[0][1], moment[1]),
+            ),
+            plus(
+                times(matrix[1][0], moment[0]),
+                times(matrix[1][1], moment[1]),
+            ),
+        ];
+        moment[0].max(moment[1])
+    })
+}
+
+pub fn inspect<P: Partition>(parts: &[P], rows: usize, available: u128) -> Result<Report> {
+    let started = Instant::now();
+    if parts.len() != 3 || rows == 0 || rows > i32::MAX as usize {
+        return Err("unsupported_dimensions");
+    }
+    if parts.iter().any(|p| p.levels() == 0 || p.levels() > rows) {
+        return Err("unsupported_levels");
+    }
+    let indices = [(0, 1), (0, 2), (1, 2)];
+    let size = indices
+        .iter()
+        .map(|&(i, j)| parts[i].levels().min(parts[j].levels()))
+        .max()
+        .unwrap();
+    let requested = size
+        .checked_mul(std::mem::size_of::<u64>())
+        .ok_or("size_overflow")?;
+    // Probe scratch is released before existing solver setup. Its actual capacity
+    // is checked against the same parent-inclusive budget, never published as
+    // ordinary solver memory or allowed to change the fit's admission outcome.
+    if requested as u128 > available {
+        return Err("scratch_budget");
+    }
+    let allocation_started = Instant::now();
+    let mut counts = Vec::<u64>::new();
+    counts
+        .try_reserve_exact(size)
+        .map_err(|_| "scratch_allocation")?;
+    let scratch_bytes = counts.capacity().checked_mul(8).ok_or("size_overflow")?;
+    if scratch_bytes as u128 > available {
+        return Err("scratch_capacity_budget");
+    }
+    counts.resize(size, 0);
+    let allocation_s = allocation_started.elapsed().as_secs_f64();
+    let marginal_started = Instant::now();
+    let mut marginal_square = [0_u128; 3];
+    let mut minimum = [u128::MAX; 3];
+    for (i, part) in parts.iter().enumerate() {
+        let mut total = 0_usize;
+        for level in 0..part.levels() {
+            let count = part.members(level).len();
+            if count == 0 {
+                return Err("empty_group");
+            }
+            total = total.checked_add(count).ok_or("size_overflow")?;
+            marginal_square[i] = add(marginal_square[i], mul(count as u128, count as u128)?)?;
+            minimum[i] = minimum[i].min(count as u128);
+        }
+        if total != rows {
+            return Err("membership_shape");
+        }
+    }
+    let marginal_s = marginal_started.elapsed().as_secs_f64();
+    let mut pairs = [Pair::default(); 3];
+    let mut bound_s = 0.0;
+    for (slot, &(i, j)) in indices.iter().enumerate() {
+        let (outer, inner) = if parts[i].levels() >= parts[j].levels() {
+            (&parts[i], &parts[j])
+        } else {
+            (&parts[j], &parts[i])
+        };
+        let work_started = Instant::now();
+        let mut squares = 0_u128;
+        let mut weighted = 0_u128;
+        for level in 0..outer.levels() {
+            let members = outer.members(level);
+            let a = members.len() as u128;
+            for &row in members {
+                if row >= rows {
+                    return Err("invalid_member");
+                }
+                let b = inner.code(row);
+                if b >= inner.levels() {
+                    return Err("invalid_code");
+                }
+                squares = add(squares, add(mul(2, counts[b] as u128)?, 1)?)?;
+                counts[b] = counts[b].checked_add(1).ok_or("count_overflow")?;
+                weighted = add(weighted, mul(a, inner.members(b).len() as u128)?)?;
+            }
+            // Clear by actual membership, including repeated keys. No scan of
+            // the full contingency rectangle and no generation/tag allocation.
+            for &row in members {
+                counts[inner.code(row)] = 0;
+            }
+        }
+        let counting_clearing_s = work_started.elapsed().as_secs_f64();
+        let bound_started = Instant::now();
+        let nn = mul(rows as u128, rows as u128)?;
+        let numerator = sub(
+            add(
+                mul(nn, squares)?,
+                mul(marginal_square[i], marginal_square[j])?,
+            )?,
+            mul(mul(2, rows as u128)?, weighted)?,
+        )?;
+        let denominator = mul(mul(nn, minimum[i])?, minimum[j])?;
+        let coherence_upper = integer_bound(numerator, denominator)?;
+        pairs[slot] = Pair {
+            sum_count_squared: squares,
+            weighted_count_sum: weighted,
+            numerator,
+            denominator,
+            coherence_upper,
+            counting_clearing_s,
+        };
+        bound_s += bound_started.elapsed().as_secs_f64();
+    }
+    let bound_started = Instant::now();
+    let map_bounds = propagate(
+        pairs[0].coherence_upper,
+        pairs[1].coherence_upper,
+        pairs[2].coherence_upper,
+    );
+    bound_s += bound_started.elapsed().as_secs_f64();
+    drop(counts);
+    Ok(Report {
+        pairs,
+        map_bounds,
+        scratch_bytes,
+        allocation_s,
+        marginal_s,
+        bound_s,
+        total_s: started.elapsed().as_secs_f64(),
+        count_visits: rows * 3,
+        clear_visits: rows * 3,
+    })
+}
