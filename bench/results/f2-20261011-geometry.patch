+sys.dont_write_bytecode = True
+from study_extract import child, digest, require, save
+
+CASES = ('ols-three-dense-1m', 'ols-three-dense-4m', 'ols-three-sparse-1m')
+WORKERS = (1, 16)
+BUDGET = 600
+FIT_TIMEOUT = 60
+
+
+def rewrite(source, destination, workers, arm, case_header):
+    with source.open('rb') as stream, destination.open('xb') as output:
+        shape, arguments = case_header(stream)
+        require(arguments[0] == b'estimate-ols', 'F2 requires OLS')
+        before = dict(value.split(b'=', 1) for value in arguments[1:])
+        require(len(before) == len(arguments) - 1, 'duplicate input arguments')
+        for name, value in ((b'solver', b'auto'), (b'preconditioner', b'auto'),
+                            (b'iterate', b'16000'), (b'threads', b'1')):
+            require(before[name] == value, 'unexpected frozen request: ' + name.decode())
+        replacements = {b'threads': str(workers).encode()}
+        if arm == 'map':
+            replacements.update({b'solver': b'map', b'preconditioner': b'off', b'iterate': b'4'})
+        changed = [arguments[0]]
+        for raw in arguments[1:]:
+            key = raw.split(b'=', 1)[0]
+            changed.append(key + b'=' + replacements[key] if key in replacements else raw)
+        output.write(b'FEREG_REPLAY_V1\n' + (' '.join(map(str, shape)) + '\n').encode())
+        for raw in changed:
+            output.write(str(len(raw)).encode() + b'\n' + raw + b'\n')
+        body = hashlib.sha256()
+        for block in iter(lambda: stream.read(1 << 20), b''):
+            body.update(block)
+            output.write(block)
+    return shape, body.hexdigest(), {key.decode(): value.decode() for key, value in replacements.items()}
+
+
+def traces(log):
+    lines = log.read_text(errors='replace').splitlines() if log.exists() else []
+    captured = [line for line in lines if line.startswith(('FEREG_PHASE|', 'FEREG_SOLVER_TRACE|'))]
+    checkpoints, parse_errors = [], []
+    for line in captured:
+        if not line.startswith('FEREG_SOLVER_TRACE|phase=map_checkpoint|'):
+            continue
+        try:
+            fields = dict(part.split('=', 1) for part in line.split('|')[1:])
+            for key in ('pid', 'map_call', 'rows', 'rhs', 'effects', 'term_slots', 'workers',
+                        'iteration', 'max_iterations', 'check_every', 'passed'):
+                fields[key] = int(fields[key])
+            for key in ('elapsed_s', 'validation_s', 'setup_s', 'sweep_s', 'certificate_s',
+                        'checkpoint_certificate_s', 'prior_trace_output_s', 'tolerance',
+                        'relative_infinity', 'relative_two'):
+                fields[key] = float(fields[key])
+                require(math.isfinite(fields[key]), 'nonfinite checkpoint diagnostic')
+            fields['elapsed_excluding_prior_trace_s'] = fields['elapsed_s'] - fields['prior_trace_output_s']
+            fields['certificate_kind'] = ('initial_may_be_rejection_screen' if fields['iteration'] == 0
+                                          else 'full_post_sweep_certificate')
+            checkpoints.append(fields)
+        except (ValueError, KeyError) as error:
+            parse_errors.append(str(error))
+    calls = list(dict.fromkeys(point['map_call'] for point in checkpoints))
+    for point in checkpoints:
+        point['call_role'] = ('primary' if point['map_call'] == calls[0] and point['rhs'] > 1 else
+            'final_residual' if len(calls) > 1 and point['map_call'] == calls[1] and point['rhs'] == 1 else
+            'unclassified')
