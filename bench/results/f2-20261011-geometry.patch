+"""Independent exact-rational contingency and explicit projection witnesses.
+
+Task-only; does not copy the probe's cancellation identity or moment recurrence.
+"""
+from fractions import Fraction as F
+
+
+def pair_reference(codes, i, j):
+    n = len(codes[0])
+    a = [codes[i].count(level) for level in range(max(codes[i])+1)]
+    b = [codes[j].count(level) for level in range(max(codes[j])+1)]
+    contingency = [[sum(x == row and y == col for x, y in zip(codes[i], codes[j]))
+                    for col in range(len(b))] for row in range(len(a))]
+    numerator = sum((n*contingency[row][col]-a[row]*b[col])**2
+                    for row in range(len(a)) for col in range(len(b)))
+    denominator = n*n*min(a)*min(b)
+    return dict(numerator=numerator, denominator=denominator,
+                sum_count_squared=sum(c*c for row in contingency for c in row),
+                weighted_count_sum=sum(contingency[row][col]*a[row]*b[col]
+                                       for row in range(len(a)) for col in range(len(b))))
+
+
+def exact_projection_witness(codes, bounds):
+    n = len(codes[0])
+    # Build each dense residual-maker matrix independently and apply it using
+    # exact fractions. No estimated contraction or floating error allowance.
+    matrices = []
+    for code in codes:
+        sizes = [code.count(level) for level in range(max(code)+1)]
+        matrices.append([[F(int(i == j))-(F(1, sizes[code[i]]) if code[i] == code[j] else F(0))
+                          for j in range(n)] for i in range(n)])
+    for raw in ([i % 7-3 for i in range(n)], [int(i == n//2) for i in range(n)]):
+        vector = list(map(F, raw))
+        norm_squared = sum(x*x for x in vector)
+        for bound in bounds:
+            for effect in (0, 1, 2, 1, 0):
+                vector = [sum(a*b for a,b in zip(row, vector)) for row in matrices[effect]]
+            for code in codes:
+                for level in range(max(code)+1):
+                    members = [i for i, c in enumerate(code) if c == level]
+                    moment = sum(vector[i] for i in members)
+                    relative_squared = moment*moment / (len(members)*norm_squared)
+                    assert relative_squared <= F(bound)**2, (relative_squared, bound)
