+#!/usr/bin/env python3
+"""Twelve predeclared SCC F2 captures; no default-route or tolerance change."""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import platform
+import re
+import signal
+import subprocess
+import sys
+import time
