+        for index, (x, y) in enumerate(zip(numbers(a), numbers(b))):
+            if name == 'RFIT' and index % 2 == 0:
+                if a['bits'][index] != b['bits'][index]:
+                    errors.append(name + ': presence difference at ' + str(index))
+                continue
+            if not math.isfinite(x) or not math.isfinite(y) or max(abs(x), abs(y)) >= 8e307:
+                if a['bits'][index] != b['bits'][index]:
+                    errors.append(name + ': nonnumeric bits differ at ' + str(index))
+                continue
+            fraction = abs(x - y) / (atol + rtol * max(abs(x), abs(y)))
+            maximum = max(maximum, fraction)
+            if fraction > 1:
+                errors.append(name + ': bound failed at ' + str(index))
+        details[name] = {'rtol': rtol, 'atol': atol, 'maximum_fraction_of_bound': maximum}
+    return {'errors': errors, 'numerical_bounds': details}
+
+
