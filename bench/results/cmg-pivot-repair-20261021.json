{
 "schema": 1,
 "date": "2026-10-21",
 "purpose": "One focused generic pivot-selection repair of the shared canonical raw-edge introsort (ninther on large partitions). Correctness, counted-work and replay evidence only; no timing, profile or claim.",
 "revisions": {
  "cmg_parent": "355d328a33639b5fa50c3c1954c8ee62e59e6b20",
  "cmg_repair": "aaf6ec4c6b88b69c58024cc18f60e6abd5754a5a",
  "fereg_base": "04d99221cc32acd1c52f3d0f03756d64f52dc8e2",
  "pins": "crates/fereg-core/Cargo.toml, Cargo.lock and fuzz/Cargo.lock pin aaf6ec4c"
 },
 "formulation": {
  "rule": "partitions of more than 40 records: Tukey ninther (Bentley and McIlroy 1993); s = len/8, last = len-1, m = last/2; median of medians of (0,s,2s), (m-s,m,m+s), (last-2s,last-s,last). 17..40 records: median of first, middle, last (explicit median using at most three comparisons, same value).",
  "unchanged": "insertion cutoff 16, depth limit 2 log2(n) with heapsort fallback, fork threshold 16,384, lane ceiling, comparator (endpoint key, total_cmp weight), duplicate reduction, hierarchy thresholds",
  "counting": "pivot selection conservatively charged after it runs: 192 units for at most twelve comparisons (ninther), or 48 for at most three (median of three), at 16 units per possible comparison; within one 1,024-unit segment; the 65,536-unit query cadence is unchanged",
  "unpolled_bound": "at most 65,535 + 1,024 counted units between queries, plus one uncounted bounded segment: 64 partition steps, one pivot selection (at most twelve comparisons, nine record copies), one insertion record or one heap step; team lanes also query on every node entry",
  "scope": "arithmetic-preserving: final order, duplicate reduction and every successful downstream scientific bit unchanged; pivot sampling and the resulting partition tree change work counts and query positions; cadence, boundedness and worker-ceiling independence remain"
 },
