  "request_wire": "1.4",
  "result_wire": "1.1",
  "action_protocol": "1.5",
  "candidate_routes": [
    "map",
    "cg",
    "lsmr",
    "cmg",
    "cmg_fused",
    "lsmr_legacy_diagonal",
