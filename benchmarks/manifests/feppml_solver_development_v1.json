  "lsmr_preconditioners": ["diagonal", "schwarz"],
  "experiment_environment": "FEREG_PPML_EXPERIMENTAL_SOLVERS=1",
  "fixed_policy": {
    "memory": "fast",
    "separation": "none_after_all_positive_outcome_oracle",
    "absorbed_effects": "two_or_three_categorical_intercept_only",
    "cmg_fused_three_fe_nuisance_columns_max": 64,
    "saved_fixed_effects": false,
    "allocation_audit": false,
