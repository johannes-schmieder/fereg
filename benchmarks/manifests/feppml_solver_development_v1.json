    "ordinary_frame_solver": "fused CMG or fused/joint LSMR only between canonical checkpoints",
    "strict_coefficient_scope": "all estimable frozen-basis coefficients; nonestimable normalization coordinates are ignored and replaced by the canonical strict state",
    "automatic_fallback": "fused CMG only: retry failed projected RHS once, then same-frame MAP on numerical nonconvergence; other arms fail closed",
    "timed_trace": false,
    "warmups": 1,
    "local_repetitions": 3,
    "scc_repetitions": 5
  },
  "science": {
    "coefficient_rtol": 1e-7,
    "coefficient_atol": 1e-10,
    "vce_rtol": 1e-6,
    "vce_atol": 1e-9,
    "degrees_of_freedom": "exact native-route decomposition; comparator total model DoF and derived residual DoF",
    "likelihood_rtol": 1e-8,
    "likelihood_atol": 1e-10,
    "sample_must_match": true,
    "certificate_must_pass": true,
    "oracle_arms": ["map", "ppmlhdfe", "independent_explicit_dummy"]
  },
