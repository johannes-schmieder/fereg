+/// Two local buffers for the pinned larger-block elimination. Categorical
+/// factors retain the smaller block; signed covers keep their previous bound.
+fn schwarz_local_scratch_values(levels: u128, maximum_levels: u128, signed_cover: bool) -> Result<u128> {
+    let payload = if signed_cover {
+        checked_mul(maximum_levels, 10, "signed Schwarz local scratch")?
+    } else {
+        // Every pair's smaller block is bounded by both the largest FE and
+        // the total levels outside it. This remains true for pairs that do
+        // not contain the largest FE and for disconnected subcomponents.
+        let others = levels.checked_sub(maximum_levels)
+            .ok_or_else(|| FeregError::new(ErrorCode::InvalidArgument,
+                "Schwarz maximum FE level count exceeds total levels"))?;
+        let kept = maximum_levels.min(others);
+        checked_sum(&[
+            checked_mul(maximum_levels, 2, "Schwarz eliminated-block scratch")?,
+            checked_mul(kept, 4, "Schwarz kept-block scratch")?,
+        ])?
+    };
+    // Preserve two possible grounding entries in each local buffer.
+    checked_add_memory(payload, 4, "Schwarz local scratch grounding")
+}
