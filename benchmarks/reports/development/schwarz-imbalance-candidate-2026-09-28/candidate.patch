+    #[test]
+    fn categorical_schwarz_scratch_bounds_every_oriented_component() {
+        // Count the upstream local buffers from component dimensions, rather
+        // than from the aggregate envelope used by the estimator.
+        for a in 1..=8_u128 {
+            for b in 1..=8_u128 {
+                for c in 0..=8_u128 {
+                    let counts = [a, b, c];
+                    let bound = schwarz_local_scratch_values(a + b + c, a.max(b).max(c), false).unwrap();
+                    for left in 0..3 {
+                        for right in left + 1..3 {
+                            for q in 1..=counts[left] {
+                                for r in 1..=counts[right] {
+                                    // Local input + smaller reduced system +
+                                    // two grounding entries, in each buffer.
+                                    let component = 2 * (q + r + q.min(r) + 2);
+                                    assert!(component <= bound, "{counts:?}: {q} x {r}");
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn schwarz_scratch_preserves_signed_balanced_and_overflow_boundaries() {
+        for total in 1..=128 {
+            for maximum in 1..=total {
+                assert_eq!(schwarz_local_scratch_values(total, maximum, true).unwrap(), 10 * maximum + 4);
+                let plain = schwarz_local_scratch_values(total, maximum, false).unwrap();
+                assert!(plain <= 6 * maximum + 4);
+                if maximum <= total - maximum {
+                    assert_eq!(plain, 6 * maximum + 4);
+                }
+            }
+        }
+        assert!(schwarz_local_scratch_values(1, 2, false).is_err());
+        assert!(schwarz_local_scratch_values(u128::MAX, u128::MAX, false).is_err());
+        assert!(schwarz_local_scratch_values(u128::MAX, u128::MAX, true).is_err());
+    }
+
+    #[test]
+    fn imbalanced_categorical_lsmr_admits_complete_workspace_under_restricted_budget() {
+        let model = crate::memory::estimate_fe_solver_memory(
+            3_932_160, 11, &[1_966_080, 49_152], 4, Some(4)).unwrap();
+        let execution = 4 * 1024_u128.pow(3);
+        let fits = crate::memory::FeSolverMemoryBudget {
+            execution_bytes: execution,
+            usable_bytes: crate::memory::usable_memory_bytes(Some(192 * 1024_u128.pow(3))).unwrap(),
+        };
+        assert!(fits.fits(model.lsmr_schwarz_bytes));
+        let too_small = crate::memory::FeSolverMemoryBudget {
+            usable_bytes: crate::memory::usable_memory_bytes(Some(128 * 1024_u128.pow(3))).unwrap(),
+            ..fits
+        };
+        assert!(!too_small.fits(model.lsmr_schwarz_bytes));
+    }
