+fn fill_generated_column_tile<P: PreparedOlsFitView + ?Sized>(
+    prepared: &P,
+    kind: &crate::ols::PreparedOlsColumnKind,
+    start: usize,
+    values: &mut [f64],
+) -> Result<()> {
+    use crate::ols::PreparedOlsColumnKind;
+    let end = start + values.len();
+    let invalid = || {
+        FeregError::new(
+            ErrorCode::InvalidArgument,
+            "generated predictor columns are not aligned and finite",
+        )
+    };
+    match kind {
+        PreparedOlsColumnKind::Intercept => values.fill(1.0),
+        PreparedOlsColumnKind::Continuous {
+            prepared_source_index,
+            ..
+        } => {
+            let source = prepared
+                .fit_sample()
+                .regressors
+                .get(*prepared_source_index)
+                .and_then(|source| source.get(start..end))
+                .ok_or_else(invalid)?;
+            values.copy_from_slice(source);
+        }
+        PreparedOlsColumnKind::Categorical {
+            categorical_source_index,
+            level_code,
+            ..
+        } => {
+            if let Some(level) = level_code {
+                let codes = prepared.fit_categorical_codes(*categorical_source_index)?;
+                let codes = codes.get(start..end).ok_or_else(invalid)?;
+                for (target, code) in values.iter_mut().zip(codes) {
+                    *target = f64::from(code == level);
+                }
+            } else {
+                values.fill(0.0);
+            }
+        }
+        PreparedOlsColumnKind::CategoricalInteraction { components } => {
+            values.fill(1.0);
+            for component in components {
+                let Some(level) = component.level_code else {
+                    values.fill(0.0);
+                    break;
+                };
+                let codes = prepared.fit_categorical_codes(component.categorical_source_index)?;
+                let codes = codes.get(start..end).ok_or_else(invalid)?;
+                for (target, code) in values.iter_mut().zip(codes) {
+                    if *code != level {
+                        *target = 0.0;
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Reuse generated recipes while retaining the prepared layout's original
+/// absent-indicator arithmetic and generated-column accumulation order.
+fn subtract_raw_columns<P: PreparedOlsFitView + ?Sized>(
+    prepared: &P,
+    coefficients: &[Option<f64>],
+    residuals: &mut [f64],
+    skip_absent_indicators: bool,
+) -> Result<()> {
+    use crate::ols::PreparedOlsColumnKind;
+    let model = prepared.fit_model();
+    let rows = prepared.fit_sample().n_active();
+    if residuals.len() != rows
+        || coefficients.len() != model.columns.len()
+        || coefficients.iter().flatten().any(|c| !c.is_finite())
+    {
+        return Err(FeregError::new(
+            ErrorCode::InvalidArgument,
+            "generated raw residual columns are not aligned and finite",
+        ));
+    }
+    if rows < 4096
+        || model.columns.len() < 8
+        || !model.columns.iter().any(|c| {
+            matches!(
+                c.kind,
+                PreparedOlsColumnKind::Categorical { .. }
+                    | PreparedOlsColumnKind::CategoricalInteraction { .. }
+            )
+        })
+    {
+        for (column, coefficient) in coefficients.iter().enumerate() {
+            if let Some(coefficient) = coefficient {
+                prepared.fit_subtract_raw_column(column, *coefficient, residuals)?;
+            }
+        }
+        return Ok(());
+    }
+    const TILE_ROWS: usize = 128;
+    let fill = |(tile, destination): (usize, &mut [f64])| -> Result<()> {
+        let mut tile_values = [0.0_f64; TILE_ROWS];
+        let values = &mut tile_values[..destination.len()];
+        for (column, coefficient) in coefficients.iter().enumerate() {
+            let Some(coefficient) = coefficient else {
+                continue;
+            };
+            let kind = &model.columns[column].kind;
+            fill_generated_column_tile(prepared, kind, tile * TILE_ROWS, values)?;
+            let skip = skip_absent_indicators
+                && matches!(
+                    kind,
+                    PreparedOlsColumnKind::Categorical { .. }
+                        | PreparedOlsColumnKind::CategoricalInteraction { .. }
+                );
+            if skip {
+                for (target, value) in destination.iter_mut().zip(values.iter()) {
+                    if *value != 0.0 {
+                        *target = (-*coefficient).mul_add(*value, *target);
+                    }
+                }
+            } else {
+                for (target, value) in destination.iter_mut().zip(values.iter()) {
+                    *target = (-*coefficient).mul_add(*value, *target);
+                }
+            }
+        }
+        if destination.iter().any(|v| !v.is_finite()) {
+            return Err(FeregError::new(
+                ErrorCode::InvalidData,
+                "generated raw residual is not finite",
+            ));
+        }
+        Ok(())
+    };
+    if rayon::current_thread_index().is_some() && rayon::current_num_threads() > 1 {
+        residuals
+            .par_chunks_mut(TILE_ROWS)
+            .enumerate()
+            .try_for_each(fill)?;
+    } else {
+        residuals
+            .chunks_mut(TILE_ROWS)
+            .enumerate()
+            .try_for_each(fill)?;
+    }
+    Ok(())
+}
