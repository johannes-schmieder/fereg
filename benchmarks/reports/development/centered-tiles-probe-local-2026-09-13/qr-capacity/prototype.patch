+#[cfg(test)]
+fn assert_centered_finalization<P: PreparedOlsFitView + ?Sized>(
+    prepared: &P,
+    bound: &BoundCenteredFrame<'_>,
+    mut qr: QrFit,
+    config: PreparedOlsFitConfig,
+) {
+    let frame = bound.frame;
+    let expected = fit_with_controls_internal_mode_with_frame(
+        prepared,
+        frame,
+        config,
+        &mut SystemFitReservation,
+        FitPerturbations::default(),
+        false,
+        MAX_FAST_SCORE_CACHE_BYTES,
+        None,
+        None,
+    )
+    .unwrap();
+    let mut raw_residuals =
+        build_independent_raw_residuals(prepared, frame.response(), &qr, &mut SystemFitReservation)
+            .unwrap();
+    let bread = finalize_reported_bread_and_intercept(
+        prepared,
+        frame.response(),
+        &mut qr,
+        Some(&mut raw_residuals),
+        frame.weights,
+        config.bread_tolerance,
+        &mut SystemFitReservation,
+        FitPerturbations::default(),
+        None,
+        Some(&bound.raw),
+    )
+    .unwrap();
+    assert!(bread.certificate().passed);
+    assert_eq!(bread.coordinates(), expected.bread().coordinates());
+    assert_eq!(bread.weight_scale(), expected.bread().weight_scale());
+    for (actual, expected) in bread.values().iter().zip(expected.bread().values()) {
+        assert!((actual - expected).abs() <= 1e-10 + 1e-6 * expected.abs());
+    }
+    let coefficients = build_coefficient_slots(prepared, &qr, &mut SystemFitReservation).unwrap();
+    for (actual, expected) in coefficients.iter().zip(expected.coefficients()) {
+        assert_eq!(actual.status, expected.status);
+        match (actual.value, expected.value) {
+            (Some(a), Some(b)) => assert!((a - b).abs() <= 1e-10 + 1e-7 * b.abs()),
+            (None, None) => {}
+            _ => panic!("reported coefficient presence changed"),
+        }
+    }
+    let residuals = DenseMatrix::from_row_major(
+        frame.response().len(),
+        1,
+        qr.within_residuals.take().unwrap(),
+    )
+    .unwrap();
+    // A final residual is a warm candidate. Keep the established independent
+    // FE certificate/polish instead of assuming that centered inputs suffice.
+    let residuals = prepared
+        .fit_absorb_matrix(frame.raw_weights(), residuals, config.absorb)
+        .unwrap();
+    assert!(residuals.report().certified());
+    for (actual, expected) in residuals
+        .residualized()
+        .as_slice()
+        .iter()
+        .zip(expected.residuals())
+    {
+        assert!((actual - expected).abs() <= 1e-9 + 1e-7 * expected.abs());
+    }
+    let corrupted_draft = FiniteScoreDraft {
+        infinity_scale: qr.finite_score.infinity_scale,
+        square_sum_scale: qr.finite_score.square_sum_scale,
+        moments: qr.finite_score.moments,
+    };
+    let score = certify_scores(
+        prepared,
+        residuals.residualized().as_slice(),
+        frame.weights,
+        &bound.raw.norms[1..],
+        &bound.within_norms[1..],
+        qr.finite_score,
+        &qr.generated_statuses,
+        bound.within_norms[0],
+        config.score_tolerance,
+    )
+    .unwrap();
+    assert!(score.passed);
+    // Supply the valid finite draft with an independently corrupted final
+    // residual. Raw-row checks must reject it despite the earlier solve pass.
+    let mut corrupted = residuals.residualized().as_slice().to_vec();
+    for (row, value) in corrupted.iter_mut().enumerate() {
+        *value += 0.25 * bound.columns.raw_value(row, 1);
+    }
+    let rejection = certify_scores(
+        prepared,
+        &corrupted,
+        frame.weights,
+        &bound.raw.norms[1..],
+        &bound.within_norms[1..],
+        corrupted_draft,
+        &qr.generated_statuses,
+        bound.within_norms[0],
+        config.score_tolerance,
+    );
+    assert!(rejection.is_err() || !rejection.unwrap().passed);
+    let within_ss = bound.within_norms[0].mul_add(bound.within_norms[0], 0.0)
+        * bread.weight_scale().reference_weight_multiplier;
+    assert_eq!(
+        within_ss,
+        expected.initial_absorbed_outcome_sum_of_squares()
+    );
+    assert_eq!(qr.rank, expected.finite_rank());
+}
