+#[test]
+fn centered_saved_outputs_recover_final_state_without_initial_coefficient_products() {
+    use crate::fe::{LsmrConfig, MapConfig};
+    let n = 260;
+    let delta = [-2.0, -1.0, 1.0, 2.0];
+    let noise = [1.0, -1.0, -1.0, 1.0];
+    let groups: Vec<f64> = (0..n).map(|i| ((i / 4) % 4) as f64).collect();
+    let x: Vec<f64> = (0..n).map(|i| 2.0_f64.powi(14) + delta[i % 4]).collect();
+    let y: Vec<f64> = (0..n)
+        .map(|i| 1e4 + 5.0 * groups[i] + 3.0 * delta[i % 4] + noise[i % 4])
+        .collect();
+    let w: Vec<f64> = (0..n).map(|i| 1.0 + groups[i]).collect();
+    for kind in 0..4 {
+        for deficient in [false, true] {
+            let xs = if deficient {
+                vec![x.clone(), x.clone()]
+            } else {
+                vec![x.clone()]
+            };
+            let weights = match kind {
+                1 => TestWeights::Frequency(&w),
+                2 => TestWeights::Analytic(&w),
+                3 => TestWeights::Probability(&w),
+                _ => TestWeights::Unit,
+            };
+            let (mut request, mut loaded) = super::tests::prepared_inputs(
+                &y,
+                &xs,
+                &vec![false; xs.len()],
+                Some(&groups),
+                true,
+                weights,
+            );
+            request.keep_singletons = false;
+            // Drop a whole contrast block, preserving the independent slope
+            // oracle but changing the FE normalization weights and row map.
+            loaded.candidate[..4].fill(false);
+            let prepared = crate::prepare_categorical_ols_data(&request, &loaded).unwrap();
+            let mut config = PreparedOlsFitConfig::default();
+            config.execution.threads =
+                ThreadConfig::from_requested(if deficient { 4 } else { 1 }, false).unwrap();
+            let actual =
+                with_centered_ols(&prepared, config, None, 8 << 20, u64::MAX, |fit, _| Ok(fit))
+                    .unwrap()
+                    .unwrap();
+            assert!(actual.recovered_fe_coefficients().is_none());
+            assert!(actual.fast_score_cache.is_none());
+            let mut retained_config = config;
+            retained_config.absorb.retain_coefficients = true;
+            let baseline =
+                fit_prepared_categorical_ols_coefficients_map(&prepared, retained_config).unwrap();
+            // Existing one-FE automatic dispatch takes the non-retaining direct
+            // MAP entry even when retention was requested. Preserve that fact.
+            assert!(baseline.recovered_fe_coefficients().is_none());
+            retained_config.absorb.solver = FeSolverKind::Map;
+            let retained =
+                fit_prepared_categorical_ols_coefficients_map(&prepared, retained_config).unwrap();
+            assert!(retained.recovered_fe_coefficients().is_some());
+            assert_eq!(actual.finite_rank(), 1);
+            assert_eq!(actual.finite_rank(), baseline.finite_rank());
+            assert!((actual.coefficients()[0].value.unwrap() - 3.0).abs() < 1e-10);
+            let target = |fit: &CertifiedPreparedOlsFit| -> Vec<f64> {
+                (0..prepared.sample().n_active())
+                    .map(|row| {
+                        let mut xb = 0.0;
+                        for coefficient in fit.coefficients() {
+                            if let (Some(column), Some(value)) =
+                                (coefficient.generated_column_index, coefficient.value)
+                            {
+                                xb = value
+                                    .mul_add(prepared.fit_column_value(column, row).unwrap(), xb);
+                            }
+                        }
+                        prepared.sample().outcome[row] - xb - fit.residuals()[row]
+                    })
+                    .collect()
+            };
+            let target_actual = target(&actual);
+            let target_baseline = target(&baseline);
+            let target_retained = target(&retained);
+            let active: Vec<usize> = (4..n).collect();
+            assert_eq!(prepared.sample().retained_rows(), active);
+            let sum: f64 = active
+                .iter()
+                .map(|&i| if kind == 0 { 1.0 } else { w[i] })
+                .sum();
+            let mean_alpha = active
+                .iter()
+                .map(|&i| 5.0 * groups[i] * if kind == 0 { 1.0 } else { w[i] })
+                .sum::<f64>()
+                / sum;
+            let oracle: Vec<f64> = active
+                .iter()
+                .map(|&i| 5.0 * groups[i] - mean_alpha)
+                .collect();
+            let map = MapConfig {
+                tolerance: 1e-12,
+                max_iterations: 20_000,
+                check_every: 1,
+                symmetric: true,
+            };
+            let lsmr = LsmrConfig {
+                tolerance: 1e-12,
+                max_iterations: 20_000,
+                ..config.absorb.lsmr
+            };
+            for materialize_sum in [false, true] {
+                let recovered = prepared
+                    .recover_absorbed_effects_fast(
+                        &target_actual,
+                        &[true],
+                        None,
+                        false,
+                        materialize_sum,
+                        lsmr,
+                        map,
+                    )
+                    .unwrap();
+                let expected = prepared
+                    .recover_absorbed_effects_fast(
+                        &target_baseline,
+                        &[true],
+                        baseline.recovered_fe_coefficients(),
+                        false,
+                        materialize_sum,
+                        lsmr,
+                        map,
+                    )
+                    .unwrap();
+                let retained_expected = prepared
+                    .recover_absorbed_effects_fast(
+                        &target_retained,
+                        &[true],
+                        retained.recovered_fe_coefficients(),
+                        false,
+                        materialize_sum,
+                        lsmr,
+                        map,
+                    )
+                    .unwrap();
+                assert!(recovered.reconstruction_relative_infinity() <= 1e-12);
+                let (sum, channels) = recovered.into_optional_parts();
+                let (expected_sum, expected_channels) = expected.into_optional_parts();
+                assert_eq!(sum.is_some(), materialize_sum);
+                assert_eq!(expected_sum.is_some(), materialize_sum);
+                let channel = channels[0].as_ref().unwrap();
+                let expected_channel = expected_channels[0].as_ref().unwrap();
+                assert_eq!(channel.len(), active.len());
+                for row in 0..active.len() {
+                    assert!(
+                        (channel[row] - expected_channel[row]).abs()
+                            <= 1e-9 + 1e-7 * expected_channel[row].abs()
+                    );
+                    assert!(
+                        (channel[row] - retained_expected.channels()[0].as_ref().unwrap()[row])
+                            .abs()
+                            <= 1e-9 + 1e-7 * channel[row].abs()
+                    );
+                    assert!((channel[row] - oracle[row]).abs() < 1e-9);
+                    assert!((target_actual[row] - oracle[row]).abs() < 1e-9);
+                    assert!((actual.residuals()[row] - noise[active[row] % 4]).abs() < 1e-9);
+                }
+                if let Some(sum) = sum {
+                    assert_eq!(&sum, channel);
+                }
+                eprintln!("CENTERED_SAVED|kind={kind}|deficient={deficient}|rows={}|materialize_sum={materialize_sum}",active.len());
+            }
+            // A corrupted final-state target must not become a saved channel.
+            let mut corrupted = target_actual.clone();
+            corrupted[0] += 1.0;
+            assert!(prepared
+                .recover_absorbed_effects_fast(
+                    &corrupted,
+                    &[true],
+                    None,
+                    false,
+                    true,
+                    LsmrConfig {
+                        max_iterations: 4,
+                        ..lsmr
+                    },
+                    MapConfig {
+                        max_iterations: 4,
+                        ..map
+                    }
+                )
+                .is_err());
+        }
+    }
+}
