+#[test]
+fn centered_frame_borrows_sources_and_certificate_detects_corrupted_means() {
+    let y = [2.0, 5.0, 6.0, 9.0, -1.0, 1.0, 5.0, 6.0];
+    let x = [1.0, 2.0, 4.0, 7.0, -3.0, 0.0, 1.0, 5.0];
+    let weights = [1.0, 2.0, 3.0, 4.0, 4.0, 3.0, 2.0, 1.0];
+    let codes = [0, 0, 0, 0, 1, 1, 1, 1];
+    let index = LevelIndex::from_codes(&codes, 2).unwrap();
+    let membership = ValidatedBorrowedInterceptSource::new(&codes, 2, &index).unwrap();
+    let mut centered = CenteredColumns::from_prepared_columns(
+        vec![Some(&y), Some(&x), None],
+        membership.effect(),
+        BorrowedMapWeights::Provided(&weights),
+        48,
+    )
+    .unwrap();
+    let CenteredInputs::Prepared(columns) = &centered.columns else {
+        panic!("prepared owner");
+    };
+    assert!(std::ptr::eq(columns[0].unwrap(), &y[..]));
+    assert!(std::ptr::eq(columns[1].unwrap(), &x[..]));
+    assert!(columns[2].is_none());
+    // The independent rational means differ by one ulp from the existing
+    // scaled mean arithmetic for the second group's x. Matrix parity is exact
+    // in the frame test; rational arithmetic is checked at rounding precision.
+    for (actual, expected) in centered
+        .means
+        .iter()
+        .zip([6.6_f64, 4.5, 1.0, 1.5, -0.5, 1.0])
+    {
+        assert!((actual - expected).abs() <= 4.0 * f64::EPSILON * expected.abs().max(1.0));
+    }
+    let reference = centered.norms(true, true, 4096).unwrap();
+    let current = centered.norms(false, true, 4096).unwrap();
+    assert!(
+        centered
+            .projection_certificate(&reference, &current, 1e-10)
+            .unwrap()
+            .passed
+    );
+    centered.means[0] += 1.0;
+    let current = centered.norms(false, true, 4096).unwrap();
+    let certificate = centered
+        .projection_certificate(&reference, &current, 1e-10)
+        .unwrap();
+    assert!(!certificate.passed);
+    // Raw weights in the first group sum to ten: a one-unit centering error
+    // creates a raw FE moment of ten, regardless of max-weight normalization.
+    assert!((certificate.absolute_infinity_norm - 10.0).abs() < 1e-13);
+    assert!(certificate.relative_infinity_norm > 0.1);
+    assert!(centered
+        .projection_certificate(&reference[..2], &current, 1e-10)
+        .is_err());
+    assert!(centered
+        .projection_certificate(&[f64::NAN; 3], &current, 1e-10)
+        .is_err());
+    assert!(centered
+        .projection_certificate(&[0.0; 3], &[0.0; 3], 1e-10)
+        .is_err());
+    assert!(centered.norms(false, true, 71).is_err());
+}
