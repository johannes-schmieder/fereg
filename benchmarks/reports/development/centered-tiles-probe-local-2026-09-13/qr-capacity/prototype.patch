+                config,
+                8 << 20,
+                &mut SystemFitReservation,
+            )
+            .unwrap()
+            .unwrap();
+            assert!(bound.certificate.relative_infinity_norm > 0.0);
+            config.absorb.map.tolerance = bound.certificate.relative_infinity_norm * 0.5;
+            config.absorb.map.max_iterations = 8;
+            let declined =
+                try_centered_ols_in_team(&prepared, config, None, |_, _| -> Result<()> {
+                    panic!("uncertified source reached inference")
+                })
+                .unwrap();
+            assert!(declined.0.is_none());
+            assert!(declined.1 > 0.0);
+            let reference = fit_prepared_ols_coefficients_map(&prepared, config).unwrap();
+            let actual = fit_prepared_ols_unadjusted_map(
+                &prepared,
+                PreparedOlsUnadjustedConfig {
+                    fit: config,
+                    ..Default::default()
+                },
+            )
+            .unwrap();
+            assert!(actual.fit().absorption_report().fallback_used);
+            assert_eq!(
+                actual.fit().absorption_report().iterations,
+                reference.absorption_report().iterations
+            );
+            assert_eq!(actual.fit().coefficients(), reference.coefficients());
+            assert_eq!(actual.fit().residuals(), reference.residuals());
+            assert_eq!(prepared.fit_sample().outcome, y);
+            assert!(prepared.fit_sample().regressors == original_sources);
+            eprintln!(
+                "CENTERED_NATIVE_DECLINE|map_iterations={}|discarded_attempt_seconds={:.9}",
+                reference.absorption_report().iterations,
+                declined.1
+            );
+            let unadmitted = PreparedOlsFitConfig {
+                absorb: AbsorbConfig {
+                    solver_memory_budget: Some(crate::memory::FeSolverMemoryBudget {
+                        execution_bytes: 1,
+                        usable_bytes: 0,
+                    }),
+                    ..config.absorb
+                },
+                ..config
+            };
+            let rejected =
+                try_centered_ols_in_team(&prepared, unadmitted, None, |_, _| -> Result<()> {
+                    panic!("unadmitted plan reached inference")
+                })
+                .unwrap_err();
+            assert_eq!(rejected.code, ErrorCode::Allocation);
+        })
+        .unwrap();
+}
