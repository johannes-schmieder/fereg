+#[test]
+fn centered_scope_keeps_borrowed_state_through_inference_on_the_requested_team() {
+    use super::super::prepared_robust::{
+        compose_centered_probe, fit_prepared_ols_robust_map, PreparedOlsRobustConfig,
+    };
+    use super::super::prepared_scores::SystemPreparedInferenceReservation;
+    let rows = 32777;
+    let g: Vec<f64> = (0..rows).map(|r| (r % 17) as f64).collect();
+    let x: Vec<f64> = (0..rows).map(|r| g[r] + (r as f64 * 0.23).cos()).collect();
+    let y: Vec<f64> = (0..rows)
+        .map(|r| g[r] + 3.0 * x[r] + 0.1 * (r as f64 * 0.17).sin())
+        .collect();
+    let w: Vec<f64> = (0..rows).map(|r| 1.0 + (r % 7) as f64).collect();
+    let prepared = prepared(
+        &y,
+        &[x],
+        &[false],
+        Some(&g),
+        true,
+        TestWeights::Probability(&w),
+    );
+    for workers in [1, 4, 16] {
+        let mut config = PreparedOlsRobustConfig::default();
+        config.fit.execution.threads = ThreadConfig::from_requested(workers, false).unwrap();
+        for cache in [usize::MAX, 0] {
+            let actual = with_centered_ols(
+                &prepared,
+                config.fit,
+                Some(cache),
+                8 << 20,
+                u64::MAX,
+                |fit, source| {
+                    assert_eq!(rayon::current_num_threads(), workers);
+                    assert!(source.matches_raw_column(0, Some(&prepared.fit_sample().outcome)));
+                    compose_centered_probe(
+                        &prepared,
+                        fit,
+                        source,
+                        config,
+                        &mut SystemPreparedInferenceReservation,
+                    )
+                },
+            )
+            .unwrap()
+            .unwrap();
+            // The completed result owns its outputs after all bound means have
+            // left scope. No inference-only cache may remain in that result.
+            assert!(actual.fit().fast_score_cache.is_none());
+            let expected = fit_prepared_ols_robust_map(&prepared, config).unwrap();
+            assert_covariance_close(actual.covariance().values(), expected.covariance().values());
+            assert_centered_statistics(actual.statistics(), expected.statistics());
+            assert_eq!(actual.dof(), expected.dof());
+            eprintln!(
+                "CENTERED_SCOPE|rows={rows}|workers={workers}|packed_requested={}",
+                cache != 0
+            );
+        }
+    }
+    let calls = std::sync::atomic::AtomicUsize::new(0);
+    let mut unsupported = PreparedOlsFitConfig::default();
+    unsupported.absorb.solver = FeSolverKind::Map;
+    assert!(
+        with_centered_ols(&prepared, unsupported, None, 8 << 20, u64::MAX, |_, _| {
+            calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            Ok(())
+        })
+        .unwrap()
+        .is_none()
+    );
+    assert!(with_centered_ols(
+        &prepared,
+        PreparedOlsFitConfig::default(),
+        None,
+        1,
+        u64::MAX,
+        |_, _| {
+            calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            Ok(())
+        }
+    )
+    .is_err());
+    assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 0);
+}
