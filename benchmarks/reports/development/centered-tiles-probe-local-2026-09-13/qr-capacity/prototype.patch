+fn centered_native_decline_continues_the_original_map_and_charges_attempt_time() {
+    use crate::ols::{fit_prepared_ols_unadjusted_map, PreparedOlsUnadjustedConfig};
+    let rows = 16_384;
+    let groups: Vec<f64> = (0..rows).map(|r| (r % 31) as f64).collect();
+    let x: Vec<Vec<f64>> = (1..=16)
+        .map(|j| {
+            (0..rows)
