+//! Current-frame centered values for the experimental scoped one-FE estimator.
+
+use super::*;
+use crate::fe::BorrowedInterceptEffect;
+#[cfg(test)]
+use crate::fe::{LevelIndex, ValidatedBorrowedInterceptSource};
+
+#[derive(Debug)]
+pub(crate) struct CenteredColumns<'a> {
+    columns: CenteredInputs<'a>,
+    effect: BorrowedInterceptEffect<'a>,
+    weights: ValidatedWeights<'a>,
+    means: Vec<f64>,
+}
+
+#[derive(Debug)]
+enum CenteredInputs<'a> {
+    #[cfg(test)]
+    Slices(&'a [&'a [f64]]),
+    // Same borrowed numeric/virtual-intercept representation as the RHS binder,
+    // owned only at column scale so it can outlive a temporary binding table.
+    Prepared(Vec<Option<&'a [f64]>>),
+}
+
+impl CenteredInputs<'_> {
+    fn len(&self) -> usize {
+        match self {
+            #[cfg(test)]
+            Self::Slices(c) => c.len(),
+            Self::Prepared(c) => c.len(),
+        }
+    }
+    fn value(&self, row: usize, column: usize) -> f64 {
+        match self {
+            #[cfg(test)]
+            Self::Slices(c) => c[column][row],
+            Self::Prepared(c) => c[column].map_or(1.0, |v| v[row]),
+        }
+    }
+    fn aligned_and_finite(&self, rows: usize) -> bool {
+        let valid = |c: &[f64]| c.len() == rows && c.iter().all(|v| v.is_finite());
+        match self {
+            #[cfg(test)]
+            Self::Slices(c) => c.iter().all(|v| valid(v)),
+            Self::Prepared(c) => c.iter().all(|v| v.is_none_or(valid)),
+        }
+    }
+}
+
+impl<'a> CenteredColumns<'a> {
+    #[cfg(test)]
+    pub(crate) fn prepare(
+        columns: &'a [&'a [f64]],
+        effect: &'a BorrowedInterceptEffect<'a>,
+        weights: BorrowedMapWeights<'a>,
+        maximum_mean_bytes: usize,
+    ) -> Result<Self> {
+        Self::new(
+            columns,
+            effect,
+            weights,
+            maximum_mean_bytes,
+            &mut SystemWorkspaceReservation,
+        )
+    }
+
+    pub(crate) fn rows(&self) -> usize {
+        self.effect.codes().len()
+    }
+    pub(crate) fn width(&self) -> usize {
+        self.columns.len()
+    }
+    pub(crate) fn raw_value(&self, row: usize, column: usize) -> f64 {
+        self.columns.value(row, column)
+    }
+    pub(crate) fn value(&self, row: usize, column: usize) -> f64 {
+        self.columns.value(row, column)
+            - self.means[self.effect.codes()[row] as usize * self.width() + column]
+    }
+
+    pub(crate) fn weight_divisor(&self) -> f64 {
+        self.weights.raw_scale
+    }
+
+    pub(crate) fn matches_raw_column(&self, column: usize, values: Option<&[f64]>) -> bool {
+        match &self.columns {
+            CenteredInputs::Prepared(columns) => match (columns.get(column), values) {
+                (Some(Some(actual)), Some(expected)) => std::ptr::eq(*actual, expected),
+                (Some(None), None) => true,
+                _ => false,
+            },
+            #[cfg(test)]
+            CenteredInputs::Slices(_) => false,
+        }
+    }
+
+    pub(crate) fn matches_weights(&self, weights: BorrowedMapWeights<'_>) -> bool {
+        match (self.weights.values, weights) {
+            (None, BorrowedMapWeights::Unit) => true,
+            (Some(actual), BorrowedMapWeights::Provided(expected)) => {
+                std::ptr::eq(actual, expected)
+            }
+            _ => false,
+        }
+    }
+
+    pub(crate) fn matches_effect(&self, effect: &BorrowedInterceptEffect<'_>) -> bool {
+        self.effect.n_levels() == effect.n_levels()
+            && std::ptr::eq(self.effect.codes(), effect.codes())
+            && std::ptr::eq(self.effect.level_index(), effect.level_index())
+    }
+
+    pub(crate) fn norms(&self, raw: bool, ols: bool, maximum_bytes: usize) -> Result<Vec<f64>> {
+        let width = self.width();
+        let fixed = ols && self.rows() >= 16_384 && width <= 64;
+        let partials = if fixed && rayon::current_num_threads() > 1 {
+            self.rows()
+                .div_ceil(4096)
+                .checked_mul(width)
+                .and_then(|v| v.checked_mul(2))
+                .ok_or_else(|| allocation("centered norm partial size overflows"))?
+        } else {
+            0
+        };
+        let elements = width
+            .checked_mul(3)
+            .and_then(|v| v.checked_add(partials))
+            .ok_or_else(|| allocation("centered norm workspace overflows"))?;
+        if elements > maximum_bytes / 8 {
+            return Err(allocation("centered norms exceed their budget"));
+        }
+        let mut reserve = SystemWorkspaceReservation;
+        let mut output = reserved_zeros(width, &mut reserve, "centered norms")?;
+        let mut scales = reserved_zeros(width, &mut reserve, "centered norm scales")?;
+        let mut squares = reserved_zeros(width, &mut reserve, "centered norm squares")?;
+        let mut partials = reserved_zeros(partials, &mut reserve, "centered norm partials")?;
+        let capacities = [&output, &scales, &squares, &partials]
+            .into_iter()
+            .try_fold(0_usize, |sum, v| sum.checked_add(v.capacity()))
+            .ok_or_else(|| allocation("centered norm capacities overflow"))?;
+        if capacities > maximum_bytes / 8 {
+            return Err(allocation("centered norm capacities exceed their budget"));
+        }
+        let value = |row, rhs| {
+            if raw {
+                self.raw_value(row, rhs)
+            } else {
+                self.value(row, rhs)
+            }
+        };
+        if fixed {
+            fill_ols_norms_by_value(
+                self.rows(),
+                width,
+                self.weights,
+                &mut output,
+                &mut scales,
+                &mut squares,
+                &mut partials,
+                value,
+            )?;
+        } else {
+            weighted_norms_by_value(
+                self.rows(),
+                width,
+                self.weights,
+                &mut output,
+                &mut scales,
+                &mut squares,
+                value,
+            )?;
+        }
+        Ok(output)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn projection_certificate(
+        &self,
+        reference: &[f64],
+        current: &[f64],
+        tolerance: f64,
+    ) -> Result<FeCertificate> {
+        self.projection_certificate_with_budget(reference, current, tolerance, 0)
+            .map(|(certificate, _)| certificate)
+    }
+
+    pub(crate) fn projection_certificate_with_budget(
+        &self,
+        reference: &[f64],
+        current: &[f64],
+        tolerance: f64,
+        maximum_partial_bytes: usize,
+    ) -> Result<(FeCertificate, usize)> {
+        self.projection_certificate_reserved(
+            reference,
+            current,
+            tolerance,
+            maximum_partial_bytes,
+            &mut SystemWorkspaceReservation,
+        )
+    }
+
+    fn projection_certificate_reserved<R: WorkspaceReservation>(
+        &self,
+        reference: &[f64],
+        current: &[f64],
+        tolerance: f64,
+        maximum_partial_bytes: usize,
+        reservation: &mut R,
+    ) -> Result<(FeCertificate, usize)> {
+        if reference.len() != self.width()
+            || current.len() != self.width()
+            || reference
+                .iter()
+                .chain(current)
+                .any(|v| !v.is_finite() || *v < 0.0)
+            || !tolerance.is_finite()
+            || tolerance <= 0.0
+            || tolerance >= 1.0
+        {
+            return Err(invalid_argument(
+                "centered projection certificate inputs are invalid",
+            ));
+        }
+        let levels = self.effect.n_levels();
+        let count = levels
+            .checked_mul(self.width())
+            .ok_or_else(|| allocation("centered certificate count overflows"))?;
+        let certify_groups = |levels: std::ops::Range<usize>| -> Result<[f64; 3]> {
+            let mut absolute = 0.0_f64;
+            let mut infinity = 0.0_f64;
+            let mut square_sum = 0.0_f64;
+            for level in levels {
+                for start in (0..self.width()).step_by(PARALLEL_GROUP_MAX_RHS) {
+                    let width = (self.width() - start).min(PARALLEL_GROUP_MAX_RHS);
+                    let mut means = [0.0; PARALLEL_GROUP_MAX_RHS];
+                    let group_weight = fused_group_means_by_value(
+                        &self.effect,
+                        level,
+                        self.weights,
+                        self.rows(),
+                        &mut means[..width],
+                        |row, rhs| self.value(row, start + rhs),
+                    )?;
+                    for (offset, &mean) in means[..width].iter().enumerate() {
+                        let rhs = start + offset;
+                        let scale = reference[rhs].max(current[rhs]);
+                        let relative = if scale == 0.0 {
+                            if mean != 0.0 {
+                                return Err(invalid_data(
+                                    "centered zero-scale certificate has a nonzero moment",
+                                ));
+                            }
+                            0.0
+                        } else {
+                            mean.abs() / scale * group_weight.sqrt()
+                        };
+                        if !relative.is_finite() {
+                            return Err(invalid_data(
+                                "centered projection certificate is nonfinite",
+                            ));
+                        }
+                        infinity = infinity.max(relative);
+                        square_sum = relative.mul_add(relative, square_sum);
+                        let normalized = mean.abs() * group_weight;
+                        let raw = normalized * self.weights.raw_scale;
+                        absolute = absolute.max(if raw.is_finite() {
+                            raw
+                        } else if normalized == 0.0 {
+                            0.0
+                        } else {
+                            f64::INFINITY
+                        });
+                    }
+                }
+            }
+            if !square_sum.is_finite() {
+                return Err(invalid_data("centered certificate norm is nonfinite"));
+            }
+            Ok([absolute, infinity, square_sum])
+        };
+        // Keep the existing fixed OLS certificate group partition. Each group
+        // retains its row/RHS arithmetic; acceptance uses exact maxima. Only
+        // the diagnostic two-norm changes summation order across fixed chunks.
+        let chunks = levels.div_ceil(OLS_CERTIFICATE_GROUP_CHUNK);
+        let elements = chunks
+            .checked_mul(3)
+            .ok_or_else(|| allocation("centered certificate partial count overflows"))?;
+        let parallel = self.rows() >= PARALLEL_PROJECTION_MIN_ROWS
+            && rayon::current_num_threads() > 1
+            && chunks > 1
+            && elements <= maximum_partial_bytes / 8;
+        let (summary, charged_bytes) = if parallel {
+            let mut partials =
+                reserved_zeros(elements, reservation, "centered certificate partials")?;
+            if partials.capacity() > maximum_partial_bytes / 8 {
+                return Err(allocation(
+                    "centered certificate partial capacity exceeds budget",
+                ));
+            }
+            partials.par_chunks_mut(3).enumerate().try_for_each(
+                |(chunk, partial)| -> Result<()> {
+                    let start = chunk * OLS_CERTIFICATE_GROUP_CHUNK;
+                    let end = start
+                        .saturating_add(OLS_CERTIFICATE_GROUP_CHUNK)
+                        .min(levels);
+                    partial.copy_from_slice(&certify_groups(start..end)?);
+                    Ok(())
+                },
+            )?;
+            let mut summary = [0.0_f64; 3];
+            for partial in partials.chunks_exact(3) {
+                summary[0] = summary[0].max(partial[0]);
+                summary[1] = summary[1].max(partial[1]);
+                summary[2] += partial[2];
+            }
+            (summary, partials.capacity() * 8)
+        } else {
+            (certify_groups(0..levels)?, 0)
+        };
+        let two = (summary[2] / count as f64).sqrt();
+        if !two.is_finite() {
+            return Err(invalid_data("centered certificate norm is nonfinite"));
+        }
+        Ok((
+            FeCertificate {
+                absolute_infinity_norm: summary[0],
+                relative_infinity_norm: summary[1],
+                relative_two_norm: two,
+                passed: summary[1] <= tolerance,
+            },
+            charged_bytes,
+        ))
+    }
+
+    #[cfg(test)]
+    fn new<R: WorkspaceReservation>(
+        columns: &'a [&'a [f64]],
+        effect: &'a BorrowedInterceptEffect<'a>,
+        weights: BorrowedMapWeights<'a>,
+        maximum_mean_bytes: usize,
+        reservation: &mut R,
+    ) -> Result<Self> {
+        Self::with_inputs(
+            #[cfg(test)]
+            CenteredInputs::Slices(columns),
+            *effect,
+            weights,
+            maximum_mean_bytes,
+            reservation,
+        )
+    }
+
+    pub(crate) fn from_prepared_columns(
+        columns: Vec<Option<&'a [f64]>>,
+        effect: BorrowedInterceptEffect<'a>,
+        weights: BorrowedMapWeights<'a>,
+        maximum_mean_bytes: usize,
+    ) -> Result<Self> {
+        Self::with_inputs(
+            CenteredInputs::Prepared(columns),
+            effect,
+            weights,
+            maximum_mean_bytes,
+            &mut SystemWorkspaceReservation,
+        )
+    }
+
+    fn with_inputs<R: WorkspaceReservation>(
+        columns: CenteredInputs<'a>,
+        effect: BorrowedInterceptEffect<'a>,
+        weights: BorrowedMapWeights<'a>,
+        maximum_mean_bytes: usize,
+        reservation: &mut R,
+    ) -> Result<Self> {
+        let rows = effect.codes().len();
+        if rows == 0 || columns.len() == 0 {
+            return Err(invalid_argument("centered columns require nonempty inputs"));
+        }
+        let elements = effect
+            .n_levels()
+            .checked_mul(columns.len())
+            .ok_or_else(|| allocation("centered group means overflow"))?;
+        let bytes = elements
+            .checked_mul(std::mem::size_of::<f64>())
+            .ok_or_else(|| allocation("centered group mean bytes overflow"))?;
+        if bytes > maximum_mean_bytes {
+            return Err(allocation(
+                "centered group means exceed their workspace budget",
+            ));
+        }
+        let weights = validate_weights(weights, rows)?;
+        if !columns.aligned_and_finite(rows) {
+            return Err(invalid_data("centered source contains a nonfinite value"));
+        }
+        let mut means = reserved_zeros(
+            elements,
+            reservation,
+            "unable to reserve centered group means",
+        )?;
+        if means.capacity() > maximum_mean_bytes / std::mem::size_of::<f64>() {
+            return Err(allocation(
+                "centered group mean capacity exceeds its budget",
+            ));
+        }
+        // Each finalized group keeps its membership order. Reuse the existing
+        // scaled/compensated mean arithmetic, including above-64 RHS blocks.
+        means
+            .par_chunks_mut(columns.len())
+            .enumerate()
+            .try_for_each(|(level, destination)| -> Result<()> {
+                for (block, output) in destination.chunks_mut(PARALLEL_GROUP_MAX_RHS).enumerate() {
+                    let start = block * PARALLEL_GROUP_MAX_RHS;
+                    fused_group_means_by_value(
+                        &effect,
+                        level,
+                        weights,
+                        rows,
+                        output,
+                        |row, rhs| columns.value(row, start + rhs),
+                    )?;
+                }
+                Ok(())
+            })?;
+        Ok(Self {
+            columns,
+            effect,
+            weights,
+            means,
+        })
+    }
+
+    pub(crate) fn fill_rows(&self, start: usize, output: &mut [f64]) -> Result<()> {
+        let width = self.columns.len();
+        let rows = output.len() / width;
+        if output.len() % width != 0
+            || start
+                .checked_add(rows)
+                .is_none_or(|end| end > self.effect.codes().len())
+        {
+            return Err(invalid_argument(
+                "centered row tile is outside its source axis",
+            ));
+        }
+        for (offset, values) in output.chunks_exact_mut(width).enumerate() {
+            let row = start + offset;
+            let level = self.effect.codes()[row] as usize;
+            for (column, value) in values.iter_mut().enumerate() {
+                *value = self.columns.value(row, column) - self.means[level * width + column];
+                if !value.is_finite() {
+                    return Err(invalid_data("centered row value is not finite"));
+                }
+            }
+        }
+        Ok(())
+    }
+}
