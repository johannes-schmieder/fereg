+        })
+        .collect();
+    let y: Vec<f64> = (0..rows)
+        .map(|r| {
+            x.iter()
+                .enumerate()
+                .fold(1e4 + groups[r] + (r as f64 * 0.113).cos(), |v, (j, x)| {
+                    v + (j + 1) as f64 * x[r]
+                })
+        })
+        .collect();
+    let prepared = prepared(&y, &x, &[false; 16], Some(&groups), true, TestWeights::Unit);
+    let original_sources = prepared.fit_sample().regressors.clone();
+    let mut config = PreparedOlsFitConfig::default();
+    config.execution.threads = ThreadConfig::from_requested(4, false).unwrap();
+    ThreadTeam::new(config.execution.threads)
