+            4096,
+            &mut SystemFitReservation,
+            |_| {},
+        )
+        .unwrap();
+        // Exact rational group contrasts give XX=111 and XY=217/2. AW/PW
+        // reference weights multiply raw weights by 8/20; FW and literal
+        // repetition retain the unnormalized reference cross-product.
