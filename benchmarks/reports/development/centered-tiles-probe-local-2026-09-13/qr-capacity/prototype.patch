+fn assert_scratch_compatible(actual: &QrFit, expected: &QrFit) {
+    assert_eq!(actual.generated_statuses, expected.generated_statuses);
+    assert_eq!(actual.kept, expected.kept);
+    assert_eq!(actual.dropped, expected.dropped);
+    assert_eq!(actual.rank, expected.rank);
+    assert_eq!(
+        actual.certificate.relative_threshold,
+        expected.certificate.relative_threshold
+    );
+    assert!(actual.certificate.passed && expected.certificate.passed);
+    let mut coefficient_error = 0.0_f64;
+    for (actual, expected) in actual
+        .generated_coefficients
+        .iter()
+        .zip(&expected.generated_coefficients)
+    {
+        match (actual, expected) {
+            (Some(actual), Some(expected)) => {
+                let error = (actual - expected).abs();
+                assert!(error <= 1e-10 + 1e-7 * expected.abs());
+                coefficient_error = coefficient_error.max(error);
+            }
+            (None, None) => {}
+            _ => panic!("scratch coefficient identity differs"),
+        }
+    }
+    let actual_bread = actual.bread.as_ref().unwrap();
+    let expected_bread = expected.bread.as_ref().unwrap();
+    assert_eq!(
+        actual_bread.generated_columns,
+        expected_bread.generated_columns
+    );
+    assert_eq!(actual_bread.weight_scale, expected_bread.weight_scale);
+    let mut bread_error = 0.0_f64;
+    for (actual, expected) in actual_bread.values.iter().zip(&expected_bread.values) {
+        let error = (actual - expected).abs();
+        assert!(error <= 1e-10 + 1e-6 * expected.abs());
+        bread_error = bread_error.max(error);
+    }
+    let mut residual_error = 0.0_f64;
+    for (actual, expected) in actual
+        .within_residuals
+        .as_ref()
+        .unwrap()
+        .iter()
+        .zip(expected.within_residuals.as_ref().unwrap())
+    {
+        let error = (actual - expected).abs();
+        assert!(error <= 1e-9 + 1e-7 * expected.abs());
+        residual_error = residual_error.max(error);
+    }
+    eprintln!("CENTERED_SCRATCH|coefficient_error={coefficient_error:.17e}|bread_error={bread_error:.17e}|residual_error={residual_error:.17e}");
+}
