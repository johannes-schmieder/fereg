+//! Experimental scoped one-FE estimator. Public admission remains bounded by
+//! the existing fast plan until complete-command evidence supports adoption.
+
+use super::super::finite_wls_kernel::{
+    accumulate_prepared_partition_rows, accumulate_prepared_rows, merge_fixed_block_partials,
+    prepared_moment_layout, FiniteWlsMomentMode,
+};
+#[cfg(test)]
+use super::tests::{prepared, TestWeights};
+use super::*;
+use crate::fe::CenteredColumns;
+#[cfg(test)]
+use crate::fe::{
+    absorb_borrowed_intercept_map_certified, BorrowedInterceptFeDesign, LevelIndex, MapConfig,
+    ValidatedBorrowedInterceptSource,
+};
+
+const TILE_ROWS: usize = 128;
+
+/// The experiment replaces one resident N-by-K allocation from the existing
+/// fast plan. Charge every new frame/finite reservation cumulatively against
+/// that displaced payload; the ordinary final-FE and covariance allocations
+/// retain their existing plan. This does not lower public memory admission.
+pub(in crate::ols) fn try_centered_ols_in_team<'a, P, T, F>(
+    prepared: &'a P,
+    config: PreparedOlsFitConfig,
+    cache_limit: Option<usize>,
+    consume: F,
+) -> Result<(Option<T>, f64)>
+where
+    P: PreparedOlsFitView + ?Sized,
+    F: for<'b> FnOnce(CertifiedPreparedOlsFit, &'b CenteredColumns<'a>) -> Result<T>,
+{
+    let rows = prepared.fit_sample().n_active();
+    let columns = prepared.fit_model().columns.len();
+    if config.execution.mode != PreparedOlsExecutionMode::Fast
+        || config.absorb.solver != FeSolverKind::Auto
+        || config.absorb.retain_coefficients
+        || rows < 16_384
+        || !(16..=64).contains(&columns)
+        || prepared.fit_model().columns.iter().any(|column| {
+            !matches!(
+                column.kind,
+                PreparedOlsColumnKind::Continuous { .. } | PreparedOlsColumnKind::Intercept
+            )
+        })
+    {
+        return Ok((None, 0.0));
+    }
+    let Some(design) = prepared.fit_borrowed_intercept_map_design()? else {
+        return Ok((None, 0.0));
+    };
+    if design.effects().len() != 1 {
+        return Ok((None, 0.0));
+    }
+    let component_bytes = rows
+        .checked_mul(columns)
+        .and_then(|v| v.checked_mul(8))
+        .ok_or_else(|| allocation("centered displaced-matrix budget overflows"))?;
+    let mean_bytes = design.effects()[0]
+        .n_levels()
+        .checked_mul(columns + 1)
+        .and_then(|v| v.checked_mul(8))
+        .ok_or_else(|| allocation("centered group-mean budget overflows"))?;
+    // Leave at least half the displaced payload for finite and tile work.
+    // A row-count cutoff incorrectly excluded the existing five-row FE targets.
+    if mean_bytes > component_bytes / 2 {
+        return Ok((None, 0.0));
+    }
+    if config
+        .absorb
+        .solver_memory_budget
+        .is_some_and(|budget| budget.execution_bytes > budget.usable_bytes)
+    {
+        return Err(allocation("centered execution plan was not admitted"));
+    }
+    let started = Instant::now();
+    let Some(bound) = BoundCenteredFrame::bind(
+        prepared,
+        LinearSolveFrame::from_prepared_ols(prepared)?,
+        config,
+        component_bytes,
+        &mut SystemFitReservation,
+    )?
+    else {
+        return Ok((None, started.elapsed().as_secs_f64()));
+    };
+    let remaining = component_bytes
+        .checked_sub(bound.charged_state_bytes)
+        .ok_or_else(|| allocation("centered frame exceeds displaced-matrix budget"))?;
+    let fit = fit_centered_frame(
+        prepared,
+        &bound,
+        config,
+        cache_limit,
+        remaining,
+        u64::try_from(component_bytes)
+            .map_err(|_| allocation("centered scratch bound overflows"))?,
+        &mut SystemFitReservation,
+    )?;
+    if std::env::var_os("FEREG_PHASE_TIMING").is_some() {
+        eprintln!("fereg centered_ols rows={rows} columns={columns} component_limit_bytes={component_bytes} frame_charge_bytes={} scratch_bytes={} fit_seconds={:.9}",
+            bound.charged_state_bytes, fit.execution().scratch_bytes, started.elapsed().as_secs_f64());
+    }
+    Ok((Some(consume(fit, &bound.columns)?), 0.0))
+}
