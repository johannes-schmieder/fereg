+#[test]
+fn centered_finite_preserves_large_reference_scales_and_absorption_status() {
+    let rows = 256;
+    let delta = [-2.0, -1.0, 1.0, 2.0];
+    let noise = [1.0, -1.0, -1.0, 1.0];
