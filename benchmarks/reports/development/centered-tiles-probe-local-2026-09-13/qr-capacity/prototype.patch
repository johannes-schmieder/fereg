+/// Scope the borrowed current-frame state through its inference consumer.
+/// The result type cannot borrow the local mean bank. This is one statically
+/// dispatched call at the estimator boundary, not a callback in a row loop.
+#[cfg(test)]
+fn with_centered_ols<'a, P, T, F>(
+    prepared: &'a P,
+    config: PreparedOlsFitConfig,
+    cache_limit: Option<usize>,
+    maximum_component_bytes: usize,
+    maximum_scratch_bytes: u64,
+    consume: F,
+) -> Result<Option<T>>
+where
+    P: PreparedOlsFitView + Sync + ?Sized,
+    T: Send,
+    F: for<'b> FnOnce(CertifiedPreparedOlsFit, &'b CenteredColumns<'a>) -> Result<T> + Send,
+{
+    let team = ThreadTeam::new(config.execution.threads);
+    team.install(|| {
+        let Some(bound) = BoundCenteredFrame::bind(
+            prepared,
+            LinearSolveFrame::from_prepared_ols(prepared)?,
+            config,
+            maximum_component_bytes,
+            &mut SystemFitReservation,
+        )?
+        else {
+            return Ok(None);
+        };
+        let fit_budget = maximum_component_bytes
+            .checked_sub(bound.charged_state_bytes)
+            .ok_or_else(|| allocation("centered frame consumes its component budget"))?;
+        let fit = fit_centered_frame(
+            prepared,
+            &bound,
+            config,
+            cache_limit,
+            fit_budget,
+            maximum_scratch_bytes,
+            &mut SystemFitReservation,
+        )?;
+        consume(fit, &bound.columns).map(Some)
+    })?
+}
