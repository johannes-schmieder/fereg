+                        ((state >> 11) as f64) / (1_u64 << 53) as f64 - 0.5 + 0.1 * g[r]
+                    })
+                    .collect()
+            })
+            .collect();
+        if deficient {
+            x[columns - 1] = x[0].clone();
+        }
+        x.insert(1, g.clone());
+        let y: Vec<f64> = (0..rows)
+            .map(|r| {
+                x.iter()
+                    .enumerate()
+                    .fold(g[r] + 0.02 * (r as f64 * 0.13).cos(), |sum, (j, x)| {
+                        sum + (j + 1) as f64 / columns as f64 * x[r]
+                    })
+            })
+            .collect();
+        let w: Vec<f64> = (0..rows).map(|r| 1.0 + (r % 7) as f64).collect();
+        let weights = match kind {
+            1 => TestWeights::Frequency(&w),
+            2 => TestWeights::Analytic(&w),
+            _ => TestWeights::Probability(&w),
+        };
+        let prepared = prepared(&y, &x, &vec![false; x.len()], Some(&g), true, weights);
+        let mut config = PreparedOlsRobustConfig::default();
+        config.fit.execution.threads = ThreadConfig::from_requested(workers, false).unwrap();
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap();
+        pool.install(|| {
+            let bound=BoundCenteredFrame::bind(&prepared,LinearSolveFrame::from_prepared_ols(&prepared).unwrap(),config.fit,32<<20,&mut SystemFitReservation).unwrap().unwrap();
+            let baseline=fit_prepared_ols_robust_map(&prepared,config).unwrap();
+            for cache in [usize::MAX,0] {
+                let fit=checked_centered_estimator(&prepared,&bound,config.fit,cache);
+                let actual=compose_centered_probe(&prepared,fit,&bound.columns,config,&mut SystemPreparedInferenceReservation).unwrap();
+                assert!(actual.certificate().passed);
+                assert_eq!(actual.dof(),baseline.dof());
+                assert_eq!(actual.weights(),baseline.weights());
+                assert_eq!(actual.fit().finite_rank(),columns-usize::from(deficient));
+                assert_eq!(actual.fit().kept_generated_columns(),baseline.fit().kept_generated_columns());
+                assert_covariance_close(actual.covariance().values(),baseline.covariance().values());
+                assert_centered_statistics(actual.statistics(),baseline.statistics());
+                eprintln!("CENTERED_SCORE_ROBUST|rows={rows}|columns={columns}|kind={kind}|workers={workers}|deficient={deficient}|packed_requested={}",cache!=0);
+            }
+        });
+    }
+}
