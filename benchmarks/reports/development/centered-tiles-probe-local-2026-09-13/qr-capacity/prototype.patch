+struct CenteredStandardized<'a> {
+    centered: &'a CenteredColumns<'a>,
+    weights: NormalizedWeights<'a>,
+    reference_norms: &'a [f64],
+}
+
+impl CenteredStandardized<'_> {
+    fn fill_tile(&self, start: usize, output: &mut [f64], candidates: &[usize]) -> Result<()> {
+        self.centered.fill_rows(start, output)?;
+        for (offset, values) in output.chunks_exact_mut(self.centered.width()).enumerate() {
+            let root = self.weights.root(start + offset)?;
+            values[0] *= root;
+            for &column in candidates {
+                values[column + 1] = root * values[column + 1] / self.reference_norms[column];
+            }
+            if values.iter().any(|value| !value.is_finite()) {
+                return Err(invalid_data("centered standardized tile is not finite"));
+            }
+        }
+        Ok(())
+    }
+}
+
+impl PreparedCholeskyResidualSource for CenteredStandardized<'_> {
+    fn nrows(&self) -> usize {
+        self.centered.rows()
+    }
+
+    fn standardized_residual(
+        &self,
+        row: usize,
+        candidates: &[usize],
+        coefficients: &[f64],
+    ) -> Result<f64> {
+        let root = self.weights.root(row)?;
+        let mut residual = root * self.centered.value(row, 0);
+        for (position, column) in candidates.iter().copied().enumerate() {
+            let value = root * self.centered.value(row, column + 1) / self.reference_norms[column];
+            residual = (-coefficients[position]).mul_add(value, residual);
+        }
+        Ok(residual)
+    }
+
+    fn standardized_within_is_reusable(&self) -> bool {
+        false
+    }
+}
+
+fn centered_moments<R: FitReservation>(
+    source: &CenteredStandardized<'_>,
+    candidates: &[usize],
+    maximum_workspace_bytes: usize,
+    reservation: &mut R,
+) -> Result<(Vec<f64>, Vec<f64>)> {
+    let rows = source.centered.rows();
+    let width = source.centered.width();
+    let dimension = candidates.len();
+    if source.reference_norms.len() != width - 1
+        || candidates.iter().any(|&column| {
+            column >= width - 1
+                || !source.reference_norms[column].is_finite()
+                || source.reference_norms[column] <= 0.0
+        })
+        || candidates.windows(2).any(|pair| pair[0] >= pair[1])
+    {
+        return Err(invalid_argument(
+            "centered moment candidates are inconsistent",
+        ));
+    }
+    let layout = prepared_moment_layout(rows, dimension)?;
+    let square = checked_square(dimension, "centered Gram dimensions overflow")?;
+    let tile_stride = TILE_ROWS
+        .min(rows)
+        .checked_mul(width)
+        .ok_or_else(|| allocation("centered tile dimensions overflow"))?;
+    let tile_elements = layout
+        .partitions
+        .checked_mul(tile_stride)
+        .ok_or_else(|| allocation("centered tile bank overflows"))?;
+    let elements = [tile_elements, layout.partial_elements, dimension, square]
+        .into_iter()
+        .try_fold(0_usize, |sum, count| sum.checked_add(count))
+        .ok_or_else(|| allocation("centered moment workspace overflows"))?;
+    if elements > maximum_workspace_bytes / std::mem::size_of::<f64>() {
+        return Err(allocation("centered moments exceed their workspace budget"));
+    }
+    // This cap covers only this call's live tile/moment storage. It is not an
+    // estimator admission claim for means, inputs, solve, inference or fallback.
+    let mut tiles = reserved_filled(reservation, tile_elements, 0.0, "centered tiles")?;
+    let mut partials = reserved_filled(
+        reservation,
+        layout.partial_elements,
+        0.0,
+        "centered partials",
+    )?;
+    let mut rhs = reserved_filled(reservation, dimension, 0.0, "centered RHS")?;
+    let mut gram = reserved_filled(reservation, square, 0.0, "centered Gram")?;
+    let capacity = [&tiles, &partials, &rhs, &gram]
+        .into_iter()
+        .try_fold(0_usize, |sum, values| sum.checked_add(values.capacity()))
+        .ok_or_else(|| allocation("centered moment capacities overflow"))?;
+    if capacity > maximum_workspace_bytes / std::mem::size_of::<f64>() {
+        return Err(allocation("centered moment capacities exceed their budget"));
+    }
+    match layout.mode {
+        FiniteWlsMomentMode::PreparedFixedBlocks => {
+            partials
+                .par_chunks_mut(layout.partial_stride)
+                .zip(tiles.par_chunks_mut(tile_stride))
+                .enumerate()
+                .try_for_each(|(partition, (partial, tile))| -> Result<()> {
+                    let rows_per_partition = rows / layout.partitions;
+                    let remainder = rows % layout.partitions;
+                    let start = partition * rows_per_partition + partition.min(remainder);
+                    let end = start + rows_per_partition + usize::from(partition < remainder);
+                    for row in (start..end).step_by(TILE_ROWS) {
+                        let values = &mut tile[..(end - row).min(TILE_ROWS) * width];
+                        source.fill_tile(row, values, candidates)?;
+                        accumulate_prepared_rows(values, width, candidates, partial)?;
+                    }
+                    if partial.iter().all(|v| v.is_finite()) {
+                        Ok(())
+                    } else {
+                        Err(invalid_data("centered moment partial is not finite"))
+                    }
+                })?;
+            merge_fixed_block_partials(layout, &partials, &mut rhs, &mut gram)?;
+        }
+        FiniteWlsMomentMode::PreparedPartitioned => {
+            let contiguous = candidates.windows(2).all(|pair| pair[1] == pair[0] + 1);
+            rhs.par_chunks_mut(layout.columns_per_partition)
+                .zip(gram.par_chunks_mut(layout.columns_per_partition * dimension))
+                .zip(tiles.par_chunks_mut(tile_stride))
+                .enumerate()
+                .try_for_each(|(partition, ((rhs_part, gram_part), tile))| -> Result<()> {
+                    for row in (0..rows).step_by(TILE_ROWS) {
+                        let values = &mut tile[..(rows - row).min(TILE_ROWS) * width];
+                        source.fill_tile(row, values, candidates)?;
+                        accumulate_prepared_partition_rows(
+                            values,
+                            width,
+                            candidates,
+                            contiguous,
+                            partition * layout.columns_per_partition,
+                            rhs_part,
+                            gram_part,
+                        );
+                    }
+                    Ok(())
+                })?;
+            for left in 0..dimension {
+                for right in left + 1..dimension {
+                    gram[right * dimension + left] = gram[left * dimension + right];
+                }
+            }
+        }
+        FiniteWlsMomentMode::RetainedPartitioned => unreachable!(),
+    }
+    if rhs.iter().chain(&gram).any(|v| !v.is_finite()) {
+        return Err(invalid_data("centered moments are not finite"));
+    }
+    Ok((rhs, gram))
+}
+
+fn centered_norm(
+    source: &CenteredColumns<'_>,
+    column: usize,
+    weights: NormalizedWeights<'_>,
+    raw: bool,
+) -> Result<f64> {
+    let mut scale = 0.0;
+    let mut sum = 1.0;
+    for row in 0..source.rows() {
+        let value = if raw {
+            source.raw_value(row, column)
+        } else {
+            source.value(row, column)
+        };
+        update_scaled_sum_of_squares(weights.root(row)? * value, &mut scale, &mut sum)?;
+    }
+    checked_norm(scale, sum)
+}
