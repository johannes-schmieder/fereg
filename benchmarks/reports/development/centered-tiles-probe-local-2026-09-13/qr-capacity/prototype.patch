+    );
+    let config = PreparedOlsFitConfig::default();
+    let bound = BoundCenteredFrame::bind(
+        &prepared,
+        LinearSolveFrame::from_prepared_ols(&prepared).unwrap(),
+        config,
+        1 << 20,
+        &mut SystemFitReservation,
+    )
+    .unwrap()
+    .unwrap();
+    let frame_charge = bound.charged_state_bytes;
+    drop(bound);
+    let calls = std::sync::atomic::AtomicUsize::new(0);
+    let run = |budget| {
+        with_centered_ols(
+            &prepared,
+            config,
+            Some(usize::MAX),
+            budget,
+            u64::MAX,
+            |fit, _| {
+                calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                Ok(fit.finite_rank())
+            },
+        )
+    };
+    let (mut lo, mut hi) = (0, 1 << 20);
+    while hi - lo > 1 {
+        let mid = (lo + hi) / 2;
+        if run(mid).is_ok() {
+            hi = mid;
+        } else {
+            lo = mid;
+        }
+    }
+    assert_eq!(hi, frame_charge + 676);
+    let before = calls.load(std::sync::atomic::Ordering::SeqCst);
+    assert!(run(hi - 1).is_err());
+    assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), before);
+    assert_eq!(run(hi).unwrap(), Some(1));
+    eprintln!("CENTERED_SCOPE_BOUNDS|frame_component_charge={frame_charge}|finite_component_charge=676|combined_minimum={hi}");
+}
