+            None,
+            1 << 20,
+            u64::MAX,
+            &mut SystemFitReservation,
+        )
+        .unwrap();
+        let actual = compose_centered_probe(&prepared, fit, config);
+        let expected = fit_prepared_ols_unadjusted_map(&prepared, config);
+        if kind == 3 {
+            assert_eq!(actual.unwrap_err().code, expected.unwrap_err().code);
+            continue;
+        }
+        let (actual, expected) = (actual.unwrap(), expected.unwrap());
+        assert!(actual.certificate().passed);
+        assert_eq!(actual.dof(), expected.dof());
+        assert_eq!(actual.weights(), expected.weights());
+        assert_covariance_close(actual.covariance().values(), expected.covariance().values());
+        assert_centered_statistics(actual.statistics(), expected.statistics());
+        let weight: Vec<f64> = (0..8).map(|i| if kind == 0 { 1.0 } else { w[i] }).collect();
+        let total: f64 = weight.iter().sum();
+        let reference: Vec<f64> = weight
+            .iter()
+            .map(|&v| if kind == 2 { v * 8.0 / total } else { v })
+            .collect();
+        let nref: f64 = reference.iter().sum();
+        let mut mx = [0.0; 2];
+        let mut my = [0.0; 2];
+        let mut gw = [0.0; 2];
+        for i in 0..8 {
+            let group = g[i] as usize;
+            mx[group] += reference[i] * x[i];
+            my[group] += reference[i] * y[i];
+            gw[group] += reference[i];
+        }
+        for group in 0..2 {
+            mx[group] /= gw[group];
+            my[group] /= gw[group];
+        }
+        let xx: f64 = (0..8)
+            .map(|i| reference[i] * (x[i] - mx[g[i] as usize]).powi(2))
+            .sum();
+        let xy: f64 = (0..8)
+            .map(|i| reference[i] * (x[i] - mx[g[i] as usize]) * (y[i] - my[g[i] as usize]))
+            .sum();
+        let beta = xy / xx;
+        let mean: f64 = (0..8).map(|i| reference[i] * x[i]).sum::<f64>() / nref;
+        let rss: f64 = (0..8)
+            .map(|i| {
+                reference[i]
+                    * ((y[i] - my[g[i] as usize]) - beta * (x[i] - mx[g[i] as usize])).powi(2)
+            })
+            .sum();
+        let effective = if kind == 1 { total } else { 8.0 };
+        let scale = rss / (effective - 3.0);
+        let oracle = [
+            scale / xx,
+            -scale * mean / xx,
+            -scale * mean / xx,
+            scale * (1.0 / nref + mean * mean / xx),
+        ];
+        assert_covariance_close(actual.covariance().values(), &oracle);
+        eprintln!(
+            "CENTERED_ESTIMATOR_IID|kind={kind}|rank={}|rss={:.17e}",
+            actual.fit().finite_rank(),
+            actual.statistics().rss
+        );
+    }
+}
