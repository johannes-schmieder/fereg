+#[test]
+fn centered_tiles_preserve_small_within_variation_and_exact_dependence() {
+    let base = 2.0_f64.powi(40);
+    let x = [base - 2.0, base - 1.0, base + 1.0, base + 2.0];
+    let twice = x.map(|v| 2.0 * v);
+    let constant = [base; 4];
+    let columns = [&x[..], &twice[..], &constant[..]];
+    let codes = [0; 4];
+    let index = LevelIndex::from_codes(&codes, 1).unwrap();
+    let source = ValidatedBorrowedInterceptSource::new(&codes, 1, &index).unwrap();
+    let effect = source.effect();
+    let centered = CenteredColumns::new(
+        &columns,
+        &effect,
+        BorrowedMapWeights::Unit,
+        24,
+        &mut SystemWorkspaceReservation,
+    )
+    .unwrap();
+    let mut values = [0.0; 12];
+    centered.fill_rows(0, &mut values).unwrap();
+    let mut square = 0.0;
+    for (row, expected) in values.chunks_exact(3).zip([-2.0, -1.0, 1.0, 2.0]) {
+        assert_eq!(row, &[expected, 2.0 * expected, 0.0]);
+        square += row[0] * row[0];
+    }
+    assert_eq!(square, 10.0);
+    // Independent exact arithmetic gives 10; uncentered product subtraction
+    // loses it at this representable between-group scale.
+    let raw = x.iter().map(|v| v * v).sum::<f64>() - x.iter().sum::<f64>().powi(2) / 4.0;
+    assert!((raw - 10.0).abs() > 1.0);
+}
