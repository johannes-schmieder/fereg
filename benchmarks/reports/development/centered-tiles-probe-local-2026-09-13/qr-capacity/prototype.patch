+        // Bind the new numerical inputs to the original immutable topology.
+        let actual =
+            BoundCenteredFrame::bind(&base, changed, config, 1 << 20, &mut SystemFitReservation)
+                .unwrap()
+                .unwrap();
+        let fresh_raw = fresh.fit_build_rhs().unwrap();
