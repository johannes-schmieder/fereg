+#[cfg(test)]
+fn checked_centered_estimator<P: PreparedOlsFitView + ?Sized>(
+    prepared: &P,
+    bound: &BoundCenteredFrame<'_>,
+    config: PreparedOlsFitConfig,
+    cache: usize,
+) -> CertifiedPreparedOlsFit {
+    let expected = fit_prepared_ols_coefficients_view_map_for_inference_with_cache_limit(
+        prepared, config, cache,
+    )
+    .unwrap();
+    let actual = fit_centered_frame(
+        prepared,
+        bound,
+        config,
+        Some(cache),
+        usize::MAX,
+        u64::MAX,
+        &mut SystemFitReservation,
+    )
+    .unwrap();
+    assert_eq!(actual.finite_rank(), expected.finite_rank());
+    assert_eq!(
+        actual.kept_generated_columns(),
+        expected.kept_generated_columns()
+    );
+    assert_eq!(
+        actual.dropped_generated_columns(),
+        expected.dropped_generated_columns()
+    );
+    assert_eq!(actual.bread().coordinates(), expected.bread().coordinates());
+    assert_eq!(
+        actual.bread().weight_scale(),
+        expected.bread().weight_scale()
+    );
+    assert_covariance_close(actual.bread().values(), expected.bread().values());
+    for (a, e) in actual.coefficients().iter().zip(expected.coefficients()) {
+        assert_eq!(a.status, e.status);
+        match (a.value, e.value) {
+            (Some(a), Some(e)) => assert!((a - e).abs() <= 1e-10 + 1e-7 * e.abs()),
+            (None, None) => {}
+            _ => panic!("centered reported coefficient presence changed"),
+        }
+    }
+    for (a, e) in actual.residuals().iter().zip(expected.residuals()) {
+        assert!(
+            (a - e).abs() <= 1e-9 + 1e-7 * e.abs(),
+            "centered residual mismatch: {a} vs {e}"
+        );
+    }
+    assert_eq!(
+        actual.initial_absorbed_outcome_sum_of_squares(),
+        expected.initial_absorbed_outcome_sum_of_squares()
+    );
+    for (a, e) in [
+        (actual.absorption_report(), expected.absorption_report()),
+        (
+            actual.residual_absorption_report(),
+            expected.residual_absorption_report(),
+        ),
+    ] {
+        assert!(a.certified());
+        assert_eq!(a.requested_solver, e.requested_solver);
+        assert_eq!(a.used_solver, e.used_solver);
+        assert_eq!(a.iterations, e.iterations);
+        assert_eq!(a.stop_reason, e.stop_reason);
+        assert_eq!(a.checkpoint_retries, e.checkpoint_retries);
+        assert_eq!(a.fallback_used, e.fallback_used);
+        assert_eq!(a.pilot_iterations, e.pilot_iterations);
+        assert_eq!(a.requested_preconditioner, e.requested_preconditioner);
+        assert_eq!(a.used_preconditioner, e.used_preconditioner);
+        assert_eq!(a.warnings, e.warnings);
+        assert!(a.setup_seconds.is_finite() && a.setup_seconds >= 0.0);
+        assert!(a.solve_seconds.is_finite() && a.solve_seconds >= 0.0);
+    }
+    match (&actual.fast_score_cache, &expected.fast_score_cache) {
+        (Some(a), Some(e)) => {
+            for column in 0..prepared.fit_model().columns.len() {
+                assert_eq!(a.mean(column), e.mean(column));
+            }
+        }
+        (None, None) => {}
+        _ => panic!("centered mean policy differs from actual matrix cache"),
+    }
+    let mut execution = actual.execution();
+    execution.scratch_bytes = 0;
+    assert_eq!(execution, expected.execution());
+    assert!(actual.rank_certificate().passed && actual.score_certificate().passed);
+    eprintln!(
+        "CENTERED_ESTIMATOR|rows={}|generated={}|rank={}|packed_requested={}|scratch_bytes={}",
+        bound.columns.rows(),
+        prepared.fit_model().columns.len(),
+        actual.finite_rank(),
+        cache != 0,
+        actual.execution().scratch_bytes
+    );
+    actual
+}
