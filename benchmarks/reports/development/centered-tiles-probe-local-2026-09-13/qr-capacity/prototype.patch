+struct BoundCenteredFrame<'a> {
+    frame: LinearSolveFrame<'a>,
+    columns: CenteredColumns<'a>,
+    raw: RawMomentCache,
+    #[cfg(test)]
+    projection_reference_norms: Vec<f64>,
+    within_norms: Vec<f64>,
+    certificate: FeCertificate,
+    charged_state_bytes: usize,
+    absorb_config: AbsorbConfig,
+    setup_seconds: f64,
+    solve_seconds: f64,
+}
+
+impl<'a> BoundCenteredFrame<'a> {
+    fn bind<P: PreparedOlsFitView + ?Sized, R: FitReservation>(
+        prepared: &'a P,
+        frame: LinearSolveFrame<'a>,
+        config: PreparedOlsFitConfig,
+        maximum_state_bytes: usize,
+        reservation: &mut R,
+    ) -> Result<Option<Self>> {
+        let started = Instant::now();
+        frame.validate_for(prepared)?;
+        validate_config(prepared, config)?;
+        if config.absorb.solver != FeSolverKind::Auto || config.absorb.retain_coefficients {
+            return Ok(None);
+        }
+        // Match the existing projector before allocating any centered state.
+        let divisor = frame
+            .weights
+            .values
+            .map_or(1.0, |v| v.iter().copied().fold(0.0_f64, f64::max));
+        if divisor != frame.weights.raw_scale {
+            return Ok(None);
+        }
+        if prepared.fit_model().columns.iter().any(|c| {
+            !matches!(
+                c.kind,
+                PreparedOlsColumnKind::Continuous { .. } | PreparedOlsColumnKind::Intercept
+            )
+        }) {
+            return Ok(None);
+        }
+        let Some(design) = prepared.fit_borrowed_intercept_map_design()? else {
+            return Ok(None);
+        };
+        if design.effects().len() != 1 {
+            return Ok(None);
+        }
+        let effect = design.effects()[0];
+        let width = prepared
+            .fit_model()
+            .columns
+            .len()
+            .checked_add(1)
+            .ok_or_else(|| allocation("centered frame width overflows"))?;
+        let means_bytes = effect
+            .n_levels()
+            .checked_mul(width)
+            .and_then(|v| v.checked_mul(8))
+            .ok_or_else(|| allocation("centered frame mean size overflows"))?;
+        let descriptor_bytes = width
+            .checked_mul(std::mem::size_of::<Option<&[f64]>>())
+            .ok_or_else(|| allocation("centered frame descriptor size overflows"))?;
+        if means_bytes
+            .checked_add(descriptor_bytes)
+            .is_none_or(|v| v > maximum_state_bytes)
+        {
+            return Err(allocation("centered frame exceeds its state budget"));
+        }
+        let mut capped = CappedReservation {
+            inner: reservation,
+            maximum_bytes: maximum_state_bytes - means_bytes,
+            charged_bytes: 0,
+        };
+        let mut columns = reserved_empty(&mut capped, width, "centered frame column descriptors")?;
+        push_reserved(
+            &mut columns,
+            Some(frame.response()),
+            "centered descriptor capacity exhausted",
+        )?;
+        for column in &prepared.fit_model().columns {
+            let values = match column.kind {
+                PreparedOlsColumnKind::Intercept => None,
+                PreparedOlsColumnKind::Continuous {
+                    prepared_source_index,
+                    ..
+                } => Some(
+                    prepared
+                        .fit_sample()
+                        .regressors
+                        .get(prepared_source_index)
+                        .filter(|v| v.len() == frame.response().len())
+                        .ok_or_else(|| invalid_argument("centered numeric source is not aligned"))?
+                        .as_slice(),
+                ),
+                _ => unreachable!(),
+            };
+            push_reserved(
+                &mut columns,
+                values,
+                "centered descriptor capacity exhausted",
+            )?;
+        }
+        let mut setup_seconds = started.elapsed().as_secs_f64();
+        let solve_started = Instant::now();
+        let columns = CenteredColumns::from_prepared_columns(
+            columns,
+            effect,
+            frame.raw_weights(),
+            means_bytes,
+        )?;
+        let mut solve_seconds = solve_started.elapsed().as_secs_f64();
+        let setup_started = Instant::now();
+        debug_assert_eq!(columns.weight_divisor(), frame.weights.raw_scale);
+        let raw = build_raw_moment_cache(&columns, frame.weights, &mut capped)?;
+        let projection_reference_norms =
+            columns.norms(true, true, capped.maximum_bytes - capped.charged_bytes)?;
+        capped.charged_bytes += projection_reference_norms.capacity() * 8;
+        setup_seconds += setup_started.elapsed().as_secs_f64();
+        let solve_started = Instant::now();
+        let within_norms =
+            columns.norms(false, true, capped.maximum_bytes - capped.charged_bytes)?;
+        capped.charged_bytes += within_norms.capacity() * 8;
+        let (certificate, certificate_bytes) = columns.projection_certificate_with_budget(
+            &projection_reference_norms,
+            &within_norms,
+            config.absorb.map.tolerance,
+            capped.maximum_bytes - capped.charged_bytes,
+        )?;
+        capped.charged_bytes += certificate_bytes;
+        if !certificate.passed {
+            // A single stored mean cannot represent every successive rounded
+            // projection. Decline from untouched inputs so the ordinary MAP
+            // caller retains its iteration budget and continuation policy.
+            return Ok(None);
+        }
+        solve_seconds += solve_started.elapsed().as_secs_f64();
+        Ok(Some(Self {
+            frame,
+            columns,
+            raw,
+            #[cfg(test)]
+            projection_reference_norms,
+            within_norms,
+            certificate,
+            absorb_config: config.absorb,
+            charged_state_bytes: means_bytes + capped.charged_bytes,
+            setup_seconds,
+            solve_seconds,
+        }))
+    }
+
+    #[cfg(test)]
+    fn standardized(&self) -> CenteredStandardized<'_> {
+        CenteredStandardized {
+            centered: &self.columns,
+            weights: self.frame.weights,
+            reference_norms: &self.raw.norms[1..],
+        }
+    }
+}
+
+/// Build a real coefficient result without a resident within matrix. This
+/// test-only entry retains the caller's finite reference policy; complete
+/// estimator admission and initial-certificate continuation remain unadopted.
+fn fit_centered_frame<P: PreparedOlsFitView + ?Sized, R: FitReservation>(
+    prepared: &P,
+    bound: &BoundCenteredFrame<'_>,
+    config: PreparedOlsFitConfig,
+    inference_cache_limit: Option<usize>,
+    maximum_fit_bytes: usize,
+    maximum_scratch_bytes: u64,
+    reservation: &mut R,
+) -> Result<CertifiedPreparedOlsFit> {
+    bound.frame.validate_for(prepared)?;
+    validate_config(prepared, config)?;
+    if config.absorb != bound.absorb_config
+        || config.absorb.solver != FeSolverKind::Auto
+        || config.absorb.retain_coefficients
+        || config.execution.mode != PreparedOlsExecutionMode::Fast
+    {
+        return Err(invalid_argument("centered estimator policy is unsupported"));
+    }
+    let design = prepared
+        .fit_borrowed_intercept_map_design()?
+        .ok_or_else(|| invalid_argument("centered estimator FE binding is absent"))?;
+    if design.effects().len() != 1 || !bound.columns.matches_effect(&design.effects()[0]) {
+        return Err(invalid_argument(
+            "centered estimator topology binding changed",
+        ));
+    }
+    for (column, recipe) in prepared.fit_model().columns.iter().enumerate() {
+        let values = match recipe.kind {
+            PreparedOlsColumnKind::Continuous {
+                prepared_source_index,
+                ..
+            } => Some(
+                prepared
+                    .fit_sample()
+                    .regressors
+                    .get(prepared_source_index)
+                    .ok_or_else(|| invalid_argument("centered estimator source is absent"))?
+                    .as_slice(),
+            ),
+            PreparedOlsColumnKind::Intercept => None,
+            _ => return Err(invalid_argument("centered estimator column recipe changed")),
+        };
+        if !bound.columns.matches_raw_column(column + 1, values) {
+            return Err(invalid_argument(
+                "centered estimator numeric binding changed",
+            ));
+        }
+    }
+    let weights = bound.frame.weights;
+    let packed = inference_cache_limit
+        .map(|limit| fast_score_cache_fits(prepared, limit))
+        .transpose()?
+        .unwrap_or(false);
+    let mut capped = CappedReservation {
+        inner: reservation,
+        maximum_bytes: maximum_fit_bytes,
+        charged_bytes: 0,
+    };
+    let generated = prepared.fit_model().columns.len();
+    let mut reference_norms = reserved_filled(
+        &mut capped,
+        generated,
+        0.0,
+        "centered estimator reference norms",
+    )?;
+    reference_norms
+        .par_iter_mut()
+        .enumerate()
+        .try_for_each(|(column, value)| -> Result<()> {
+            *value = if packed {
+                centered_norm(&bound.columns, column + 1, weights, true)?
+            } else {
+                bound.raw.norms[column + 1]
+            };
+            Ok(())
+        })?;
+    // Packed inference preserves its original partitioned raw means even when
+    // rank reduction later makes that cache ineligible for score storage.
+    let mut fast_score_cache = if packed {
+        Some(centered_packed_means(prepared, bound, &mut capped)?)
+    } else {
+        None
+    };
+    let (statuses, candidates) = classify_finite_candidates(
+        prepared,
+        &reference_norms,
+        &bound.within_norms[1..],
+        config,
+        &mut capped,
+    )?;
+    let source = CenteredStandardized {
+        centered: &bound.columns,
+        weights,
+        reference_norms: &reference_norms,
+    };
+    let attempted = if candidates.is_empty() {
+        None
+    } else {
+        let (rhs, gram) = centered_moments(&source, &candidates, usize::MAX, &mut capped)?;
+        let relative_threshold = config.rank_tolerance_multiplier
+            * f64::EPSILON
+            * bound.columns.rows().max(generated) as f64;
+        let attempted = try_fit_scaled_pivoted_cholesky(
+            &source,
+            weights,
+            bound.frame.bread_weight_scale,
+            &reference_norms,
+            &bound.within_norms[1..],
+            &candidates,
+            &statuses,
+            &gram,
+            &rhs,
+            relative_threshold,
+            config,
+            &mut capped,
+            false,
+            false,
+            true,
+        )?;
+        drop(rhs);
+        drop(gram);
+        attempted
+    };
+    let (mut qr, scratch_bytes, cholesky) = match attempted {
+        Some(qr) => (qr, 0, true),
+        None => {
+            let before = capped.charged_bytes;
+            let remaining = capped.maximum_bytes - before;
+            let fallback = centered_scratch_fallback(
+                prepared,
+                &source,
+                &bound.within_norms[1..],
+                bound.frame.bread_weight_scale,
+                config,
+                remaining,
+                maximum_scratch_bytes,
+                &mut capped,
+                |_| {},
+            )?;
+            // Include the scratch owner's independently checked I/O buffer,
+            // which does not allocate through the fit reservation delegate.
+            capped.charged_bytes = before
+                .checked_add(fallback.charged_fit_payload_bytes)
+                .ok_or_else(|| allocation("centered scratch charges overflow"))?;
+            (fallback.fit, fallback.scratch_bytes, false)
+        }
+    };
+    if inference_cache_limit.is_some() && !packed && cholesky {
+        let identities = &qr
+            .bread
+            .as_ref()
+            .ok_or_else(|| invalid_argument("centered finite bread is absent"))?
+            .generated_columns;
+        let mut generated_columns = reserved_empty(
+            &mut capped,
+            identities.len(),
+            "centered strided-policy identities",
+        )?;
+        generated_columns.extend_from_slice(identities);
+        let mut means = reserved_filled(
+            &mut capped,
+            identities.len(),
+            0.0,
+            "centered strided-policy means",
+        )?;
+        for (value, &column) in means.iter_mut().zip(identities) {
+            *value = bound.raw.means[column + 1];
+        }
+        fast_score_cache = Some(PreparedOlsFastScoreCache::CenteredMeans {
+            generated_columns,
+            means,
+        });
+    }
+    let raw_moments = (!packed).then_some(&bound.raw);
+    let mut raw_residuals =
+        if raw_moments.is_some() && qr.generated_coefficients.iter().any(Option::is_some) {
+            Some(build_independent_raw_residuals(
+                prepared,
+                bound.frame.response(),
+                &qr,
+                &mut capped,
+            )?)
+        } else {
+            None
+        };
+    let bread = finalize_reported_bread_and_intercept(
+        prepared,
+        bound.frame.response(),
+        &mut qr,
+        raw_residuals.as_deref_mut(),
+        weights,
+        config.bread_tolerance,
+        &mut capped,
+        FitPerturbations::default(),
+        fast_score_cache.as_ref(),
+        raw_moments,
+    )?;
+    drop(raw_residuals);
+    let initial_absorbed_outcome_sum_of_squares = bound.within_norms[0]
+        * bound.within_norms[0]
+        * bread.weight_scale().reference_weight_multiplier;
+    if !initial_absorbed_outcome_sum_of_squares.is_finite()
+        || initial_absorbed_outcome_sum_of_squares < 0.0
+    {
+        return Err(invalid_data(
+            "centered initial outcome sum of squares is invalid",
+        ));
+    }
+    let residual_matrix = DenseMatrix::from_row_major(
+        bound.columns.rows(),
+        1,
+        qr.within_residuals
+            .take()
+            .ok_or_else(|| invalid_argument("centered finite residual is absent"))?,
+    )?;
+    // Use the same warm residual entry as the matrix estimator. Its initial
+    // check and any subsequent polish remain independent of the initial tiles.
+    let residual_absorbed =
+        prepared.fit_absorb_matrix(bound.frame.raw_weights(), residual_matrix, config.absorb)?;
+    if !residual_absorbed.report().certified() {
+        return Err(invalid_data("centered final FE certificate failed"));
+    }
+    let (residuals, residual_absorption_report, residual_fe_coefficients) =
+        residual_absorbed.into_full_parts();
+    let score_certificate = certify_scores(
+        prepared,
+        residuals.as_slice(),
+        weights,
+        &reference_norms,
+        &bound.within_norms[1..],
+        qr.finite_score,
+        &qr.generated_statuses,
+        bound.within_norms[0],
+        config.score_tolerance,
+    )?;
+    if !score_certificate.passed {
+        return Err(invalid_data("centered final raw score certificate failed"));
+    }
+    let recovered_fe_coefficients = combine_recovered_fe_coefficients(
+        None,
+        residual_fe_coefficients,
+        residual_absorption_report.iterations,
+        &qr.generated_coefficients,
+        &mut capped,
+    )?;
+    let coefficients = build_coefficient_slots(prepared, &qr, &mut capped)?;
+    qr.kept.sort_unstable();
+    qr.dropped.sort_unstable();
+    let absorption_report = SolveReport {
+        requested_solver: FeSolverKind::Auto,
+        used_solver: FeSolverKind::Map,
+        iterations: 1,
+        checkpoint_retries: 0,
+        stop_reason: SolveStopReason::Certified,
+        certificate: bound.certificate.clone(),
+        normal_equation_residual: bound.certificate.relative_two_norm,
+        setup_seconds: bound.setup_seconds,
+        solve_seconds: bound.solve_seconds,
+        certification_seconds: 0.0,
+        fallback_used: false,
+        requested_preconditioner: None,
+        used_preconditioner: None,
+        pilot_iterations: 0,
+        pilot_contraction: 0.0,
+        warnings: Vec::new(),
+    };
+    if !absorption_report.certified() {
+        return Err(invalid_data("centered initial report is uncertified"));
+    }
+    Ok(CertifiedPreparedOlsFit {
+        coefficients,
+        kept_generated_columns: qr.kept,
+        dropped_generated_columns: qr.dropped,
+        finite_rank: qr.rank,
+        rank_certificate: qr.certificate,
+        score_certificate,
+        bread,
+        absorption_report,
+        residual_absorption_report,
+        initial_absorbed_outcome_sum_of_squares,
+        residuals,
+        recovered_fe_coefficients,
+        fast_score_cache,
+        execution: PreparedOlsExecutionReport {
+            mode: PreparedOlsExecutionMode::Fast,
+            poolsize: config.execution.poolsize,
+            scratch_bytes,
+            requested_threads: config.execution.threads.requested.map_or(0, |v| v.get()),
+            effective_threads: config.execution.threads.resolved(),
+            deterministic: config.execution.threads.deterministic,
+        },
+    })
+}
+
+/// Match packed-cache raw mean arithmetic without allocating its value array.
+fn centered_packed_means<P: PreparedOlsFitView + ?Sized, R: FitReservation>(
+    prepared: &P,
+    bound: &BoundCenteredFrame<'_>,
+    reservation: &mut R,
+) -> Result<PreparedOlsFastScoreCache> {
+    let mut generated_columns = reserved_empty(
+        reservation,
+        prepared.fit_model().columns.len(),
+        "centered packed-policy identities",
+    )?;
+    for (column, recipe) in prepared.fit_model().columns.iter().enumerate() {
+        if !matches!(recipe.kind, PreparedOlsColumnKind::Intercept) {
+            generated_columns.push(column);
+        }
+    }
+    let mut means = reserved_filled(
+        reservation,
+        generated_columns.len(),
+        0.0,
+        "centered packed-policy means",
+    )?;
+    if !generated_columns.is_empty() {
+        let nrows = bound.columns.rows();
+        let rows_per_chunk = nrows.div_ceil(
+            nrows
+                .div_ceil(PARALLEL_REDUCTION_CHUNK_ROWS)
+                .clamp(1, FUSED_MOMENT_MAX_BLOCKS),
+        );
+        let chunks = nrows.div_ceil(rows_per_chunk);
+        let stride = generated_columns
+            .len()
+            .checked_add(1)
+            .ok_or_else(|| allocation("centered mean stride overflows"))?;
+        let size = chunks
+            .checked_mul(stride)
+            .ok_or_else(|| allocation("centered mean partials overflow"))?;
+        let mut partials =
+            reserved_filled(reservation, size, 0.0, "centered packed-policy partials")?;
+        partials.par_chunks_mut(stride).enumerate().try_for_each(
+            |(chunk, partial)| -> Result<()> {
+                for row in chunk * rows_per_chunk..((chunk + 1) * rows_per_chunk).min(nrows) {
+                    let weight = bound.frame.weights.value(row)?;
+                    partial[0] += weight;
+                    for (cached, &column) in generated_columns.iter().enumerate() {
+                        let scale = bound.raw.scales[column + 1];
+                        if scale > 0.0 {
+                            partial[cached + 1] +=
+                                weight * (bound.columns.raw_value(row, column + 1) / scale);
+                        }
+                    }
+                }
+                if !partial.iter().all(|v| v.is_finite()) {
+                    return Err(invalid_data("centered raw mean partial is nonfinite"));
+                }
+                Ok(())
+            },
+        )?;
+        let (mut denominator, mut correction) = (0.0, 0.0);
+        for partial in partials.chunks_exact(stride) {
+            compensated_add(partial[0], &mut denominator, &mut correction)?;
+        }
+        let denominator = denominator + correction;
+        for (cached, &column) in generated_columns.iter().enumerate() {
+            let (mut mean, mut correction) = (0.0, 0.0);
+            for partial in partials.chunks_exact(stride) {
+                compensated_add(partial[cached + 1], &mut mean, &mut correction)?;
+            }
+            let scale = bound.raw.scales[column + 1];
+            means[cached] = if scale == 0.0 {
+                0.0
+            } else {
+                scale * ((mean + correction) / denominator)
+            };
+        }
+        if !denominator.is_finite() || denominator <= 0.0 || !means.iter().all(|v| v.is_finite()) {
+            return Err(invalid_data("centered raw mean is nonfinite"));
+        }
+    }
+    Ok(PreparedOlsFastScoreCache::CenteredMeans {
+        generated_columns,
+        means,
+    })
+}
+
+struct ScratchFallback {
+    fit: QrFit,
+    scratch_bytes: u64,
+    charged_fit_payload_bytes: usize,
+}
+
+// A cumulative reservation bound is conservative: it charges allocations even
+// after their owners are dropped. This probe does not yet relax that bound to
+// the overlapping lifetimes in the estimator's ordinary memory model.
+struct CappedReservation<'a, R> {
+    inner: &'a mut R,
+    maximum_bytes: usize,
+    charged_bytes: usize,
+}
+
+impl<R: FitReservation> FitReservation for CappedReservation<'_, R> {
+    fn reserve<T>(
+        &mut self,
+        target: &mut Vec<T>,
+        elements: usize,
+        label: &'static str,
+    ) -> Result<()> {
+        if !target.is_empty() || target.capacity() != 0 {
+            return Err(invalid_argument(
+                "centered scratch reservation requires a fresh owner",
+            ));
+        }
+        let bytes = elements
+            .checked_mul(std::mem::size_of::<T>())
+            .ok_or_else(|| allocation("centered scratch reservation size overflows"))?;
+        if bytes > self.maximum_bytes.saturating_sub(self.charged_bytes) {
+            return Err(allocation(
+                "centered scratch reservation exceeds its budget",
+            ));
+        }
+        self.inner.reserve(target, elements, label)?;
+        let bytes = target
+            .capacity()
+            .checked_mul(std::mem::size_of::<T>())
+            .ok_or_else(|| allocation("centered scratch capacity bytes overflow"))?;
+        if bytes > self.maximum_bytes.saturating_sub(self.charged_bytes) {
+            return Err(allocation("centered scratch capacity exceeds its budget"));
+        }
+        self.charged_bytes += bytes;
+        Ok(())
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn centered_scratch_fallback<P: PreparedOlsFitView + ?Sized, R: FitReservation>(
+    prepared: &P,
+    source: &CenteredStandardized<'_>,
+    score_norms: &[f64],
+    bread_weight_scale: PreparedOlsBreadWeightScale,
+    config: PreparedOlsFitConfig,
+    maximum_allocation_bytes: usize,
+    maximum_scratch_bytes: u64,
+    reservation: &mut R,
+    _observe_created: impl FnOnce(&std::path::Path),
+) -> Result<ScratchFallback> {
+    let rows = source.centered.rows();
+    let columns = source.reference_norms.len();
+    if rows != prepared.fit_sample().n_active()
+        || columns != prepared.fit_model().columns.len()
+        || source.centered.width() != columns + 1
+        || score_norms.len() != columns
+    {
+        return Err(invalid_argument(
+            "centered scratch source axes are inconsistent",
+        ));
+    }
+    let scratch_bytes = rows
+        .checked_mul(columns)
+        .and_then(|v| u64::try_from(v).ok())
+        .and_then(|v| v.checked_mul(8))
+        .ok_or_else(|| allocation("centered scratch file size overflows"))?;
+    if scratch_bytes > maximum_scratch_bytes {
+        return Err(allocation("centered scratch file exceeds its budget"));
+    }
+    // QR transfers one column at a time. Bound the existing I/O buffer by
+    // that transfer size, and include its actual capacity below as well.
+    let io_bytes = rows
+        .checked_mul(8)
+        .ok_or_else(|| allocation("centered scratch column bytes overflow"))?
+        .min(1 << 20)
+        .max(8);
+    let staging_bytes = rows
+        .checked_mul(16)
+        .and_then(|v| v.checked_add(io_bytes))
+        .ok_or_else(|| allocation("centered scratch staging size overflows"))?;
+    if staging_bytes > maximum_allocation_bytes {
+        return Err(allocation("centered scratch staging exceeds its budget"));
+    }
+    let mut capped = CappedReservation {
+        inner: reservation,
+        maximum_bytes: maximum_allocation_bytes,
+        charged_bytes: 0,
+    };
+    let mut outcome = reserved_filled(&mut capped, rows, 0.0, "centered scratch outcome")?;
+    let mut column = reserved_filled(&mut capped, rows, 0.0, "centered scratch column")?;
+    let mut scratch = PreparedOlsScratch::create_with_column_buffer(rows, columns)?;
+    #[cfg(test)]
+    _observe_created(scratch.identity_path());
+    let capacity = scratch.io_buffer_capacity();
+    if capacity > capped.maximum_bytes.saturating_sub(capped.charged_bytes) {
+        return Err(allocation(
+            "centered scratch I/O capacity exceeds its budget",
+        ));
+    }
+    capped.charged_bytes += capacity;
+    for (row, value) in outcome.iter_mut().enumerate() {
+        *value = source.centered.value(row, 0);
+    }
+    for generated in 0..columns {
+        for (row, value) in column.iter_mut().enumerate() {
+            *value = source.centered.value(row, generated + 1);
+        }
+        scratch.write_column(generated, &column)?;
+    }
+    drop(column);
+    let mut fit = fit_scaled_pivoted_qr_low(
+        prepared,
+        &mut scratch,
+        &mut outcome,
+        source.weights,
+        bread_weight_scale,
+        source.reference_norms,
+        score_norms,
+        config,
+        &mut capped,
+        false,
+        false,
+    )?;
+    let scratch_bytes = scratch.bytes();
+    drop(scratch);
+    drop(outcome);
+    // The scratch factorization consumes its within columns. Reconstruct from
+    // the immutable centered source; final independent FE/score certification
+    // belongs to the estimator and remains necessary before publication.
+    let mut residuals = reserved_filled(&mut capped, rows, 0.0, "centered scratch residuals")?;
+    residuals
+        .par_iter_mut()
+        .enumerate()
+        .try_for_each(|(row, residual)| -> Result<()> {
+            let mut value = source.centered.value(row, 0);
+            for (generated, coefficient) in fit.generated_coefficients.iter().enumerate() {
+                if let Some(coefficient) = coefficient {
+                    value =
+                        (-*coefficient).mul_add(source.centered.value(row, generated + 1), value);
+                }
+            }
+            if !value.is_finite() {
+                return Err(invalid_data("centered scratch residual is not finite"));
+            }
+            *residual = value;
+            Ok(())
+        })?;
+    fit.within_residuals = Some(residuals);
+    Ok(ScratchFallback {
+        fit,
+        scratch_bytes,
+        charged_fit_payload_bytes: capped.charged_bytes,
+    })
+}
