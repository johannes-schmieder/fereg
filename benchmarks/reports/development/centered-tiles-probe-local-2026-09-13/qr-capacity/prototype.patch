+        }
+    }
+    let groups = 4099_usize;
+    let rows = groups * 4;
+    let codes: Vec<u32> = (0..rows).map(|row| (row / 4) as u32).collect();
+    let index = LevelIndex::from_codes(&codes, groups).unwrap();
+    let source = ValidatedBorrowedInterceptSource::new(&codes, groups, &index).unwrap();
+    let raw_weights: Vec<f64> = (0..rows).map(|row| [0.5, 2.0, 3.0, 7.0][row % 4]).collect();
+    let bytes = groups.div_ceil(OLS_CERTIFICATE_GROUP_CHUNK) * 3 * 8;
+    assert_eq!(
+        bytes, 120,
+        "last partial must include the three tail groups"
+    );
+    for width in [1, 65] {
+        let values: Vec<Vec<f64>> = (0..width)
+            .map(|column| {
+                (0..rows)
+                    .map(|row| {
+                        (row / 4) as f64 * 16.0
+                            + ((row % 4) as f64 - 1.5) * (column + 1) as f64
+                            + 0.1 * (row as f64 * (column + 1) as f64).sin()
+                    })
+                    .collect()
+            })
+            .collect();
+        let columns: Vec<&[f64]> = values.iter().map(Vec::as_slice).collect();
+        for weighted in [false, true] {
+            let weights = if weighted {
+                BorrowedMapWeights::Provided(&raw_weights)
+            } else {
+                BorrowedMapWeights::Unit
+            };
+            let effect = source.effect();
+            let mut centered = CenteredColumns::new(
+                &columns,
+                &effect,
+                weights,
+                groups * width * 8,
+                &mut SystemWorkspaceReservation,
+            )
+            .unwrap();
+            let reference = centered.norms(true, true, usize::MAX).unwrap();
+            let current = centered.norms(false, true, usize::MAX).unwrap();
+            for corrupted in [false, true] {
+                if corrupted {
+                    centered.means[0] += 0.125;
+                }
+                let serial = centered
+                    .projection_certificate(&reference, &current, 1e-10)
+                    .unwrap();
+                if corrupted {
+                    assert!(!serial.passed);
+                }
+                for workers in [1, 4, 16] {
+                    let pool = rayon::ThreadPoolBuilder::new()
+                        .num_threads(workers)
+                        .build()
+                        .unwrap();
+                    pool.install(|| {
+                        for budget in [0, bytes - 1, bytes] {
+                            let mut reservation = RecordingReservation::default();
+                            let (actual, charged) = centered
+                                .projection_certificate_reserved(
+                                    &reference,
+                                    &current,
+                                    1e-10,
+                                    budget,
+                                    &mut reservation,
+                                )
+                                .unwrap();
+                            assert_eq!(
+                                actual.absolute_infinity_norm,
+                                serial.absolute_infinity_norm
+                            );
+                            assert_eq!(
+                                actual.relative_infinity_norm,
+                                serial.relative_infinity_norm
+                            );
+                            assert_eq!(actual.passed, serial.passed);
+                            assert!(
+                                (actual.relative_two_norm - serial.relative_two_norm).abs()
+                                    <= 1e-12 * serial.relative_two_norm.max(1e-100)
+                            );
+                            let expected_bytes = if workers > 1 && budget == bytes {
+                                bytes
+                            } else {
+                                0
+                            };
+                            assert_eq!(charged, expected_bytes);
+                            assert_eq!(reservation.calls, usize::from(expected_bytes > 0));
+                            let repeated = centered
+                                .projection_certificate_with_budget(
+                                    &reference, &current, 1e-10, budget,
+                                )
+                                .unwrap();
+                            assert_eq!(repeated.0, actual, "fixed partitions must be reproducible");
+                            if expected_bytes > 0 {
+                                let mut failure = RecordingReservation {
+                                    fail: true,
+                                    ..Default::default()
+                                };
+                                assert_eq!(
+                                    centered
+                                        .projection_certificate_reserved(
+                                            &reference,
+                                            &current,
+                                            1e-10,
+                                            budget,
+                                            &mut failure
+                                        )
+                                        .unwrap_err()
+                                        .code,
+                                    ErrorCode::Allocation
+                                );
+                                assert_eq!(failure.calls, 1);
+                                assert_eq!(
+                                    centered
+                                        .projection_certificate_reserved(
+                                            &reference,
+                                            &current,
+                                            1e-10,
+                                            budget,
+                                            &mut ExtraCapacity,
+                                        )
+                                        .unwrap_err()
+                                        .code,
+                                    ErrorCode::Allocation
+                                );
+                            }
+                        }
+                    });
+                }
+            }
+        }
+    }
