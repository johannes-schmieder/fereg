+fn centered_parallel_certificate_preserves_acceptance_and_bounds_partial_capacity() {
+    struct ExtraCapacity;
+    impl WorkspaceReservation for ExtraCapacity {
+        fn reserve_f64(
+            &mut self,
+            target: &mut Vec<f64>,
+            elements: usize,
+            _: &'static str,
+        ) -> Result<()> {
+            target
+                .try_reserve_exact(elements + 1)
