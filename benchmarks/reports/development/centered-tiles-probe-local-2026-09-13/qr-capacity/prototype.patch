+//! Current-frame centered storage for the existing OLS covariance consumers.
+use super::*;
+use crate::fe::CenteredColumns;
+use crate::ols::PreparedOlsColumnKind;
+
+#[derive(Debug)]
+pub(super) struct CenteredScoreStorage<'a> {
+    source: &'a CenteredColumns<'a>,
+    generated_columns: Vec<usize>,
+}
+
+impl CenteredScoreStorage<'_> {
+    pub(super) fn value(&self, row: usize, finite: usize) -> Result<f64> {
+        let generated = *self
+            .generated_columns
+            .get(finite)
+            .ok_or_else(|| invalid_argument("centered score finite coordinate is absent"))?;
+        if row >= self.source.rows() || generated + 1 >= self.source.width() {
+            return Err(invalid_argument("centered score axes are inconsistent"));
+        }
+        let value = self.source.value(row, generated + 1);
+        if !value.is_finite() {
+            return Err(invalid_data("centered score value is nonfinite"));
+        }
+        Ok(value)
+    }
+
+    pub(super) fn fill_row(&self, row: usize, output: &mut [f64]) -> Result<()> {
+        if output.len() != self.generated_columns.len() {
+            return Err(invalid_argument("centered score row width is inconsistent"));
+        }
+        for (finite, value) in output.iter_mut().enumerate() {
+            *value = self.value(row, finite)?;
+        }
+        Ok(())
+    }
+}
