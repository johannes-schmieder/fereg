+fn centered_scores_preserve_cluster_covariance_nesting_and_final_samples() {
+    use super::super::prepared_clustered::{
+        compose_centered_probe, fit_prepared_ols_clustered_map, PreparedOlsClusteredConfig,
+    };
+    use super::super::prepared_scores::SystemPreparedInferenceReservation;
