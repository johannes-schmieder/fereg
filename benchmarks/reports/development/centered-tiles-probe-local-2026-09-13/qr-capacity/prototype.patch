+            assert!(fit.generated_coefficients.iter().all(Option::is_none));
+            assert_eq!(
+                fit.generated_statuses,
+                vec![PreparedOlsFitStatus::CollinearWithFixedEffects]
+            );
+            assert!(fit.bread.unwrap().values.is_empty());
+            assert_eq!(
+                fit.within_residuals.unwrap(),
+                vec![-2.0, -1.0, 1.0, 2.0, -2.0, -1.0, 1.0, 2.0]
+            );
+        }
+    }
+}
