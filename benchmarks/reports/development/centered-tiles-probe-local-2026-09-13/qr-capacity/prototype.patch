+#[cfg(test)]
+fn native_entrypoint_orthogonal_oracle(large_mean: bool) {
+    use crate::metadata::SourceId;
+    use crate::ols::*;
+    let rows = 16_384;
+    let columns = 16;
+    let walsh = |row: usize, column: usize| {
+        if (row & column).count_ones() % 2 == 0 {
+            1.0
+        } else {
+            -1.0
+        }
+    };
+    let groups: Vec<f64> = (0..rows).map(|r| (r / 256) as f64).collect();
+    let x: Vec<Vec<f64>> = (1..=columns)
+        .map(|j| {
+            (0..rows)
+                .map(|r| (if large_mean { 16384.0 } else { 0.0 }) + 3.0 * groups[r] + walsh(r, j))
+                .collect()
+        })
+        .collect();
+    let y: Vec<f64> = (0..rows)
+        .map(|r| {
+            (1..=columns).fold(1e4 + 4.0 * groups[r] + walsh(r, 31), |v, j| {
+                v + j as f64 / 32.0 * walsh(r, j)
+            })
+        })
+        .collect();
+    let w: Vec<f64> = groups.iter().map(|g| 1.0 + g % 3.0).collect();
+    let compare = |actual: &CertifiedPreparedOlsFit, expected: &CertifiedPreparedOlsFit| {
+        assert_eq!(actual.finite_rank(), columns);
+        assert_eq!(
+            actual.kept_generated_columns(),
+            expected.kept_generated_columns()
+        );
+        for (j, (a, e)) in actual
+            .coefficients()
+            .iter()
+            .zip(expected.coefficients())
+            .enumerate()
+        {
+            assert_eq!(a.status, e.status);
+            assert_eq!(a.value.is_some(), e.value.is_some());
+            if let (Some(a), Some(e)) = (a.value, e.value) {
+                assert!((a - e).abs() <= 1e-10 + 1e-7 * e.abs());
+                if j < columns {
+                    assert!((a - (j + 1) as f64 / 32.0).abs() < 1e-9);
+                }
+            }
+        }
+        for (r, (&a, &e)) in actual
+            .residuals()
+            .iter()
+            .zip(expected.residuals())
+            .enumerate()
+        {
+            assert!((a - e).abs() < 1e-9);
+            assert!((a - walsh(r, 31)).abs() < 1e-9);
+        }
+    };
+    for kind in 0..if large_mean { 1 } else { 4 } {
+        let weights = match kind {
+            1 => TestWeights::Frequency(&w),
+            2 => TestWeights::Analytic(&w),
+            3 => TestWeights::Probability(&w),
+            _ => TestWeights::Unit,
+        };
+        let (request, loaded) = super::tests::prepared_inputs(
+            &y,
+            &x,
+            &vec![false; columns],
+            Some(&groups),
+            true,
+            weights,
+        );
+        let prepared = prepare_ols_data(&request, &loaded).unwrap();
+        let categorical = crate::prepare_categorical_ols_data(&request, &loaded).unwrap();
+        let mut config = PreparedOlsFitConfig::default();
+        config.execution.threads = ThreadConfig::from_requested(4, false).unwrap();
+        let mut matrix = config;
+        matrix.absorb.solver = FeSolverKind::Map;
+        let eligible = ThreadTeam::new(config.execution.threads)
+            .install(|| {
+                try_centered_ols_in_team(&prepared, config, None, |fit, _| {
+                    assert_eq!(fit.finite_rank(), columns);
+                    Ok(())
+                })
+            })
+            .unwrap()
+            .unwrap();
+        assert!(eligible.0.is_some());
+        if kind != 3 {
+            let policy = PreparedOlsUnadjustedConfig {
+                fit: config,
+                ..Default::default()
+            };
+            let reference = PreparedOlsUnadjustedConfig {
+                fit: matrix,
+                ..policy
+            };
+            let actual = fit_prepared_ols_unadjusted_map(&prepared, policy).unwrap();
+            let expected = fit_prepared_ols_unadjusted_map(&prepared, reference).unwrap();
+            compare(actual.fit(), expected.fit());
+            assert_eq!(actual.dof(), expected.dof());
+            assert_covariance_close(actual.covariance().values(), expected.covariance().values());
+            let actual = fit_prepared_categorical_ols_unadjusted_map(&categorical, policy).unwrap();
+            let expected =
+                fit_prepared_categorical_ols_unadjusted_map(&categorical, reference).unwrap();
+            compare(actual.fit(), expected.fit());
+            assert_covariance_close(actual.covariance().values(), expected.covariance().values());
+        }
+        let policy = PreparedOlsRobustConfig {
+            fit: config,
+            ..Default::default()
+        };
+        let reference = PreparedOlsRobustConfig {
+            fit: matrix,
+            ..policy
+        };
+        let actual = fit_prepared_ols_robust_map(&prepared, policy);
+        let expected = fit_prepared_ols_robust_map(&prepared, reference);
+        eprintln!(
+            "CENTERED_NATIVE_ROBUST|kind={kind}|actual_error={:?}|matrix_error={:?}",
+            actual.as_ref().err(),
+            expected.as_ref().err()
+        );
+        if large_mean {
+            let actual_error = actual.unwrap_err();
+            let expected_error = expected.unwrap_err();
+            assert_eq!(actual_error.code, ErrorCode::InvalidData);
+            assert_eq!(actual_error.code, expected_error.code);
+            assert_eq!(actual_error.message, expected_error.message);
+            assert_eq!(
+                actual_error.message,
+                "prepared robust covariance or statistic certificate did not pass"
+            );
+            let actual = fit_prepared_categorical_ols_robust_map(&categorical, policy).unwrap_err();
+            let expected =
+                fit_prepared_categorical_ols_robust_map(&categorical, reference).unwrap_err();
+            assert_eq!(actual.code, expected.code);
+            assert_eq!(actual.message, expected.message);
+            eprintln!("CENTERED_NATIVE_LARGE_MEAN|iid_comparisons=2|robust_rejections=2");
+            continue;
+        }
+        let actual = actual.unwrap();
+        let expected = expected.unwrap();
+        compare(actual.fit(), expected.fit());
+        assert_eq!(actual.dof(), expected.dof());
+        assert_covariance_close(actual.covariance().values(), expected.covariance().values());
+        let actual = fit_prepared_categorical_ols_robust_map(&categorical, policy).unwrap();
+        let expected = fit_prepared_categorical_ols_robust_map(&categorical, reference).unwrap();
+        compare(actual.fit(), expected.fit());
+        assert_covariance_close(actual.covariance().values(), expected.covariance().values());
+        let cluster_request = OlsClusteredRequestV1 {
+            ols: request,
+            clusters: vec![OlsClusterTermV1 {
+                label: "g".into(),
+                sources: vec![SourceId::new(u32::try_from(columns + 1).unwrap()).unwrap()],
+            }],
+        };
+        let clustered = prepare_ols_clustered_data(&cluster_request, &loaded).unwrap();
+        let categorical =
+            prepare_categorical_ols_clustered_data(&cluster_request, &loaded).unwrap();
+        let policy = PreparedOlsClusteredConfig {
+            fit: config,
+            ..Default::default()
+        };
+        let reference = PreparedOlsClusteredConfig {
+            fit: matrix,
+            ..policy
+        };
+        let actual = fit_prepared_ols_clustered_map(&clustered, policy).unwrap();
+        let expected = fit_prepared_ols_clustered_map(&clustered, reference).unwrap();
+        compare(actual.fit(), expected.fit());
+        assert_eq!(actual.dof(), expected.dof());
+        assert_covariance_close(actual.covariance().values(), expected.covariance().values());
+        let actual = fit_prepared_categorical_ols_clustered_map(&categorical, policy).unwrap();
+        let expected = fit_prepared_categorical_ols_clustered_map(&categorical, reference).unwrap();
+        compare(actual.fit(), expected.fit());
+        assert_covariance_close(actual.covariance().values(), expected.covariance().values());
+        eprintln!("CENTERED_NATIVE|rows={rows}|finite_columns={columns}|weight_kind={kind}|covariance_comparisons={}", if kind==3 {4} else {6});
+    }
+}
