+//! Unadopted P5 primitive. Compiled only in tests until estimator-level rank,
+//! inference, memory admission and command comparisons have been established.
+
+use super::*;
+use crate::fe::{BorrowedInterceptEffect, LevelIndex, ValidatedBorrowedInterceptSource};
+
+struct CenteredColumns<'a> {
+    columns: &'a [&'a [f64]],
+    effect: &'a BorrowedInterceptEffect<'a>,
+    means: Vec<f64>,
+}
+
+impl<'a> CenteredColumns<'a> {
+    fn new<R: WorkspaceReservation>(
+        columns: &'a [&'a [f64]],
+        effect: &'a BorrowedInterceptEffect<'a>,
+        weights: BorrowedMapWeights<'_>,
+        maximum_mean_bytes: usize,
+        reservation: &mut R,
+    ) -> Result<Self> {
+        let rows = effect.codes().len();
+        if rows == 0 || columns.is_empty() || columns.iter().any(|c| c.len() != rows) {
+            return Err(invalid_argument(
+                "centered columns require aligned nonempty inputs",
+            ));
+        }
+        let elements = effect
+            .n_levels()
+            .checked_mul(columns.len())
+            .ok_or_else(|| allocation("centered group means overflow"))?;
+        let bytes = elements
+            .checked_mul(std::mem::size_of::<f64>())
+            .ok_or_else(|| allocation("centered group mean bytes overflow"))?;
+        if bytes > maximum_mean_bytes {
+            return Err(allocation(
+                "centered group means exceed their workspace budget",
+            ));
+        }
+        let weights = validate_weights(weights, rows)?;
+        if columns.iter().any(|c| c.iter().any(|v| !v.is_finite())) {
+            return Err(invalid_data("centered source contains a nonfinite value"));
+        }
+        let mut means = reserved_zeros(
+            elements,
+            reservation,
+            "unable to reserve centered group means",
+        )?;
+        if means.capacity() > maximum_mean_bytes / std::mem::size_of::<f64>() {
+            return Err(allocation(
+                "centered group mean capacity exceeds its budget",
+            ));
+        }
+        // Each finalized group keeps its membership order. Reuse the existing
+        // scaled/compensated mean arithmetic, including above-64 RHS blocks.
+        means
+            .par_chunks_mut(columns.len())
+            .enumerate()
+            .try_for_each(|(level, destination)| -> Result<()> {
+                for (block, output) in destination.chunks_mut(PARALLEL_GROUP_MAX_RHS).enumerate() {
+                    let start = block * PARALLEL_GROUP_MAX_RHS;
+                    fused_group_means_by_value(
+                        effect,
+                        level,
+                        weights,
+                        rows,
+                        output,
+                        |row, rhs| columns[start + rhs][row],
+                    )?;
+                }
+                Ok(())
+            })?;
+        Ok(Self {
+            columns,
+            effect,
+            means,
+        })
+    }
+
+    fn fill_rows(&self, start: usize, output: &mut [f64]) -> Result<()> {
+        let width = self.columns.len();
+        let rows = output.len() / width;
+        if output.len() % width != 0
+            || start
+                .checked_add(rows)
+                .is_none_or(|end| end > self.effect.codes().len())
+        {
+            return Err(invalid_argument(
+                "centered row tile is outside its source axis",
+            ));
+        }
+        for (offset, values) in output.chunks_exact_mut(width).enumerate() {
+            let row = start + offset;
+            let level = self.effect.codes()[row] as usize;
+            for (column, value) in values.iter_mut().enumerate() {
+                *value = self.columns[column][row] - self.means[level * width + column];
+                if !value.is_finite() {
+                    return Err(invalid_data("centered row value is not finite"));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[test]
+fn centered_tiles_match_existing_projection_across_widths_weights_and_workers() {
+    let rows = 257;
+    let codes: Vec<u32> = (0..rows).map(|r| ((r * 7) % 17) as u32).collect();
+    let index = LevelIndex::from_codes(&codes, 17).unwrap();
+    let source = ValidatedBorrowedInterceptSource::new(&codes, 17, &index).unwrap();
+    let effect = source.effect();
+    for workers in [1, 4, 16] {
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap();
+        pool.install(|| {
+            for width in [1, 2, 17, 64, 65, 129] {
+                let columns: Vec<Vec<f64>> = (0..width)
+                    .map(|c| {
+                        (0..rows)
+                            .map(|r| {
+                                let between = f64::from(codes[r]) * 10_000.0;
+                                between + (((r + 1) * (c + 3)) as f64 * 0.17).sin()
+                            })
+                            .collect()
+                    })
+                    .collect();
+                let views: Vec<&[f64]> = columns.iter().map(Vec::as_slice).collect();
+                let supplied: Vec<f64> = (0..rows)
+                    .map(|r| match r % 3 {
+                        0 => 2.0_f64.powi(-100),
+                        1 => 1.0,
+                        _ => 2.0_f64.powi(100),
+                    })
+                    .collect();
+                for weights in [
+                    BorrowedMapWeights::Unit,
+                    BorrowedMapWeights::Provided(&supplied),
+                ] {
+                    let centered = CenteredColumns::new(
+                        &views,
+                        &effect,
+                        weights,
+                        17 * width * 8,
+                        &mut SystemWorkspaceReservation,
+                    )
+                    .unwrap();
+                    assert!(centered.means.capacity() <= 17 * width);
+                    let design =
+                        BorrowedInterceptFeDesign::new(rows, vec![source.effect()]).unwrap();
+                    let expected = absorb_borrowed_intercept_map_certified(
+                        &design,
+                        weights,
+                        DenseMatrix::from_columns(&columns).unwrap(),
+                        MapConfig::default(),
+                    )
+                    .unwrap();
+                    for tile_rows in [1, 17, 128] {
+                        let mut tile = vec![0.0; tile_rows * width];
+                        for start in (0..rows).step_by(tile_rows) {
+                            let count = tile_rows.min(rows - start);
+                            centered
+                                .fill_rows(start, &mut tile[..count * width])
+                                .unwrap();
+                            assert_eq!(
+                                &tile[..count * width],
+                                &expected.residualized().as_slice()
+                                    [start * width..(start + count) * width]
+                            );
+                        }
+                    }
+                }
+            }
+        });
+    }
+}
