+#[test]
+fn centered_finite_wide_workspace_does_not_grow_with_observations() {
+    struct CountReservation {
+        elements: usize,
+    }
+    impl FitReservation for CountReservation {
+        fn reserve<T>(
+            &mut self,
+            target: &mut Vec<T>,
+            elements: usize,
+            label: &'static str,
+        ) -> Result<()> {
+            self.elements += elements;
+            SystemFitReservation.reserve(target, elements, label)
+        }
+    }
+    let pool = rayon::ThreadPoolBuilder::new()
+        .num_threads(4)
+        .build()
+        .unwrap();
+    pool.install(|| {
+        let dimension = 65;
+        let layout = prepared_moment_layout(512, dimension).unwrap();
+        assert_eq!(layout.partial_elements, 0, "no blocks*K^2 bank above 64");
+        let bound =
+            layout.partitions * TILE_ROWS * (dimension + 1) + dimension + dimension * dimension;
+        for rows in [512, 1024] {
+            let codes: Vec<u32> = (0..rows).map(|r| (r % 2) as u32).collect();
+            let columns: Vec<Vec<f64>> = (0..=dimension)
+                .map(|c| (0..rows).map(|r| ((c + r) % 7) as f64).collect())
+                .collect();
+            let views: Vec<&[f64]> = columns.iter().map(Vec::as_slice).collect();
+            let index = LevelIndex::from_codes(&codes, 2).unwrap();
+            let membership = ValidatedBorrowedInterceptSource::new(&codes, 2, &index).unwrap();
+            let effect = membership.effect();
+            let centered = CenteredColumns::prepare(
+                &views,
+                &effect,
+                BorrowedMapWeights::Unit,
+                2 * (dimension + 1) * 8,
+            )
+            .unwrap();
+            let norms = vec![1.0; dimension];
+            let source = CenteredStandardized {
+                centered: &centered,
+                weights: NormalizedWeights {
+                    values: None,
+                    raw_scale: 1.0,
+                    kind: None,
+                },
+                reference_norms: &norms,
+            };
+            let mut reservation = CountReservation { elements: 0 };
+            centered_moments(
+                &source,
+                &(0..dimension).collect::<Vec<_>>(),
+                bound * 8,
+                &mut reservation,
+            )
+            .unwrap();
+            assert_eq!(reservation.elements, bound);
+        }
+        assert_eq!(
+            prepared_moment_layout(usize::MAX, 64).unwrap().partitions,
+            64
+        );
+        // Wide layout metadata needs no square allocation; its consumer checks
+        // the Gram size before requesting storage.
+        assert!(checked_square(usize::MAX, "Gram overflow control").is_err());
+    });
+}
