+#[derive(Default)]
+struct RecordingReservation {
+    calls: usize,
+    elements: usize,
+    fail: bool,
+}
+impl WorkspaceReservation for RecordingReservation {
+    fn reserve_f64(
+        &mut self,
+        target: &mut Vec<f64>,
+        elements: usize,
+        _: &'static str,
+    ) -> Result<()> {
+        self.calls += 1;
+        self.elements += elements;
+        if self.fail {
+            return Err(allocation("injected centered reservation failure"));
+        }
+        target
+            .try_reserve_exact(elements)
+            .map_err(|_| allocation("centered test reservation failed"))
+    }
+}
