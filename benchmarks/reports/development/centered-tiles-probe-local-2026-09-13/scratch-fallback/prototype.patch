+    fn standardized_residual(
+        &self,
+        row: usize,
+        candidates: &[usize],
+        coefficients: &[f64],
+    ) -> Result<f64> {
+        let values = &self.as_slice()[row * self.ncols()..(row + 1) * self.ncols()];
+        let mut value = values[0];
+        for (position, generated) in candidates.iter().copied().enumerate() {
+            value = (-coefficients[position]).mul_add(values[generated + 1], value);
+        }
+        Ok(value)
+    }
+    fn standardized_within_is_reusable(&self) -> bool {
+        true
+    }
+}
