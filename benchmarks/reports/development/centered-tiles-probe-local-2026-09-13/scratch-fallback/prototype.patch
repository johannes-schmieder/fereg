+fn run_case(rows: usize, columns: usize, kind: usize, dependence: Option<f64>) {
+    let codes: Vec<u32> = (0..rows).map(|r| (r % 17) as u32).collect();
+    let groups: Vec<f64> = codes.iter().map(|&g| f64::from(g)).collect();
+    let mut state = 0x9e37_79b9_7f4a_7c15_u64;
+    let mut regressors: Vec<Vec<f64>> = (0..columns)
+        .map(|_| {
+            (0..rows)
+                .map(|r| {
+                    state = state
+                        .wrapping_mul(6_364_136_223_846_793_005)
+                        .wrapping_add(1_442_695_040_888_963_407);
+                    ((state >> 11) as f64) / ((1_u64 << 53) as f64) - 0.5 + 0.1 * groups[r]
+                })
+                .collect()
+        })
+        .collect();
+    if let Some(perturbation) = dependence {
+        for row in 0..rows {
+            regressors[columns - 1][row] =
+                regressors[0][row] + perturbation * regressors[columns - 1][row];
+        }
+    }
+    // An exactly absorbed interior slot exercises indexed candidate mappings.
+    regressors.insert(1, groups.clone());
+    let outcome: Vec<f64> = (0..rows)
+        .map(|r| {
+            regressors
+                .iter()
+                .enumerate()
+                .fold(groups[r] + 0.02 * (r as f64 * 0.13).cos(), |y, (j, x)| {
+                    ((j + 1) as f64 / columns as f64).mul_add(x[r], y)
+                })
+        })
+        .collect();
+    let weights: Vec<f64> = (0..rows).map(|r| 1.0 + (r % 7) as f64).collect();
+    let weight_kind = match kind {
+        0 => TestWeights::Unit,
+        1 => TestWeights::Frequency(&weights),
+        2 => TestWeights::Analytic(&weights),
+        _ => TestWeights::Probability(&weights),
+    };
+    let prepared = prepared(
+        &outcome,
+        &regressors,
+        &vec![false; columns + 1],
+        Some(&groups),
+        true,
+        weight_kind,
+    );
+    let frame = LinearSolveFrame::from_prepared_ols(&prepared).unwrap();
+    let raw = prepared.fit_build_rhs().unwrap();
+    // Generated fixture columns are materialized only for the matrix oracle.
+    // The adapter borrows them and never retains a projected N-by-K array.
+    let raw_columns: Vec<Vec<f64>> = (0..raw.ncols())
+        .map(|c| (0..rows).map(|r| raw[(r, c)]).collect())
+        .collect();
+    let views: Vec<&[f64]> = raw_columns.iter().map(Vec::as_slice).collect();
+    let index = LevelIndex::from_codes(&codes, 17).unwrap();
+    let membership = ValidatedBorrowedInterceptSource::new(&codes, 17, &index).unwrap();
+    let effect = membership.effect();
+    let centered = CenteredColumns::prepare(
+        &views,
+        &effect,
+        frame.weights.borrowed(),
+        17 * views.len() * 8,
+    )
+    .unwrap();
+    let design = BorrowedInterceptFeDesign::new(rows, vec![membership.effect()]).unwrap();
+    let projected = absorb_borrowed_intercept_map_certified(
+        &design,
+        frame.weights.borrowed(),
+        raw.clone(),
+        MapConfig::default(),
+    )
+    .unwrap();
+    let (mut within, _) = projected.into_parts();
+    let mut from_tiles = DenseMatrix::zeros(rows, views.len()).unwrap();
+    for start in (0..rows).step_by(TILE_ROWS) {
+        let end = (start + TILE_ROWS).min(rows);
+        centered
+            .fill_rows(
+                start,
+                &mut from_tiles.as_mut_slice()[start * views.len()..end * views.len()],
+            )
+            .unwrap();
+    }
+    assert_eq!(within.as_slice(), from_tiles.as_slice());
+    let norms: Vec<f64> = (1..views.len())
+        .map(|c| {
+            let norm = centered_norm(&centered, c, frame.weights, true).unwrap();
+            assert_eq!(
+                norm,
+                weighted_matrix_column_norm(&raw, c, frame.weights).unwrap()
+            );
+            norm
+        })
+        .collect();
+    let score_norms: Vec<f64> = (1..views.len())
+        .map(|c| {
+            let norm = centered_norm(&centered, c, frame.weights, false).unwrap();
+            assert_eq!(
+                norm,
+                weighted_matrix_column_norm(&within, c, frame.weights).unwrap()
+            );
+            norm
+        })
+        .collect();
+    let config = PreparedOlsFitConfig::default();
+    let (statuses, candidates) = classify_finite_candidates(
+        &prepared,
+        &norms,
+        &score_norms,
+        config,
+        &mut SystemFitReservation,
+    )
+    .unwrap();
+    assert!(!candidates.contains(&1));
+    assert_eq!(candidates.len(), columns);
+    let source = CenteredStandardized {
+        centered: &centered,
+        weights: frame.weights,
+        reference_norms: &norms,
+    };
+    let (rhs, gram) =
+        centered_moments(&source, &candidates, usize::MAX, &mut SystemFitReservation).unwrap();
+    let mut standardized = within.clone();
+    for row in 0..rows {
+        let root = frame.weights.root(row).unwrap();
+        standardized[(row, 0)] *= root;
+        for &c in &candidates {
+            standardized[(row, c + 1)] = root * standardized[(row, c + 1)] / norms[c];
+        }
+    }
+    let expected =
+        build_standardized_moments(&standardized, &candidates, &mut SystemFitReservation).unwrap();
+    assert_eq!(rhs, expected.0);
+    assert_eq!(gram, expected.1);
+    let relative_threshold =
+        config.rank_tolerance_multiplier * f64::EPSILON * rows.max(norms.len()) as f64;
+    let fit = try_fit_scaled_pivoted_cholesky(
+        &source,
+        frame.weights,
+        frame.bread_weight_scale,
+        &norms,
+        &score_norms,
+        &candidates,
+        &statuses,
+        &gram,
+        &rhs,
+        relative_threshold,
+        config,
+        &mut SystemFitReservation,
+        false,
+        false,
+        true,
+    )
+    .unwrap();
+    let expected = fit_scaled_pivoted_qr(
+        &prepared,
+        &mut within,
+        frame.weights,
+        frame.bread_weight_scale,
+        &norms,
+        &score_norms,
+        config,
+        &mut SystemFitReservation,
+        false,
+        false,
+        true,
+    )
+    .unwrap();
+    if let Some(perturbation) = dependence {
+        assert!(fit.is_none(), "Cholesky must not decide omissions");
+        let fallback = fit_scaled_pivoted_qr(
+            &prepared,
+            &mut from_tiles,
+            frame.weights,
+            frame.bread_weight_scale,
+            &norms,
+            &score_norms,
+            config,
+            &mut SystemFitReservation,
+            false,
+            false,
+            true,
+        )
+        .unwrap();
+        assert_same_finite(&fallback, &expected);
+        assert_eq!(fallback.rank, columns - usize::from(perturbation == 0.0));
+        assert!(!fallback.standardized_within_is_reusable);
+        let allocation_budget = rows * 128 + norms.len() * norms.len() * 256 + (1 << 20);
+        let bounded = centered_scratch_fallback(
+            &prepared,
+            &source,
+            &score_norms,
+            frame.bread_weight_scale,
+            config,
+            allocation_budget,
+            u64::MAX,
+            &mut SystemFitReservation,
+            |_| {},
+        )
+        .unwrap();
+        assert!(bounded.charged_fit_payload_bytes <= allocation_budget);
+        assert_eq!(bounded.scratch_bytes, (rows * norms.len() * 8) as u64);
+        eprintln!("CENTERED_SCRATCH_CASE|rows={rows}|active_columns={columns}|weight_kind={kind}|dependence={perturbation:.17e}|charged_payload={}|scratch_bytes={}",
+            bounded.charged_fit_payload_bytes, bounded.scratch_bytes);
+        assert_scratch_compatible(&bounded.fit, &expected);
+    } else {
+        let fit = fit.expect("well-conditioned centered design admitted");
+        assert_same_finite(&fit, &expected);
+        assert_eq!(fit.rank, columns);
+        assert!(!fit.standardized_within_is_reusable);
+        assert!(expected.standardized_within_is_reusable);
+    }
+}
