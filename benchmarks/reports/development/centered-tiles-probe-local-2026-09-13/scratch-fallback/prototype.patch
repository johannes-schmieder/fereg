+#[test]
+fn centered_scratch_fallback_budget_failures_remove_private_storage() {
+    struct Reservation {
+        calls: usize,
+        fail_at: usize,
+    }
+    impl FitReservation for Reservation {
+        fn reserve<T>(
+            &mut self,
+            target: &mut Vec<T>,
+            elements: usize,
+            label: &'static str,
+        ) -> Result<()> {
+            self.calls += 1;
+            if self.calls == self.fail_at {
+                return Err(allocation("injected fallback reserve failure"));
+            }
+            SystemFitReservation.reserve(target, elements, label)
+        }
+    }
+    let rows = 64;
+    let codes: Vec<u32> = (0..rows).map(|r| (r / 4) as u32).collect();
+    let groups: Vec<f64> = codes.iter().map(|&g| f64::from(g)).collect();
+    let x: Vec<f64> = (0..rows).map(|r| (r % 4) as f64).collect();
+    let y: Vec<f64> = (0..rows).map(|r| 2.0 * x[r] + groups[r]).collect();
+    let ones = vec![1.0; rows];
+    let prepared = prepared(
+        &y,
+        &[x.clone(), x.clone()],
+        &[false, false],
+        Some(&groups),
+        true,
+        TestWeights::Unit,
+    );
+    let frame = LinearSolveFrame::from_prepared_ols(&prepared).unwrap();
+    let views: Vec<&[f64]> = vec![&y, &x, &x, &ones];
+    let index = LevelIndex::from_codes(&codes, 16).unwrap();
+    let membership = ValidatedBorrowedInterceptSource::new(&codes, 16, &index).unwrap();
+    let effect = membership.effect();
+    let centered =
+        CenteredColumns::prepare(&views, &effect, frame.weights.borrowed(), 16 * 4 * 8).unwrap();
+    let reference: Vec<f64> = (1..=3)
+        .map(|c| centered_norm(&centered, c, frame.weights, true).unwrap())
+        .collect();
+    let scores: Vec<f64> = (1..=3)
+        .map(|c| centered_norm(&centered, c, frame.weights, false).unwrap())
+        .collect();
+    let source = CenteredStandardized {
+        centered: &centered,
+        weights: frame.weights,
+        reference_norms: &reference,
+    };
+    let scratch_bytes = (rows * 3 * 8) as u64;
+    for (bytes, disk) in [(0, scratch_bytes), (1 << 20, scratch_bytes - 1)] {
+        let mut reservation = Reservation {
+            calls: 0,
+            fail_at: usize::MAX,
+        };
+        let mut created = None;
+        let result = centered_scratch_fallback(
+            &prepared,
+            &source,
+            &scores,
+            frame.bread_weight_scale,
+            PreparedOlsFitConfig::default(),
+            bytes,
+            disk,
+            &mut reservation,
+            |path| created = Some(path.to_path_buf()),
+        );
+        assert!(result.is_err());
+        assert_eq!(reservation.calls, 0);
+        assert!(created.is_none());
+    }
+    let mut reservation = Reservation {
+        calls: 0,
+        fail_at: usize::MAX,
+    };
+    let mut created = None;
+    let result = centered_scratch_fallback(
+        &prepared,
+        &source,
+        &scores,
+        frame.bread_weight_scale,
+        PreparedOlsFitConfig::default(),
+        1 << 20,
+        scratch_bytes,
+        &mut reservation,
+        |path| created = Some(path.to_path_buf()),
+    )
+    .unwrap();
+    assert!(
+        !created.unwrap().exists(),
+        "successful scratch owner must be removed"
+    );
+    let calls = reservation.calls;
+    assert_eq!(result.fit.rank, 1);
+    assert!((result.fit.generated_coefficients[0].unwrap() - 2.0).abs() < 1e-13);
+    assert!(result
+        .fit
+        .within_residuals
+        .as_ref()
+        .unwrap()
+        .iter()
+        .all(|v| v.abs() < 1e-13));
+    for fail_at in 1..=calls {
+        let mut reservation = Reservation { calls: 0, fail_at };
+        let mut created = None;
+        let result = centered_scratch_fallback(
+            &prepared,
+            &source,
+            &scores,
+            frame.bread_weight_scale,
+            PreparedOlsFitConfig::default(),
+            1 << 20,
+            scratch_bytes,
+            &mut reservation,
+            |path| created = Some(path.to_path_buf()),
+        );
+        assert!(result.is_err(), "reserve call {fail_at} must be terminal");
+        assert_eq!(reservation.calls, fail_at);
+        if let Some(path) = created {
+            assert!(!path.exists(), "failed owner must be removed");
+        }
+    }
+    for bytes in [
+        result.charged_fit_payload_bytes - 1,
+        result.charged_fit_payload_bytes,
+    ] {
