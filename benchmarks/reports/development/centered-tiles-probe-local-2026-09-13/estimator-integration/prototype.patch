+#[test]
+fn centered_finite_preserves_large_reference_scales_and_absorption_status() {
+    let rows = 256;
+    let delta = [-2.0, -1.0, 1.0, 2.0];
+    let noise = [1.0, -1.0, -1.0, 1.0];
+    let codes: Vec<u32> = (0..rows).map(|r| (r / 4) as u32).collect();
+    let groups: Vec<f64> = codes.iter().map(|&g| f64::from(g)).collect();
+    let x: Vec<f64> = (0..rows).map(|r| 2.0_f64.powi(14) + delta[r % 4]).collect();
+    let absorbed: Vec<f64> = (0..rows).map(|r| 2.0_f64.powi(40) + delta[r % 4]).collect();
+    let y: Vec<f64> = (0..rows)
+        .map(|r| 1e6 + groups[r] + 7.0 * delta[r % 4] + noise[r % 4])
+        .collect();
+    let prepared = prepared(
+        &y,
+        &[x.clone(), absorbed.clone()],
+        &[false, false],
+        Some(&groups),
+        false,
+        TestWeights::Unit,
+    );
+    let frame = LinearSolveFrame::from_prepared_ols(&prepared).unwrap();
+    let views: Vec<&[f64]> = vec![&y, &x, &absorbed];
+    let index = LevelIndex::from_codes(&codes, 64).unwrap();
+    let membership = ValidatedBorrowedInterceptSource::new(&codes, 64, &index).unwrap();
+    let effect = membership.effect();
+    let centered =
+        CenteredColumns::prepare(&views, &effect, frame.weights.borrowed(), 64 * 3 * 8).unwrap();
+    let design = BorrowedInterceptFeDesign::new(rows, vec![membership.effect()]).unwrap();
+    let projected = absorb_borrowed_intercept_map_certified(
+        &design,
+        frame.weights.borrowed(),
+        prepared.fit_build_rhs().unwrap(),
+        MapConfig::default(),
+    )
+    .unwrap();
+    let centering_error = (0..rows)
+        .map(|row| {
+            assert_eq!(centered.value(row, 0), projected.residualized()[(row, 0)]);
+            (centered.value(row, 0) - (7.0 * delta[row % 4] + noise[row % 4])).abs()
+        })
+        .fold(0.0_f64, f64::max);
+    eprintln!("CENTERED_ORACLE|maximum_outcome_centering_error={centering_error:.17e}");
+    assert!(
+        centering_error < 1e-9,
+        "registered absolute residual envelope"
+    );
+    for row in 0..rows {
+        assert_eq!(centered.value(row, 1), delta[row % 4]);
+        assert_eq!(centered.value(row, 2), delta[row % 4]);
+    }
+    let reference: Vec<f64> = (1..=2)
+        .map(|c| centered_norm(&centered, c, frame.weights, true).unwrap())
+        .collect();
+    let norms: Vec<f64> = (1..=2)
+        .map(|c| centered_norm(&centered, c, frame.weights, false).unwrap())
+        .collect();
+    let config = PreparedOlsFitConfig::default();
+    let (statuses, candidates) = classify_finite_candidates(
+        &prepared,
+        &reference,
+        &norms,
+        config,
+        &mut SystemFitReservation,
+    )
+    .unwrap();
+    assert_eq!(candidates, vec![0]);
+    assert_eq!(statuses[1], PreparedOlsFitStatus::CollinearWithFixedEffects);
+    let source = CenteredStandardized {
+        centered: &centered,
+        weights: frame.weights,
+        reference_norms: &reference,
+    };
+    let (rhs, gram) =
+        centered_moments(&source, &candidates, usize::MAX, &mut SystemFitReservation).unwrap();
+    let threshold = config.rank_tolerance_multiplier * f64::EPSILON * rows as f64;
+    let fit = try_fit_scaled_pivoted_cholesky(
+        &source,
+        frame.weights,
+        frame.bread_weight_scale,
+        &reference,
+        &norms,
+        &candidates,
+        &statuses,
+        &gram,
+        &rhs,
+        threshold,
+        config,
+        &mut SystemFitReservation,
+        false,
+        false,
+        true,
+    )
+    .unwrap()
+    .unwrap();
+    // Independent four-point contrasts: sum(delta*noise)=0 and sum(delta^2)=10.
+    assert!((fit.generated_coefficients[0].unwrap() - 7.0).abs() < 1e-12);
+    assert_eq!(fit.generated_coefficients[1], None);
+    assert_eq!(fit.rank, 1);
+    assert!((fit.bread.as_ref().unwrap().values[0] - 1.0 / 640.0).abs() < 1e-15);
+    for (row, &residual) in fit.within_residuals.as_ref().unwrap().iter().enumerate() {
+        let centered_noise = centered.value(row, 0) - 7.0 * delta[row % 4];
+        assert!((residual - centered_noise).abs() < 1e-12);
+        assert!((residual - noise[row % 4]).abs() < 1e-9);
+    }
+    let bound =
+        BoundCenteredFrame::bind(&prepared, frame, config, 1 << 20, &mut SystemFitReservation)
+            .unwrap()
+            .unwrap();
+    for cache in [usize::MAX, 0] {
+        let actual = checked_centered_estimator(&prepared, &bound, config, cache);
+        assert_eq!(actual.finite_rank(), 1);
+        assert_eq!(
+            actual.coefficients()[1].status,
+            PreparedOlsFitStatus::CollinearWithFixedEffects
+        );
+        assert!((actual.coefficients()[0].value.unwrap() - 7.0).abs() < 1e-12);
+        assert!((actual.bread().values()[0] - 1.0 / 640.0).abs() < 1e-15);
+    }
+}
