+    let frame = LinearSolveFrame::from_prepared_ols(&base).unwrap();
+    let config = PreparedOlsFitConfig::default();
+    let bound = BoundCenteredFrame::bind(&base, frame, config, 1 << 20, &mut SystemFitReservation)
+        .unwrap()
+        .unwrap();
+    let original_values: Vec<f64> = (0..y.len()).map(|r| bound.columns.value(r, 0)).collect();
+    let next_y: Vec<f64> = y
+        .iter()
+        .enumerate()
+        .map(|(r, v)| v + 0.13 * (r * r) as f64)
+        .collect();
+    let next_weights = [8.0, 1.0, 0.125, 2.0, 0.25, 3.0, 0.5, 1.0];
+    for (response, raw_weights) in [
+        (&next_y[..], &weights[..]),
+        (&y[..], &next_weights[..]),
+        (&next_y[..], &next_weights[..]),
+    ] {
+        let fresh = prepared(
+            response,
+            std::slice::from_ref(&x),
+            &[false],
+            Some(&groups),
+            true,
+            TestWeights::Analytic(raw_weights),
+        );
+        let fresh_frame = LinearSolveFrame::from_prepared_ols(&fresh).unwrap();
+        let changed = LinearSolveFrame::from_parts(
+            response,
+            BorrowedMapWeights::Provided(raw_weights),
+            fresh_frame.bread_weight_scale,
+        )
+        .unwrap();
+        // Bind the new numerical inputs to the original immutable topology.
+        let actual =
+            BoundCenteredFrame::bind(&base, changed, config, 1 << 20, &mut SystemFitReservation)
+                .unwrap()
+                .unwrap();
+        let fresh_raw = fresh.fit_build_rhs().unwrap();
+        let expected_raw =
+            build_raw_moment_cache(&fresh_raw, fresh_frame.weights, &mut SystemFitReservation)
+                .unwrap();
+        assert_eq!(actual.raw.means, expected_raw.means);
+        assert_eq!(actual.raw.scales, expected_raw.scales);
+        assert_eq!(actual.raw.norms, expected_raw.norms);
+        assert_eq!(actual.raw.weight_sum, expected_raw.weight_sum);
+        let mut expected = fresh
+            .fit_absorb_initial_matrix(fresh_frame.raw_weights(), fresh_raw, config.absorb)
+            .unwrap();
+        assert_eq!(actual.within_norms, expected.take_residual_norms());
+        for row in 0..y.len() {
+            for column in 0..actual.columns.width() {
+                assert_eq!(
+                    actual.columns.value(row, column),
+                    expected.residualized()[(row, column)]
+                );
+            }
+        }
+        assert_ne!(actual.raw.means, bound.raw.means);
+        assert!(std::ptr::eq(actual.frame.response(), response));
+        assert!(std::ptr::eq(
+            actual.frame.weights.values.unwrap(),
+            raw_weights
+        ));
+    }
+    assert_eq!(
+        original_values,
+        (0..y.len())
+            .map(|r| bound.columns.value(r, 0))
+            .collect::<Vec<_>>()
+    );
+    assert!(bound.certificate.relative_infinity_norm > 0.0);
+    let mut strict = config;
+    strict.absorb.map.tolerance = bound.certificate.relative_infinity_norm * 0.5;
+    assert!(
+        BoundCenteredFrame::bind(&base, frame, strict, 1 << 20, &mut SystemFitReservation).is_err()
+    );
+    let mut scale = frame.bread_weight_scale;
+    scale.solver_weight_divisor *= 8.0;
+    scale.reference_weight_multiplier *= 8.0;
+    let alternate =
+        LinearSolveFrame::from_parts(frame.response(), frame.raw_weights(), scale).unwrap();
+    assert!(
+        BoundCenteredFrame::bind(&base, alternate, config, 0, &mut SystemFitReservation)
+            .unwrap()
+            .is_none()
+    );
+    let mut explicit = config;
+    explicit.absorb.solver = FeSolverKind::Map;
+    assert!(
+        BoundCenteredFrame::bind(&base, frame, explicit, 0, &mut SystemFitReservation)
+            .unwrap()
+            .is_none()
+    );
+    explicit = config;
+    explicit.absorb.retain_coefficients = true;
+    assert!(
+        BoundCenteredFrame::bind(&base, frame, explicit, 0, &mut SystemFitReservation)
+            .unwrap()
+            .is_none()
+    );
+    let no_fe = prepared(
+        &y,
+        &[x],
+        &[false],
+        None,
+        true,
+        TestWeights::Analytic(&weights),
+    );
+    assert!(
+        BoundCenteredFrame::bind(&no_fe, frame, config, 0, &mut SystemFitReservation)
+            .unwrap()
+            .is_none()
+    );
+}
