+#[test]
+fn centered_scores_match_independent_weighted_hc1_and_frequency_expansion() {
+    use super::super::prepared_robust::{
+        compose_centered_probe, fit_prepared_ols_robust_map, PreparedOlsRobustConfig,
+    };
+    use super::super::prepared_scores::SystemPreparedInferenceReservation;
+    let x = [1.0, 2.0, 4.0, 7.0, -3.0, 0.0, 1.0, 5.0];
+    let y = [2.0, 5.0, 6.0, 9.0, -1.0, 1.0, 5.0, 6.0];
+    let w = [1.0, 2.0, 3.0, 4.0, 4.0, 3.0, 2.0, 1.0];
+    for kind in 0..5 {
+        let indices: Vec<usize> = if kind == 4 {
+            (0..8)
+                .flat_map(|i| std::iter::repeat(i).take(w[i] as usize))
+                .collect()
+        } else {
+            (0..8).collect()
+        };
+        let x: Vec<f64> = indices.iter().map(|&i| x[i]).collect();
+        let y: Vec<f64> = indices.iter().map(|&i| y[i]).collect();
+        let g: Vec<f64> = indices.iter().map(|&i| (i / 4) as f64).collect();
+        let weights = match kind {
+            1 => TestWeights::Frequency(&w),
+            2 => TestWeights::Analytic(&w),
+            3 => TestWeights::Probability(&w),
+            _ => TestWeights::Unit,
+        };
+        let prepared = prepared(
+            &y,
+            std::slice::from_ref(&x),
+            &[false],
+            Some(&g),
+            true,
+            weights,
+        );
+        let config = PreparedOlsRobustConfig::default();
+        let bound = BoundCenteredFrame::bind(
+            &prepared,
+            LinearSolveFrame::from_prepared_ols(&prepared).unwrap(),
+            config.fit,
+            1 << 20,
+            &mut SystemFitReservation,
+        )
+        .unwrap()
+        .unwrap();
+        let baseline = fit_prepared_ols_robust_map(&prepared, config).unwrap();
+        for cache in [usize::MAX, 0] {
+            let fit = checked_centered_estimator(&prepared, &bound, config.fit, cache);
+            let actual = compose_centered_probe(
+                &prepared,
+                fit,
+                &bound.columns,
+                config,
+                &mut SystemPreparedInferenceReservation,
+            )
+            .unwrap();
+            assert!(actual.certificate().passed);
+            assert_eq!(actual.dof(), baseline.dof());
+            assert_eq!(actual.weights(), baseline.weights());
+            assert_eq!(actual.absorbed_dof(), baseline.absorbed_dof());
+            assert_covariance_close(actual.covariance().values(), baseline.covariance().values());
+            assert_centered_statistics(actual.statistics(), baseline.statistics());
+            // Independent two-group WLS/HC1 oracle, including the normalized
+            // intercept coordinate. It does not call native moment, bread,
+            // score, correction or covariance implementations.
+            let weights: Vec<f64> = (0..x.len())
+                .map(|i| if (1..=3).contains(&kind) { w[i] } else { 1.0 })
+                .collect();
+            let sum: f64 = weights.iter().sum();
+            let multiplier = if kind == 2 || kind == 3 {
+                x.len() as f64 / sum
+            } else {
+                1.0
+            };
+            let reference: Vec<f64> = weights.iter().map(|v| multiplier * v).collect();
+            let nref: f64 = reference.iter().sum();
+            let mut mx = [0.0; 2];
+            let mut my = [0.0; 2];
+            let mut gw = [0.0; 2];
+            for i in 0..x.len() {
+                let group = g[i] as usize;
+                mx[group] += reference[i] * x[i];
+                my[group] += reference[i] * y[i];
+                gw[group] += reference[i];
+            }
+            for group in 0..2 {
+                mx[group] /= gw[group];
+                my[group] /= gw[group];
+            }
+            let xx: f64 = (0..x.len())
+                .map(|i| reference[i] * (x[i] - mx[g[i] as usize]).powi(2))
+                .sum();
+            let xy: f64 = (0..x.len())
+                .map(|i| reference[i] * (x[i] - mx[g[i] as usize]) * (y[i] - my[g[i] as usize]))
+                .sum();
+            let beta = xy / xx;
+            let mean: f64 = (0..x.len()).map(|i| reference[i] * x[i]).sum::<f64>() / nref;
+            let bread = [
+                1.0 / xx,
+                -mean / xx,
+                -mean / xx,
+                1.0 / nref + mean * mean / xx,
+            ];
+            let mut meat = [0.0; 4];
+            for i in 0..x.len() {
+                let within = x[i] - mx[g[i] as usize];
+                let residual = (y[i] - my[g[i] as usize]) - beta * within;
+                let factor = if kind == 1 {
+                    reference[i]
+                } else {
+                    reference[i] * reference[i]
+                } * residual
+                    * residual;
+                let score = [within + mean, 1.0];
+                for a in 0..2 {
+                    for b in 0..2 {
+                        meat[a * 2 + b] += factor * score[a] * score[b];
+                    }
+                }
+            }
+            let effective = if kind == 1 { sum } else { x.len() as f64 };
+            let correction = effective / (effective - 3.0);
+            let mut covariance = [0.0; 4];
+            for a in 0..2 {
+                for b in 0..2 {
+                    for i in 0..2 {
+                        for j in 0..2 {
+                            covariance[a * 2 + b] +=
+                                correction * bread[a * 2 + i] * meat[i * 2 + j] * bread[j * 2 + b];
+                        }
+                    }
+                }
+            }
+            assert_covariance_close(actual.covariance().values(), &covariance);
+        }
+    }
+}
