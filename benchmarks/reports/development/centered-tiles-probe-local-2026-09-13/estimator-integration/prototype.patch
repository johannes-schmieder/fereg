+//! Test-only centered storage for the existing OLS covariance consumers.
+use super::*;
+use crate::fe::CenteredColumns;
+use crate::ols::PreparedOlsColumnKind;
+
+#[derive(Debug)]
+pub(super) struct CenteredScoreStorage<'a> {
+    source: &'a CenteredColumns<'a>,
+    generated_columns: Vec<usize>,
+}
+
+impl CenteredScoreStorage<'_> {
+    pub(super) fn value(&self, row: usize, finite: usize) -> Result<f64> {
+        let generated = *self
+            .generated_columns
+            .get(finite)
+            .ok_or_else(|| invalid_argument("centered score finite coordinate is absent"))?;
+        if row >= self.source.rows() || generated + 1 >= self.source.width() {
+            return Err(invalid_argument("centered score axes are inconsistent"));
+        }
+        let value = self.source.value(row, generated + 1);
+        if !value.is_finite() {
+            return Err(invalid_data("centered score value is nonfinite"));
+        }
+        Ok(value)
+    }
+
+    pub(super) fn fill_row(&self, row: usize, output: &mut [f64]) -> Result<()> {
+        if output.len() != self.generated_columns.len() {
+            return Err(invalid_argument("centered score row width is inconsistent"));
+        }
+        for (finite, value) in output.iter_mut().enumerate() {
+            *value = self.value(row, finite)?;
+        }
+        Ok(())
+    }
+}
+
+pub(in crate::ols) fn build_centered_score_design<
+    'a,
+    P: PreparedOlsFitView + ?Sized,
+    R: PreparedInferenceReservation,
+>(
+    prepared: &'a P,
+    source: &'a CenteredColumns<'a>,
+    fit: &mut CertifiedPreparedOlsFit,
+    weights: ReferenceWeightView<'a>,
+    tolerance: f64,
+    reservation: &mut R,
+) -> Result<CertifiedPreparedOlsScoreDesign<'a>> {
+    let nrows = prepared.fit_sample().n_active();
+    let rank = fit.finite_rank();
+    let map_weights = match &prepared.fit_sample().weights {
+        PreparedWeights::None => BorrowedMapWeights::Unit,
+        PreparedWeights::Provided { values, .. } => BorrowedMapWeights::Provided(values),
+    };
+    if nrows == 0
+        || source.rows() != nrows
+        || source.width() != prepared.fit_model().columns.len() + 1
+        || !source.matches_raw_column(0, Some(&prepared.fit_sample().outcome))
+        || !source.matches_weights(map_weights)
+        || !tolerance.is_finite()
+        || tolerance <= 0.0
+        || tolerance >= 1.0
+    {
+        return Err(invalid_argument(
+            "centered score source does not match the prepared frame",
+        ));
+    }
+    for (generated, column) in prepared.fit_model().columns.iter().enumerate() {
+        let raw = match column.kind {
+            PreparedOlsColumnKind::Continuous {
+                prepared_source_index,
+                ..
+            } => Some(
+                prepared
+                    .fit_sample()
+                    .regressors
+                    .get(prepared_source_index)
+                    .ok_or_else(|| invalid_argument("centered score numeric column is absent"))?
+                    .as_slice(),
+            ),
+            PreparedOlsColumnKind::Intercept => None,
+            _ => {
+                return Err(invalid_argument(
+                    "centered score generated recipe is unsupported",
+                ))
+            }
+        };
+        if !source.matches_raw_column(generated + 1, raw) {
+            return Err(invalid_argument(
+                "centered score column identity differs from the prepared frame",
+            ));
+        }
+    }
+    let design = prepared
+        .fit_borrowed_intercept_map_design()?
+        .ok_or_else(|| invalid_argument("centered score FE source is absent"))?;
+    if design.effects().len() != 1 || !source.matches_effect(&design.effects()[0]) {
+        return Err(invalid_argument(
+            "centered score topology identity differs from the prepared frame",
+        ));
+    }
+    let ScoreCoordinates {
+        generated_columns,
+        finite_positions,
+        reported_to_finite,
+        normalized_intercept_position,
+    } = score_coordinates(fit, reservation)?;
+    // Release the displaced N-by-rank cache before allocating certificate
+    // workspace, retaining its exact current-fit mean arithmetic when present.
+    let means = match fit.take_fast_score_cache(&generated_columns) {
+        Some(PreparedOlsFastScoreCache::Packed { means, .. })
+        | Some(PreparedOlsFastScoreCache::Strided { means, .. })
+        | Some(PreparedOlsFastScoreCache::CenteredMeans { means, .. }) => means,
+        None => {
+            let mut means = reserved_filled(reservation, rank, 0.0, "centered score raw means")?;
+            for (finite, &generated) in generated_columns.iter().enumerate() {
+                // Match the existing reconstructed-score mean policy on reference
+                // weights. Packed-cache means retain a different partition arithmetic;
+                // their cross-route rounding differences are evaluated in the tests.
+                means[finite] = weighted_column_mean_by_value(nrows, weights, |row| {
+                    source.raw_value(row, generated + 1)
+                })?;
+            }
+
+            means
+        }
+    };
+    let storage = PreparedOlsScoreStorage::Centered(CenteredScoreStorage {
+        source,
+        generated_columns,
+    });
+    let mut certificate = certify_score_design(
+        ScoreCertificateInputs {
+            storage: &storage,
+            nrows,
+            rank,
+            means: &means,
+            finite_positions: &finite_positions,
+            normalized_intercept_position,
+            fit,
+            weights,
+        },
+        reservation,
+    )?;
+    certificate.passed = certificate.left_inverse_relative_infinity_norm <= tolerance
+        && certificate.right_inverse_relative_infinity_norm <= tolerance
+        && certificate.intercept_coordinate_relative_infinity_norm <= tolerance;
+    if !certificate.passed {
+        return Err(invalid_data("centered score design did not certify"));
+    }
+    let finite_row_buffer = reserved_filled(reservation, rank, 0.0, "centered finite score row")?;
+    Ok(CertifiedPreparedOlsScoreDesign {
+        storage,
+        nrows,
+        finite_rank: rank,
+        means,
+        finite_row_buffer: RefCell::new(finite_row_buffer),
+        reported_to_finite,
+        normalized_intercept_position,
+        certificate,
+    })
+}
