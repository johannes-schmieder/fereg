+#[test]
+fn centered_estimator_reservations_budgets_and_changed_bindings_fail_closed() {
+    struct Reservation {
+        calls: usize,
+        fail: usize,
+        extra: usize,
+    }
+    impl FitReservation for Reservation {
+        fn reserve<T>(
+            &mut self,
+            target: &mut Vec<T>,
+            elements: usize,
+            label: &'static str,
+        ) -> Result<()> {
+            self.calls += 1;
+            if self.calls == self.fail {
+                return Err(allocation("injected centered estimator reservation"));
+            }
+            target
+                .try_reserve_exact(elements + self.extra)
+                .map_err(|_| allocation(label))
+        }
+    }
+    let y = [2., 2., 5., 5., 1., 3., 4., 8.];
+    let x = [0., 1., 2., 4., -1., 0., 3., 5.];
+    let g = [0., 0., 0., 0., 1., 1., 1., 1.];
+    let w = [1., 2., 3., 4., 4., 3., 2., 1.];
+    for deficient in [false, true] {
+        let xs = if deficient {
+            vec![x.to_vec(), x.to_vec()]
+        } else {
+            vec![x.to_vec()]
+        };
+        let prepared = prepared(
+            &y,
+            &xs,
+            &vec![false; xs.len()],
+            Some(&g),
+            true,
+            TestWeights::Analytic(&w),
+        );
+        let config = PreparedOlsFitConfig::default();
+        let bound = BoundCenteredFrame::bind(
+            &prepared,
+            LinearSolveFrame::from_prepared_ols(&prepared).unwrap(),
+            config,
+            1 << 20,
+            &mut SystemFitReservation,
+        )
+        .unwrap()
+        .unwrap();
+        let mut reservation = Reservation {
+            calls: 0,
+            fail: usize::MAX,
+            extra: 0,
+        };
+        let successful = fit_centered_frame(
+            &prepared,
+            &bound,
+            config,
+            Some(usize::MAX),
+            1 << 20,
+            u64::MAX,
+            &mut reservation,
+        )
+        .unwrap();
+        let calls = reservation.calls;
+        for fail in 1..=calls {
+            let mut reservation = Reservation {
+                calls: 0,
+                fail,
+                extra: 0,
+            };
+            assert!(
+                fit_centered_frame(
+                    &prepared,
+                    &bound,
+                    config,
+                    Some(usize::MAX),
+                    1 << 20,
+                    u64::MAX,
+                    &mut reservation
+                )
+                .is_err(),
+                "reservation {fail} was ignored"
+            );
+            assert_eq!(reservation.calls, fail);
+        }
+        let (mut lo, mut hi) = (0, 1 << 20);
+        while hi - lo > 1 {
+            let mid = (lo + hi) / 2;
+            if fit_centered_frame(
+                &prepared,
+                &bound,
+                config,
+                Some(usize::MAX),
+                mid,
+                u64::MAX,
+                &mut SystemFitReservation,
+            )
+            .is_ok()
+            {
+                hi = mid;
+            } else {
+                lo = mid;
+            }
+        }
+        let mut over = Reservation {
+            calls: 0,
+            fail: usize::MAX,
+            extra: 1,
+        };
+        assert!(fit_centered_frame(
+            &prepared,
+            &bound,
+            config,
+            Some(usize::MAX),
+            hi,
+            u64::MAX,
+            &mut over
+        )
+        .is_err());
+        assert!(fit_centered_frame(
+            &prepared,
+            &bound,
+            config,
+            Some(usize::MAX),
+            hi - 1,
+            u64::MAX,
+            &mut SystemFitReservation
+        )
+        .is_err());
+        fit_centered_frame(
+            &prepared,
+            &bound,
+            config,
+            Some(usize::MAX),
+            hi,
+            u64::MAX,
+            &mut SystemFitReservation,
+        )
+        .unwrap();
+        let mut changed = config;
+        changed.absorb.map.tolerance *= 0.1;
+        let mut none = Reservation {
+            calls: 0,
+            fail: usize::MAX,
+            extra: 0,
+        };
+        assert!(fit_centered_frame(
+            &prepared,
+            &bound,
+            changed,
+            Some(0),
+            usize::MAX,
+            u64::MAX,
+            &mut none
+        )
+        .is_err());
+        assert_eq!(none.calls, 0);
+        let foreign = super::tests::prepared(
+            &y,
+            &xs,
+            &vec![false; xs.len()],
+            Some(&g),
+            true,
+            TestWeights::Analytic(&w),
+        );
+        assert!(fit_centered_frame(
+            &foreign,
+            &bound,
+            config,
+            Some(0),
+            usize::MAX,
+            u64::MAX,
+            &mut none
+        )
+        .is_err());
+        assert_eq!(none.calls, 0);
+        if deficient {
+            let bytes = successful.execution().scratch_bytes;
+            assert!(bytes > 0);
+            assert!(fit_centered_frame(
+                &prepared,
+                &bound,
+                config,
+                Some(usize::MAX),
+                1 << 20,
+                bytes - 1,
+                &mut SystemFitReservation
+            )
+            .is_err());
+            fit_centered_frame(
+                &prepared,
+                &bound,
+                config,
+                Some(usize::MAX),
+                1 << 20,
+                bytes,
+                &mut SystemFitReservation,
+            )
+            .unwrap();
+        }
+        eprintln!("CENTERED_ESTIMATOR_BOUNDS|deficient={deficient}|reservation_failures={calls}|minimum_component_budget={hi}|scratch_bytes={}",successful.execution().scratch_bytes);
+    }
