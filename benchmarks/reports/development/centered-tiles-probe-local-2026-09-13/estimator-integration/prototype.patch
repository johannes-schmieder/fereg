+fn run_case(rows: usize, columns: usize, kind: usize, dependence: Option<f64>) {
+    run_frame_case(rows, columns, kind, dependence, false);
+}
+
+fn run_frame_case(
+    rows: usize,
+    columns: usize,
+    kind: usize,
+    dependence: Option<f64>,
+    bind_frame: bool,
+) {
+    let codes: Vec<u32> = (0..rows).map(|r| (r % 17) as u32).collect();
+    let groups: Vec<f64> = codes.iter().map(|&g| f64::from(g)).collect();
+    let mut state = 0x9e37_79b9_7f4a_7c15_u64;
+    let mut regressors: Vec<Vec<f64>> = (0..columns)
+        .map(|_| {
+            (0..rows)
+                .map(|r| {
+                    state = state
+                        .wrapping_mul(6_364_136_223_846_793_005)
+                        .wrapping_add(1_442_695_040_888_963_407);
+                    ((state >> 11) as f64) / ((1_u64 << 53) as f64) - 0.5 + 0.1 * groups[r]
+                })
+                .collect()
+        })
+        .collect();
+    if let Some(perturbation) = dependence {
+        for row in 0..rows {
+            regressors[columns - 1][row] =
+                regressors[0][row] + perturbation * regressors[columns - 1][row];
+        }
+    }
+    // An exactly absorbed interior slot exercises indexed candidate mappings.
+    regressors.insert(1, groups.clone());
+    let outcome: Vec<f64> = (0..rows)
+        .map(|r| {
+            regressors
+                .iter()
+                .enumerate()
+                .fold(groups[r] + 0.02 * (r as f64 * 0.13).cos(), |y, (j, x)| {
+                    ((j + 1) as f64 / columns as f64).mul_add(x[r], y)
+                })
+        })
+        .collect();
+    let weights: Vec<f64> = (0..rows).map(|r| 1.0 + (r % 7) as f64).collect();
+    let weight_kind = match kind {
+        0 => TestWeights::Unit,
+        1 => TestWeights::Frequency(&weights),
+        2 => TestWeights::Analytic(&weights),
+        _ => TestWeights::Probability(&weights),
+    };
+    let prepared = prepared(
+        &outcome,
+        &regressors,
+        &vec![false; columns + 1],
+        Some(&groups),
+        true,
+        weight_kind,
+    );
+    let frame = LinearSolveFrame::from_prepared_ols(&prepared).unwrap();
+    let raw = prepared.fit_build_rhs().unwrap();
+    // Generated fixture columns are materialized only for the matrix oracle.
+    // The adapter borrows them and never retains a projected N-by-K array.
+    let raw_columns: Vec<Vec<f64>> = (0..raw.ncols())
+        .map(|c| (0..rows).map(|r| raw[(r, c)]).collect())
+        .collect();
+    let views: Vec<&[f64]> = raw_columns.iter().map(Vec::as_slice).collect();
+    let index = LevelIndex::from_codes(&codes, 17).unwrap();
+    let membership = ValidatedBorrowedInterceptSource::new(&codes, 17, &index).unwrap();
+    let effect = membership.effect();
+    let legacy_centered = CenteredColumns::prepare(
+        &views,
+        &effect,
+        frame.weights.borrowed(),
+        17 * views.len() * 8,
+    )
+    .unwrap();
+    let config = PreparedOlsFitConfig::default();
+    let bound = bind_frame.then(|| {
+        BoundCenteredFrame::bind(
+            &prepared,
+            frame,
+            config,
+            32 << 20,
+            &mut SystemFitReservation,
+        )
+        .unwrap()
+        .unwrap()
+    });
+    let centered = bound.as_ref().map_or(&legacy_centered, |b| &b.columns);
+    let mut projected = if bind_frame {
+        prepared
+            .fit_absorb_initial_matrix(frame.raw_weights(), raw.clone(), config.absorb)
+            .unwrap()
+    } else {
+        let design = BorrowedInterceptFeDesign::new(rows, vec![membership.effect()]).unwrap();
+        absorb_borrowed_intercept_map_certified(
+            &design,
+            frame.raw_weights(),
+            raw.clone(),
+            config.absorb.map,
+        )
+        .unwrap()
+    };
+    if let Some(bound) = &bound {
+        let cache = build_raw_moment_cache(&raw, frame.weights, &mut SystemFitReservation).unwrap();
+        assert_eq!(bound.raw.means, cache.means);
+        assert_eq!(bound.raw.scales, cache.scales);
+        assert_eq!(bound.raw.norms, cache.norms);
+        assert_eq!(bound.raw.weight_sum, cache.weight_sum);
+        assert_eq!(bound.within_norms, projected.take_residual_norms());
+        let expected = &projected.report().certificate;
+        assert_eq!(bound.certificate.passed, expected.passed);
+        assert_eq!(
+            bound.certificate.relative_infinity_norm,
+            expected.relative_infinity_norm
+        );
+        assert_eq!(
+            bound.certificate.absolute_infinity_norm,
+            expected.absolute_infinity_norm
+        );
+        assert!(
+            (bound.certificate.relative_two_norm - expected.relative_two_norm).abs()
+                <= 1e-14 * expected.relative_two_norm.max(f64::MIN_POSITIVE)
+        );
+        assert_eq!(
+            bound.projection_reference_norms,
+            bound.columns.norms(true, true, 32 << 20).unwrap()
+        );
+        assert!(bound.charged_state_bytes < 32 << 20);
+        assert!(std::ptr::eq(
+            bound.frame.response(),
+            prepared.fit_sample().outcome.as_slice()
+        ));
+    }
+    let (mut within, _) = projected.into_parts();
+    let mut from_tiles = DenseMatrix::zeros(rows, views.len()).unwrap();
+    for start in (0..rows).step_by(TILE_ROWS) {
+        let end = (start + TILE_ROWS).min(rows);
+        centered
+            .fill_rows(
+                start,
+                &mut from_tiles.as_mut_slice()[start * views.len()..end * views.len()],
+            )
+            .unwrap();
+    }
+    assert_eq!(within.as_slice(), from_tiles.as_slice());
+    let norms: Vec<f64> = if let Some(bound) = &bound {
+        bound.raw.norms[1..].to_vec()
+    } else {
+        (1..views.len())
+            .map(|c| {
+                let norm = centered_norm(&centered, c, frame.weights, true).unwrap();
+                assert_eq!(
+                    norm,
+                    weighted_matrix_column_norm(&raw, c, frame.weights).unwrap()
+                );
+                norm
+            })
+            .collect()
+    };
+    let score_norms: Vec<f64> = if let Some(bound) = &bound {
+        bound.within_norms[1..].to_vec()
+    } else {
+        (1..views.len())
+            .map(|c| {
+                let norm = centered_norm(&centered, c, frame.weights, false).unwrap();
+                assert_eq!(
+                    norm,
+                    weighted_matrix_column_norm(&within, c, frame.weights).unwrap()
+                );
+                norm
+            })
+            .collect()
+    };
+    let (statuses, candidates) = classify_finite_candidates(
+        &prepared,
+        &norms,
+        &score_norms,
+        config,
+        &mut SystemFitReservation,
+    )
+    .unwrap();
+    assert!(!candidates.contains(&1));
+    assert_eq!(candidates.len(), columns);
+    let source = bound.as_ref().map_or(
+        CenteredStandardized {
+            centered,
+            weights: frame.weights,
+            reference_norms: &norms,
+        },
+        BoundCenteredFrame::standardized,
+    );
+    let (rhs, gram) =
+        centered_moments(&source, &candidates, usize::MAX, &mut SystemFitReservation).unwrap();
+    let mut standardized = within.clone();
+    for row in 0..rows {
+        let root = frame.weights.root(row).unwrap();
+        standardized[(row, 0)] *= root;
+        for &c in &candidates {
+            standardized[(row, c + 1)] = root * standardized[(row, c + 1)] / norms[c];
+        }
+    }
+    let expected =
+        build_standardized_moments(&standardized, &candidates, &mut SystemFitReservation).unwrap();
+    assert_eq!(rhs, expected.0);
+    assert_eq!(gram, expected.1);
+    let relative_threshold =
+        config.rank_tolerance_multiplier * f64::EPSILON * rows.max(norms.len()) as f64;
+    let fit = try_fit_scaled_pivoted_cholesky(
+        &source,
+        frame.weights,
+        frame.bread_weight_scale,
+        &norms,
+        &score_norms,
+        &candidates,
+        &statuses,
+        &gram,
+        &rhs,
+        relative_threshold,
+        config,
+        &mut SystemFitReservation,
+        false,
+        false,
+        true,
+    )
+    .unwrap();
+    let expected = fit_scaled_pivoted_qr(
+        &prepared,
+        &mut within,
+        frame.weights,
+        frame.bread_weight_scale,
+        &norms,
+        &score_norms,
+        config,
+        &mut SystemFitReservation,
+        false,
+        false,
+        true,
+    )
+    .unwrap();
+    if let Some(perturbation) = dependence {
+        assert!(fit.is_none(), "Cholesky must not decide omissions");
+        let fallback = fit_scaled_pivoted_qr(
+            &prepared,
+            &mut from_tiles,
+            frame.weights,
+            frame.bread_weight_scale,
+            &norms,
+            &score_norms,
+            config,
+            &mut SystemFitReservation,
+            false,
+            false,
+            true,
+        )
+        .unwrap();
+        assert_same_finite(&fallback, &expected);
+        assert_eq!(fallback.rank, columns - usize::from(perturbation == 0.0));
+        assert!(!fallback.standardized_within_is_reusable);
+        let allocation_budget = rows * 128 + norms.len() * norms.len() * 256 + (1 << 20);
+        let bounded = centered_scratch_fallback(
+            &prepared,
+            &source,
+            &score_norms,
+            frame.bread_weight_scale,
+            config,
+            allocation_budget,
+            u64::MAX,
+            &mut SystemFitReservation,
+            |_| {},
+        )
+        .unwrap();
+        assert!(bounded.charged_fit_payload_bytes <= allocation_budget);
+        assert_eq!(bounded.scratch_bytes, (rows * norms.len() * 8) as u64);
+        eprintln!("CENTERED_SCRATCH_CASE|rows={rows}|active_columns={columns}|weight_kind={kind}|dependence={perturbation:.17e}|charged_payload={}|scratch_bytes={}",
+            bounded.charged_fit_payload_bytes, bounded.scratch_bytes);
+        assert_scratch_compatible(&bounded.fit, &expected);
+        if let Some(bound) = &bound {
+            assert_centered_finalization(&prepared, bound, bounded.fit, config);
+        }
+    } else {
+        let fit = fit.expect("well-conditioned centered design admitted");
+        assert_same_finite(&fit, &expected);
+        assert_eq!(fit.rank, columns);
+        assert!(!fit.standardized_within_is_reusable);
+        assert!(expected.standardized_within_is_reusable);
+        if let Some(bound) = &bound {
+            assert_centered_finalization(&prepared, bound, fit, config);
+        }
+    }
+}
+
+fn assert_centered_finalization<P: PreparedOlsFitView + ?Sized>(
+    prepared: &P,
+    bound: &BoundCenteredFrame<'_>,
+    mut qr: QrFit,
+    config: PreparedOlsFitConfig,
+) {
+    let frame = bound.frame;
+    let expected = fit_with_controls_internal_mode_with_frame(
+        prepared,
+        frame,
+        config,
+        &mut SystemFitReservation,
+        FitPerturbations::default(),
+        false,
+        MAX_FAST_SCORE_CACHE_BYTES,
+        None,
+        None,
+    )
+    .unwrap();
+    let mut raw_residuals =
+        build_independent_raw_residuals(prepared, frame.response(), &qr, &mut SystemFitReservation)
+            .unwrap();
+    let bread = finalize_reported_bread_and_intercept(
+        prepared,
+        frame.response(),
+        &mut qr,
+        Some(&mut raw_residuals),
+        frame.weights,
+        config.bread_tolerance,
+        &mut SystemFitReservation,
+        FitPerturbations::default(),
+        None,
+        Some(&bound.raw),
+    )
+    .unwrap();
+    assert!(bread.certificate().passed);
+    assert_eq!(bread.coordinates(), expected.bread().coordinates());
+    assert_eq!(bread.weight_scale(), expected.bread().weight_scale());
+    for (actual, expected) in bread.values().iter().zip(expected.bread().values()) {
+        assert!((actual - expected).abs() <= 1e-10 + 1e-6 * expected.abs());
+    }
+    let coefficients = build_coefficient_slots(prepared, &qr, &mut SystemFitReservation).unwrap();
+    for (actual, expected) in coefficients.iter().zip(expected.coefficients()) {
+        assert_eq!(actual.status, expected.status);
+        match (actual.value, expected.value) {
+            (Some(a), Some(b)) => assert!((a - b).abs() <= 1e-10 + 1e-7 * b.abs()),
+            (None, None) => {}
+            _ => panic!("reported coefficient presence changed"),
+        }
+    }
+    let residuals = DenseMatrix::from_row_major(
+        frame.response().len(),
+        1,
+        qr.within_residuals.take().unwrap(),
+    )
+    .unwrap();
+    // A final residual is a warm candidate. Keep the established independent
+    // FE certificate/polish instead of assuming that centered inputs suffice.
+    let residuals = prepared
+        .fit_absorb_matrix(frame.raw_weights(), residuals, config.absorb)
+        .unwrap();
+    assert!(residuals.report().certified());
+    for (actual, expected) in residuals
+        .residualized()
+        .as_slice()
+        .iter()
+        .zip(expected.residuals())
+    {
+        assert!((actual - expected).abs() <= 1e-9 + 1e-7 * expected.abs());
+    }
+    let corrupted_draft = FiniteScoreDraft {
+        infinity_scale: qr.finite_score.infinity_scale,
+        square_sum_scale: qr.finite_score.square_sum_scale,
+        moments: qr.finite_score.moments,
+    };
+    let score = certify_scores(
+        prepared,
+        residuals.residualized().as_slice(),
+        frame.weights,
+        &bound.raw.norms[1..],
+        &bound.within_norms[1..],
+        qr.finite_score,
+        &qr.generated_statuses,
+        bound.within_norms[0],
+        config.score_tolerance,
+    )
+    .unwrap();
+    assert!(score.passed);
+    // Supply the valid finite draft with an independently corrupted final
+    // residual. Raw-row checks must reject it despite the earlier solve pass.
+    let mut corrupted = residuals.residualized().as_slice().to_vec();
+    for (row, value) in corrupted.iter_mut().enumerate() {
+        *value += 0.25 * bound.columns.raw_value(row, 1);
+    }
+    let rejection = certify_scores(
+        prepared,
+        &corrupted,
+        frame.weights,
+        &bound.raw.norms[1..],
+        &bound.within_norms[1..],
+        corrupted_draft,
+        &qr.generated_statuses,
+        bound.within_norms[0],
+        config.score_tolerance,
+    );
+    assert!(rejection.is_err() || !rejection.unwrap().passed);
+    let within_ss = bound.within_norms[0].mul_add(bound.within_norms[0], 0.0)
+        * bread.weight_scale().reference_weight_multiplier;
+    assert_eq!(
+        within_ss,
+        expected.initial_absorbed_outcome_sum_of_squares()
+    );
+    assert_eq!(qr.rank, expected.finite_rank());
+}
