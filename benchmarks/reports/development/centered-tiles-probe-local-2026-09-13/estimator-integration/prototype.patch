+#[test]
+fn centered_scores_handle_rank_zero_and_absent_reported_intercept() {
+    use super::super::prepared_robust::{
+        compose_centered_probe, fit_prepared_ols_robust_map, PreparedOlsRobustConfig,
+    };
+    use super::super::prepared_scores::SystemPreparedInferenceReservation;
+    let rows = 257;
+    let g: Vec<f64> = (0..rows).map(|r| (r % 2) as f64).collect();
+    let w: Vec<f64> = (0..rows).map(|r| 1.0 + (r % 3) as f64).collect();
+    for (rank_zero, report_intercept) in [(true, true), (false, false)] {
+        let x: Vec<f64> = (0..rows)
+            .map(|r| {
+                if rank_zero {
+                    g[r]
+                } else {
+                    g[r] + (r as f64 * 0.13).sin()
+                }
+            })
+            .collect();
+        let y: Vec<f64> = (0..rows)
+            .map(|r| g[r] + 2.0 * x[r] + 0.1 * (r as f64 * 0.17).cos())
+            .collect();
+        let prepared = prepared(
+            &y,
+            &[x],
+            &[false],
+            Some(&g),
+            report_intercept,
+            TestWeights::Probability(&w),
+        );
+        let config = PreparedOlsRobustConfig::default();
+        let bound = BoundCenteredFrame::bind(
+            &prepared,
+            LinearSolveFrame::from_prepared_ols(&prepared).unwrap(),
+            config.fit,
+            1 << 20,
+            &mut SystemFitReservation,
+        )
+        .unwrap()
+        .unwrap();
+        let baseline = fit_prepared_ols_robust_map(&prepared, config).unwrap();
+        for cache in [usize::MAX, 0] {
+            let fit = checked_centered_estimator(&prepared, &bound, config.fit, cache);
+            let actual = compose_centered_probe(
+                &prepared,
+                fit,
+                &bound.columns,
+                config,
+                &mut SystemPreparedInferenceReservation,
+            )
+            .unwrap();
+            assert!(actual.certificate().passed);
+            assert_eq!(actual.fit().finite_rank(), usize::from(!rank_zero));
+            assert_eq!(
+                actual.covariance_coordinates(),
+                baseline.covariance_coordinates()
+            );
+            assert_eq!(actual.dof(), baseline.dof());
+            assert_covariance_close(actual.covariance().values(), baseline.covariance().values());
+            assert_centered_statistics(actual.statistics(), baseline.statistics());
+        }
+    }
+}
+
+fn assert_centered_statistics(
+    actual: super::super::prepared_unadjusted::PreparedOlsFitStatistics,
+    expected: super::super::prepared_unadjusted::PreparedOlsFitStatistics,
+) {
+    for (a, e) in [
+        (actual.rss, expected.rss),
+        (actual.tss, expected.tss),
+        (actual.within_tss, expected.within_tss),
+        (
+            actual.root_mean_squared_error,
+            expected.root_mean_squared_error,
+        ),
+    ] {
+        assert!((a - e).abs() <= 1e-9 + 1e-7 * e.abs());
+    }
+    for (a, e) in [
+        (actual.r_squared, expected.r_squared),
+        (actual.adjusted_r_squared, expected.adjusted_r_squared),
+        (actual.within_r_squared, expected.within_r_squared),
+        (
+            actual.adjusted_within_r_squared,
+            expected.adjusted_within_r_squared,
+        ),
+        (actual.f_statistic, expected.f_statistic),
+        (
+            actual.gaussian_log_likelihood,
+            expected.gaussian_log_likelihood,
+        ),
+        (
+            actual.gaussian_null_log_likelihood,
+            expected.gaussian_null_log_likelihood,
+        ),
+    ] {
+        match (a, e) {
+            (Some(a), Some(e)) => assert!((a - e).abs() <= 1e-9 + 1e-7 * e.abs()),
+            (None, None) => {}
+            _ => panic!("centered fit statistic availability changed"),
+        }
+    }
+}
