+            &mut reservation,
+            |path| created = Some(path.to_path_buf()),
+        );
+        assert!(result.is_err(), "reserve call {fail_at} must be terminal");
+        assert_eq!(reservation.calls, fail_at);
+        if let Some(path) = created {
+            assert!(!path.exists(), "failed owner must be removed");
+        }
+    }
+    for bytes in [
+        result.charged_fit_payload_bytes - 1,
+        result.charged_fit_payload_bytes,
+    ] {
+        let mut created = None;
+        let attempt = centered_scratch_fallback(
+            &prepared,
+            &source,
+            &scores,
+            frame.bread_weight_scale,
+            PreparedOlsFitConfig::default(),
+            bytes,
+            scratch_bytes,
+            &mut SystemFitReservation,
+            |path| created = Some(path.to_path_buf()),
+        );
+        assert_eq!(attempt.is_ok(), bytes == result.charged_fit_payload_bytes);
+        assert!(!created.unwrap().exists());
+    }
+    eprintln!("CENTERED_SCRATCH_BOUNDS|reserve_calls={calls}|charged_fit_payload={}|scratch_bytes={scratch_bytes}", result.charged_fit_payload_bytes);
+}
