+        request.ols.absorbed_terms = vec![AbsorbedTerm {
+            id: AbsorbTermId::new(1).unwrap(),
+            intercept: true,
+            categorical_sources: vec![first],
+            slope_sources: vec![],
+            label: "a".into(),
+            saved_name: String::new(),
+        }];
+        request.clusters = vec![OlsClusterTermV1 {
+            label: "a".into(),
+            sources: vec![first],
+        }];
+        if ways == 2 {
+            request.clusters.push(OlsClusterTermV1 {
+                label: "b".into(),
+                sources: vec![second],
+            });
+        }
+        let column = |values: Vec<f64>| LoadedNumericColumn {
+            missing: vec![false; values.len()],
+            values,
+        };
+        let mut groups: Vec<f64> = (0..rows).map(|r| (r % 17) as f64).collect();
+        if missing {
+            groups[0] = 999.0;
+            groups[1] = 999.0;
+        }
+        let x: Vec<f64> = (0..rows)
+            .map(|r| (r as f64 * 0.37).sin() + 0.1 * groups[r])
+            .collect();
+        let y: Vec<f64> = (0..rows)
+            .map(|r| 0.3 * groups[r] + 1.2 * x[r] + 0.05 * (r as f64 * 0.19).cos())
+            .collect();
+        loaded.candidate = vec![true; rows];
+        loaded.outcome = column(y);
+        loaded.numeric_sources[0].1 = column(x);
+        loaded.numeric_sources[1].1 = column(groups);
+        loaded.numeric_sources[2].1 = column((0..rows).map(|r| (r % 7) as f64).collect());
+        if missing {
+            loaded.numeric_sources[2].1.missing[0] = true;
+        }
+        let weights = column((0..rows).map(|r| 1.0 + (r % 3) as f64).collect());
+        match kind {
+            1 => {
+                loaded.frequency_weight = Some(weights);
+                request.ols.bindings.push(OlsInputBinding {
+                    stata_var_position: 6,
+                    role: OlsInputRole::FrequencyWeight,
+                });
+            }
+            2 => {
+                loaded.analytic_weight = Some(weights);
+                request.ols.bindings.push(OlsInputBinding {
+                    stata_var_position: 6,
+                    role: OlsInputRole::AnalyticWeight,
+                });
+            }
+            3 => {
+                loaded.probability_weight = Some(weights);
+                request.ols.bindings.push(OlsInputBinding {
+                    stata_var_position: 6,
+                    role: OlsInputRole::ProbabilityWeight,
+                });
+            }
+            _ => {}
+        }
+        if ways == 1 {
+            request.ols.model.sources.pop();
+            request.ols.bindings.pop();
+            loaded.numeric_sources.pop();
+        }
+        let prepared = prepare_ols_clustered_data(&request, &loaded).unwrap();
+        if missing {
+            assert_eq!(
+                prepared.ols().fit_sample().n_active(),
+                rows - if kind == 1 { 1 } else { 2 }
+            );
+        }
+        let mut config = PreparedOlsClusteredConfig::default();
+        config.fit.execution.threads = ThreadConfig::from_requested(workers, false).unwrap();
+        rayon::ThreadPoolBuilder::new().num_threads(workers).build().unwrap().install(|| {
+            let ols=prepared.ols();
+            let bound=BoundCenteredFrame::bind(ols,LinearSolveFrame::from_prepared_ols(ols).unwrap(),config.fit,32<<20,&mut SystemFitReservation).unwrap().unwrap();
+            let baseline=fit_prepared_ols_clustered_map(&prepared,config).unwrap();
+            for cache in [usize::MAX,0] {
+                let fit=checked_centered_estimator(ols,&bound,config.fit,cache);
+                let actual=compose_centered_probe(&prepared,fit,&bound.columns,config,&mut SystemPreparedInferenceReservation).unwrap();
+                assert!(actual.certificate().passed);
+                assert_eq!(actual.dof(),baseline.dof()); assert_eq!(actual.weights(),baseline.weights());
+                assert_eq!(actual.absorbed_dof(),baseline.absorbed_dof());
+                assert_eq!(actual.cluster_counts(),baseline.cluster_counts()); assert_eq!(actual.subsets(),baseline.subsets());
+                assert_eq!(actual.covariance().psd().state,baseline.covariance().psd().state);
+                assert_covariance_close(actual.covariance().raw_values(),baseline.covariance().raw_values());
+                assert_covariance_close(actual.covariance().values(),baseline.covariance().values());
+                assert_centered_statistics(actual.statistics(),baseline.statistics());
+                // Independent original-row group sums and inclusion-exclusion.
+                // The FE is also the first cluster, so all FE categories are
+                // nested and the registered correction denominator is N-2.
+                let sample=ols.fit_sample();let n=sample.n_active();let x=&sample.regressors[0];
+                let raw_weights:Vec<f64>=match &sample.weights {PreparedWeights::None=>vec![1.0;n],PreparedWeights::Provided{values,..}=>values.clone()};
+                let sum:f64=raw_weights.iter().sum();let scale=if kind==2||kind==3 {n as f64/sum}else{1.0};
+                let w:Vec<f64>=raw_weights.iter().map(|v|v*scale).collect();let nref:f64=w.iter().sum();
+                let fe=prepared.cluster_codes(0).unwrap();
+                let mut totals=std::collections::BTreeMap::<u32,[f64;3]>::new();
+                for r in 0..n {let t=totals.entry(fe[r]).or_default();t[0]+=w[r];t[1]+=w[r]*x[r];t[2]+=w[r]*sample.outcome[r];}
+                let mut cx=Vec::new();let mut cy=Vec::new();
+                for r in 0..n {let t=totals[&fe[r]];cx.push(x[r]-t[1]/t[0]);cy.push(sample.outcome[r]-t[2]/t[0]);}
+                let xx:f64=(0..n).map(|r|w[r]*cx[r]*cx[r]).sum();let beta=(0..n).map(|r|w[r]*cx[r]*cy[r]).sum::<f64>()/xx;
+                let mean=(0..n).map(|r|w[r]*x[r]).sum::<f64>()/nref;
+                let bread=[1.0/xx,-mean/xx,-mean/xx,1.0/nref+mean*mean/xx];let mut meat=[0.0;4];
+                for mask in 1_usize..(1<<ways) {
+                    let mut scores=std::collections::BTreeMap::<Vec<u32>,[f64;2]>::new();
+                    for r in 0..n {
+                        let key=(0..ways).filter(|&d|mask&(1<<d)!=0).map(|d|prepared.cluster_codes(d).unwrap()[r]).collect();
+                        let t=scores.entry(key).or_default();let residual=cy[r]-beta*cx[r];
+                        t[0]+=w[r]*residual*(cx[r]+mean);t[1]+=w[r]*residual;
+                    }
+                    let sign=if mask.count_ones()%2==1 {1.0}else{-1.0};
+                    for s in scores.values() {for a in 0..2 {for b in 0..2 {meat[a*2+b]+=sign*s[a]*s[b];}}}
+                }
+                let effective=if kind==1 {sum}else{n as f64};let min_groups=*actual.cluster_counts().iter().min().unwrap() as f64;
+                let correction=((effective-1.0)/(effective-2.0))*(min_groups/(min_groups-1.0));
+                assert!((actual.covariance().correction()-correction).abs()<1e-12);
+                let mut covariance=[0.0;4];for a in 0..2 {for b in 0..2 {for i in 0..2 {for j in 0..2 {covariance[a*2+b]+=correction*bread[a*2+i]*meat[i*2+j]*bread[j*2+b];}}}}
+                assert_covariance_close(actual.covariance().raw_values(),&covariance);
+                eprintln!("CENTERED_SCORE_CLUSTER|rows={n}|kind={kind}|ways={ways}|workers={workers}|missing={missing}|packed_requested={}",cache!=0);
+            }
+        });
+    }
