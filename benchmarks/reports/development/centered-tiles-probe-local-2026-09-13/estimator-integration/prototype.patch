+    for (rows, kind, ways, workers, missing) in [
+        (257, 0, 1, 1, false),
+        (257, 1, 2, 4, true),
+        (257, 2, 2, 1, true),
+        (32777, 3, 2, 4, false),
+    ] {
+        let (mut request, mut loaded) = super::super::prepared_clusters::tests::fixture();
