+#[test]
+fn centered_scratch_fallback_matches_rational_weighted_and_expanded_oracles() {
+    let original_x = [1.0, 2.0, 4.0, 7.0, -3.0, 0.0, 1.0, 5.0];
+    let original_y = [2.0, 5.0, 6.0, 9.0, -1.0, 1.0, 5.0, 6.0];
+    let original_w = [1.0, 2.0, 3.0, 4.0, 4.0, 3.0, 2.0, 1.0];
+    for kind in 0..4 {
+        let indices: Vec<usize> = if kind == 3 {
+            (0..8)
+                .flat_map(|i| std::iter::repeat(i).take(original_w[i] as usize))
+                .collect()
+        } else {
+            (0..8).collect()
+        };
+        let x: Vec<f64> = indices.iter().map(|&i| original_x[i]).collect();
+        let y: Vec<f64> = indices.iter().map(|&i| original_y[i]).collect();
+        let duplicate: Vec<f64> = x.iter().map(|x| 2.0 * x).collect();
+        let codes: Vec<u32> = indices.iter().map(|&i| (i / 4) as u32).collect();
+        let groups: Vec<f64> = codes.iter().map(|&g| f64::from(g)).collect();
+        let weights = match kind {
+            0 => TestWeights::Analytic(&original_w),
+            1 => TestWeights::Frequency(&original_w),
+            2 => TestWeights::Probability(&original_w),
+            _ => TestWeights::Unit,
+        };
+        let prepared = prepared(
+            &y,
+            &[x.clone(), duplicate.clone()],
+            &[false, false],
+            Some(&groups),
+            false,
+            weights,
+        );
+        let frame = LinearSolveFrame::from_prepared_ols(&prepared).unwrap();
+        let views: Vec<&[f64]> = vec![&y, &x, &duplicate];
+        let index = LevelIndex::from_codes(&codes, 2).unwrap();
+        let membership = ValidatedBorrowedInterceptSource::new(&codes, 2, &index).unwrap();
+        let effect = membership.effect();
+        let centered =
+            CenteredColumns::prepare(&views, &effect, frame.weights.borrowed(), 2 * 3 * 8).unwrap();
+        let reference: Vec<f64> = (1..=2)
+            .map(|c| centered_norm(&centered, c, frame.weights, true).unwrap())
+            .collect();
+        let scores: Vec<f64> = (1..=2)
+            .map(|c| centered_norm(&centered, c, frame.weights, false).unwrap())
+            .collect();
+        let source = CenteredStandardized {
+            centered: &centered,
+            weights: frame.weights,
+            reference_norms: &reference,
+        };
+        let result = centered_scratch_fallback(
+            &prepared,
+            &source,
+            &scores,
+            frame.bread_weight_scale,
+            PreparedOlsFitConfig::default(),
+            65_536,
+            4096,
+            &mut SystemFitReservation,
+            |_| {},
+        )
+        .unwrap();
+        // Exact rational group contrasts give XX=111 and XY=217/2. AW/PW
+        // reference weights multiply raw weights by 8/20; FW and literal
+        // repetition retain the unnormalized reference cross-product.
+        let beta = 217.0 / 222.0;
+        let bread = if kind == 0 || kind == 2 {
+            5.0 / 222.0
+        } else {
+            1.0 / 111.0
+        };
+        assert_eq!(result.fit.rank, 1);
+        assert_eq!(result.fit.kept, vec![0]);
+        assert_eq!(result.fit.generated_coefficients[1], None);
+        assert!((result.fit.generated_coefficients[0].unwrap() - beta).abs() < 1e-13);
+        assert!((result.fit.bread.as_ref().unwrap().values[0] - bread).abs() < 1e-14);
+        for (row, residual) in result
+            .fit
+            .within_residuals
+            .as_ref()
+            .unwrap()
+            .iter()
+            .enumerate()
+        {
+            let group = codes[row] as usize;
+            let expected = (y[row] - [6.6, 1.5][group]) - beta * (x[row] - [4.5, -0.5][group]);
+            assert!((residual - expected).abs() < 1e-13);
+        }
+    }
+}
