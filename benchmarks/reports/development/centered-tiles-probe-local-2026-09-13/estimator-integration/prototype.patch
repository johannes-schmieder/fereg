+#[test]
+fn centered_finite_workspace_and_invalid_inputs_fail_closed() {
+    struct Reservation {
+        calls: usize,
+        fail_at: usize,
+        oversize: bool,
+    }
+    impl FitReservation for Reservation {
+        fn reserve<T>(
+            &mut self,
+            target: &mut Vec<T>,
+            elements: usize,
+            label: &'static str,
+        ) -> Result<()> {
+            self.calls += 1;
+            if self.calls == self.fail_at {
+                return Err(allocation("injected centered reserve failure"));
+            }
+            SystemFitReservation.reserve(target, elements + usize::from(self.oversize), label)
+        }
+    }
+    let columns = [vec![1.0, 4.0, 3.0, 8.0], vec![2.0, 5.0, 7.0, 9.0]];
+    let views: Vec<&[f64]> = columns.iter().map(Vec::as_slice).collect();
+    let codes = [0, 0, 1, 1];
+    let index = LevelIndex::from_codes(&codes, 2).unwrap();
+    let membership = ValidatedBorrowedInterceptSource::new(&codes, 2, &index).unwrap();
+    let effect = membership.effect();
+    let centered = CenteredColumns::prepare(&views, &effect, BorrowedMapWeights::Unit, 32).unwrap();
+    let source = CenteredStandardized {
+        centered: &centered,
+        weights: NormalizedWeights {
+            values: None,
+            raw_scale: 1.0,
+            kind: None,
+        },
+        reference_norms: &[12.0],
+    };
+    let bytes = (4 * 2 + 2 + 1 + 1) * 8;
+    let mut reservation = Reservation {
+        calls: 0,
+        fail_at: usize::MAX,
+        oversize: false,
+    };
+    assert!(centered_moments(&source, &[0], bytes - 1, &mut reservation).is_err());
+    assert_eq!(reservation.calls, 0, "admit before any allocation");
+    centered_moments(&source, &[0], bytes, &mut reservation).unwrap();
+    for fail_at in 1..=4 {
+        let mut reservation = Reservation {
+            calls: 0,
+            fail_at,
+            oversize: false,
+        };
+        assert!(centered_moments(&source, &[0], bytes, &mut reservation).is_err());
+        assert_eq!(reservation.calls, fail_at);
+    }
+    let mut reservation = Reservation {
+        calls: 0,
+        fail_at: usize::MAX,
+        oversize: true,
+    };
+    assert!(centered_moments(&source, &[0], bytes, &mut reservation).is_err());
+    for candidates in [vec![], vec![1], vec![0, 0]] {
+        let mut reservation = Reservation {
+            calls: 0,
+            fail_at: usize::MAX,
+            oversize: false,
+        };
+        assert!(centered_moments(&source, &candidates, bytes, &mut reservation).is_err());
+        assert_eq!(reservation.calls, 0);
+    }
+    let invalid = CenteredStandardized {
+        reference_norms: &[f64::NAN],
+        ..source
+    };
+    let mut reservation = Reservation {
+        calls: 0,
+        fail_at: usize::MAX,
+        oversize: false,
+    };
+    assert!(centered_moments(&invalid, &[0], bytes, &mut reservation).is_err());
+    assert_eq!(reservation.calls, 0);
+}
