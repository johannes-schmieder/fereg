+    #[test]
+    fn reusable_initial_projection_counts_sweeps_and_keeps_multife_warm_checks() {
+        let codes = [0_u32, 0, 1, 1, 0, 0, 1, 1];
+        let index = LevelIndex::from_codes(&codes, 2).unwrap();
+        let source = ValidatedBorrowedInterceptSource::new(&codes, 2, &index).unwrap();
+        let second_codes = [0_u32, 1, 0, 1, 0, 1, 0, 1];
+        let second_index = LevelIndex::from_codes(&second_codes, 2).unwrap();
+        let second = ValidatedBorrowedInterceptSource::new(&second_codes, 2, &second_index).unwrap();
+        for multi in [false, true] {
+            let effects = if multi {
+                vec![source.effect(), second.effect()]
+            } else {
+                vec![source.effect()]
+            };
+            let design = BorrowedInterceptFeDesign::new(codes.len(), effects).unwrap();
+            let mut projector = ReusableCategoricalMapAbsorber::new(design, 1, 1).unwrap();
+            let capacities = projector.capacities();
+            let one_step = MapConfig {
+                max_iterations: 1,
+                ..config()
+            };
+            let actual = projector
+                .absorb_initial(
+                    BorrowedMapWeights::Unit,
+                    DenseMatrix::zeros(codes.len(), 1).unwrap(),
+                    one_step,
+                )
+                .unwrap();
+            assert_eq!(actual.report().iterations, usize::from(!multi));
+            assert!(actual.report().certified());
+            let (within, _) = actual.into_parts();
+            let warm = projector
+                .absorb(BorrowedMapWeights::Unit, within, one_step)
+                .unwrap();
+            assert_eq!(warm.report().iterations, 0);
+            let invalid = MapConfig {
+                max_iterations: 0,
+                ..config()
+            };
+            assert_eq!(
+                projector
+                    .absorb_initial(
+                        BorrowedMapWeights::Unit,
+                        DenseMatrix::zeros(codes.len(), 1).unwrap(),
+                        invalid,
+                    )
+                    .unwrap_err()
+                    .code,
+                ErrorCode::InvalidArgument
+            );
+            if !multi {
+                let values =
+                    DenseMatrix::from_columns(&[vec![0.1, 0.3, 0.8, 1.4, 0.7, 0.2, 1.1, 0.9]]).unwrap();
+                let weights = [1.0, 3.0, 5.0, 7.0, 2.0, 4.0, 6.0, 8.0];
+                let strict = MapConfig {
+                    tolerance: 1e-30,
+                    ..one_step
+                };
+                let error = projector
+                    .absorb_initial(BorrowedMapWeights::Provided(&weights), values, strict)
+                    .unwrap_err();
+                assert_eq!(
+                    error.message,
+                    "reusable categorical MAP exhausted its iteration budget without certification"
+                );
+            }
+            assert_eq!(projector.capacities(), capacities);
+        }
+    }
