+fn independent_outcome_sum(
+    outcome: &[f64],
+    weights: ReferenceWeightView<'_>,
+    has_intercept: bool,
+) -> Result<f64> {
+    let mean = weighted_mean(outcome, weights)?;
+    weighted_sum_of_squares(outcome, weights, if has_intercept { mean } else { 0.0 })
 }
 
