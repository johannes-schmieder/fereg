+        let team = crate::parallel::ThreadTeam::new(ThreadConfig::from_requested(1, true).unwrap());
+        team.install(|| {
+            let rows = 800;
+            let columns = 65;
+            let worker = (0..rows).map(|r| (r / 8) as u32).collect::<Vec<_>>();
+            let firm = (0..rows)
+                .map(|r| ((r / 8 + r % 8) % 10) as u32)
+                .collect::<Vec<_>>();
+            let worker_index = LevelIndex::from_codes(&worker, 100).unwrap();
+            let firm_index = LevelIndex::from_codes(&firm, 10).unwrap();
+            let input = DenseMatrix::from_columns(
+                &(0..columns)
+                    .map(|c| {
+                        (0..rows)
+                            .map(|r| (r as f64 * 0.017 + c as f64).sin() + worker[r] as f64 * 0.125)
+                            .collect::<Vec<_>>()
+                    })
+                    .collect::<Vec<_>>(),
+            )
+            .unwrap();
