+                let design = BorrowedInterceptFeDesign::new(
+                    rows,
+                    vec![
+                        effect(&worker, 100, &worker_index),
+                        effect(&firm, 10, &firm_index),
+                    ],
+                )
+                .unwrap();
+                let mut cfg = config(1);
+                cfg.retain_coefficients = retain_coefficients;
+                let mut session =
