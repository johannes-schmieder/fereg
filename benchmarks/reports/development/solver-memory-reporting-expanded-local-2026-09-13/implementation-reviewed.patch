+// Admission and report-only callers use the pool that executes the batch.
+// A requested/default thread count can differ for retained core sessions.
+fn borrowed_solver_memory(
+    design: &BorrowedInterceptFeDesign<'_>,
+    rhs_columns: usize,
+    local_size: Option<usize>,
+) -> Result<crate::memory::FeSolverMemoryEstimate> {
+    let mut levels = Vec::new();
+    levels
+        .try_reserve_exact(design.effects().len())
+        .map_err(|_| allocation("unable to reserve solver memory shape"))?;
+    levels.extend(design.effects().iter().map(|effect| effect.n_levels()));
+    estimate_fe_solver_memory(
+        design.nobs(),
+        rhs_columns,
+        &levels,
+        rayon::current_num_threads(),
+        local_size,
+    )
+}
