+                let (reference, reference_report, reference_coefficients) =
+                    session.absorb(input.clone()).unwrap().into_full_parts();
+                let retained = match &session.route {
+                    CmgRoute::Graph(graph) => {
+                        ensure_cmg_exact_retained_memory_fits(graph, cfg, None).unwrap()
+                    }
+                    _ => panic!("test must retain the CMG hierarchy"),
+                };
+                let coefficient_bytes = reference_coefficients
+                    .as_ref()
+                    .map_or(0, FeCoefficientBatch::retained_bytes);
+                assert_eq!(coefficient_bytes > 0, retain_coefficients);
+                let cg = estimate_fe_solver_memory(rows, columns, &[100, 10], 1, None)
+                    .unwrap()
+                    .cg_bytes;
+                let overlap = retained + coefficient_bytes + cg;
+                assert!(overlap > cg);
+                assert!(reference_report.solver_workspace_peak_bytes >= overlap);
+
+                // Admit the graph by itself, then exercise the actual projection
+                // and the boundary immediately before CG can allocate its banks.
+                session.config.solver_memory_budget = Some(FeSolverMemoryBudget {
+                    execution_bytes: 1024,
+                    usable_bytes: 1024 + overlap - 1,
+                });
+                let error = session.absorb(input.clone()).unwrap_err();
+                assert_eq!(error.code, ErrorCode::Allocation);
+                assert!(error.message.contains("including retained CMG state"));
