+/// Detector weights can connect otherwise separate positive-outcome components
+/// by arbitrarily small bridges. A stationary MAP sweep is then ineffective.
+/// Admit retained-product CG before any detector solve, on generation zero;
+/// later generations only shrink. Publication IRLS keeps its own solver policy.
+fn admit_detector_projection(
+    generation: &PreparedPpmlModelGeneration,
+    mut ppml: PpmlConfig,
+    config: SeparationConfig,
+    execution: &mut PreparedPpmlSeparationExecution,
+) -> Result<(PpmlConfig, PreparedOlsFitConfig)> {
+    let mut linear = execution.linear;
+    if ppml.absorb.solver != FeSolverKind::Map
+        || !(config.methods.simplex || config.methods.iterated_rectifier || config.methods.mu)
+        || !generation.outcome().contains(&0.0)
+    {
+        return Ok((ppml, linear));
+    }
+    let Some(design) = generation.fit_view().fit_borrowed_intercept_map_design()? else {
+        return Ok((ppml, linear));
+    };
+    if design.effects().len() < 2 { return Ok((ppml, linear)); }
+    let levels = fallible_collect(design.effects().iter().map(|e| e.n_levels()),
+        design.effects().len(), "unable to reserve separation solver level counts")?;
+    let rhs = generation.model().columns.len().checked_add(1)
+        .ok_or_else(|| allocation("separation projection width overflows"))?;
+    let estimate = crate::memory::estimate_fe_solver_memory(
+        generation.original_rows().len(), rhs, &levels,
+        linear.execution.threads.resolved(), linear.absorb.lsmr.local_size,
+    )?;
+    // Five coefficient banks include return/conversion overlap. Conservatively
+    // cover both full raw/within banks even in Low's otherwise streamed plan.
+    let bytes = estimate.coefficient_batch_bytes.checked_mul(5)
+        .and_then(|n| n.checked_add(estimate.cg_bytes))
+        .and_then(|n| estimate.rhs_copy_bytes.checked_mul(2).and_then(|m| n.checked_add(m)))
+        .ok_or_else(|| allocation("separation CG memory bound overflows"))?;
+    let base = execution.preliminary_plan.selected_bytes();
+    if !execution.preliminary_plan.admit_separation_solver(bytes) {
+        return Ok((ppml, linear));
+    }
+    linear.absorb.solver = FeSolverKind::Cg;
+    linear.absorb.retain_coefficients = true;
+    linear.absorb.solver_memory_budget = Some(crate::memory::FeSolverMemoryBudget {
+        execution_bytes: base,
+        usable_bytes: base.checked_add(bytes).ok_or_else(|| allocation("separation CG budget overflows"))?,
+    });
+    ppml.absorb = linear.absorb;
+    Ok((ppml, linear))
+}
