new file mode 100644
index 00000000..71702eb0
--- /dev/null
+++ b/crates/fereg-core/src/ppml/prepared_separation_graph.rs
@@ -0,0 +1,205 @@
+//! Exact recession-direction proposal from a two-intercept submodel.
+//!
+//! Positive rows identify the two endpoint potentials. On the resulting
+//! quotient, a zero row imposes potential(left) <= potential(right). Strongly
+//! connected components must share a potential; their topological order gives
+//! a nonpositive direction on every zero row and a strict one across components.
+//! This supplies an IR starting proposal, never a full-model no-separation proof.
+
+use super::{allocation, fallible_copy, fallible_filled, invalid_argument};
+use crate::error::Result;
+use crate::fe::BorrowedInterceptFeDesign;
+
+pub(super) fn workspace_bytes(design: &BorrowedInterceptFeDesign<'_>) -> Result<Option<u128>> {
+    if design.effects().len() < 2 { return Ok(None); }
+    let levels = (design.effects()[0].n_levels() as u128)
+        .checked_add(design.effects()[1].n_levels() as u128)
+        .ok_or_else(|| allocation("separation graph levels overflow"))?;
+    // Integer potentials and their differences must be exactly representable.
+    if levels > (1_u128 << 53) { return Ok(None); }
+    // DSU, dual CSR, traversal, finishing order, component labels, returned
+    // direction and proposal overlap. No recursion or per-vertex allocation.
+    let bytes = levels.checked_mul(96)
+        .and_then(|n| (design.nobs() as u128).checked_mul(32).and_then(|m| n.checked_add(m)))
+        .and_then(|n| n.checked_add(4096))
+        .ok_or_else(|| allocation("separation graph workspace overflows"))?;
+    Ok(Some(bytes))
+}
+
+fn root(parent: &mut [usize], mut v: usize) -> usize {
+    while parent[v] != v {
+        parent[v] = parent[parent[v]];
+        v = parent[v];
+    }
+    v
+}
+
+pub(super) fn direction(design: &BorrowedInterceptFeDesign<'_>, outcome: &[f64], interrupt: &mut dyn FnMut() -> Result<()>) -> Result<Option<Vec<f64>>> {
+    if workspace_bytes(design)?.is_none() { return Ok(None); }
+    if outcome.len() != design.nobs() || outcome.iter().any(|v| !v.is_finite() || *v < 0.) {
+        return Err(invalid_argument("separation graph outcomes are not aligned and nonnegative"));
+    }
+    interrupt()?;
+    let left = design.effects()[0];
+    let right = design.effects()[1];
+    let split = left.n_levels();
+    let levels = split.checked_add(right.n_levels())
+        .ok_or_else(|| allocation("separation graph levels overflow"))?;
+    let offsets = levels.checked_add(1).ok_or_else(|| allocation("separation graph offsets overflow"))?;
+    let mut parent = fallible_filled(levels, 0_usize, "unable to reserve separation graph parents")?;
+    for (v, p) in parent.iter_mut().enumerate() { *p = v; }
+    let mut rank = fallible_filled(levels, 0_u8, "unable to reserve separation graph ranks")?;
+    for (row, &y) in outcome.iter().enumerate() {
+        if row % 65_536 == 0 { interrupt()?; }
+        if y > 0. {
+            let mut a = root(&mut parent, left.codes()[row] as usize);
+            let mut b = root(&mut parent, split + right.codes()[row] as usize);
+            if a != b {
+                if rank[a] < rank[b] { std::mem::swap(&mut a, &mut b); }
+                parent[b] = a;
+                if rank[a] == rank[b] { rank[a] += 1; }
+            }
+        }
+    }
+    for v in 0..levels { parent[v] = root(&mut parent, v); }
+    drop(rank);
+    let endpoints = |row: usize| (parent[left.codes()[row] as usize], parent[split + right.codes()[row] as usize]);
+    let mut forward = fallible_filled(offsets, 0_usize, "unable to reserve separation graph forward offsets")?;
+    let mut reverse = fallible_filled(offsets, 0_usize, "unable to reserve separation graph reverse offsets")?;
+    for (row, &y) in outcome.iter().enumerate() {
+        if row % 65_536 == 0 { interrupt()?; }
+        if y == 0. {
+            let (a,b) = endpoints(row);
+            if a != b { forward[a+1] += 1; reverse[b+1] += 1; }
+        }
+    }
+    for v in 0..levels { forward[v+1] += forward[v]; reverse[v+1] += reverse[v]; }
+    if forward[levels] == 0 { return Ok(None); }
+    let mut targets = fallible_filled(forward[levels], 0_usize, "unable to reserve separation graph edges")?;
+    let mut origins = fallible_filled(reverse[levels], 0_usize, "unable to reserve separation graph reverse edges")?;
+    let mut next = fallible_copy(&forward[..levels], "unable to reserve separation graph cursors")?;
+    let mut reverse_next = fallible_copy(&reverse[..levels], "unable to reserve separation graph reverse cursors")?;
+    for (row, &y) in outcome.iter().enumerate() {
+        if row % 65_536 == 0 { interrupt()?; }
+        if y == 0. {
+            let (a,b) = endpoints(row);
+            if a != b {
+                targets[next[a]] = b; next[a] += 1;
+                origins[reverse_next[b]] = a; reverse_next[b] += 1;
+            }
+        }
+    }
+    drop(reverse_next);
+    next.copy_from_slice(&forward[..levels]);
+    let mut seen = fallible_filled(levels, false, "unable to reserve separation graph visits")?;
+    let mut stack = Vec::new();
+    stack.try_reserve_exact(levels).map_err(|_| allocation("unable to reserve separation graph traversal"))?;
+    let mut order = Vec::new();
+    order.try_reserve_exact(levels).map_err(|_| allocation("unable to reserve separation graph finishing order"))?;
+    for v in 0..levels {
+        if v % 65_536 == 0 { interrupt()?; }
+        if parent[v] != v || seen[v] { continue; }
+        seen[v] = true; stack.push(v);
+        while let Some(&a) = stack.last() {
+            if next[a] == forward[a+1] { order.push(a); stack.pop(); }
+            else {
+                if next[a] % 65_536 == 0 { interrupt()?; }
+                let b = targets[next[a]]; next[a] += 1;
+                if !seen[b] { seen[b] = true; stack.push(b); }
+            }
+        }
+    }
+    let mut component = fallible_filled(levels, usize::MAX, "unable to reserve separation graph components")?;
+    let mut count = 0;
+    for &v in order.iter().rev() {
+        if component[v] != usize::MAX { continue; }
+        component[v] = count; stack.push(v);
+        while let Some(a) = stack.pop() {
+            if a % 65_536 == 0 { interrupt()?; }
+            for &b in &origins[reverse[a]..reverse[a+1]] {
+                if component[b] == usize::MAX { component[b] = count; stack.push(b); }
+            }
+        }
+        count += 1;
+    }
+    let mut direction = fallible_filled(outcome.len(), 0., "unable to reserve separation graph direction")?;
+    let mut strict = false;
+    // Reconstruct from original endpoint codes, independently of CSR edges.
+    // Extra model columns/FE effects have coefficient zero in this proposal.
+    for (row, z) in direction.iter_mut().enumerate() {
+        if row % 65_536 == 0 { interrupt()?; }
+        let (a,b) = endpoints(row);
+        *z = component[a] as f64 - component[b] as f64;
+        if (outcome[row] > 0. && *z != 0.) || (outcome[row] == 0. && *z > 0.) {
+            return Err(invalid_argument("separation graph direction failed exact endpoint reconstruction"));
+        }
+        strict |= *z < 0.;
+    }
+    Ok(strict.then_some(direction))
+}
