+        let design = BorrowedInterceptFeDesign::new(g.len(), vec![
+            BorrowedInterceptEffect::new(g, ng, &gi).unwrap(),
+            BorrowedInterceptEffect::new(h, nh, &hi).unwrap(),
+        ]).unwrap();
+        direction(&design, y, &mut || Ok(())).unwrap()
+    }
