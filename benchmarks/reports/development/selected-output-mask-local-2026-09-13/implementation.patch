+    #[test]
+    fn selected_sd_recovery_preserves_channels_and_certificates_without_absorbed_sum() {
+        let worker = [0_u32, 0, 1, 1, 2, 2, 3, 3];
+        let firm = [0_u32, 1, 1, 2, 2, 3, 3, 0];
+        let weights = [1.0, 3.0, 2.0, 5.0, 4.0, 7.0, 2.0, 1.0];
+        for effect_count in [1, 2] {
+            let factors = if effect_count == 1 {
+                vec![CategoricalCodeView::new(&worker, 4)]
+            } else {
+                vec![
+                    CategoricalCodeView::new(&worker, 4),
+                    CategoricalCodeView::new(&firm, 4),
+                ]
+            };
+            let arities: Vec<&[usize]> = if effect_count == 1 {
+                vec![&[0]]
+            } else {
+                vec![&[0], &[1]]
+            };
+            let topology = finalize_categorical_topology(&factors, &arities, &[true; 8]).unwrap();
+            let effects: Vec<_> = (0..effect_count)
+                .map(|_| CategoricalAbsorbedEffectView::new(true, Vec::new()).unwrap())
+                .collect();
+            for zero in [false, true] {
+                let target: Vec<f64> = (0..8)
+                    .map(|row| {
+                        if zero {
+                            0.0
+                        } else {
+                            worker[row] as f64
+                                + if effect_count == 2 {
+                                    0.5 * firm[row] as f64
+                                } else {
+                                    0.0
+                                }
+                        }
+                    })
+                    .collect();
+                for weighted in [false, true] {
+                    let weights = if weighted {
+                        BorrowedMapWeights::Provided(&weights)
+                    } else {
+                        BorrowedMapWeights::Unit
+                    };
+                    let mut mask = vec![false; effect_count];
+                    mask[0] = true;
+                    let lsmr = LsmrConfig {
+                        tolerance: 1e-12,
+                        max_iterations: 20_000,
+                        ..LsmrConfig::default()
+                    };
+                    let map = MapConfig {
+                        tolerance: 1e-12,
+                        ..config()
+                    };
+                    let full = recover_finalized_categorical_effects_sd_lsmr_selected_certified(
+                        &topology, &effects, weights, &target, &mask, lsmr, map, true,
+                    )
+                    .unwrap();
+                    let selected =
+                        recover_finalized_categorical_effects_sd_lsmr_selected_certified(
+                            &topology, &effects, weights, &target, &mask, lsmr, map, false,
+                        )
+                        .unwrap();
+                    assert_eq!(selected.recovery_method(), full.recovery_method());
+                    assert_eq!(selected.iterations(), full.iterations());
+                    assert_eq!(
+                        selected.reconstruction_relative_infinity(),
+                        full.reconstruction_relative_infinity()
+                    );
+                    for (a, e) in full.absorbed_sum().iter().zip(&target) {
+                        assert!((a - e).abs() <= 1e-10);
+                    }
+                    let (sum, channels) = selected.into_optional_parts();
+                    assert!(sum.is_none());
+                    assert_eq!(channels.as_slice(), full.channels());
+                    assert_eq!(channels.iter().filter(|v| v.is_some()).count(), 1);
+                    eprintln!("SELECTED_RECOVERY|effects={effect_count}|weighted={weighted}|zero={zero}|method={:?}|iterations={}",full.recovery_method(),full.iterations());
+                }
+            }
+        }
+    }
