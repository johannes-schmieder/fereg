+impl OlsShadowResult<'_> {
+    pub(crate) fn capacity_bytes(&self) -> u128 {
+        [
+            &self.b,
+            &self.covariance,
+            &self.coefficient_status,
+            &self.omission_b_marker,
+            &self.omission_v_marker,
+            &self.fit,
+            &self.dof,
+            &self.solver,
+            &self.fixed_effects,
+            &self.clusters,
+            &self.subsets,
+            &self.certificates,
+            &self.receipt,
+        ]
+        .into_iter()
+        .map(|values| values.capacity() as u128)
+        .sum::<u128>()
+            * std::mem::size_of::<f64>() as u128
+    }
+}
