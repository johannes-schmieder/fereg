+            .unwrap();
+            let runtime = build_runtime_shadow(&action, &shadow, &observation).unwrap();
+            let bytes = shadow.capacity_bytes()
+                + derived.capacity_bytes()
+                + runtime.capacity() as u128 * std::mem::size_of::<f64>() as u128;
+            assert_eq!(
