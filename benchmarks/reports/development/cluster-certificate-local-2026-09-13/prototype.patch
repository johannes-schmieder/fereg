+fn certify_interaction_partition<R: CategoricalClusterReservation>(
+    components: &[CategoricalCodeView<'_>],
+    codes: &[u32],
+    groups: usize,
+    reservation: &mut R,
+) -> Result<()> {
+    if components.len() < 2
+        || codes.is_empty()
+        || groups == 0
+        || groups > codes.len()
+        || components
+            .iter()
+            .any(|source| source.codes().len() != codes.len())
+    {
+        return Err(invalid_argument(
+            "categorical cluster partition axes disagree",
+        ));
+    }
+    // At most one row index per observed group. On 64-bit targets this fits
+    // the replaced factorization's 4*N codes + 4*P dense map (G <= N, P),
+    // or its 8*N ordering + 4*N codes. No second contiguity bitmap overlaps.
+    let mut representatives = reserved_filled(
+        reservation,
+        groups,
+        usize::MAX,
+        "unable to reserve categorical cluster certificate representatives",
+    )?;
+    for (row, &code) in codes.iter().enumerate() {
+        let representative = representatives
+            .get_mut(code as usize)
+            .ok_or_else(|| invalid_data("categorical cluster partition code is out of range"))?;
+        if *representative == usize::MAX {
+            *representative = row;
+        } else if components
+            .iter()
+            .any(|source| source.codes()[row] != source.codes()[*representative])
+        {
+            return Err(invalid_data(
+                "categorical cluster code merges distinct source tuples",
+            ));
+        }
+    }
+    let mut previous: Option<usize> = None;
+    for representative in representatives {
+        if representative == usize::MAX {
+            return Err(invalid_data(
+                "categorical cluster codes are not contiguous on the final sample",
+            ));
+        }
+        if let Some(prior) = previous {
+            let order = components
+                .iter()
+                .map(|source| source.codes()[prior].cmp(&source.codes()[representative]))
+                .find(|order| !order.is_eq());
+            // Strict lexicographic order excludes split tuples as well as
+            // noncanonical relabeling, independently of the factorizer.
+            if order != Some(std::cmp::Ordering::Less) {
+                return Err(invalid_data(
+                    "categorical cluster codes do not follow canonical tuple order",
+                ));
+            }
+        }
+        previous = Some(representative);
+    }
+    Ok(())
+}
