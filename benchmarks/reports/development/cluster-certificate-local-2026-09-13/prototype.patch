+#[cfg(test)]
+mod partition_certificate_tests {
+    use super::*;
+
+    #[test]
+    fn interaction_certificate_matches_exact_factorization_across_row_orders() {
+        for rows in [2, 17, 257] {
+            for reverse in [false, true] {
+                let mut first = (0..rows).map(|row| (row % 7) as u32).collect::<Vec<_>>();
+                let mut second = (0..rows)
+                    .map(|row| ((row * 13) % 11) as u32)
+                    .collect::<Vec<_>>();
+                if reverse {
+                    first.reverse();
+                    second.reverse();
+                }
+                let components = [
+                    CategoricalCodeView::new(&first, 7),
+                    CategoricalCodeView::new(&second, 11),
+                    CategoricalCodeView::new(&first, 7),
+                ];
+                let encoded = factorize_code_interaction(&components).unwrap();
+                certify_interaction_partition(
+                    &components,
+                    encoded.codes(),
+                    encoded.n_levels(),
+                    &mut SystemCategoricalClusterReservation,
+                )
+                .unwrap();
+            }
+        }
+    }
+
+    #[test]
+    fn interaction_certificate_rejects_merge_split_relabel_and_missing_groups() {
+        let first = [0, 0, 0, 1, 1, 1];
+        let second = [0, 0, 1, 0, 1, 1];
+        let components = [
+            CategoricalCodeView::new(&first, 2),
+            CategoricalCodeView::new(&second, 2),
+        ];
+        let valid = [0, 0, 1, 2, 3, 3];
+        certify_interaction_partition(
+            &components,
+            &valid,
+            4,
+            &mut SystemCategoricalClusterReservation,
+        )
+        .unwrap();
+        for (codes, groups) in [
+            ([0, 0, 0, 2, 3, 3], 4),
+            ([0, 1, 2, 3, 4, 4], 5),
+            ([1, 1, 0, 2, 3, 3], 4),
+            ([0, 0, 1, 2, 4, 4], 5),
+            ([0, 0, 1, 2, 4, 4], 4),
+        ] {
+            assert_eq!(
+                certify_interaction_partition(
+                    &components,
+                    &codes,
+                    groups,
+                    &mut SystemCategoricalClusterReservation,
+                )
+                .unwrap_err()
+                .code,
+                ErrorCode::InvalidData,
+            );
+        }
+        assert_eq!(first, [0, 0, 0, 1, 1, 1]);
+        assert_eq!(valid, [0, 0, 1, 2, 3, 3]);
+    }
+
+    struct BoundedReservation {
+        bytes: usize,
+        fail: bool,
+    }
+    impl CategoricalClusterReservation for BoundedReservation {
+        fn reserve_vec<T>(
+            &mut self,
+            target: &mut Vec<T>,
+            elements: usize,
+            label: &'static str,
+        ) -> Result<()> {
+            self.bytes += elements * std::mem::size_of::<T>();
+            if self.fail {
+                return Err(allocation("injected partition certificate allocation"));
+            }
+            SystemCategoricalClusterReservation.reserve_vec(target, elements, label)
+        }
+        fn reserve_string(&mut self, _: &mut String, _: usize, _: &'static str) -> Result<()> {
+            panic!("partition certification must not allocate strings");
+        }
+    }
+
+    #[test]
+    fn interaction_certificate_bounds_workspace_and_propagates_allocation_failure() {
+        for rows in [2, 513] {
+            let first = (0..rows).map(|row| row as u32).collect::<Vec<_>>();
+            let second = vec![0; rows];
+            let components = [
+                CategoricalCodeView::new(&first, rows),
+                CategoricalCodeView::new(&second, 1),
+            ];
+            for fail in [false, true] {
+                let mut reservation = BoundedReservation { bytes: 0, fail };
+                let result =
+                    certify_interaction_partition(&components, &first, rows, &mut reservation);
+                assert!(reservation.bytes <= 4 * rows + 4 * rows);
+                if fail {
+                    assert_eq!(result.unwrap_err().code, ErrorCode::Allocation);
+                } else {
+                    result.unwrap();
+                }
+            }
+        }
+    }
+}
