+    #[test]
+    fn constant_weight_kernels_preserve_raw_handoffs_and_projection_certificates() {
+        let rows = 16_384;
+        let codes = (0..rows).map(|r| (r % 97) as u32).collect::<Vec<_>>();
+        let index = LevelIndex::from_codes(&codes, 97).unwrap();
+        let source = ValidatedBorrowedInterceptSource::new(&codes, 97, &index).unwrap();
+        let design = BorrowedInterceptFeDesign::new(rows, vec![source.effect()]).unwrap();
+        let columns = (0..17)
+            .map(|c| {
+                (0..rows)
+                    .map(|r| (codes[r] as f64) * 32.0 + ((r * (c + 7) % 997) as f64).sin())
+                    .collect::<Vec<_>>()
+            })
+            .collect::<Vec<_>>();
+        let values = DenseMatrix::from_columns(&columns).unwrap();
+        for threads in [1, 7] {
+            crate::parallel::ThreadTeam::new(
+                crate::options::ThreadConfig::from_requested(threads, true).unwrap(),
+            )
+            .install(|| {
+                let unit = absorb_borrowed_intercept_map_certified(
+                    &design,
+                    BorrowedMapWeights::Unit,
+                    values.clone(),
+                    config(),
+                )
+                .unwrap();
+                for scale in [f64::from_bits(1), f64::MIN_POSITIVE, 128.0, f64::MAX] {
+                    let raw = vec![scale; rows];
+                    let weights =
+                        validate_weights(BorrowedMapWeights::Provided(&raw), rows).unwrap();
+                    assert!(weights.unit_normalized);
+                    assert!(weights.kernel_values().is_none());
+                    assert_eq!(weights.raw_scale, scale);
+                    assert_eq!(weights.normalized(rows - 1), 1.0);
+                    match borrowed_weights(weights) {
+                        BorrowedMapWeights::Provided(original) => {
+                            assert_eq!(original.as_ptr(), raw.as_ptr());
+                            assert_eq!(original.len(), rows);
+                        }
+                        BorrowedMapWeights::Unit => panic!("raw weights were erased"),
+                    }
+                    let constant = absorb_borrowed_intercept_map_certified(
+                        &design,
+                        BorrowedMapWeights::Provided(&raw),
+                        values.clone(),
+                        config(),
+                    )
+                    .unwrap();
+                    assert_eq!(constant.residualized(), unit.residualized());
+                    assert_eq!(constant.report().iterations, unit.report().iterations);
+                    assert_eq!(
+                        constant.report().certificate.relative_infinity_norm,
+                        unit.report().certificate.relative_infinity_norm
+                    );
+                    assert_eq!(
+                        constant.report().certificate.absolute_infinity_norm,
+                        unit.report().certificate.absolute_infinity_norm * scale
+                    );
+                }
+            })
+            .unwrap();
+        }
+        // A one-ULP difference must retain weighted arithmetic, and the
+        // original normalized-underflow rejection must remain authoritative.
+        let almost = [128.0, f64::from_bits(128.0_f64.to_bits() + 1)];
+        let weights = validate_weights(BorrowedMapWeights::Provided(&almost), 2).unwrap();
+        assert!(!weights.unit_normalized);
+        assert!(weights.kernel_values().is_some());
+        assert_eq!(weights.normalized(0), almost[0] / almost[1]);
+        assert_eq!(
+            validate_weights(
+                BorrowedMapWeights::Provided(&[f64::MAX, f64::from_bits(1)]),
+                2
+            )
+            .unwrap_err()
+            .code,
+            ErrorCode::InvalidData
+        );
+    }
