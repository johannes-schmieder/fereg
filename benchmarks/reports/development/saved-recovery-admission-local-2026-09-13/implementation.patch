+            (96, vec![97], 1, 1),
+            (96, vec![4, 3], 3, 1),
+            (96, vec![4, 3], 2, 0),
+        ] {
+            assert_eq!(
+                estimate_intercept_recovery_memory(n, &levels, requested, workers, Some(4))
+                    .unwrap_err()
+                    .code,
+                ErrorCode::InvalidArgument,
+            );
+        }
+    }
