+
+// Isolated diagnostic only: fixed storage and C unwinder, never a production gate.
+static TRACE_ENABLED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static TRACE_INDEX: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static TRACE_DATA: [std::sync::atomic::AtomicUsize; 64 * 34] = [const { std::sync::atomic::AtomicUsize::new(0) }; 64 * 34];
+fn trace_allocation(size: usize) {
+    if !TRACE_ENABLED.load(Ordering::Acquire) { return; }
+    let index = TRACE_INDEX.fetch_add(1, Ordering::Relaxed);
+    if index >= 64 { return; }
+    let mut frames = [std::ptr::null_mut(); 32];
+    let count = unsafe { libc::backtrace(frames.as_mut_ptr(), 32) } as usize;
+    TRACE_DATA[index * 34].store(size, Ordering::Relaxed);
+    TRACE_DATA[index * 34 + 1].store(count, Ordering::Relaxed);
+    for (i, frame) in frames.iter().take(count).enumerate() {
+        TRACE_DATA[index * 34 + 2 + i].store(*frame as usize, Ordering::Relaxed);
+    }
+}
+pub(crate) fn trace_boundary() {
+    if !TRACE_ENABLED.swap(true, Ordering::AcqRel) {
+        TRACE_INDEX.store(0, Ordering::Relaxed);
+        return;
+    }
+    TRACE_ENABLED.store(false, Ordering::Release);
+    let count = TRACE_INDEX.load(Ordering::Acquire);
+    eprintln!("ALLOCATION_TRACE_COUNT={count}");
+    for index in 0..count.min(64) {
+        let size = TRACE_DATA[index*34].load(Ordering::Relaxed);
+        eprintln!("ALLOCATION_TRACE_EVENT={index} size={size}");
+        for i in 0..TRACE_DATA[index*34+1].load(Ordering::Relaxed) {
+            let address = TRACE_DATA[index*34+2+i].load(Ordering::Relaxed);
+            let mut info: libc::Dl_info = unsafe { std::mem::zeroed() };
+            unsafe { libc::dladdr(address as *const _, &mut info); }
+            eprintln!("ALLOCATION_TRACE_FRAME={i} address={address:#x} base={:#x}", info.dli_fbase as usize);
+        }
+    }
+}
