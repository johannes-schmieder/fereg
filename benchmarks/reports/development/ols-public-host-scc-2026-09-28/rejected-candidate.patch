diff --git a/stata/fereg.ado b/stata/fereg.ado
index 57942cf4..9f9aaffd 100644
--- a/stata/fereg.ado
+++ b/stata/fereg.ado
@@ -48,6 +48,17 @@ program define fereg, rclass
     }
 
     local display_results = c(noisily)
-    _fereg_estimate_public `0'
+    local host_processors = c(processors)
+    local quiet_prefix
+    if !`display_results' local quiet_prefix quietly
+    // Suppress host workers before parsing and native computation; restore
+    // the caller's setting before the optional coefficient table.
+    nobreak {
+        if `host_processors' > 1 quietly set processors 1
+        capture noisily break `quiet_prefix' _fereg_estimate_public `0'
+        local fit_rc = _rc
+        if `host_processors' > 1 quietly set processors `host_processors'
+    }
+    if `fit_rc' exit `fit_rc'
     if `display_results' ereturn display
 end
diff --git a/tests/licensed_stata/estimate_ols_eclass_break.do b/tests/licensed_stata/estimate_ols_eclass_break.do
index 4add1f87..b7aaddb1 100644
--- a/tests/licensed_stata/estimate_ols_eclass_break.do
+++ b/tests/licensed_stata/estimate_ols_eclass_break.do
@@ -1,6 +1,19 @@
 version 18.0
 clear all
 set more off
+args scope
+local original_processors = c(processors)
+local host_processors = min(4, c(processors_lic), c(processors_mach))
+set processors `host_processors'
+local estimate_command _fereg_estimate_ols_test
+if "`scope'" == "public" {
+    // Only this test adapter exposes hidden injection to the real wrapper.
+    local estimate_command fereg
+    program define _fereg_estimate_public, eclass
+        assert c(processors) == 1
+        _fereg_estimate_ols_test `0'
+    end
+}
 
 quietly findfile fereg.ado
 local ado_path = subinstr(`"`r(fn)'"', "\", "/", .)
@@ -21,11 +34,12 @@ local prior_rss : display %21x e(rss)
 
 * The interactive PTY controller sends an actual Control-C only after this
 * hidden action has completed its sole plugin call and printed its armed line.
-capture noisily _fereg_estimate_ols_test y c.x1, ///
+capture noisily `estimate_command' y c.x1, ///
     absorb(worker firm) cluster(cluster_a cluster_b) ///
     residual(__frg_break_resid) inject(breakpostplugin)
 local break_rc = _rc
 assert `break_rc' == 1
+assert c(processors) == `host_processors'
 confirm new variable __frg_break_resid
 assert `"`e(cmd)'"' == `"`prior_cmd'"'
 local after_N : display %21x e(N)
@@ -39,4 +53,6 @@ assert e(sample) == __frg_prior_sample
 
 * Split the literal so the PTY controller cannot mistake Stata's command echo
 * for the emitted terminal sentinel.
+set processors `original_processors'
+if "`scope'" == "public" display as result "FEREG_" "PUBLIC_SCOPE_VERIFIED"
 di as result "END_" "FIXTURE|estimate_ols_eclass_break|rc=0"
