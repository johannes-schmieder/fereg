use fereg_core::error::{FeregError, ErrorCode, Result};
use fereg_core::fe::LevelIndex;
fn allocation(message: impl Into<String>) -> FeregError { FeregError::new(ErrorCode::Allocation,message) }
fn fallible_filled<T: Clone>(len:usize,value:T,message:&'static str)->Result<Vec<T>> {
 let mut out=Vec::new();out.try_reserve_exact(len).map_err(|_|allocation(message))?;out.resize(len,value);Ok(out)
}
fn bounded_push<T>(out:&mut Vec<T>,n:usize,value:T,message:&'static str)->Result<()> {
 if out.len()>=n || out.len()>=out.capacity(){return Err(allocation(message));}out.push(value);Ok(())
}
#[path=CANDIDATE_SINGLETON_PATH]
mod indexed;
use std::alloc::{GlobalAlloc, Layout, System};
use std::sync::atomic::{AtomicUsize,Ordering};
struct Audit;
static LIVE:AtomicUsize=AtomicUsize::new(0);
static PEAK:AtomicUsize=AtomicUsize::new(0);
fn added(n:usize) { let live=LIVE.fetch_add(n,Ordering::Relaxed)+n; PEAK.fetch_max(live,Ordering::Relaxed); }
unsafe impl GlobalAlloc for Audit {
 unsafe fn alloc(&self,l:Layout)->*mut u8 { let p=System.alloc(l);if !p.is_null(){added(l.size());}p }
 unsafe fn alloc_zeroed(&self,l:Layout)->*mut u8 { let p=System.alloc_zeroed(l);if !p.is_null(){added(l.size());}p }
 unsafe fn dealloc(&self,p:*mut u8,l:Layout) { LIVE.fetch_sub(l.size(),Ordering::Relaxed);System.dealloc(p,l); }
 unsafe fn realloc(&self,p:*mut u8,l:Layout,n:usize)->*mut u8 { let q=System.realloc(p,l,n); if !q.is_null(){LIVE.fetch_sub(l.size(),Ordering::Relaxed);added(n);} q }
}
#[global_allocator] static ALLOCATOR:Audit=Audit;
fn legacy(sources:&[(&[u32],&LevelIndex)],mut active:Vec<bool>,frequency:Option<&[f64]>)->Result<Vec<usize>> {
    let mut dropped = Vec::new();
    dropped
        .try_reserve_exact(active.len())
        .map_err(|_| allocation("unable to reserve prepared singleton drop rows"))?;
    let mut pass = Vec::new();
    pass.try_reserve_exact(active.len())
        .map_err(|_| allocation("unable to reserve prepared singleton pass rows"))?;
    let mut selected = fallible_filled(
        active.len(),
        false,
        "unable to reserve prepared singleton pass selection mask",
    )?;
    loop {
        pass.clear();
        selected.fill(false);
        for (_, source) in sources {
            for level in 0..source.n_levels() {
                let mut multiplicity = 0_u128;
                let mut sole_row = None;
                for &row in source.checked_members(level)? {
                    if !active[row] {
                        continue;
                    }
                    let row_multiplicity =
                        if let Some(weights) = frequency {
                            weights[row] as u128
                        } else {
                            1
                        };
                    multiplicity = multiplicity.checked_add(row_multiplicity).ok_or_else(|| {
                        FeregError::new(
                            ErrorCode::InvalidData,
                            "prepared singleton multiplicity overflowed",
                        )
                    })?;
                    sole_row = Some(row);
                }
                if multiplicity == 1 {
                    let row = sole_row.expect("unit singleton has one active row");
                    if !selected[row] {
                        selected[row] = true;
                        pass.push(row);
                    }
                }
            }
        }
        pass.sort_unstable();
        pass.dedup();
        pass.retain(|row| active[*row]);
        if pass.is_empty() {
            break;
        }
        for &row in &pass {
            active[row] = false;
        }
        dropped.extend(pass.iter().copied());
    }
    dropped.sort_unstable();
    dropped.dedup();
    Ok(dropped)
}

fn main() {
 let args:Vec<String>=std::env::args().collect();let method=&args[1];let shape=&args[2];let n:usize=args[3].parse().unwrap();
 let mut a=Vec::with_capacity(n+4);let mut b=Vec::with_capacity(n+4);
 a.extend([0,0,1,1]);b.extend([0,1,0,1]);
 for i in 0..n {match shape.as_str(){
  "chain"=>{a.push((2+i/2)as u32);b.push((2+(i+1)/2)as u32);},
  "half"=>{a.push(if i<n/2 {(2+i)as u32}else{0});b.push(0);},
  "balanced"=>{a.push((i%2)as u32);b.push(((i/2)%2)as u32);}, _=>panic!("shape")
 }}
 let ai=LevelIndex::from_codes(&a,1+*a.iter().max().unwrap()as usize).unwrap();
 let bi=LevelIndex::from_codes(&b,1+*b.iter().max().unwrap()as usize).unwrap();
 let sources=[(a.as_slice(),&ai),(b.as_slice(),&bi)];
 let before=LIVE.load(Ordering::Relaxed);PEAK.store(before,Ordering::Relaxed);
 let start=std::time::Instant::now();
 let active=vec![true;n+4];
 let result=if method=="legacy" {legacy(&sources,active,None)}else{indexed::prune(&sources,active,None)}.unwrap();
 let seconds=start.elapsed().as_secs_f64();let peak=PEAK.load(Ordering::Relaxed)-before;
 let expected=match shape.as_str(){"chain"=>n,"half"=>n/2,_=>0};
 assert_eq!(result.len(),expected);
 assert!(result.iter().copied().eq(4..4+expected));
 let mut hash=14695981039346656037u64;for row in 0..n+4 {let keep=!(4..4+expected).contains(&row);hash=(hash^u64::from(keep)).wrapping_mul(1099511628211);}
 println!("{{\"method\":\"{}\",\"shape\":\"{}\",\"n\":{},\"dropped\":{},\"seconds\":{:.9},\"peak_bytes\":{},\"mask_hash\":\"{:016x}\"}}",method,shape,n+4,expected,seconds,peak,hash);
}
