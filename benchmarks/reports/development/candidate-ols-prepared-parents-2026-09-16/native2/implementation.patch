+                    .unwrap();
+                let base = unrestricted.memory_plan.selected_bytes();
+                let reserve = unrestricted.publication_memory.peak_bytes();
+                let limit = 512 * 1024 * 1024 + base + reserve;
+                let exact = spec
+                    .decode_with_memory_limit(&mut spi, || Ok(Some(limit)))
