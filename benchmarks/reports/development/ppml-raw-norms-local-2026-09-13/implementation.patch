+    #[test]
+    fn reusable_raw_norms_are_bound_to_the_current_call() {
+        let codes = [0_u32, 0, 1, 1, 2, 2, 3, 3];
+        let index = LevelIndex::from_codes(&codes, 4).unwrap();
+        let source = ValidatedBorrowedInterceptSource::new(&codes, 4, &index).unwrap();
+        let design = BorrowedInterceptFeDesign::new(codes.len(), vec![source.effect()]).unwrap();
+        let mut projector = ReusableCategoricalMapAbsorber::new(design, 3, 1).unwrap();
+        let capacities = projector.capacities();
+        let frames = [
+            [1.0, 3.0, 2.0, 5.0, 4.0, 7.0, 6.0, 8.0],
+            [8.0, 6.0, 7.0, 4.0, 5.0, 2.0, 3.0, 1.0],
+            [1e-100, 1e100, 1e100, 1e-100, 1e100, 1e100, 1e-100, 1e100],
+        ];
+        let mut norms = [-1.0; 2];
+        let mut references = [-2.0; 2];
+        for (frame, weights) in frames.iter().enumerate() {
+            let divisor = weights.iter().copied().fold(0.0_f64, f64::max);
+            let raw = DenseMatrix::from_columns(&[
+                (0..8).map(|r| (r + frame + 1) as f64 * 1e140).collect(),
+                vec![1.0; 8],
+                (0..8)
+                    .map(|r| ((r * 3 + frame) as f64).sin() * 1e-140)
+                    .collect(),
+            ])
+            .unwrap();
+            let expected_norms = |values: &DenseMatrix| {
+                [2, 0].map(|column| {
+                    (0..8).fold(0.0_f64, |norm, row| {
+                        norm.hypot((weights[row] / divisor).sqrt() * values[(row, column)])
+                    })
+                })
+            };
+            let expected_raw = expected_norms(&raw);
+            assert!(projector
+                .selected_norms_match_frame(BorrowedMapWeights::Provided(weights), divisor));
+            let (absorbed, reused) = projector
+                .absorb_with_selected_norms(
+                    BorrowedMapWeights::Provided(weights),
+                    raw,
+                    config(),
+                    divisor,
+                    [2, 0].into_iter(),
+                    &mut norms,
+                    Some(&mut references),
+                )
+                .unwrap();
+            assert!(reused);
+            for (actual, expected) in references.iter().zip(expected_raw) {
+                assert!((actual / expected - 1.0).abs() < 2e-15);
+            }
+            let expected_within = expected_norms(absorbed.residualized());
+            let (warm, reused) = projector
+                .absorb_with_selected_norms(
+                    BorrowedMapWeights::Provided(weights),
+                    absorbed.into_parts().0,
+                    config(),
+                    divisor,
+                    [2, 0].into_iter(),
+                    &mut norms,
+                    Some(&mut references),
+                )
+                .unwrap();
+            assert!(reused);
+            assert_eq!(warm.report().iterations, 0);
+            for (actual, expected) in references.iter().zip(expected_within) {
+                assert!((actual / expected - 1.0).abs() < 2e-15);
+            }
+            let saved = (norms, references);
+            let matrix =
+                || DenseMatrix::from_columns(&[vec![1.0; 8], vec![1.0; 8], vec![1.0; 8]]).unwrap();
+            assert!(projector
+                .absorb_with_selected_norms(
+                    BorrowedMapWeights::Provided(weights),
+                    matrix(),
+                    config(),
+                    divisor,
+                    [2, 0].into_iter(),
+                    &mut norms,
+                    Some(&mut references[..1]),
+                )
+                .is_err());
+            assert_eq!((norms, references), saved);
+            let (_, reused) = projector
+                .absorb_with_selected_norms(
+                    BorrowedMapWeights::Provided(weights),
+                    matrix(),
+                    config(),
+                    divisor * 8.0,
+                    [2, 0].into_iter(),
+                    &mut norms,
+                    Some(&mut references),
+                )
+                .unwrap();
+            assert!(!reused);
+            assert_eq!((norms, references), saved);
+            let invalid =
+                DenseMatrix::from_columns(&[vec![f64::NAN; 8], vec![1.0; 8], vec![1.0; 8]])
+                    .unwrap();
+            assert!(projector
+                .absorb_with_selected_norms(
+                    BorrowedMapWeights::Provided(weights),
+                    invalid,
+                    config(),
+                    divisor,
+                    [2, 0].into_iter(),
+                    &mut norms,
+                    Some(&mut references),
+                )
+                .is_err());
+            assert_eq!((norms, references), saved);
+        }
+        assert_eq!(projector.capacities(), capacities);
+    }
