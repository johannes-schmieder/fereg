+    /// A frame compatibility check, not authority for previously computed norms.
+    /// Only a subsequent successful projection can supply the selected values.
+    pub(crate) fn selected_norms_match_frame(
+        &self,
+        weights: BorrowedMapWeights<'_>,
+        norm_weight_scale: f64,
+    ) -> bool {
+        if self.design.effects().len() != 1 {
+            return false;
+        }
+        let raw_scale = match weights {
+            BorrowedMapWeights::Unit => 1.0,
+            BorrowedMapWeights::Provided(values) => values.iter().copied().fold(0.0_f64, f64::max),
+        };
+        raw_scale == norm_weight_scale
+    }
