+pub(crate) fn absorb_ols_schur_certified(
+    design: BorrowedInterceptFeDesign<'_>, weights: BorrowedMapWeights<'_>,
+    values: DenseMatrix, config: crate::fe::AbsorbConfig, probe_seconds: f64, contraction: f64,
+) -> Result<CertifiedBorrowedMap> {
+    let started = Instant::now();
+    let mut absorber = ReusableCategoricalMapAbsorber::new(design, values.ncols(), rayon::current_num_threads())?;
+    validate_config(config.map)?;
+    if values.as_slice().iter().any(|v| !v.is_finite()) { return Err(invalid_data("OLS Schur values must be finite")); }
+    let validated = validate_weights(weights, values.nrows())?;
+    absorber.workspace.set_rhs_count(values.ncols())?;
+    weighted_column_norms(&values, validated, &mut absorber.workspace.reference_norms,
+        &mut absorber.workspace.value_scales, &mut absorber.workspace.group_sums)?;
+    let setup_seconds = started.elapsed().as_secs_f64();
+    let solve_started = Instant::now();
