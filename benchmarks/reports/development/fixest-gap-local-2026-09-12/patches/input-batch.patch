+        let mut chunk = reserved_empty(columns.len(), "numeric batch pointers")?;
+        chunk.extend(columns.iter_mut().map(|column| &mut column[start..end]));
+        let mut status_chunks = reserved_empty(positions.len(), "missing batch pointers")?;
+        status_chunks.extend(statuses.chunks_mut(capacity).map(|part| &mut part[..count]));
