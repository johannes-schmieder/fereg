+enum SchurAttempt {
+    Certified(CertifiedBorrowedMap),
+    Continue { values: DenseMatrix, iterations: usize, candidate: bool },
+}
+
+pub(crate) fn schur_ols_workspace_bytes(
+    design: &BorrowedInterceptFeDesign<'_>, rhs: usize, threads: usize,
+) -> Result<u128> {
+    if design.effects().len() != 2 || !(1..=64).contains(&rhs) || threads == 0 {
+        return Err(invalid_argument("OLS Schur workspace dimensions are unsupported"));
+    }
+    let left = design.effects().iter().map(|e| e.n_levels()).max().unwrap() as u128;
+    let right = design.effects().iter().map(|e| e.n_levels()).min().unwrap() as u128;
+    let width = rhs as u128;
+    let parallel = design.nobs() >= PARALLEL_PROJECTION_MIN_ROWS && threads > 1;
+    let mut elements = left + right + (2 * left + 4 * right) * width + 12 * width;
+    if parallel {
+        elements += left * width + left
+            + design.nobs().div_ceil(PARALLEL_DOT_CHUNK_ROWS) as u128 * width;
+    }
+    // The three-column probe is released before the full session is constructed.
+    let probe_elements = left + right + (2 * left + 4 * right) * 3;
+    Ok(8 * elements.max(probe_elements))
+}
+
+pub(crate) fn schur_ols_probe(design: &BorrowedInterceptFeDesign<'_>, values: &DenseMatrix) -> Result<f64> {
+    if design.effects().len() != 2 || design.nobs() != values.nrows() || values.ncols() < 3 {
+        return Err(invalid_argument("OLS Schur probe dimensions are unsupported"));
+    }
+    let mut reservation = SystemWorkspaceReservation;
+    let mut graph = TwoFePcgWorkspace::new(design, 3, &mut reservation)?;
+    let left = &design.effects()[graph.left_effect];
+    let right = &design.effects()[graph.right_effect];
+    let columns = [0, 1, values.ncols() / 2];
+    for row in 0..design.nobs() {
+        let a = left.codes()[row] as usize;
+        let b = right.codes()[row] as usize;
+        graph.left_weights[a] += 1.0;
+        graph.right_weights[b] += 1.0;
+        for (rhs, &column) in columns.iter().enumerate() {
+            graph.left_rhs[a * 3 + rhs] += values[(row, column)];
+            graph.residual[b * 3 + rhs] += values[(row, column)];
+        }
+    }
+    for level in 0..left.n_levels() {
+        for rhs in 0..3 { graph.left_rhs[level * 3 + rhs] /= graph.left_weights[level]; }
+    }
+    for row in 0..design.nobs() {
+        let a = left.codes()[row] as usize;
+        let b = right.codes()[row] as usize;
+        for rhs in 0..3 { graph.residual[b * 3 + rhs] -= graph.left_rhs[a * 3 + rhs]; }
+    }
+    let mut square = [0.0; 3];
+    for level in 0..right.n_levels() {
+        for rhs in 0..3 {
+            let i = level * 3 + rhs;
+            graph.direction[i] = graph.residual[i] / graph.right_weights[level];
+            square[rhs] = graph.residual[i].mul_add(graph.direction[i], square[rhs]);
+        }
+    }
+    let initial = square;
+    if initial.iter().any(|v| !v.is_finite() || *v < 0.0) { return Ok(f64::INFINITY); }
+    for _ in 0..8 {
+        graph.apply_schur(design, ValidatedWeights { values: None, raw_scale: 1.0 }, 3, 3)?;
+        let mut projection = [0.0; 3];
+        for level in 0..right.n_levels() {
+            for rhs in 0..3 {
+                let i = level * 3 + rhs;
+                projection[rhs] = graph.direction[i].mul_add(graph.operator[i], projection[rhs]);
+            }
+        }
+        let mut step = [0.0; 3];
+        for rhs in 0..3 {
+            if square[rhs] <= initial[rhs] * 1e-24 || square[rhs] == 0.0 { continue; }
+            if !projection[rhs].is_finite() || projection[rhs] <= 0.0 { return Ok(f64::INFINITY); }
+            step[rhs] = square[rhs] / projection[rhs];
+        }
+        let mut next = [0.0; 3];
+        for level in 0..right.n_levels() {
+            for rhs in 0..3 {
+                let i = level * 3 + rhs;
+                graph.residual[i] = (-step[rhs]).mul_add(graph.operator[i], graph.residual[i]);
+                next[rhs] = graph.residual[i].mul_add(graph.residual[i] / graph.right_weights[level], next[rhs]);
+            }
+        }
+        for rhs in 0..3 {
+            if !next[rhs].is_finite() || next[rhs] < 0.0 { return Ok(f64::INFINITY); }
+        }
+        for level in 0..right.n_levels() {
+            for rhs in 0..3 {
+                let i = level * 3 + rhs;
+                graph.direction[i] = if step[rhs] == 0.0 { 0.0 } else {
+                    graph.residual[i] / graph.right_weights[level] + next[rhs] / square[rhs] * graph.direction[i]
+                };
+            }
+        }
+        square = next;
+    }
+    Ok((0..3).map(|rhs| if initial[rhs] == 0.0 { 0.0 } else { (square[rhs] / initial[rhs]).sqrt() }).fold(0.0, f64::max))
+}
