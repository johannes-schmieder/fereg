+            let coefficients = vec![Some(f64::MAX); generated];
+            assert_eq!(
+                bound
+                    .subtract_fitted(&coefficients, &mut residual)
+                    .unwrap_err()
+                    .code,
+                ErrorCode::InvalidData
+            );
+        }
+        numeric.sample.regressors[1][200] = f64::NAN;
