+        let mut numeric = prepared(&outcome, &x, &omitted, None, false, TestWeights::Unit);
+        let effects = vec![
+            (0..rows).map(|r| (r % 17) as f64).collect(),
+            (0..rows).map(|r| (r % 23) as f64).collect(),
