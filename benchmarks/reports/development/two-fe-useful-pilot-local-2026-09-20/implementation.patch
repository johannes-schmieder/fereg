+
+pub(crate) enum NarrowOlsSchurAttempt {
+    Certified(CertifiedBorrowedMap),
+    Rejected {
+        values: DenseMatrix,
+        contraction: f64,
+        probe_seconds: f64,
+        peak: SolverWorkspacePeak,
+    },
