+/// Fill generated recipes in bounded row tiles within the caller's admitted
+/// matrix. Numeric-only designs retain their existing specialized paths.
+/// Factor codes stay borrowed; neither expanded columns nor interaction tuples
+/// are retained. Public builders validate the authoritative sample first.
+pub(crate) fn fill_generated_rhs_block<P: PreparedOlsFitView + ?Sized>(
+    prepared: &P,
+    generated: std::ops::Range<usize>,
+    response: Option<&[f64]>,
+    output: &mut [f64],
+) -> Result<bool> {
+    use super::ols::PreparedOlsColumnKind;
+    let invalid = || {
+        FeregError::new(
+            ErrorCode::InvalidArgument,
+            "generated RHS block is not aligned",
+        )
+    };
+    let recipes = prepared
+        .fit_model()
+        .columns
+        .get(generated)
+        .ok_or_else(invalid)?;
+    let rows = prepared.fit_sample().n_active();
+    if rows < 4096
+        || !recipes.iter().any(|column| {
+            matches!(
+                column.kind,
+                PreparedOlsColumnKind::Categorical { .. }
+                    | PreparedOlsColumnKind::CategoricalInteraction { .. }
+            )
+        })
+    {
+        return Ok(false);
+    }
+    let offset = usize::from(response.is_some());
+    let width = recipes.len().checked_add(offset).ok_or_else(invalid)?;
+    if rows.checked_mul(width) != Some(output.len()) || response.is_some_and(|v| v.len() != rows) {
+        return Err(invalid());
+    }
+    // Keep the destination tile near 64 KiB even when generated width grows.
+    // The only auxiliary payload is the fixed 128-byte interaction mask.
+    let tile_rows = (8192 / width).clamp(1, 128);
+    let tile_elements = tile_rows * width;
+    let fill = |(tile, destination): (usize, &mut [f64])| -> Result<()> {
+        let start = tile * tile_rows;
+        let count = destination.len() / width;
+        let end = start + count;
+        if let Some(response) = response {
+            for (row, value) in destination
+                .chunks_exact_mut(width)
+                .zip(&response[start..end])
+            {
+                row[0] = *value;
+            }
+        }
+        for (position, column) in recipes.iter().enumerate() {
+            let target = position + offset;
+            match &column.kind {
+                PreparedOlsColumnKind::Intercept => {
+                    for row in destination.chunks_exact_mut(width) {
+                        row[target] = 1.0;
+                    }
+                }
+                PreparedOlsColumnKind::Continuous {
+                    prepared_source_index,
+                    ..
+                } => {
+                    let values = prepared
+                        .fit_sample()
+                        .regressors
+                        .get(*prepared_source_index)
+                        .and_then(|v| v.get(start..end))
+                        .ok_or_else(invalid)?;
+                    for (row, value) in destination.chunks_exact_mut(width).zip(values) {
+                        row[target] = *value;
+                    }
+                }
+                PreparedOlsColumnKind::Categorical {
+                    categorical_source_index,
+                    level_code,
+                    ..
+                } => {
+                    if let Some(level) = level_code {
+                        let codes = prepared.fit_categorical_codes(*categorical_source_index)?;
+                        let codes = codes.get(start..end).ok_or_else(invalid)?;
+                        for (row, code) in destination.chunks_exact_mut(width).zip(codes) {
+                            row[target] = f64::from(code == level);
+                        }
+                    } else {
+                        for row in destination.chunks_exact_mut(width) {
+                            row[target] = 0.0;
+                        }
+                    }
+                }
+                PreparedOlsColumnKind::CategoricalInteraction { components } => {
+                    let mut present = [true; 128];
+                    for component in components {
+                        let Some(level) = component.level_code else {
+                            present[..count].fill(false);
+                            break;
+                        };
+                        let codes =
+                            prepared.fit_categorical_codes(component.categorical_source_index)?;
+                        let codes = codes.get(start..end).ok_or_else(invalid)?;
+                        for (present, code) in present[..count].iter_mut().zip(codes) {
+                            *present &= *code == level;
+                        }
+                    }
+                    for (row, present) in destination.chunks_exact_mut(width).zip(&present[..count])
+                    {
+                        row[target] = f64::from(*present);
+                    }
+                }
+            }
+        }
+        Ok(())
+    };
+    if output.len() >= 65536
+        && rayon::current_thread_index().is_some()
+        && rayon::current_num_threads() > 1
+    {
+        output
+            .par_chunks_mut(tile_elements)
+            .enumerate()
+            .try_for_each(fill)?;
+    } else {
+        output
+            .chunks_mut(tile_elements)
+            .enumerate()
+            .try_for_each(fill)?;
+    }
+    Ok(true)
+}
