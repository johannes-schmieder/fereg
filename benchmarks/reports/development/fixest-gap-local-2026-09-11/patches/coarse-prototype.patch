+// LOCAL DIAGNOSTIC ONLY: explicit elimination may expand sparse graphs and has
+// not been admitted to the production memory planner or automatic policy.
+pub(crate) fn absorb_schur_cmg_probe(
+    design: &BorrowedInterceptFeDesign<'_>, weights: BorrowedMapWeights<'_>,
+    mut values: DenseMatrix, map: MapConfig,
+) -> Result<CertifiedBorrowedMap> {
+    use rayon::prelude::*;
+    let began = Instant::now();
+    let scale = validate_weights(weights, design.nobs())?;
+    let reference_norms = weighted_column_norms(&values, weights, scale)?;
+    let left_index = usize::from(design.effects()[1].n_levels() > design.effects()[0].n_levels());
+    let left = &design.effects()[left_index];
+    let right = &design.effects()[1-left_index];
+    let mut edges = Vec::new();
+    let mut left_weights = zero_vec(left.n_levels(), "probe left weights")?;
+    for (level, total) in left_weights.iter_mut().enumerate() {
+        let members = left.level_index().checked_members(level)?;
+        if members.len() > 16 { return Err(invalid_argument("local explicit Schur probe degree cap")); }
+        *total = members.iter().map(|&row| normalized_weight(weights, scale, row)).sum();
+        for (i, &row) in members.iter().enumerate() {
+            for &other in &members[i+1..] {
+                if right.codes()[row] != right.codes()[other] {
+                    edges.push((right.codes()[row] as usize, right.codes()[other] as usize,
+                        normalized_weight(weights, scale, row)*normalized_weight(weights, scale, other)/ *total));
+                }
+            }
+        }
+    }
+    let generated_edges = edges.len();
+    let parallel = ParallelOptions { threads: rayon::current_num_threads(), ..ParallelOptions::default() };
+    let executor = ParallelExecutor::new(parallel).map_err(cmg_error)?;
+    let graph = Laplacian::from_edges_with_executor(right.n_levels(), edges, &executor).map_err(cmg_error)?;
+    let canonical_edges = graph.edges().len();
+    let preconditioner = CmgPreconditioner::build_with_executor(&graph, CmgOptions::default(), &executor).map_err(cmg_error)?;
+    drop(graph);
+    let solver = ParallelPcgSolver::from_preconditioner(preconditioner, executor, ParallelPcgPolicy::default()).map_err(cmg_error)?;
+    let mut workspace = solver.workspace();
+    let setup_seconds = began.elapsed().as_secs_f64();
+    let solve_started = Instant::now();
+    let mut iterations = 0;
+    let mut backward_error = 0.0_f64;
+    let capacity = 10;
+    let concurrency = solver.select_batch_execution(capacity).map_err(cmg_error)?.concurrency().max(1);
+    let batch_width = capacity/concurrency*concurrency;
+    for start in (0..values.ncols()).step_by(batch_width) {
+        let end = (start + batch_width).min(values.ncols());
+        let width = end-start;
+        let mut left_means = DenseMatrix::zeros(left.n_levels(), width)?;
+        left_means.as_mut_slice().par_chunks_mut(width).enumerate().try_for_each(|(level, means)| -> Result<()> {
+            for &row in left.level_index().checked_members(level)? {
+                let weight = normalized_weight(weights, scale, row);
+                for (local, mean) in means.iter_mut().enumerate() { *mean += weight * values[(row,start+local)]; }
+            }
+            for mean in means { *mean /= left_weights[level]; }
+            Ok(())
+        })?;
+        let mut rhs = zero_matrix_vectors(width, right.n_levels(), "probe right RHS")?;
+        rhs.par_iter_mut().enumerate().try_for_each(|(local, column)| -> Result<()> {
+            for (level, value) in column.iter_mut().enumerate() {
+                for &row in right.level_index().checked_members(level)? {
+                    *value += normalized_weight(weights, scale, row) * (values[(row,start+local)] - left_means[(left.codes()[row] as usize,local)]);
+                }
+            }
+            Ok(())
+        })?;
+        let solved = solver.solve_batch_with_workspace(&rhs, PcgOptions {
+            relative_tolerance: (map.tolerance*0.01).max(32.0*f64::EPSILON), max_iterations: map.max_iterations,
+            ..PcgOptions::default()
+        }, &mut workspace).map_err(cmg_solve_error)?;
+        for result in solved.results() { iterations = iterations.max(result.iterations()); backward_error = backward_error.max(result.backward_error()); }
+        left_means.as_mut_slice().par_chunks_mut(width).enumerate().try_for_each(|(level, means)| -> Result<()> {
+            for (local, mean) in means.iter_mut().enumerate() {
+                let mut correction = 0.0;
+                for &row in left.level_index().checked_members(level)? {
+                    correction += normalized_weight(weights, scale, row) * solved.results()[local].solution()[right.codes()[row] as usize];
+                }
+                *mean -= correction/left_weights[level];
+            }
+            Ok(())
+        })?;
+        let columns = values.ncols();
+        values.as_mut_slice().par_chunks_mut(columns).enumerate().try_for_each(|(row, values)| -> Result<()> {
+            for local in 0..width {
+                values[start+local] -= left_means[(left.codes()[row] as usize,local)] + solved.results()[local].solution()[right.codes()[row] as usize];
+                if !values[start+local].is_finite() { return Err(invalid_data("probe nonfinite reconstructed value")); }
+            }
+            Ok(())
+        })?;
+    }
+    let bulk_seconds = solve_started.elapsed().as_secs_f64();
+    let polished = polish_borrowed_intercept_cg_with_reference_norms_certified(design, weights, values, map, &reference_norms)?;
+    let (values, mut report) = polished.into_parts();
+    report.requested_solver = FeSolverKind::Auto;
+    report.used_solver = FeSolverKind::Cmg;
+    report.iterations += iterations;
+    report.normal_equation_residual = report.normal_equation_residual.max(backward_error);
+    report.setup_seconds += setup_seconds;
+    report.solve_seconds += bulk_seconds;
+    if std::env::var_os("FEREG_PHASE_TIMING").is_some() {
+        eprintln!("FEREG_PHASE|coarse_probe|vertices={}|generated_edges={generated_edges}|canonical_edges={canonical_edges}|setup={setup_seconds:.9}|bulk={bulk_seconds:.9}|polish={:.9}|iterations={iterations}",right.n_levels(),solve_started.elapsed().as_secs_f64()-bulk_seconds);
+    }
+    CertifiedBorrowedMap::from_certified_parts(values, report)
+}
