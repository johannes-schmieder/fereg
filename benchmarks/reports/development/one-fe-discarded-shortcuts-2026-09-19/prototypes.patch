+/// Whole groups occupy disjoint row ranges. Keep each group's means on the
+/// stack and update its rows while they are hot, using the same scaled,
+/// compensated mean primitive as the general kernel. Certification remains
+/// a separate pass over the completed residual matrix.
+#[allow(clippy::too_many_arguments)]
+fn project_contiguous_levels(
+    effect: &crate::fe::BorrowedInterceptEffect<'_>,
+    weights: ValidatedWeights<'_>,
+    nrows: usize,
+    columns: usize,
+    first_level: usize,
+    end_level: usize,
+    first_row: usize,
+    values: &mut [f64],
+    level_chunk: usize,
+) -> Result<()> {
+    if end_level - first_level > level_chunk {
+        let middle = first_level + (end_level - first_level) / 2;
+        let middle_row = effect.level_index().checked_members(middle)?.first().copied()
+            .ok_or_else(|| invalid_argument("borrowed MAP effect contains an empty final level"))?;
+        let (left, right) = values.split_at_mut((middle_row - first_row) * columns);
+        let (left_result, right_result) = rayon::join(
+            || project_contiguous_levels(effect, weights, nrows, columns, first_level, middle,
+                first_row, left, level_chunk),
+            || project_contiguous_levels(effect, weights, nrows, columns, middle, end_level,
+                middle_row, right, level_chunk),
+        );
+        left_result?;
+        return right_result;
+    }
+    let mut means = [0.0; PARALLEL_GROUP_MAX_RHS];
+    let mut start = 0;
+    for level in first_level..end_level {
+        let rows = effect.level_index().checked_members(level)?.len();
+        let group_start = first_row + start / columns;
+        let end = start + rows * columns;
+        let group = &mut values[start..end];
+        fused_group_means_by_value(effect, level, weights, nrows, &mut means[..columns],
+            |row, column| group[(row - group_start) * columns + column])?;
+        for row in group.chunks_exact_mut(columns) {
+            for (value, mean) in row.iter_mut().zip(&means[..columns]) {
+                *value -= mean;
+                if !value.is_finite() {
+                    return Err(invalid_data("borrowed MAP projection produced a nonfinite residual"));
+                }
+            }
+        }
+        start = end;
+    }
+    Ok(())
+}
