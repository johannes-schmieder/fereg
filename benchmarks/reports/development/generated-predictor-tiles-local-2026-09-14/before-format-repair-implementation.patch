+                categorical_interaction_term(4, (g.id, 99.0), (h.id, 2.0)),
+            ];
+            for level in 2..=67 {
+                terms.push(categorical_term(level + 3, g.id, f64::from(level), false));
+            }
+            terms.push(categorical_term(71, h.id, 1.0, true));
