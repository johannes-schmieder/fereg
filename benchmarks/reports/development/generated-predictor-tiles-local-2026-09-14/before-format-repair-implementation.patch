diff --git a/crates/fereg-core/src/ols/prepared_fit_view.rs b/crates/fereg-core/src/ols/prepared_fit_view.rs
index a658779..1894ffc 100644
--- a/crates/fereg-core/src/ols/prepared_fit_view.rs
