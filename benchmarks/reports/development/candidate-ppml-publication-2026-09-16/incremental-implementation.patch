+    pub(crate) fn capacity_bytes(&self) -> u128 {
+        [
+            &self.b,
+            &self.covariance,
+            &self.coefficient_status,
+            &self.fit,
+            &self.dof,
+            &self.fixed_effects,
+            &self.clusters,
