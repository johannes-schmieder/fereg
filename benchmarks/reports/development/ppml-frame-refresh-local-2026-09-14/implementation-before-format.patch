+    #[test]
+    fn combined_frame_refresh_rejects_invalid_inputs_before_discarding_output() {
+        let outcome = vec![1.2, 4.0, 0.5, 6.1, 2.7, 8.3, 5.5, 11.8];
+        let x = vec![-2.0, 0.5, -1.0, 2.0, -0.25, 3.0, 1.0, 4.5];
+        let weights = vec![1.5, 0.75, 2.0, 1.25, 3.5, 0.6, 1.8, 2.2];
+        let prepared = prepared_two_fe(&outcome, &x);
+        let scale = ppml_bread_weight_scale(&weights).unwrap();
+        let frame = LinearSolveFrame::from_parts(
+            &outcome, BorrowedMapWeights::Provided(&weights), scale,
+        ).unwrap();
+        for mode in [PreparedOlsExecutionMode::Fast, PreparedOlsExecutionMode::Low] {
+            let mut config = ppml_linear_config(PreparedPpmlIrlsConfig::default(), 1e-10).unwrap();
+            config.execution.mode = mode;
+            config.execution.poolsize = 1;
+            let mut session = CertifiedLinearSession::new_with_ppml_fe_design(
+                &prepared, frame, config, LinearSessionGenerations::new(1, 1, 1, 1, 1),
+                prepared.fit_owned_fe_design().unwrap(),
+            ).unwrap();
+            let initial = session.solve_fresh().unwrap();
+            let coefficients = initial.fit().coefficients().to_vec();
+            let capacities = session.workspace_capacities();
+            for bad in [0.0, -1.0, f64::NAN, f64::INFINITY] {
+                let mut invalid = weights.clone();
+                invalid[2] = bad;
+                assert!(session.refresh_frame(&x, BorrowedMapWeights::Provided(&invalid), scale, 2).is_err());
+                let retained = session.output().expect("rejected input must leave prior fit usable");
+                assert!(retained.certified());
+                assert_eq!(retained.response(), outcome);
+                assert_eq!(retained.fit().coefficients(), coefficients);
+                assert_eq!(session.workspace_capacities(), capacities);
+            }
+            let mut invalid_response = outcome.clone();
+            invalid_response[0] = f64::NAN;
+            assert!(session.refresh_frame(&invalid_response, BorrowedMapWeights::Provided(&weights), scale, 2).is_err());
+            assert!(session.output().unwrap().certified());
+            // Reusing generation 2 proves none of the rejected frames advanced it.
+            assert!(session.refresh_frame(&x, BorrowedMapWeights::Provided(&weights), scale, 2).unwrap());
+            assert!(session.strict_candidate().unwrap().candidate().certified());
+        }
+    }
