+fn canonical_witness_objective_accepts(
+    accepted: PoissonObjective,
+    candidate: PoissonObjective,
+    config: PpmlConfig,
+) -> bool {
+    // Same full-step objective rule as accept_candidate_interruptible and the
+    // registered deviance convergence denominator (including near-zero D).
+    let allowed = accepted.deviance
+        + config.objective_slack * accepted.deviance.abs().max(1.0);
+    candidate.deviance <= allowed
+        && relative_deviance_change(accepted, candidate) <= config.tolerance
+}
+
 fn relative_deviance_change(old: PoissonObjective, new: PoissonObjective) -> f64 {
     (old.deviance - new.deviance).abs() / old.deviance.min(new.deviance).max(0.1)
 }
