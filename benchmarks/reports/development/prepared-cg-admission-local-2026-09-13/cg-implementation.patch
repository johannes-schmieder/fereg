+                                        _ => {
+                                            let mut session = FitFeAbsorber {
+                                                session: None,
+                                                lsmr: None,
+                                                auto_direct_solver: Some(FeSolverKind::Cg),
+                                                auto_discarded_setup_seconds: 0.0,
+                                                auto_setup_warning: None,
+                                                schur_config: None,
+                                                schur_probe: None,
+                                            };
+                                            absorb_fit_matrix(
+                                                view,
+                                                weights,
+                                                values,
+                                                config,
+                                                &mut session,
+                                                true,
+                                                false,
+                                            )
+                                        }
+                                    }
+                                };
+                                let error = run(execution + incremental - 1)
