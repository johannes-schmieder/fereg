+        .and_then(|cells| cells.checked_mul(2 * std::mem::size_of::<usize>() as u128));
+    values
+        .and_then(|bytes| bytes.checked_add(metadata?))
+        .ok_or_else(|| allocation("retained FE product parent overflows"))
