+    #[test]
+    fn mean_reuse_invalidates_trial_scratch_before_partial_writes() {
+        let bounds = PoissonBounds::default();
+        for failure in 0..4 {
+            let mut workspace = mean_reuse_workspace(MemoryMode::Fast, &[0.0; 4]);
+            workspace
+                .refresh_working_state(&[1.0; 4], &[1.0; 4], &[0.0; 4], bounds)
+                .unwrap();
+            workspace.set_candidate_eta(&[0.2; 4]).unwrap();
+            workspace.fill_line_search_trial(0.5, bounds).unwrap();
+            assert_eq!(workspace.trial_mean_bounds, Some(bounds));
+            let step = match failure {
+                0 => f64::NAN,
+                1 => {
+                    workspace.candidate_eta_mut()[2] = f64::NAN;
+                    0.5
+                }
+                2 => {
+                    workspace.candidate_coefficients_mut()[0] = f64::NAN;
+                    0.5
+                }
+                _ => {
+                    workspace
+                        .set_candidate_eta(&[0.3, 1000.0, 0.5, 0.6])
+                        .unwrap();
+                    1.0
+                }
+            };
+            assert!(workspace.fill_line_search_trial(step, bounds).is_err());
+            assert_eq!(workspace.trial_mean_bounds, None);
+            assert_eq!(workspace.eta(), &[0.0; 4]);
+            assert_eq!(workspace.mean_bounds, Some(bounds));
+            workspace
+                .refresh_working_state(&[1.0; 4], &[1.0; 4], &[0.0; 4], bounds)
+                .unwrap();
+            assert_mean_reuse_matches_fresh(&workspace, &[1.0; 4], &[1.0; 4], &[0.0; 4]);
+        }
+    }
