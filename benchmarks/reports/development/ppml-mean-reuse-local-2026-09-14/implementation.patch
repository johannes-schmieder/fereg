+    fn mean_reuse_workspace(mode: MemoryMode, eta: &[f64]) -> PpmlIterationWorkspace {
+        let mut dims = dimensions();
+        dims.observations = eta.len();
+        dims.fe_max_level_members = eta.len();
+        dims.finite_columns = 1;
+        dims.coefficient_slots = 1;
+        dims.reported_coefficient_slots = 1;
+        let plan = plan_ppml_memory(
+            dims,
+            PpmlMemoryConfig {
+                requested: mode,
+                poolsize: 1,
+                diagnostic_capacity: 0,
+                ..PpmlMemoryConfig::default()
+            },
+        )
+        .unwrap();
+        PpmlIterationWorkspace::new(plan, eta).unwrap()
+    }
+
+    fn assert_mean_reuse_matches_fresh(
+        workspace: &PpmlIterationWorkspace,
+        outcome: &[f64],
+        weights: &[f64],
+        offset: &[f64],
+    ) {
+        let expected_mean = workspace
+            .eta()
+            .iter()
+            .map(|eta| eta.exp())
+            .collect::<Vec<_>>();
+        let mut expected_weight = vec![0.0; outcome.len()];
+        let mut expected_response = vec![0.0; outcome.len()];
+        fill_poisson_working_state(
+            outcome,
+            &expected_mean,
+            weights,
+            workspace.eta(),
+            offset,
+            &mut expected_weight,
+            &mut expected_response,
+        )
+        .unwrap();
+        assert_eq!(workspace.mean(), expected_mean);
+        assert_eq!(workspace.hessian_weights(), expected_weight);
+        assert_eq!(workspace.working_response(), expected_response);
+        for ((&actual, &y), &mean) in workspace
+            .score_residuals()
+            .iter()
+            .zip(outcome)
+            .zip(&expected_mean)
+        {
+            assert_eq!(actual.to_bits(), (y - mean).to_bits());
+        }
+    }
