+    #[test]
+    fn mean_reuse_keeps_working_inputs_fresh_across_swaps_and_repeated_bounds_failures() {
+        for mode in [MemoryMode::Fast, MemoryMode::Low] {
+            let mut workspace = mean_reuse_workspace(mode, &[-1.0, 0.0, 0.5, 1.0]);
+            let capacity = workspace.capacity_report();
+            let bounds = PoissonBounds::default();
+            assert_eq!(workspace.mean_bounds, None);
+            for (outcome, weights, offset) in [
+                ([0.0, 1.0, 2.0, 3.0], [1.0; 4], [0.0; 4]),
+                (
+                    [4.0, 0.0, 3.0, 1.0],
+                    [0.5, 2.0, 4.0, 1.0],
+                    [0.1, -0.3, 0.5, 1.0],
+                ),
+            ] {
+                workspace
+                    .refresh_working_state(&outcome, &weights, &offset, bounds)
+                    .unwrap();
+                assert_mean_reuse_matches_fresh(&workspace, &outcome, &weights, &offset);
+                assert_eq!(workspace.mean_bounds, Some(bounds));
+            }
+            for bad_bounds in [
+                PoissonBounds {
+                    eta_min: -0.5,
+                    ..bounds
+                },
+                PoissonBounds {
+                    eta_max: 0.7,
+                    ..bounds
+                },
+                PoissonBounds {
+                    mu_min: 0.8,
+                    ..bounds
+                },
+                PoissonBounds {
+                    mu_max: 2.0,
+                    ..bounds
+                },
+                PoissonBounds {
+                    eta_min: f64::NAN,
+                    ..bounds
+                },
+            ] {
+                for _ in 0..2 {
+                    assert!(workspace
+                        .refresh_working_state(&[1.0; 4], &[1.0; 4], &[0.0; 4], bad_bounds)
+                        .is_err());
+                    assert_eq!(workspace.mean_bounds, None);
+                }
+                workspace
+                    .refresh_working_state(&[1.0; 4], &[1.0; 4], &[0.0; 4], bounds)
+                    .unwrap();
+                assert_mean_reuse_matches_fresh(&workspace, &[1.0; 4], &[1.0; 4], &[0.0; 4]);
+            }
+            assert!(workspace
+                .refresh_working_state(&[-1.0; 4], &[1.0; 4], &[0.0; 4], bounds)
+                .is_err());
+            assert!(workspace
+                .refresh_working_state(&[1.0; 4], &[0.0; 4], &[0.0; 4], bounds)
+                .is_err());
+            // Outcome/weight errors do not change the inputs of the valid mean.
+            assert_eq!(workspace.mean_bounds, Some(bounds));
+            workspace.set_candidate_eta(&[0.2, 0.3, 0.4, 0.5]).unwrap();
+            workspace.set_candidate_coefficients(&[0.4]).unwrap();
+            workspace.fill_line_search_trial(0.5, bounds).unwrap();
+            let trial = workspace.trial_mean().to_vec();
+            workspace.accept_trial().unwrap();
+            assert_eq!(workspace.mean(), trial);
+            assert_eq!(workspace.mean_bounds, Some(bounds));
+            workspace
+                .refresh_working_state(&[1.0; 4], &[2.0; 4], &[0.25; 4], bounds)
+                .unwrap();
+            assert_mean_reuse_matches_fresh(&workspace, &[1.0; 4], &[2.0; 4], &[0.25; 4]);
+            assert_eq!(workspace.capacity_report(), capacity);
+        }
