+    // Stata's waiting MP workers can compete with the native team. The request
+    // already owns its thread policy; change only the host workers and restore
+    // them before validation or publication, including native errors and Break.
+    local host_processors = c(processors)
+    nobreak {
+        if `host_processors' > 1 quietly set processors 1
+        capture noisily break plugin call __fereg_estimate_plugin ///
+            `touse' `depvar' `source_vars' `weight_variable' ///
+            `adjustment_variable' `biasunit' `output_variables', ///
+            `"estimate-ppml"' `"`request_bundle'"'
+        local native_rc = _rc
+        if `host_processors' > 1 quietly set processors `host_processors'
+    }
+    if `native_rc' exit `native_rc'
 
     // Developer-only publication-boundary mutations prove that malformed
